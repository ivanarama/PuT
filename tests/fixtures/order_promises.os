Функция ПервыйТовар(Док)
  Для Каждого Строка Из Док.Товары Цикл
    Возврат Строка.Номенклатура;
  КонецЦикла;
КонецФункции

Функция ДокументПоставщика(Менеджер, Продажа, Поставщик, День)
  Док = Менеджер.Создать();
  Док.Организация = Продажа.Организация;
  Док.Склад = Продажа.Склад;
  Док.Поставщик = Поставщик;
  Док.Дата = Дата(2031, 7, День, 12, 0, 0);
  Возврат Док;
КонецФункции

Процедура СтрокаПоставки(Закупка, Продажа, Количество, ДеньПоставки)
  Позиция = Закупка.Товары.Добавить();
  Позиция.ЗаказПокупателя = Продажа.Ссылка;
  Позиция.Номенклатура = ПервыйТовар(Продажа);
  Позиция.Количество = Количество;
  Позиция.Цена = 100;
  Если ДеньПоставки > 0 Тогда
    Позиция.ПодтвержденнаяДатаПоставки = Дата(2031, 7, ДеньПоставки);
  КонецЕсли;
КонецПроцедуры

Процедура Приёмка(Продажа, Поставщик, День, Количество, Заказ, НомерСтроки)
  Док = ДокументПоставщика(Документы.ПоступлениеТоваров, Продажа, Поставщик, День);
  Позиция = Док.Товары.Добавить();
  Позиция.Номенклатура = ПервыйТовар(Продажа);
  Позиция.Количество = Количество;
  Позиция.Цена = 100;
  Если ЗначениеЗаполнено(Заказ) Тогда
    Док.ЗаказПоставщику = Заказ;
    Позиция.ЗаказПокупателя = Продажа.Ссылка;
    Позиция.СтрокаЗаказа = НомерСтроки;
  КонецЕсли;
  Док.Записать();
  Док.Провести();
КонецПроцедуры

Процедура Выполнить()
  Образец = Документы.ЗаказПоставщику.НайтиПоНомеру("ЗПС-00001").ПолучитьОбъект();
  Покупатель = Справочники.Контрагент.Создать();
  Покупатель.Наименование = "Покупатель по графику";
  Покупатель.Вид = "Покупатель";
  Покупатель.Записать();
  Склад = Справочники.Склад.Создать();
  Склад.Наименование = "Склад проверки графика";
  Склад.Записать();
  Продажа = Документы.ЗаказПокупателя.Создать();
  Продажа.Организация = Образец.Организация;
  Продажа.Склад = Склад.Ссылка;
  Продажа.Покупатель = Покупатель.Ссылка;
  Продажа.Дата = Дата(2031, 7, 1);
  Продажа.Комментарий = "order-promise-test";
  Позиция = Продажа.Товары.Добавить();
  Позиция.Номенклатура = ПервыйТовар(Образец);
  Позиция.Количество = 10;
  Позиция.Цена = 150;
  Продажа.Записать();
  Продажа.Провести();
  Поставщик = Образец.Поставщик;
  Приёмка(Продажа, Поставщик, 1, 2, Неопределено, 0);

  Первый = ДокументПоставщика(Документы.ЗаказПоставщику, Продажа, Поставщик, 1);
  СтрокаПоставки(Первый, Продажа, 2, 10);
  СтрокаПоставки(Первый, Продажа, 3, 14);
  Первый.Записать();
  Первый.Провести();
  Второй = ДокументПоставщика(Документы.ЗаказПоставщику, Продажа, Поставщик, 1);
  СтрокаПоставки(Второй, Продажа, 3, 12);
  СтрокаПоставки(Второй, Продажа, 2, 0);
  Второй.Записать();
  Второй.Провести();

  Приёмка(Продажа, Поставщик, 2, 3, Первый.Ссылка, 2);
  Закрытие = ДокументПоставщика(Документы.ЗакрытиеЗаказовПоставщикам, Продажа, Поставщик, 3);
  Стр = Закрытие.Заказы.Добавить();
  Стр.ЗаказПоставщику = Первый.Ссылка;
  Стр.ЗаказПокупателя = Продажа.Ссылка;
  Стр.Номенклатура = Позиция.Номенклатура;
  Стр.Количество = 1;
  Закрытие.Записать();
  Закрытие.Провести();
  Замена = ДокументПоставщика(Документы.ЗаказПоставщику, Продажа, Поставщик, 4);
  СтрокаПоставки(Замена, Продажа, 1, 18);
  Замена.Записать();
  Замена.Провести();
  Приёмка(Продажа, Поставщик, 5, 1, Второй.Ссылка, 0);
  Приёмка(Продажа, Поставщик, 21, 4, Неопределено, 0);
КонецПроцедуры

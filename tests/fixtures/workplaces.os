Процедура Выполнить()
    Образец = Документы.ЗаказПоставщику.НайтиПоНомеру("ЗПС-00001").ПолучитьОбъект();
    Товар = Справочники.Номенклатура.НайтиПоНаименованию("Табурет «Шаткий-2000»");
    Заказ = Документы.ЗаказПоставщику.Создать();
    Заказ.Дата = ТекущаяДатаВремя();
    Заказ.Организация = Образец.Организация;
    Заказ.Поставщик = Образец.Поставщик;
    Заказ.Склад = Образец.Склад;
    Заказ.СпособУчетаНДС = "Сверху";
    Заказ.Комментарий = "workplace-test";
    Покупатель = Справочники.Контрагент.Создать();
    Покупатель.Наименование = "Покупатель АРМ";
    Покупатель.Вид = "Покупатель";
    Покупатель.Записать();
    Для Номер = 1 По 2 Цикл
        Клиент = Документы.ЗаказПокупателя.Создать();
        Клиент.Дата = Заказ.Дата;
        Клиент.Организация = Заказ.Организация;
        Клиент.Склад = Заказ.Склад;
        Клиент.Покупатель = Покупатель.Ссылка;
        Стр = Клиент.Товары.Добавить();
        Стр.Номенклатура = Товар;
        Стр.Цена = 200;
        Стр.Количество = Номер;
        Клиент.Записать();
        Клиент.Провести();
        Стр = Заказ.Товары.Добавить();
        Стр.Номенклатура = Товар;
        Стр.Количество = Номер;
        Стр.Цена = 100 / Номер;
        Стр.ЗаказПокупателя = Клиент.Ссылка;
    КонецЦикла;
    Заказ.Записать();
    Заказ.Провести();

    Владелец = Справочники.Организация.Создать();
    Владелец.Наименование = "Владелец инвентаризации АРМ";
    Владелец.Записать();
    Начальные = Документы.ОприходованиеТоваров.Создать();
    Начальные.Дата = Заказ.Дата;
    Начальные.Организация = Владелец.Ссылка;
    Начальные.Склад = Заказ.Склад;
    Для Каждого Имя Из СтрРазделить("Табурет «Шаткий-2000»|Диван «Проваленный, но мягкий»", "|") Цикл
        Стр = Начальные.Товары.Добавить();
        Стр.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(Имя);
        Стр.Количество = 5;
        Стр.Цена = 321;
    КонецЦикла;
    Начальные.Записать();
    Начальные.Провести();
    ПодготовитьПланЗакупок(Заказ, Владелец.Ссылка, Покупатель.Ссылка);
    ПодготовитьПродажиДляОплаты(Заказ);
КонецПроцедуры

Процедура ДобавитьПозициюПлана(Док, Товар, Количество)
    Стр = Док.Товары.Добавить();
    Стр.Номенклатура = Товар;
    Стр.Количество = Количество;
    Стр.Цена = 50;
КонецПроцедуры

Процедура ПодготовитьПланЗакупок(Образец, ДругаяОрганизация, Покупатель)
    Склад = Справочники.Склад.Создать();
    Склад.Наименование = "Общий склад для плана закупок";
    Склад.Записать();
    Товары = Новый Массив;
    Для Каждого Артикул Из СтрРазделить("PLAN-1|PLAN-2", "|") Цикл
        Товар = Справочники.Номенклатура.Создать();
        Товар.Артикул = Артикул;
        Товар.Наименование = "Одноимённый товар для закупок";
        Товар.Записать();
        Товары.Добавить(Товар.Ссылка);
    КонецЦикла;

    Цены = Документы.УстановкаЦен.Создать();
    Цены.Дата = Образец.Дата;
    Цены.Организация = Образец.Организация;
    Цены.ТипЦен = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");
    Для Номер = 0 По 1 Цикл
        Стр = Цены.Цены.Добавить();
        Стр.Номенклатура = Товары[Номер];
        Стр.Цена = 50 + Номер;
    КонецЦикла;
    Цены.Записать();
    Цены.Провести();

    Остаток = Документы.ОприходованиеТоваров.Создать();
    Остаток.Дата = Образец.Дата;
    Остаток.Склад = Склад.Ссылка;
    Остаток.Организация = ДругаяОрганизация;
    ДобавитьПозициюПлана(Остаток, Товары[0], 7);
    Остаток.Записать();
    Остаток.Провести();

    Для Номер = 0 По 1 Цикл
        Организация = ?(Номер = 0, Образец.Организация, ДругаяОрганизация);
        Резерв = Документы.ЗаказПокупателя.Создать();
        Резерв.Дата = Образец.Дата;
        Резерв.Организация = Организация;
        Резерв.Покупатель = Покупатель;
        Резерв.Склад = Склад.Ссылка;
        Если Номер = 0 Тогда
            ДобавитьПозициюПлана(Резерв, Товары[0], 10);
            ДобавитьПозициюПлана(Резерв, Товары[1], 5);
        Иначе
            ДобавитьПозициюПлана(Резерв, Товары[0], 12);
        КонецЕсли;
        Резерв.Записать();
        Резерв.Провести();

        ВПути = Документы.ЗаказПоставщику.Создать();
        ВПути.Дата = Образец.Дата;
        ВПути.Организация = Организация;
        ВПути.Поставщик = Образец.Поставщик;
        ВПути.Склад = Склад.Ссылка;
        Если Номер = 0 Тогда
            ДобавитьПозициюПлана(ВПути, Товары[1], 2);
        Иначе
            ДобавитьПозициюПлана(ВПути, Товары[0], 4);
        КонецЕсли;
        ВПути.Записать();
        ВПути.Провести();
    КонецЦикла;
КонецПроцедуры

Процедура ПодготовитьПродажиДляОплаты(Образец)
    Покупатель = Справочники.Контрагент.Создать();
    Покупатель.Наименование = "Покупатель для распределения платежа";
    Покупатель.Вид = "Покупатель";
    Покупатель.Записать();
    Услуга = Справочники.Номенклатура.Создать();
    Услуга.Наименование = "Услуга для распределения платежа";
    Услуга.Услуга = Истина;
    Услуга.Записать();
    Для Каждого Сумма Из СтрРазделить("6000,4000", ",") Цикл
        Продажа = Документы.РеализацияТоваров.Создать();
        Продажа.Дата = ДобавитьДень(Образец.Дата, -1);
        Продажа.Организация = Образец.Организация;
        Продажа.Покупатель = Покупатель.Ссылка;
        Продажа.Склад = Образец.Склад;
        Стр = Продажа.Товары.Добавить();
        Стр.Номенклатура = Услуга.Ссылка;
        Стр.Количество = 1;
        Стр.Цена = Число(Сумма);
        Продажа.Записать();
        Продажа.Провести();
    КонецЦикла;
КонецПроцедуры

Процедура Выполнить()
    Образец = Документы.ЗаказПоставщику.НайтиПоНомеру("ЗПС-00001").ПолучитьОбъект();
    Товар = Справочники.Номенклатура.НайтиПоНаименованию("Табурет «Шаткий-2000»");
    Заказ = Документы.ЗаказПоставщику.Создать();
    Заказ.Дата = ТекущаяДатаВремя();
    Заказ.Организация = Образец.Организация;
    Заказ.Поставщик = Образец.Поставщик;
    Заказ.Склад = Образец.Склад;
    Заказ.СпособУчетаНДС = "Сверху";
    Заказ.Комментарий = "workplace-test";
    Покупатель = Справочники.Контрагент.Создать();
    Покупатель.Наименование = "Покупатель АРМ";
    Покупатель.Вид = "Покупатель";
    Покупатель.Записать();
    Для Номер = 1 По 2 Цикл
        Клиент = Документы.ЗаказПокупателя.Создать();
        Клиент.Дата = Заказ.Дата;
        Клиент.Организация = Заказ.Организация;
        Клиент.Склад = Заказ.Склад;
        Клиент.Покупатель = Покупатель.Ссылка;
        Стр = Клиент.Товары.Добавить();
        Стр.Номенклатура = Товар;
        Стр.Цена = 200;
        Стр.Количество = Номер;
        Клиент.Записать();
        Клиент.Провести();
        Стр = Заказ.Товары.Добавить();
        Стр.Номенклатура = Товар;
        Стр.Количество = Номер;
        Стр.Цена = 100 / Номер;
        Стр.ЗаказПокупателя = Клиент.Ссылка;
    КонецЦикла;
    Заказ.Записать();
    Заказ.Провести();

    Владелец = Справочники.Организация.Создать();
    Владелец.Наименование = "Владелец инвентаризации АРМ";
    Владелец.Записать();
    Начальные = Документы.ОприходованиеТоваров.Создать();
    Начальные.Дата = Заказ.Дата;
    Начальные.Организация = Владелец.Ссылка;
    Начальные.Склад = Заказ.Склад;
    Для Каждого Имя Из СтрРазделить("Табурет «Шаткий-2000»|Диван «Проваленный, но мягкий»", "|") Цикл
        Стр = Начальные.Товары.Добавить();
        Стр.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(Имя);
        Стр.Количество = 5;
        Стр.Цена = 321;
    КонецЦикла;
    Начальные.Записать();
    Начальные.Провести();
КонецПроцедуры

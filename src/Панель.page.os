// Демо-страница (план 66) для базы Trade: произвольное представление на
// встроенном языке. Открывается из раздела «Продажи» и по адресу /ui/page/Панель.
//
// Кнопка «Обновить сводку» демонстрирует кнопку-действие — вызов серверной
// процедуры (постбэк), а не переход по ссылке: клик шлёт POST, сервер исполняет
// процедуру «Обновить», страница перерисовывается, а Сообщить() показывает
// общий бар сообщений.

Процедура ПриФормировании(Страница, Параметры) Экспорт
    Страница.Заголовок("Панель руководителя");
    Страница.Абзац("Произвольная страница на встроенном языке. Открыл: " + ИмяПользователя());

    // Показатель: число позиций номенклатуры.
    Кол = 0;
    ЗапросКол = Новый Запрос;
    ЗапросКол.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура";
    Для Каждого Стр Из ЗапросКол.Выполнить() Цикл
        Кол = Кол + 1;
    КонецЦикла;
    Страница.Показатель("Позиций номенклатуры", Кол, "number");

    // Таблица: первые 20 позиций со ссылками на карточки объектов (СсылкаНаОбъект).
    // Ссылка → колонка id; даём явный псевдоним КАК Ид, иначе поле зовётся «id».
    Таблица = Страница.Таблица("Номенклатура (первые 20)");
    Таблица.Колонки("Наименование", "Артикул");
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Ссылка КАК Ид, Наименование, Артикул ИЗ Справочник.Номенклатура УПОРЯДОЧИТЬ ПО Наименование";
    Н = 0;
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        СтрокаТаблицы = Таблица.ДобавитьСтроку();
        СтрокаТаблицы.Установить("Наименование", Стр.Наименование);
        СтрокаТаблицы.Ссылка("Наименование", СсылкаНаОбъект("Номенклатура", Стр.Ид));
        СтрокаТаблицы.Установить("Артикул", Стр.Артикул);
        Н = Н + 1;
        Если Н >= 20 Тогда
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Страница.Кнопка("Открыть справочник", "/ui/catalog/Номенклатура");
    // Кнопка-действие: вызывает процедуру «Обновить» (ниже), а не переходит по URL.
    Страница.КнопкаДействие("Обновить сводку", "Обновить");
КонецПроцедуры

// Процедура-действие кнопки (план 66): резолвится по имени, как ПриФормировании.
// Демонстрационный побочный эффект — Сообщить с пересчитанным числом; на практике
// здесь проводят документы, пересчитывают итоги или формируют выгрузку.
Процедура Обновить(Страница, Параметры) Экспорт
    Кол = 0;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура";
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        Кол = Кол + 1;
    КонецЦикла;
    Сообщить("Сводка обновлена " + Строка(ТекущаяДата()) + ": позиций номенклатуры — " + Строка(Кол));
КонецПроцедуры

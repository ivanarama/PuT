// Перемещение между складами с честным переносом партий.
//
// Со склада-отправителя списываем по ФИФО по партиям этого склада.
// На склад-получатель приходуем встречной партией С ТОЙ ЖЕ ДатойПоставки
// и С ТОЙ ЖЕ суммой (сохраняется ФИФО-возраст товара).
//
// Если на отправителе нет нужного остатка — проведение откатывается
// до того, как успели записать хоть одно движение.

Процедура ОбработкаПроведения()
  Движения.ОстаткиТоваров.Очистить();
  Движения.ПартииТоваров.Очистить();

  ПотребностьПоНом = Новый Соответствие;
  Для Каждого Строка Из this.Товары Цикл
    Текущая = ПотребностьПоНом.Получить(Строка.Номенклатура);
    Если Текущая = Неопределено Тогда
      Текущая = 0;
    КонецЕсли;
    ПотребностьПоНом.Вставить(Строка.Номенклатура, Текущая + Строка.Количество);
  КонецЦикла;

  СписокНом = Новый Массив;
  Для Каждого Пара Из ПотребностьПоНом Цикл
    СписокНом.Добавить(Пара.Ключ);
  КонецЦикла;

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ
                    Номенклатура,
                    ДатаПоставки,
                    КоличествоОстаток,
                    СуммаОстаток
                  ИЗ РегистрНакопления.ПартииТоваров.Остатки()
                  ГДЕ Номенклатура В (&СписокНом)
                    И Склад = &СкладОтправитель
                    И Организация = &Организация
                    И КоличествоОстаток > 0
                  УПОРЯДОЧИТЬ ПО Номенклатура, ДатаПоставки";
  Запрос.УстановитьПараметр("СписокНом", СписокНом);
  Запрос.УстановитьПараметр("СкладОтправитель", this.СкладОтправитель);
  Запрос.УстановитьПараметр("Организация", this.Организация);
  Результат = Запрос.Выполнить();

  ПартииПоНом = Новый Соответствие;
  Для Каждого Стр Из Результат Цикл
    Список = ПартииПоНом.Получить(Стр.Номенклатура);
    Если Список = Неопределено Тогда
      Список = Новый Массив;
      ПартииПоНом.Вставить(Стр.Номенклатура, Список);
    КонецЕсли;
    Список.Добавить(Новый Структура(
      "ДатаПоставки, КоличествоОстаток, СуммаОстаток",
      Стр.ДатаПоставки, Стр.КоличествоОстаток, Стр.СуммаОстаток));
  КонецЦикла;

  Для Каждого Пара Из ПотребностьПоНом Цикл
    Ном = Пара.Ключ;
    Надо = Пара.Значение;
    Доступно = 0;
    Список = ПартииПоНом.Получить(Ном);
    Если Список <> Неопределено Тогда
      Для Каждого П Из Список Цикл
        Доступно = Доступно + П.КоличествоОстаток;
      КонецЦикла;
    КонецЕсли;
    Если Доступно < Надо Тогда
      ВызватьИсключение("Недостаточно остатков на складе «" + Строка(this.СкладОтправитель)
        + "» для перемещения «" + Строка(Ном) + "»: нужно " + Строка(Надо)
        + ", доступно " + Строка(Доступно) + ".");
    КонецЕсли;
  КонецЦикла;

  ИтогСумма = 0;

  Для Каждого Строка Из this.Товары Цикл
    ОстатокКПереносу = Строка.Количество;
    СтрокаСебестоимость = 0;
    Список = ПартииПоНом.Получить(Строка.Номенклатура);

    Если Список <> Неопределено Тогда
      Для Каждого ТекПартия Из Список Цикл
        Если ОстатокКПереносу <= 0 Тогда
          Прервать;
        КонецЕсли;
        Если ТекПартия.КоличествоОстаток <= 0 Тогда
          Продолжить;
        КонецЕсли;

        КолВоИзПартии   = Мин(ОстатокКПереносу, ТекПартия.КоличествоОстаток);
        ЦенаПартии      = ТекПартия.СуммаОстаток / ТекПартия.КоличествоОстаток;
        СтоимостьПартии = Окр(КолВоИзПартии * ЦенаПартии, 2);

        СтрокаСебестоимость = СтрокаСебестоимость + СтоимостьПартии;
        ОстатокКПереносу    = ОстатокКПереносу - КолВоИзПартии;

        ТекПартия.КоличествоОстаток = ТекПартия.КоличествоОстаток - КолВоИзПартии;
        ТекПартия.СуммаОстаток      = ТекПартия.СуммаОстаток - СтоимостьПартии;

        // Расход партии на складе-отправителе
        ДвРасх = Движения.ПартииТоваров.Добавить();
        ДвРасх.ВидДвижения  = "Расход";
        ДвРасх.Номенклатура = Строка.Номенклатура;
        ДвРасх.Склад        = this.СкладОтправитель;
        ДвРасх.Организация  = this.Организация;
        ДвРасх.ДатаПоставки = ТекПартия.ДатаПоставки;
        ДвРасх.Количество   = КолВоИзПартии;
        ДвРасх.Сумма        = СтоимостьПартии;

        // Зеркальная партия на складе-получателе с той же ДатойПоставки
        ДвПрих = Движения.ПартииТоваров.Добавить();
        ДвПрих.ВидДвижения  = "Приход";
        ДвПрих.Номенклатура = Строка.Номенклатура;
        ДвПрих.Склад        = this.СкладПолучатель;
        ДвПрих.Организация  = this.Организация;
        ДвПрих.ДатаПоставки = ТекПартия.ДатаПоставки;
        ДвПрих.Количество   = КолВоИзПартии;
        ДвПрих.Сумма        = СтоимостьПартии;
      КонецЦикла;
    КонецЕсли;

    Строка.Себестоимость = СтрокаСебестоимость;
    ИтогСумма = ИтогСумма + СтрокаСебестоимость;

    ДвОР = Движения.ОстаткиТоваров.Добавить();
    ДвОР.ВидДвижения  = "Расход";
    ДвОР.Номенклатура = Строка.Номенклатура;
    ДвОР.Склад        = this.СкладОтправитель;
    ДвОР.Организация  = this.Организация;
    ДвОР.Количество   = Строка.Количество;
    ДвОР.Сумма        = СтрокаСебестоимость;

    ДвОП = Движения.ОстаткиТоваров.Добавить();
    ДвОП.ВидДвижения  = "Приход";
    ДвОП.Номенклатура = Строка.Номенклатура;
    ДвОП.Склад        = this.СкладПолучатель;
    ДвОП.Организация  = this.Организация;
    ДвОП.Количество   = Строка.Количество;
    ДвОП.Сумма        = СтрокаСебестоимость;
  КонецЦикла;

  this.Сумма = ИтогСумма;
КонецПроцедуры

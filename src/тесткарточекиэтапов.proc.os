Функция ОшибкаЗаписи(Документ)
  Попытка
    Документ.Записать();
    Возврат "";
  Исключение
    Возврат ОписаниеОшибки();
  КонецПопытки;
КонецФункции

Процедура Выполнить()
  Орг = Справочники.Организация.Создать();
  Орг.Наименование = "Тест карточек: организация";
  Организация = Орг.Записать();
  Пост = Справочники.Контрагент.Создать();
  Пост.Наименование = "Тест карточек: поставщик";
  Пост.Вид = "Поставщик";
  Поставщик = Пост.Записать();
  Пок = Справочники.Контрагент.Создать();
  Пок.Наименование = "Тест карточек: одинаковое имя";
  Пок.Вид = "Покупатель";
  Покупатель = Пок.Записать();
  Другой = Справочники.Контрагент.Создать();
  Другой.Наименование = Пок.Наименование;
  Другой.Вид = "Покупатель";
  ДругойПокупатель = Другой.Записать();
  Товар = Справочники.Номенклатура.Создать();
  Товар.Наименование = "Тест карточек: товар";
  Номенклатура = Товар.Записать();
  ПервыйСклад = Неопределено;
  Для НомерСклада = 1 По 2 Цикл
    Скл = Справочники.Склад.Создать();
    Скл.Наименование = "Тест карточек: одинаковый склад";
    Склад = Скл.Записать();
    Если НомерСклада = 1 Тогда ПервыйСклад = Склад; КонецЕсли;
    Приход = Документы.ПоступлениеТоваров.Создать();
    Приход.Дата = ТекущаяДатаВремя();
    Приход.Организация = Организация;
    Приход.Поставщик = Поставщик;
    Приход.Склад = Склад;
    Стр = Приход.Товары.Добавить();
    Стр.Номенклатура = Номенклатура;
    Стр.Количество = НомерСклада + 2;
    Стр.Цена = 10;
    Приход.Провести();
  КонецЦикла;
  Остатки = ОстаткиТовараПУТ(Номенклатура);
  Утверждать.Равно(Остатки.Количество(), 2, "одноимённые склады не объединяются");
  Сумма = 0;
  Для Каждого Ост Из Остатки Цикл Сумма = Сумма + Ост.Остаток; КонецЦикла;
  Утверждать.Равно(Сумма, 7, "физические остатки карточки сходятся с приходом");

  Продажа = Документы.РеализацияТоваров.Создать();
  Продажа.Дата = ТекущаяДатаВремя();
  Продажа.Организация = Организация;
  Продажа.Склад = ПервыйСклад;
  Продажа.Покупатель = Покупатель;
  Продажа.СрокОплаты = ДобавитьДень(ТекущаяДата(), -1);
  Стр = Продажа.Товары.Добавить();
  Стр.Номенклатура = Номенклатура;
  Стр.Количество = 1;
  Стр.Цена = 100;
  Продажа.Провести();
  Сводка = СводкаКонтрагентаПУТ(Покупатель);
  Утверждать.Равно(Сводка.ДолгПокупателя, 100, "карточка показывает долг по реализации");
  Утверждать.Равно(Сводка.Просрочено, 100, "просроченная реализация учитывается");
  Утверждать.Равно(Сводка.Неоплаченные.Количество(), 1, "неоплаченная реализация попала в таблицу");
  Кас = Справочники.Касса.Создать();
  Кас.Наименование = "Тест карточек: касса";
  Кас.Вид = "Касса";
  Касса = Кас.Записать();
  Оплата = Документы.ПриходныйКассовыйОрдер.Создать();
  Оплата.Дата = ТекущаяДатаВремя();
  Оплата.Организация = Организация;
  Оплата.Контрагент = Покупатель;
  Оплата.Касса = Касса;
  Оплата.ДокументРеализации = Продажа.Ссылка;
  Оплата.Сумма = 60;
  Оплата.Провести();
  Сводка = СводкаКонтрагентаПУТ(Покупатель);
  Утверждать.Равно(Сводка.ДолгПокупателя, 40, "частичная оплата уменьшает общий долг");
  Утверждать.Равно(Сводка.Просрочено, 40, "просрочка уменьшается на назначенную оплату");
  Утверждать.Равно(Сводка.НераспределённыеОплаты, 0, "назначенная оплата не считается нераспределённой");
  СводкаДругого = СводкаКонтрагентаПУТ(ДругойПокупатель);
  Утверждать.Равно(СводкаДругого.ДолгПокупателя, 0, "одноимённые контрагенты не смешиваются");
  История = ИсторияКонтрагентаПУТ(Покупатель);
  Утверждать.Равно(История.Количество(), 1, "история карточки читается без ошибки UNION");
  Движения = ДвиженияТовараПУТ(Номенклатура);
  Утверждать.Равно(Движения.Количество(), 3, "движения товара включают два прихода и продажу");

  Заказ = Документы.ЗаказПокупателя.Создать();
  Заказ.Дата = ТекущаяДатаВремя();
  Заказ.Покупатель = Покупатель;
  Заказ.Организация = Организация;
  Заказ.Склад = ПервыйСклад;
  Стр = Заказ.Товары.Добавить();
  Стр.Номенклатура = Номенклатура;
  Стр.Количество = 1;
  Стр.Цена = 100;
  Заказ.Провести();
  Заказ.Состояние = "Готов";
  Утверждать.Истина(ЗначениеЗаполнено(ОшибкаЗаписи(Заказ)), "запрещён пропуск этапов");
  Заказ.Состояние = "Принят";
  Утверждать.Равно(ОшибкаЗаписи(Заказ), "", "разрешён переход Новый → Принят");
  Заказ.Состояние = "Отменён";
  Утверждать.Истина(ЗначениеЗаполнено(ОшибкаЗаписи(Заказ)), "нельзя отменить заказ с резервом");
  Заказ.Состояние = "Принят";
  Документы.ЗаказПокупателя.ОтменитьПроведение(Заказ.Ссылка);
  Заказ = Заказ.Ссылка.ПолучитьОбъект();
  Заказ.Состояние = "Отменён";
  Утверждать.Равно(ОшибкаЗаписи(Заказ), "", "заказ без обеспечения можно отменить");
  Ошибка = "";
  Попытка Заказ.Провести(); Исключение Ошибка = ОписаниеОшибки(); КонецПопытки;
  Утверждать.Истина(ЗначениеЗаполнено(Ошибка), "отменённый заказ не создаёт резерв повторно");
КонецПроцедуры

// Проведение «Установка цен»: одна запись в периодический регистр сведений
// на дату документа для каждой строки ТЧ.

Процедура ОбработкаПроведения()
  ПроверитьДатуЗапрета(this.Дата);
  Движения.ЦеныНоменклатуры.Очистить();

  Для Каждого Строка Из this.Цены Цикл
    Дв = Движения.ЦеныНоменклатуры.Добавить();
    Дв.Период       = this.Дата;
    Дв.Номенклатура = Строка.Номенклатура;
    Дв.ТипЦен       = this.ТипЦен;
    Дв.Цена         = Строка.Цена;
  КонецЦикла;
КонецПроцедуры

// Проведение «Установка цен»: одна запись в периодический регистр сведений
// на дату документа для каждой строки ТЧ.

Процедура ОбработкаПроведения()
  ПроверитьРеквизитШапки(this.Дата, "Дата");
  ПроверитьДатуЗапрета(this.Дата);

  ПроверитьРеквизитШапки(this.ТипЦен, "Тип цен");

  Движения.ЦеныНоменклатуры.Очистить();

  // «Цены» — ТЧ без полей Количество и Суммы: оба флага Ложь, реально
  // проверяются непустота, номенклатура и цена (циклом ниже).
  ПроверитьЗаполнениеСтрокТоваров(this.Цены, "Цены", Ложь, Ложь);

  Для Каждого Строка Из this.Цены Цикл
    Если Строка.Цена <= 0 Тогда
      ВызватьИсключение("Цена по «" + Строка(Строка.Номенклатура)
        + "» равна нулю или отрицательна — "
        + "проверьте строку в табличной части «Цены».");
    КонецЕсли;
  КонецЦикла;

  Для Каждого Строка Из this.Цены Цикл
    Дв = Движения.ЦеныНоменклатуры.Добавить();
    Дв.Период       = this.Дата;
    Дв.Номенклатура = Строка.Номенклатура;
    Дв.ТипЦен       = this.ТипЦен;
    Дв.Цена         = Строка.Цена;
  КонецЦикла;
КонецПроцедуры

// Демонстрация: ReadJSON / WriteJSON + НачатьТранзакцию / ЗафиксироватьТранзакцию
//
// Принимает JSON-строку вида:
//   [{"Наименование":"Ноутбук"},...]
// Загружает каждую позицию в справочник Номенклатура в одной транзакции.
// Закупочные цены задаются Поступлением, продажные — расчётными типами цен.
// При ошибке транзакция откатывается, результат сообщается через WriteJSON.

Процедура Выполнить()
  ФайлJSON = Параметры.ФайлJSON;
  Если ФайлJSON = "" Тогда
    Error("Параметр ФайлJSON не задан");
  КонецЕсли;

  // Читаем JSON → Массив Структур
  Данные = ReadJSON(ФайлJSON);

  Результат = Новый Структура;
  Результат.Добавлено = 0;
  Результат.Ошибки = Новый Массив;

  // Открываем явную транзакцию
  НачатьТранзакцию();
  Попытка
    Для Каждого Элемент Из Данные Цикл
      Наименование = Элемент.Получить("Наименование");
      Артикул = Элемент.Получить("Артикул");
      Если НЕ ЗначениеЗаполнено(Наименование) Тогда ВызватьИсключение("Не заполнено наименование товара"); КонецЕсли;
      Существующая = Неопределено;
      Если ЗначениеЗаполнено(Артикул) Тогда
        Существующая = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
      Иначе
        Существующая = Справочники.Номенклатура.НайтиПоНаименованию(Наименование);
      КонецЕсли;
      Если ЗначениеЗаполнено(Существующая) Тогда
        Номенклатура = Существующая.ПолучитьОбъект();
      Иначе
        Номенклатура = Справочники.Номенклатура.Создать();
        Результат.Добавлено = Результат.Добавлено + 1;
      КонецЕсли;
      Если ЗначениеЗаполнено(Артикул) Тогда Номенклатура.Артикул = Артикул; КонецЕсли;
      Номенклатура.Наименование = Наименование;
      Номенклатура.Записать();
    КонецЦикла;

    // Всё успешно — фиксируем
    ЗафиксироватьТранзакцию();
  Исключение
    ОтменитьТранзакцию();
    Результат.Добавлено = 0;
    ВызватьИсключение("Импорт отменён: " + ОписаниеОшибки());
  КонецПопытки;

  // Возвращаем итог как JSON
  Сообщить(WriteJSON(Результат));
КонецПроцедуры

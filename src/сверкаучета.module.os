// Каждая строка результата указывает на первичный документ. Все выборки
// ограничены одной датой, в том числе при запуске из закрытия месяца.
Процедура ДобавитьРезультатыСверки(Строки, Проверка, Текст, Граница)
  Запрос = Новый Запрос;
  Запрос.Текст = Текст;
  Запрос.УстановитьПараметр("До", Граница);
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Строки.Добавить(Новый Структура("Проверка,Вид,ИД,Описание,Разница",
      Проверка, Стр.Вид, Стр.ИД, Стр.Описание, Стр.Разница));
  КонецЦикла;
КонецПроцедуры

// Ссылки отбираются запросом, табличные части читаются через разрешения
// документа. Каждая реализация загружается один раз вместе со своими строками.
Процедура СверитьВозвратыПоСтрокамПродажи(Результат, Граница)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Вр.Ссылка КАК ВозвратИД, Д.Ссылка КАК ПродажаИД, Д.Номер КАК НомерПродажи
    ИЗ Документ.ВозвратОтПокупателя КАК Вр ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров КАК Д ПО Вр.Основание = Д.Ссылка
    ГДЕ Вр.posted = Истина И Вр.Дата <= &До УПОРЯДОЧИТЬ ПО Д.Ссылка, Вр.Дата, Вр.Ссылка";
  Запрос.УстановитьПараметр("До", Граница);
  ПродажаИД = "";
  Для Каждого Док Из Запрос.Выполнить() Цикл
    Если ПродажаИД <> УИДСсылки(Док.ПродажаИД) Тогда
      ПродажаИД = УИДСсылки(Док.ПродажаИД);
      Продажа = Документы.РеализацияТоваров.НайтиПоИдентификатору(ПродажаИД).ПолучитьОбъект();
      Остатки = Новый Массив;
      СтрокиТоваров = Новый Соответствие;
      Для Каждого Стр Из Продажа.Товары Цикл
        Остатки.Добавить(Стр.Сумма + ?(Продажа.СпособУчетаНДС = "Сверху", Стр.СуммаНДС + 0, 0));
        // В возвратах до 1.3.4 нет номера строки продажи. Сопоставление
        // по товару однозначно только когда в исходной продаже он встречался один раз.
        Товар = УИДСсылки(Стр.Номенклатура);
        Если ТипЗнч(СтрокиТоваров.Получить(Товар)) = Тип("Неопределено") Тогда
          СтрокиТоваров.Вставить(Товар, Остатки.Количество());
        Иначе
          СтрокиТоваров.Вставить(Товар, 0);
        КонецЕсли;
      КонецЦикла;
    КонецЕсли;
    ВозвратДок = Документы.ВозвратОтПокупателя.НайтиПоИдентификатору(УИДСсылки(Док.ВозвратИД)).ПолучитьОбъект();
    Для Каждого Стр Из ВозвратДок.Товары Цикл
      Номер = Стр.СтрокаРеализации;
      Если Номер <= 0 Тогда Номер = СтрокиТоваров.Получить(УИДСсылки(Стр.Номенклатура)); КонецЕсли;
      Если Номер <= 0 ИЛИ Номер > Остатки.Количество() Тогда Продолжить; КонецЕсли;
      ДоВозврата = Остатки[Номер - 1];
      Остатки[Номер - 1] = Окр(ДоВозврата - Стр.Сумма - ?(ВозвратДок.СпособУчетаНДС = "Сверху", Стр.СуммаНДС + 0, 0), 2);
      Если Остатки[Номер - 1] < 0 Тогда
        Результат.Добавить(Новый Структура("Проверка,Вид,ИД,Описание,Разница",
          "Возвраты превышают сумму строки реализации", "ВозвратОтПокупателя", Док.ВозвратИД,
          Док.НомерПродажи + " / строка " + Строка(Номер), -Остатки[Номер - 1]));
      КонецЕсли;
    КонецЦикла;
  КонецЦикла;
КонецПроцедуры

Функция РасхожденияУчетаПуТ(НаДату) Экспорт
  Результат = Новый Массив;
  Граница = КонецДня(НаДату);

  Для Каждого Вид Из СтрРазделить("ПоступлениеНаРасчётныйСчёт,СписаниеСРасчётногоСчёта", ",") Цикл
    ДобавитьРезультатыСверки(Результат, "Возможный дубль платёжки",
      "ВЫБРАТЬ РАЗЛИЧНЫЕ """ + Вид + """ КАК Вид, Д.Ссылка КАК ИД, Д.НомерПлатёжки КАК Описание,
       CAST(Д.Сумма AS NUMERIC) КАК Разница ИЗ Документ." + Вид + " КАК Д
       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ." + Вид + " КАК Б ПО Б.НомерПлатёжки = Д.НомерПлатёжки
       ГДЕ Д.posted = Истина И Д.Дата <= &До И Д.НомерПлатёжки <> """"
         И Б.Ссылка <> Д.Ссылка И Б.posted = Истина И Б.Дата <= &До
         И Б.Организация = Д.Организация И Б.БанковскийСчёт = Д.БанковскийСчёт
         И Б.Контрагент = Д.Контрагент
         И COALESCE(Б.ДатаПлатёжки, Б.Дата) = COALESCE(Д.ДатаПлатёжки, Д.Дата)
         И CAST(Б.Сумма AS NUMERIC) = CAST(Д.Сумма AS NUMERIC)", Граница);
  КонецЦикла;

  Для Каждого ВидОснования Из СтрРазделить("РеализацияТоваров,ПоступлениеТоваров", ",") Цикл
    Сторона = ?(ВидОснования = "РеализацияТоваров", "Покупатель", "Поставщик");
    Поле = ?(ВидОснования = "РеализацияТоваров", "ДокументРеализации", "ДокументПоступления");
    ДобавитьРезультатыСверки(Результат, "Стороны движения отличаются от основания",
      "ВЫБРАТЬ Р.recorder_type КАК Вид, Р.recorder КАК ИД, Д.Номер КАК Описание,
        CAST(Р.Сумма AS NUMERIC) КАК Разница ИЗ РегистрНакопления.Взаиморасчеты КАК Р
        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ." + ВидОснования + " КАК Д ПО Р." + Поле + " = Д.Ссылка
        ГДЕ Р.period <= &До И (Р.Организация <> Д.Организация ИЛИ Р.Контрагент <> Д." + Сторона + "
          ИЛИ (Р.Организация ЕСТЬ ПУСТО И Д.Организация ЕСТЬ НЕ ПУСТО)
          ИЛИ (Р.Организация ЕСТЬ НЕ ПУСТО И Д.Организация ЕСТЬ ПУСТО)
          ИЛИ (Р.Контрагент ЕСТЬ ПУСТО И Д." + Сторона + " ЕСТЬ НЕ ПУСТО)
          ИЛИ (Р.Контрагент ЕСТЬ НЕ ПУСТО И Д." + Сторона + " ЕСТЬ ПУСТО))", Граница);
    Направление = ?(ВидОснования = "РеализацияТоваров", "Приход", "Расход");
    Начисление = "COALESCE(СУММА(ВЫБОР КОГДА Р.вид_движения = """ + Направление
      + """ ТОГДА CAST(Р.Сумма AS NUMERIC) ИНАЧЕ -CAST(Р.Сумма AS NUMERIC) КОНЕЦ), 0)";
    Разница = "ROUND(CAST(Д.Сумма AS NUMERIC) - " + Начисление + ", 2)";
    ДобавитьРезультатыСверки(Результат, "Начисленный долг расходится с суммой документа",
      "ВЫБРАТЬ """ + ВидОснования + """ КАК Вид, Д.Ссылка КАК ИД, Д.Номер КАК Описание, " + Разница + " КАК Разница
       ИЗ Документ." + ВидОснования + " КАК Д ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Взаиморасчеты КАК Р
       ПО Р.recorder = Д.Ссылка И Р.recorder_type = """ + ВидОснования + """ И Р." + Поле + " = Д.Ссылка И Р.period <= &До
       ГДЕ Д.posted = Истина И Д.Дата <= &До СГРУППИРОВАТЬ ПО Д.Ссылка, Д.Номер, Д.Сумма ИМЕЯ " + Разница + " <> 0", Граница);
  КонецЦикла;

  ДобавитьРезультатыСверки(Результат, "Возвраты превышают сумму реализации",
    "ВЫБРАТЬ ""РеализацияТоваров"" КАК Вид, Д.Ссылка КАК ИД, Д.Номер КАК Описание,
      ROUND(СУММА(CAST(Вр.Сумма AS NUMERIC)) - CAST(Д.Сумма AS NUMERIC), 2) КАК Разница
      ИЗ Документ.ВозвратОтПокупателя КАК Вр ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров КАК Д ПО Вр.Основание = Д.Ссылка
      ГДЕ Вр.posted = Истина И Вр.Дата <= &До
      СГРУППИРОВАТЬ ПО Д.Ссылка, Д.Номер, Д.Сумма
      ИМЕЯ ROUND(СУММА(CAST(Вр.Сумма AS NUMERIC)) - CAST(Д.Сумма AS NUMERIC), 2) > 0", Граница);

  ДобавитьРезультатыСверки(Результат, "В пути нулевое количество с суммой",
    "ВЫБРАТЬ ""ЗаказПоставщику"" КАК Вид, З.Ссылка КАК ИД, З.Номер КАК Описание,
      ROUND(СУММА(ВЫБОР КОГДА Т.вид_движения = ""Приход"" ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ), 2) КАК Разница
      ИЗ РегистрНакопления.ТоварыВПути КАК Т ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК З ПО Т.ЗаказПоставщику = З.Ссылка
      ГДЕ Т.period <= &До СГРУППИРОВАТЬ ПО З.Ссылка, З.Номер, Т.Номенклатура, Т.Склад, Т.ЗаказПокупателя
      ИМЕЯ ROUND(СУММА(ВЫБОР КОГДА Т.вид_движения = ""Приход"" ТОГДА Т.Количество ИНАЧЕ -Т.Количество КОНЕЦ), 6) = 0
        И ROUND(СУММА(ВЫБОР КОГДА Т.вид_движения = ""Приход"" ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ), 2) <> 0", Граница);

  // Сравниваем движения двух регистров по документу и аналитике. Так
  // взаимная компенсация ошибок двух регистраторов не скрывает расхождения.
  Для Каждого Ресурс Из СтрРазделить("Количество,Сумма", ",") Цикл
    Точность = ?(Ресурс = "Сумма", "2", "6");
    Поля = "Р.recorder_type КАК Вид, Р.recorder КАК ИД, Р.Номенклатура.Ссылка КАК Товар,
      Р.Организация.Ссылка КАК ОрганизацияИД, Р.Склад.Ссылка КАК СкладИД, Р.Номенклатура КАК Описание, ";
    Значение = "ВЫБОР КОГДА Р.вид_движения = ""Приход"" ТОГДА CAST(Р." + Ресурс
      + " AS NUMERIC) ИНАЧЕ -CAST(Р." + Ресурс + " AS NUMERIC) КОНЕЦ";
    ДобавитьРезультатыСверки(Результат, "Склад и партии (" + Ресурс + ")",
      "ВЫБРАТЬ Итог.Вид КАК Вид, Итог.ИД КАК ИД, Итог.Описание КАК Описание, ROUND(СУММА(Итог.Дельта), " + Точность + ") КАК Разница
       ИЗ (ВЫБРАТЬ " + Поля + Значение + " КАК Дельта ИЗ РегистрНакопления.ОстаткиТоваров КАК Р ГДЕ Р.period <= &До
           ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ " + Поля + "-(" + Значение + ") КАК Дельта ИЗ РегистрНакопления.ПартииТоваров КАК Р ГДЕ Р.period <= &До) КАК Итог
       СГРУППИРОВАТЬ ПО Итог.Вид, Итог.ИД, Итог.Товар, Итог.ОрганизацияИД, Итог.СкладИД, Итог.Описание
       ИМЕЯ ROUND(СУММА(Итог.Дельта), " + Точность + ") <> 0", Граница);
  КонецЦикла;
  СверитьВозвратыПоСтрокамПродажи(Результат, Граница);
  СверитьКоличествоВПути(Результат, Граница);
  Возврат Результат;
КонецФункции

Функция ВывестиСверкуУчетаПуТ(НаДату) Экспорт
  Строки = РасхожденияУчетаПуТ(НаДату);
  ОшибкиУчета = 0;
  Сообщить("Сверка на " + Формат(НаДату, "ДФ=dd.MM.yyyy") + ". Строк для проверки: " + Строка(Строки.Количество()));
  Для Каждого Стр Из Строки Цикл
    Сообщить(Стр.Проверка + " — " + Стр.Описание + ", значение " + Строка(Стр.Разница) + " " + СсылкаНаОбъект(Стр.Вид, Стр.ИД));
    Если Стр.Проверка <> "Возможный дубль платёжки" Тогда ОшибкиУчета = ОшибкиУчета + 1; КонецЕсли;
  КонецЦикла;
  Возврат ОшибкиУчета;
КонецФункции

// Пересчёт товаров: учётные остатки для заполнения и оформление излишков и
// недостач. Логика живёт в общем модуле, а не в форме: так её проверяет тест
// конфигурации (ТестПересчета), а форма остаётся тонкой.

// Учётные остатки склада организации на момент: массив структур
// («Номенклатура, Остаток»), по наименованию. Остатки — на дату документа, а не
// «сейчас»: пересчёт задним числом сверяется с тем, что было на его дату.
// Организация — обязательный отбор: после разделения партий по организациям
// остатки одного склада у разных организаций не смешиваются.
Функция УчетныеОстаткиСклада(Склад, Организация, МоментВремени) Экспорт
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Номенклатура.Ссылка КАК НомИД, Номенклатура.Наименование КАК Имя,
                    СУММА(КоличествоОстаток) КАК Остаток
                  ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент)
                  ГДЕ Склад = &Склад И Организация = &Организация
                  СГРУППИРОВАТЬ ПО Номенклатура.Ссылка, Номенклатура.Наименование
                  ИМЕЯ СУММА(КоличествоОстаток) <> 0
                  УПОРЯДОЧИТЬ ПО Номенклатура.Наименование";
  Запрос.УстановитьПараметр("Момент", МоментВремени);
  Запрос.УстановитьПараметр("Склад", Склад);
  Запрос.УстановитьПараметр("Организация", Организация);
  Результат = Новый Массив;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    // Поле-ссылку из запроса берём как «.Ссылка»: голое поле приходит
    // представлением (строкой), и документ пересчёта не записывался.
    Результат.Добавить(Новый Структура("Номенклатура, Остаток",
      Справочники.Номенклатура.НайтиПоИдентификатору(УИДСсылки(Стр.НомИД)), Стр.Остаток));
  КонецЦикла;
  Возврат Результат;
КонецФункции

// Средняя себестоимость единицы по партиям склада организации на момент — для
// оценки излишков. Нет остатка партий — 0.
Функция СредняяЦенаПартии(Номенклатура, Склад, Организация, МоментВремени) Экспорт
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ СУММА(СуммаОстаток) КАК Сумма, СУММА(КоличествоОстаток) КАК Кол
                  ИЗ РегистрНакопления.ПартииТоваров.Остатки(&Момент)
                  ГДЕ Номенклатура = &Ном И Склад = &Скл И Организация = &Орг";
  Запрос.УстановитьПараметр("Момент", МоментВремени);
  Запрос.УстановитьПараметр("Ном", Номенклатура);
  Запрос.УстановитьПараметр("Скл", Склад);
  Запрос.УстановитьПараметр("Орг", Организация);
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Если ЗначениеЗаполнено(Стр.Кол) И Стр.Кол > 0 И ЗначениеЗаполнено(Стр.Сумма) Тогда
      Возврат Окр(Стр.Сумма / Стр.Кол, 2);
    КонецЕсли;
  КонецЦикла;
  Возврат 0;
КонецФункции

// Номера документов, уже оформленных по пересчёту (не помеченных на удаление),
// через запятую; пусто — не оформлялось.
Функция ОформленоПоПересчету(Пересчет) Экспорт
  Номера = "";
  Для Каждого Вид Из СтрРазделить("ОприходованиеТоваров,СписаниеТоваров", ",") Цикл
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Д.Номер КАК Номер ИЗ Документ." + Вид + " КАК Д
                    ГДЕ Д.Пересчет = &Пересчет И Д.deletion_mark = Ложь";
    Запрос.УстановитьПараметр("Пересчет", Пересчет);
    Для Каждого Стр Из Запрос.Выполнить() Цикл
      Номера = Номера + ?(Номера = "", "", ", ") + Стр.Номер;
    КонецЦикла;
  КонецЦикла;
  Возврат Номера;
КонецФункции

// Оформить излишки (оприходование) и недостачи (списание) по записанному
// пересчёту. Оба документа ссылаются на пересчёт и создаются в одной
// транзакции: сбой списания не оставляет одинокого оприходования, а повторное
// оформление (второй клик, второй пользователь) отклоняется. Возвращает текст
// итога для сообщения.
Функция ОформитьОтклоненияПересчета(ПересчетСсылка) Экспорт
  Пересчет = Документы.ПересчетТоваров.НайтиПоИдентификатору(УИДСсылки(ПересчетСсылка)).ПолучитьОбъект();
  Если НЕ ЗначениеЗаполнено(Пересчет.Организация) ИЛИ НЕ ЗначениеЗаполнено(Пересчет.Склад) Тогда
    ВызватьИсключение("В пересчёте не указаны организация и склад");
  КонецЕсли;
  Дата = ?(ЗначениеЗаполнено(Пересчет.Дата), Пересчет.Дата, ТекущаяДатаВремя());

  // Повтор отклоняется сразу, до блокировки: блокировка в платформе не
  // реентерабельна в одной транзакции, и повторный вызов под той же внешней
  // транзакцией (обработка, тест) ждал бы сам себя.
  Уже = ОформленоПоПересчету(ПересчетСсылка);
  Если Уже <> "" Тогда
    ВызватьИсключение("Излишки и недостачи по этому пересчёту уже оформлены: " + Уже);
  КонецЕсли;

  НачатьТранзакцию();
  Попытка
    // Повторная проверка — под блокировкой: два одновременных клика иначе
    // оба прошли бы первую до записи документов.
    Блокировка = БлокировкаДанных();
    ЭлементБлокировки = Блокировка.Добавить("ОформлениеПересчета");
    ЭлементБлокировки.УстановитьЗначение("Пересчет", УИДСсылки(ПересчетСсылка));
    Блокировка.Заблокировать();
    Уже = ОформленоПоПересчету(ПересчетСсылка);
    Если Уже <> "" Тогда
      ВызватьИсключение("Излишки и недостачи по этому пересчёту уже оформлены: " + Уже);
    КонецЕсли;

    Опр = Неопределено;
    Спис = Неопределено;
    Излишков = 0;
    Недостач = 0;
    Для Каждого Стр Из Пересчет.Товары Цикл
      Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
        Продолжить;
      КонецЕсли;
      Откл = Стр.КоличествоФакт - Стр.КоличествоУчёт;
      Если Откл = 0 Тогда
        Продолжить;
      КонецЕсли;
      Если Откл > 0 Тогда
        Если Опр = Неопределено Тогда
          Опр = Документы.ОприходованиеТоваров.Создать();
          Опр.Дата = Дата;
          Опр.Организация = Пересчет.Организация;
          Опр.Склад = Пересчет.Склад;
          Опр.Пересчет = ПересчетСсылка;
          Опр.Причина = "Излишки по пересчёту № " + Пересчет.Номер;
        КонецЕсли;
        СтрО = Опр.Товары.Добавить();
        СтрО.Номенклатура = Стр.Номенклатура;
        СтрО.Количество = Откл;
        СтрО.Цена = СредняяЦенаПартии(Стр.Номенклатура, Пересчет.Склад, Пересчет.Организация, Дата);
        СтрО.Сумма = Окр(СтрО.Количество * СтрО.Цена, 2);
        Излишков = Излишков + 1;
      Иначе
        Если Спис = Неопределено Тогда
          Спис = Документы.СписаниеТоваров.Создать();
          Спис.Дата = Дата;
          Спис.Организация = Пересчет.Организация;
          Спис.Склад = Пересчет.Склад;
          Спис.Пересчет = ПересчетСсылка;
          Спис.Причина = "Недостачи по пересчёту № " + Пересчет.Номер;
        КонецЕсли;
        СтрС = Спис.Товары.Добавить();
        СтрС.Номенклатура = Стр.Номенклатура;
        СтрС.Количество = -Откл;
        Недостач = Недостач + 1;
      КонецЕсли;
    КонецЦикла;

    Итог = "";
    Если Опр <> Неопределено Тогда
      Опр.Записать();
      Опр.Провести();
      Итог = "Излишки: «Оприходование товаров» № " + Опр.Номер + " проведено (" + Строка(Излишков) + " поз.)";
    КонецЕсли;
    Если Спис <> Неопределено Тогда
      Спис.Записать();
      Спис.Провести();
      Итог = Итог + ?(Итог = "", "", "; ") + "Недостачи: «Списание товаров» № " + Спис.Номер + " проведено (" + Строка(Недостач) + " поз.)";
    КонецЕсли;
    ЗафиксироватьТранзакцию();
  Исключение
    ОтменитьТранзакцию();
    ВызватьИсключение(ОписаниеОшибки());
  КонецПопытки;
  Если Итог = "" Тогда
    Итог = "Отклонений нет — расхождений факт/учёт не обнаружено.";
  КонецЕсли;
  Возврат Итог;
КонецФункции

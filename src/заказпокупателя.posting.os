// Проведение заказа покупателя — резервирует товар на складе.

Процедура ОбработкаПроведения()
  ПроверитьЗакрытыйПериод(this);

  ПроверитьРеквизитШапки(this.Покупатель, "Покупатель");
  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.РезервыТоваров.Очистить();

  ПроверитьЗаполнениеСтрокТоваров(this.Товары, "Товары", Ложь);

  // Опциональный контроль: не резервировать больше, чем свободно на складе
  // (свободно = остаток − чужие резервы). Включается константой; СвойЗаказ = this,
  // чтобы при перепроведении не учитывать собственный прежний резерв.
  Если Константы.КонтролироватьОстаткиПриРезерве = Истина Тогда
    // Та же блокировка, что у продажи: резерв и продажа одной позиции
    // одновременно иначе оба видят свободный остаток.
    ЗаблокироватьПартии(this.Товары);
    ПроверитьСвободныйОстаток(this.Склад, this.Организация, this.Товары,
      this, this.МоментВремени());
  КонецЕсли;

  Для Каждого Строка Из this.Товары Цикл
    ДвР = Движения.РезервыТоваров.Добавить();
    ДвР.ВидДвижения    = "Приход";
    ДвР.Номенклатура   = Строка.Номенклатура;
    ДвР.Склад          = this.Склад;
    ДвР.ЗаказПокупателя = this;
    ДвР.Количество     = Строка.Количество;
  КонецЦикла;
КонецПроцедуры

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

// Дополняет существующую демонстрационную базу без очистки и перепроведения
// прежних документов. Каждый пример создаётся одной транзакцией.
Процедура ЗаполнитьДемоЭтапыЗаказовПУТ(ДатаПримеров, Организация, Склад, Покупатель, Поставщик, Товар, ТипЦен) Экспорт
  Добавлено = 0;
  Для Каждого Вид Из СтрРазделить("Поставщик;Покупатель", ";") Цикл
    Для Каждого Этап Из СтрРазделить("Новый;Принят;НаОбеспечении;ВРаботе;Готов;Завершён;Отменён", ";") Цикл
      Метка = "Демо этапов: " + Вид + " / " + Этап;
      Если Вид = "Поставщик" Тогда
        Сущность = "ЗаказПоставщику";
      Иначе
        Сущность = "ЗаказПокупателя";
      КонецЕсли;
      Поиск = Новый Запрос;
      Поиск.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ид ИЗ Документ." + Сущность + " ГДЕ Комментарий = &Метка";
      Поиск.УстановитьПараметр("Метка", Метка);
      Если Поиск.Выполнить().Количество() > 0 Тогда Продолжить; КонецЕсли;

      НачатьТранзакцию();
      Попытка
        Если Вид = "Поставщик" Тогда
          Заказ = Документы.ЗаказПоставщику.Создать();
          Заказ.Поставщик = Поставщик;
          Цена = 500;
        Иначе
          Заказ = Документы.ЗаказПокупателя.Создать();
          Заказ.Покупатель = Покупатель;
          Заказ.ТипЦенПродажи = ТипЦен;
          Цена = 900;
        КонецЕсли;
        Заказ.Дата = ДатаПримеров;
        Заказ.Организация = Организация;
        Заказ.Склад = Склад;
        Заказ.Комментарий = Метка;
        Заказ.СпособУчетаНДС = "ВТомЧисле";
        Заказ.Состояние = "Новый";
        Количество = ?(Этап = "Завершён", 2, 1);
        Стр = Заказ.Товары.Добавить();
        Стр.Номенклатура = Товар; Стр.Количество = Количество; Стр.Цена = Цена;
        Заказ.Записать();
        // Новый — сохранённый черновик. Остальные примеры имеют реальные
        // резервы/ожидания, а не только заполненный реквизит состояния.
        Если Этап <> "Новый" Тогда
          Заказ.Провести();
          Заказ.Состояние = "Принят"; Заказ.Записать();
          Если Этап = "НаОбеспечении" Тогда
            Заказ.Состояние = "НаОбеспечении"; Заказ.Записать();
          ИначеЕсли Этап = "ВРаботе" ИЛИ Этап = "Готов" ИЛИ Этап = "Завершён" Тогда
            Заказ.Состояние = "ВРаботе"; Заказ.Записать();
            Если Этап = "Готов" ИЛИ Этап = "Завершён" Тогда
              Заказ.Состояние = "Готов"; Заказ.Записать();
            КонецЕсли;
          КонецЕсли;

          Если Этап = "Завершён" Тогда
            Если Вид = "Поставщик" Тогда
              Исполнение = Документы.ПоступлениеТоваров.Создать();
              Исполнение.Поставщик = Поставщик;
              Исполнение.ЗаказПоставщику = Заказ.Ссылка;
            Иначе
              Исполнение = Документы.РеализацияТоваров.Создать();
              Исполнение.Покупатель = Покупатель;
              Исполнение.ЗаказПокупателя = Заказ.Ссылка;
              Исполнение.ТипЦенПродажи = ТипЦен;
              Исполнение.СрокОплаты = ДобавитьДень(ДатаПримеров, 7);
            КонецЕсли;
            Исполнение.Дата = ДатаПримеров;
            Исполнение.Организация = Организация;
            Исполнение.Склад = Склад;
            Исполнение.СпособУчетаНДС = "ВТомЧисле";
            Стр = Исполнение.Товары.Добавить();
            Стр.Номенклатура = Товар; Стр.Количество = Количество; Стр.Цена = Цена;
            Исполнение.Записать(); Исполнение.Провести();
            Заказ.Состояние = "Завершён"; Заказ.Записать();
          ИначеЕсли Этап = "Отменён" Тогда
            Если Вид = "Поставщик" Тогда
              Закрытие = Документы.ЗакрытиеЗаказовПоставщикам.Создать();
              Закрытие.Поставщик = Поставщик;
              Стр = Закрытие.Заказы.Добавить(); Стр.ЗаказПоставщику = Заказ.Ссылка;
            Иначе
              Закрытие = Документы.ЗакрытиеЗаказовПокупателей.Создать();
              Закрытие.Покупатель = Покупатель;
              Стр = Закрытие.Заказы.Добавить(); Стр.ЗаказПокупателя = Заказ.Ссылка;
            КонецЕсли;
            Закрытие.Дата = ДатаПримеров;
            Закрытие.Организация = Организация;
            Закрытие.Склад = Склад;
            Закрытие.Комментарий = "Демо: отмена заказа со снятием обеспечения";
            Стр.Номенклатура = Товар; Стр.Количество = Количество;
            Закрытие.Записать(); Закрытие.Провести();
            Заказ.Состояние = "Отменён"; Заказ.Записать();
          КонецЕсли;
        КонецЕсли;
        ЗафиксироватьТранзакцию();
        Добавлено = Добавлено + 1;
      Исключение
        Ошибка = ОписаниеОшибки();
        ОтменитьТранзакцию();
        ВызватьИсключение(Метка + ": " + Ошибка);
      КонецПопытки;
    КонецЦикла;
  КонецЦикла;
  Сообщить("Демонстрационные заказы по этапам: добавлено " + Строка(Добавлено));
КонецПроцедуры

// Обработка «Загрузка и сопоставление документов ЭДО (УПД)».
// Поддерживает разбор формата ФНС УПД (5.01 / 5.02 / 5.03 / 820),
// умное сопоставление номенклатуры (по артикулу, коду, наименованию, регистру соответствий),
// нормализацию строк и автосоздание документа «ПоступлениеТоваров».

Функция НормализоватьАртикул(Знач АртикулВход, Знач Префикс, Знач ОчищатьСпец) Экспорт
	Стр = СокрЛП(Строка(АртикулВход));
	Если Стр = "" Тогда
		Возврат "";
	КонецЕсли;

	// Отсечение префикса
	Если ЗначениеЗаполнено(Префикс) Тогда
		Пр = СокрЛП(Строка(Префикс));
		Если СтрНачинаетсяС(ВРег(Стр), ВРег(Пр)) Тогда
			Стр = Сред(Стр, СтрДлина(Пр) + 1);
		КонецЕсли;
	КонецЕсли;

	Если ОчищатьСпец Тогда
		// Удаление разделителей и спецсимволов
		СпецСимволы = " -_./\,();:+=*#~`'""";
		Рез = "";
		Для Поз = 1 По СтрДлина(Стр) Цикл
			Симв = Сред(Стр, Поз, 1);
			Если СтрНайти(СпецСимволы, Симв) = 0 Тогда
				Рез = Рез + Симв;
			КонецЕсли;
		КонецЦикла;
		Возврат ВРег(Рез);
	Иначе
		Возврат ВРег(СокрЛП(Стр));
	КонецЕсли;
КонецФункции

Функция ИзвлечьАртикулИзНаименования(Наим)
	Стр = СокрЛП(Строка(Наим));
	ПозПробела = СтрНайти(Стр, " ");
	Если ПозПробела > 2 Тогда
		ПервоеСлово = Лев(Стр, ПозПробела - 1);
		ЕстьЦифры = Ложь;
		Для Индекс = 1 По СтрДлина(ПервоеСлово) Цикл
			Симв = Сред(ПервоеСлово, Индекс, 1);
			Если Симв >= "0" И Симв <= "9" Тогда
				ЕстьЦифры = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьЦифры Тогда
			Возврат ПервоеСлово;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПолучитьАтрибутТега(СтрокаТега, ИмяАтрибута)
	Поиск = ИмяАтрибута + "=";
	Поз = СтрНайти(СтрокаТега, Поиск);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Остаток = Сред(СтрокаТега, Поз + СтрДлина(Поиск));
	Если СтрНачинаетсяС(Остаток, """") Тогда
		Остаток = Сред(Остаток, 2);
		ПозЗакр = СтрНайти(Остаток, """");
		Если ПозЗакр > 0 Тогда
			Возврат Лев(Остаток, ПозЗакр - 1);
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция РазобратьXML_УПД(ТекстФайла)
	Результат = Новый Структура;
	Результат.Вставить("НомерДок", "");
	Результат.Вставить("ДатаДок", "");
	Результат.Вставить("ПродавецИНН", "");
	Результат.Вставить("ПродавецКПП", "");
	Результат.Вставить("ПродавецНаим", "");
	Результат.Вставить("ПокупательИНН", "");
	Результат.Вставить("ПокупательКПП", "");
	Результат.Вставить("ПокупательНаим", "");
	Результат.Вставить("СуммаВсего", 0);
	Результат.Вставить("Товары", Новый Массив);

	СтрокиXML = СтрРазделить(СтрЗаменить(ТекстФайла, Символ(13), ""), Символ(10));
	
	ВБлокеПрод = Ложь;
	ВБлокеПокуп = Ложь;
	ТекТовар = Неопределено;

	Для Каждого Стр Из СтрокиXML Цикл
		Стр = СокрЛП(Стр);
		Если Стр = "" Тогда Продолжить; КонецЕсли;

		// 1. Шапка документа
		Если СтрНайти(Стр, "<СвСчФакт") > 0 ИЛИ СтрНайти(Стр, "<СвДокПТП") > 0 ИЛИ СтрНайти(Стр, "<Документ") > 0 Тогда
			Ном = ПолучитьАтрибутТега(Стр, "НомерСчФ");
			Если Ном = "" Тогда Ном = ПолучитьАтрибутТега(Стр, "НомерДок"); КонецЕсли;
			Если Ном <> "" И Результат.НомерДок = "" Тогда Результат.НомерДок = Ном; КонецЕсли;

			Дат = ПолучитьАтрибутТега(Стр, "ДатаСчФ");
			Если Дат = "" Тогда Дат = ПолучитьАтрибутТега(Стр, "ДатаДок"); КонецЕсли;
			Если Дат <> "" И Результат.ДатаДок = "" Тогда Результат.ДатаДок = Дат; КонецЕсли;
		КонецЕсли;

		// 2. Продавец
		Если СтрНайти(Стр, "<СвПрод") > 0 Тогда
			ВБлокеПрод = Истина;
			ВБлокеПокуп = Ложь;
		ИначеЕсли СтрНайти(Стр, "</СвПрод>") > 0 Тогда
			ВБлокеПрод = Ложь;
		КонецЕсли;

		// 3. Покупатель
		Если СтрНайти(Стр, "<СвПокуп") > 0 Тогда
			ВБлокеПокуп = Истина;
			ВБлокеПрод = Ложь;
		ИначеЕсли СтрНайти(Стр, "</СвПокуп>") > 0 Тогда
			ВБлокеПокуп = Ложь;
		КонецЕсли;

		Если ВБлокеПрод И (СтрНайти(Стр, "<СвЮЛУч") > 0 ИЛИ СтрНайти(Стр, "<СвИП") > 0 ИЛИ СтрНайти(Стр, "<ИдСв") > 0) Тогда
			Инн = ПолучитьАтрибутТега(Стр, "ИННЮЛ");
			Если Инн = "" Тогда Инн = ПолучитьАтрибутТега(Стр, "ИННФЛ"); КонецЕсли;
			Если Инн <> "" Тогда Результат.ПродавецИНН = Инн; КонецЕсли;

			Кпп = ПолучитьАтрибутТега(Стр, "КПП");
			Если Кпп <> "" Тогда Результат.ПродавецКПП = Кпп; КонецЕсли;

			Наим = ПолучитьАтрибутТега(Стр, "НаимОрг");
			Если Наим <> "" Тогда Результат.ПродавецНаим = Наим; КонецЕсли;
		КонецЕсли;

		Если ВБлокеПокуп И (СтрНайти(Стр, "<СвЮЛУч") > 0 ИЛИ СтрНайти(Стр, "<СвИП") > 0 ИЛИ СтрНайти(Стр, "<ИдСв") > 0) Тогда
			Инн = ПолучитьАтрибутТега(Стр, "ИННЮЛ");
			Если Инн = "" Тогда Инн = ПолучитьАтрибутТега(Стр, "ИННФЛ"); КонецЕсли;
			Если Инн <> "" Тогда Результат.ПокупательИНН = Инн; КонецЕсли;

			Кпп = ПолучитьАтрибутТега(Стр, "КПП");
			Если Кпп <> "" Тогда Результат.ПокупательКПП = Кпп; КонецЕсли;

			Наим = ПолучитьАтрибутТега(Стр, "НаимОрг");
			Если Наим <> "" Тогда Результат.ПокупательНаим = Наим; КонецЕсли;
		КонецЕсли;

		// 4. Табличная часть
		Если СтрНайти(Стр, "<СведТов") > 0 Тогда
			ТекТовар = Новый Структура;
			ТекТовар.Вставить("НомСтр", ПолучитьАтрибутТега(Стр, "НомСтр"));
			ТекТовар.Вставить("НаимТов", ПолучитьАтрибутТега(Стр, "НаимТов"));
			ТекТовар.Вставить("Артикул", ПолучитьАтрибутТега(Стр, "АртикулТов"));
			ТекТовар.Вставить("КодТов", "");
			ТекТовар.Вставить("ОКЕИ", ПолучитьАтрибутТега(Стр, "ОКЕИ_Тов"));
			ТекТовар.Вставить("ЕдИзм", ПолучитьАтрибутТега(Стр, "НаимЕдИзм"));
			Если ТекТовар.ЕдИзм = "" Тогда ТекТовар.ЕдИзм = "шт"; КонецЕсли;

			Кол = Число(ПолучитьАтрибутТега(Стр, "КолТов"));
			ТекТовар.Вставить("Количество", Кол);

			Цена = Число(ПолучитьАтрибутТега(Стр, "ЦенаТов"));
			ТекТовар.Вставить("Цена", Цена);

			Сумма = Число(ПолучитьАтрибутТега(Стр, "СтТовБезНДС"));
			ТекТовар.Вставить("Сумма", Сумма);

			Ставка = ПолучитьАтрибутТега(Стр, "НалСт");
			Если Ставка = "" Тогда Ставка = "20%"; КонецЕсли;
			ТекТовар.Вставить("СтавкаНДС", Ставка);

			СуммаНДС = Число(ПолучитьАтрибутТега(Стр, "СумНал"));
			ТекТовар.Вставить("СуммаНДС", СуммаНДС);

			Всего = Число(ПолучитьАтрибутТега(Стр, "СтТовУчНал"));
			Если Всего = 0 Тогда Всего = Сумма + СуммаНДС; КонецЕсли;
			ТекТовар.Вставить("Всего", Всего);

			// Если артикул пуст — пробуем извлечь из начала наименования
			Если ТекТовар.Артикул = "" Тогда
				ТекТовар.Артикул = ИзвлечьАртикулИзНаименования(ТекТовар.НаимТов);
			КонецЕсли;

			Результат.Товары.Добавить(ТекТовар);
		КонецЕсли;

		Если ТекТовар <> Неопределено И СтрНайти(Стр, "<ДопСведТов") > 0 Тогда
			Код = ПолучитьАтрибутТега(Стр, "КодТов");
			Если Код <> "" Тогда
				ТекТовар.КодТов = Код;
				Если ТекТовар.Артикул = "" Тогда
					ТекТовар.Артикул = Код;
				КонецЕсли;
			КонецЕсли;
			Арт = ПолучитьАтрибутТега(Стр, "Артикул");
			Если Арт <> "" Тогда
				ТекТовар.Артикул = Арт;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция ПоискПоРегиструСопоставлений(КонтрагентСсылка, АртикулПоставщика, НаимПоставщика)
	Если НЕ ЗначениеЗаполнено(КонтрагентСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Номенклатура ИЗ РегистрСведений.НоменклатураКонтрагентов ГДЕ Контрагент = &Контрагент И (АртикулПоставщика = &Артикул ИЛИ НаименованиеПоставщика = &Наим)";
	Запрос.УстановитьПараметр("Контрагент", КонтрагентСсылка);
	Запрос.УстановитьПараметр("Артикул", СокрЛП(Строка(АртикулПоставщика)));
	Запрос.УстановитьПараметр("Наим", СокрЛП(Строка(НаимПоставщика)));
	Рез = Запрос.Выполнить();
	Если Рез.Количество() > 0 Тогда
		Если ЗначениеЗаполнено(Рез[0].Номенклатура) Тогда
			Возврат Рез[0].Номенклатура;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПодобратьНоменклатуруБазы(ПоставщикСсылка, АртикулПоставщика, НаимПоставщика, КодПоставщика, Вариант, Префикс, ОчищатьСпец) Экспорт
	// 1. Сначала проверяем сохраненные сопоставления
	Сохраненная = ПоискПоРегиструСопоставлений(ПоставщикСсылка, АртикулПоставщика, НаимПоставщика);
	Если ЗначениеЗаполнено(Сохраненная) Тогда
		Рез = Новый Структура;
		Рез.Вставить("Номенклатура", Сохраненная);
		Рез.Вставить("Статус", "✅ Сопоставлено (по регистру)");
		Рез.Вставить("КоличествоВариантов", 1);
		Рез.Вставить("Варианты", Новый Массив);
		Возврат Рез;
	КонецЕсли;

	НормАртикул = НормализоватьАртикул(АртикулПоставщика, Префикс, ОчищатьСпец);
	НаимПоиск = СокрЛП(Строка(НаимПоставщика));

	Найденные = Новый Массив;

	// 2. Поиск по артикулу
	Если (Вариант = "Умный поиск (все варианты)" ИЛИ Вариант = "По артикулу" ИЛИ Вариант = "Артикул + Наименование") И ЗначениеЗаполнено(АртикулПоставщика) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Ссылка, Наименование, Артикул ИЗ Справочник.Номенклатура ГДЕ Артикул = &Арт";
		Запрос.УстановитьПараметр("Арт", СокрЛП(Строка(АртикулПоставщика)));
		Для Каждого Стр Из Запрос.Выполнить() Цикл
			Найденные.Добавить(Стр.Ссылка);
		КонецЦикла;

		// Если точный артикул не нашел — пробуем перебором по нормализованному артикулу
		Если Найденные.Количество() = 0 И НормАртикул <> "" Тогда
			ЗапросВсе = Новый Запрос;
			ЗапросВсе.Текст = "ВЫБРАТЬ Ссылка, Артикул, Наименование ИЗ Справочник.Номенклатура";
			Для Каждого Стр Из ЗапросВсе.Выполнить() Цикл
				Если ЗначениеЗаполнено(Стр.Артикул) Тогда
					АртБазыНорм = НормализоватьАртикул(Стр.Артикул, "", ОчищатьСпец);
					Если АртБазыНорм = НормАртикул Тогда
						Найденные.Добавить(Стр.Ссылка);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// 3. Поиск по коду / 1С идентификатору
	Если Найденные.Количество() = 0 И (Вариант = "Умный поиск (все варианты)" ИЛИ Вариант = "По коду") И ЗначениеЗаполнено(КодПоставщика) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ Идентификатор1С = &Код ИЛИ Артикул = &Код";
		Запрос.УстановитьПараметр("Код", СокрЛП(Строка(КодПоставщика)));
		Для Каждого Стр Из Запрос.Выполнить() Цикл
			Найденные.Добавить(Стр.Ссылка);
		КонецЦикла;
	КонецЕсли;

	// 4. Поиск по наименованию
	Если Найденные.Количество() = 0 И (Вариант = "Умный поиск (все варианты)" ИЛИ Вариант = "По наименованию" ИЛИ Вариант = "Артикул + Наименование") И НаимПоиск <> "" Тогда
		// Точное совпадение
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Ссылка, Наименование ИЗ Справочник.Номенклатура ГДЕ Наименование = &Наим";
		Запрос.УстановитьПараметр("Наим", НаимПоиск);
		Для Каждого Стр Из Запрос.Выполнить() Цикл
			Найденные.Добавить(Стр.Ссылка);
		КонецЦикла;

		// Если не найдено — поиск по вхождению подстроки
		Если Найденные.Количество() = 0 И СтрДлина(НаимПоиск) > 5 Тогда
			ЗапросВсе = Новый Запрос;
			ЗапросВсе.Текст = "ВЫБРАТЬ Ссылка, Наименование ИЗ Справочник.Номенклатура";
			Подстрока = ВРег(Лев(НаимПоиск, 15));
			Для Каждого Стр Из ЗапросВсе.Выполнить() Цикл
				Если СтрНайти(ВРег(Стр.Наименование), Подстрока) > 0 Тогда
					Найденные.Добавить(Стр.Ссылка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Рез = Новый Структура;
	Рез.Вставить("КоличествоВариантов", Найденные.Количество());
	Рез.Вставить("Варианты", Найденные);

	Если Найденные.Количество() = 1 Тогда
		Рез.Вставить("Номенклатура", Найденные[0]);
		Рез.Вставить("Статус", "✅ Сопоставлено (точно)");
	ИначеЕсли Найденные.Количество() > 1 Тогда
		Рез.Вставить("Номенклатура", Найденные[0]);
		Рез.Вставить("Статус", "⚠️ Несколько вариантов (" + Строка(Найденные.Количество()) + ")");
	Иначе
		Рез.Вставить("Номенклатура", Неопределено);
		Рез.Вставить("Статус", "❓ Не найдено");
	КонецЕсли;

	Возврат Рез;
КонецФункции

Процедура ЗаписатьВРегистрСопоставлений(КонтрагентСсылка, АртикулПоставщика, НаимПоставщика, НоменклатураСсылка)
	Если НЕ ЗначениеЗаполнено(КонтрагентСсылка) ИЛИ НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат;
	КонецЕсли;

	МЗ = РегистрыСведений.НоменклатураКонтрагентов.СоздатьМенеджерЗаписи();
	МЗ.Контрагент = КонтрагентСсылка;
	МЗ.АртикулПоставщика = СокрЛП(Строка(АртикулПоставщика));
	МЗ.НаименованиеПоставщика = СокрЛП(Строка(НаимПоставщика));
	МЗ.Номенклатура = НоменклатураСсылка;
	Попытка
		МЗ.Записать(Истина);
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция СоздатьНовуюНоменклатуру(Наим, Артикул, ЕдИзм, СтавкаНДС)
	Нов = Справочники.Номенклатура.Создать();
	Нов.Наименование = СокрЛП(Строка(Наим));
	Нов.Артикул = СокрЛП(Строка(Артикул));
	Нов.ЕдиницаИзмерения = ?(ЗначениеЗаполнено(ЕдИзм), СокрЛП(Строка(ЕдИзм)), "шт");
	Нов.СтавкаНДС = ?(ЗначениеЗаполнено(СтавкаНДС), СокрЛП(Строка(СтавкаНДС)), "20%");
	Нов.Услуга = Ложь;
	Нов.Записать();
	Возврат Нов.Ссылка;
КонецФункции

Процедура Выполнить() Экспорт
	ФайлТекст = Параметры.ФайлЭДО;
	Если НЕ ЗначениеЗаполнено(ФайлТекст) Тогда
		Сообщить("ОШИБКА: Укажите файл УПД (XML) для загрузки!");
		Возврат;
	КонецЕсли;

	ТекстФайла = "";
	Если СтрНайти(ФайлТекст, Символ(10)) > 0 ИЛИ СтрНайти(ФайлТекст, "<?xml") > 0 Тогда
		ТекстФайла = ФайлТекст;
	Иначе
		Чтение = Новый ЧтениеТекста(ФайлТекст);
		ТекстФайла = Чтение.Прочитать();
		Чтение.Закрыть();
	КонецЕсли;

	Если ТекстФайла = "" Тогда
		Сообщить("ОШИБКА: Файл пуст!");
		Возврат;
	КонецЕсли;

	Вариант = ?(ЗначениеЗаполнено(Параметры.ВариантПоиска), Параметры.ВариантПоиска, "Умный поиск (все варианты)");
	Префикс = Параметры.ПрефиксАртикула;
	ОчищатьСпец = ?(Параметры.ОчищатьСпецсимволы = Ложь, Ложь, Истина);
	СоздаватьНедост = ?(Параметры.СоздаватьНедостающую = Истина, Истина, Ложь);
	СохранятьСопост = ?(Параметры.СохранятьСопоставления = Ложь, Ложь, Истина);
	ДействиеЗнач = ?(ЗначениеЗаполнено(Параметры.Действие), Параметры.Действие, "Предпросмотр");

	ДанныеУПД = РазобратьXML_УПД(ТекстФайла);
	
	Сообщить("======================================================================");
	Сообщить("ЗАГРУЗКА И СОПОСТАВЛЕНИЕ ЭДО (УПД):");
	Сообщить("Документ №: " + ДанныеУПД.НомерДок + " от " + ДанныеУПД.ДатаДок);
	Сообщить("Продавец (по файлу): " + ДанныеУПД.ПродавецНаим + " (ИНН: " + ДанныеУПД.ПродавецИНН + ")");
	Сообщить("Покупатель (по файлу): " + ДанныеУПД.ПокупательНаим + " (ИНН: " + ДанныеУПД.ПокупательИНН + ")");
	Сообщить("Позиций в документе: " + Строка(ДанныеУПД.Товары.Количество()));
	Сообщить("======================================================================");

	// Определение Организации
	ОргСсылка = Параметры.Организация;
	Если НЕ ЗначениеЗаполнено(ОргСсылка) И ДанныеУПД.ПокупательИНН <> "" Тогда
		ЗапросОрг = Новый Запрос;
		ЗапросОрг.Текст = "ВЫБРАТЬ Ссылка, Наименование ИЗ Справочник.Организация ГДЕ ИНН = &ИНН";
		ЗапросОрг.УстановитьПараметр("ИНН", ДанныеУПД.ПокупательИНН);
		РезОрг = ЗапросОрг.Выполнить();
		Если РезОрг.Количество() > 0 Тогда
			ОргСсылка = РезОрг[0].Ссылка;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ОргСсылка) Тогда
		ЗапросПервОрг = Новый Запрос;
		ЗапросПервОрг.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Организация";
		РезПервОрг = ЗапросПервОрг.Выполнить();
		Если РезПервОрг.Количество() > 0 Тогда
			ОргСсылка = РезПервОрг[0].Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Определение Поставщика
	ПостСсылка = Параметры.Поставщик;
	Если НЕ ЗначениеЗаполнено(ПостСсылка) И ДанныеУПД.ПродавецИНН <> "" Тогда
		ЗапросПост = Новый Запрос;
		ЗапросПост.Текст = "ВЫБРАТЬ Ссылка, Наименование ИЗ Справочник.Контрагент ГДЕ ИНН = &ИНН";
		ЗапросПост.УстановитьПараметр("ИНН", ДанныеУПД.ПродавецИНН);
		РезПост = ЗапросПост.Выполнить();
		Если РезПост.Количество() > 0 Тогда
			ПостСсылка = РезПост[0].Ссылка;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПостСсылка) И СоздаватьНедост И ДанныеУПД.ПродавецИНН <> "" Тогда
		НовПост = Справочники.Контрагент.Создать();
		НовПост.Наименование = ?(ДанныеУПД.ПродавецНаим <> "", ДанныеУПД.ПродавецНаим, "Поставщик ИНН " + ДанныеУПД.ПродавецИНН);
		НовПост.ИНН = ДанныеУПД.ПродавецИНН;
		НовПост.КПП = ДанныеУПД.ПродавецКПП;
		НовПост.Поставщик = Истина;
		НовПост.Записать();
		ПостСсылка = НовПост.Ссылка;
		Сообщить("Создан новый контрагент: " + НовПост.Наименование);
	КонецЕсли;

	// Определение Склада
	СкладСсылка = Параметры.Склад;
	Если НЕ ЗначениеЗаполнено(СкладСсылка) Тогда
		ЗапросПервСкл = Новый Запрос;
		ЗапросПервСкл.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Склад";
		РезПервСкл = ЗапросПервСкл.Выполнить();
		Если РезПервСкл.Количество() > 0 Тогда
			СкладСсылка = РезПервСкл[0].Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Сопоставление строк
	Сопоставлено = 0;
	НеНайдено = 0;
	Создано = 0;
	ВсегоСумма = 0;

	Для Каждого Товар Из ДанныеУПД.Товары Цикл
		Подбор = ПодобратьНоменклатуруБазы(ПостСсылка, Товар.Артикул, Товар.НаимТов, Товар.КодТов, Вариант, Префикс, ОчищатьСпец);
		
		ТомСсылка = Подбор.Номенклатура;
		Статус = Подбор.Статус;

		Если НЕ ЗначениеЗаполнено(ТомСсылка) И СоздаватьНедост Тогда
			ТомСсылка = СоздатьНовуюНоменклатуру(Товар.НаимТов, Товар.Артикул, Товар.ЕдИзм, Товар.СтавкаНДС);
			Статус = "✨ Создано автоматически";
			Создано = Создано + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(ТомСсылка) Тогда
			Сопоставлено = Сопоставлено + 1;
			Товар.Вставить("Номенклатура", ТомСсылка);
			Если СохранятьСопост И ЗначениеЗаполнено(ПостСсылка) Тогда
				ЗаписатьВРегистрСопоставлений(ПостСсылка, Товар.Артикул, Товар.НаимТов, ТомСсылка);
			КонецЕсли;
		Иначе
			НеНайдено = НеНайдено + 1;
			Товар.Вставить("Номенклатура", Неопределено);
		КонецЕсли;

		Товар.Вставить("Статус", Статус);
		ВсегоСумма = ВсегоСумма + Товар.Всего;

		Сообщить("[" + Строка(Товар.НомСтр) + "] " + Товар.НаимТов + " (Арт: " + Товар.Артикул + ") -> " + Статус + ?(ЗначениеЗаполнено(ТомСсылка), " (" + Строка(ТомСсылка) + ")", ""));
	КонецЦикла;

	Сообщить("----------------------------------------------------------------------");
	Сообщить("ИТОГИ СОПОСТАВЛЕНИЯ: Всего " + Строка(ДанныеУПД.Товары.Количество()) + ", Сопоставлено: " + Строка(Сопоставлено) + ", Создано: " + Строка(Создано) + ", Не найдено: " + Строка(НеНайдено));
	Сообщить("----------------------------------------------------------------------");

	// Создание документа
	Если ДействиеЗнач = "Создать документ" ИЛИ ДействиеЗнач = "Создать и провести" Тогда
		Если НЕ ЗначениеЗаполнено(ОргСсылка) Тогда
			Сообщить("ОШИБКА: Не определена организация для создания поступления!");
			Возврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПостСсылка) Тогда
			Сообщить("ОШИБКА: Не определен поставщик для создания поступления!");
			Возврат;
		КонецЕсли;

		Док = Документы.ПоступлениеТоваров.Создать();
		Док.Номер = ?(ДанныеУПД.НомерДок <> "", ДанныеУПД.НомерДок, "ЭДО-" + Формат(ТекущаяДата(), "ДФ=yyyyMMddHHmmss"));
		Док.Дата = ТекущаяДата();
		Док.Организация = ОргСсылка;
		Док.Поставщик = ПостСсылка;
		Док.Склад = СкладСсылка;

		СуммаБезНДСИтог = 0;
		СуммаНДСИтог = 0;
		СуммаИтог = 0;

		Для Каждого Товар Из ДанныеУПД.Товары Цикл
			Если ЗначениеЗаполнено(Товар.Номенклатура) Тогда
				СтрТЧ = Док.Товары.Добавить();
				СтрТЧ.Номенклатура = Товар.Номенклатура;
				СтрТЧ.Количество = Товар.Количество;
				СтрТЧ.Цена = Товар.Цена;
				СтрТЧ.Сумма = Товар.Сумма;
				СтрТЧ.СуммаНДС = Товар.СуммаНДС;
				
				Ставка = Справочники.СтавкаНДС.НайтиПоНаименованию(Товар.СтавкаНДС);
				Если ЗначениеЗаполнено(Ставка) Тогда
					СтрТЧ.СтавкаНДС = Ставка;
				КонецЕсли;

				СуммаБезНДСИтог = СуммаБезНДСИтог + Товар.Сумма;
				СуммаНДСИтог = СуммаНДСИтог + Товар.СуммаНДС;
				СуммаИтог = СуммаИтог + Товар.Всего;
			КонецЕсли;
		КонецЦикла;

		Док.СуммаБезНДС = СуммаБезНДСИтог;
		Док.СуммаНДС = СуммаНДСИтог;
		Док.Сумма = СуммаИтог;

		Док.Записать();
		Сообщить("✅ Документ «Поступление товаров» № " + Док.Номер + " успешно создан! (Ссылка: " + Строка(Док.Ссылка) + ")");

		Если ДействиеЗнач = "Создать и провести" Тогда
			Попытка
				Док.Провести();
				Сообщить("🚀 Документ «Поступление товаров» успешно ПРОВЕДЕН!");
			Исключение
				Сообщить("ВНИМАНИЕ: Ошибка при проведении документа: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


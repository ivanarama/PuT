Процедура Выполнить() Экспорт
  Загрузка = Неопределено;
  Если Параметры.Действие = "Создать документ" ИЛИ Параметры.Действие = "Создать и провести" Тогда Загрузка = НачатьЗагрузкуОбмена("ЭДО", Параметры.ИсточникОбмена); КонецЕсли;
  Попытка
    ВыполнитьИмпортУПД(Загрузка);
  Исключение
    Ошибка = ОписаниеОшибки();
    Если ТранзакцияАктивна() Тогда ОтменитьТранзакцию(); КонецЕсли;
    Если Параметры.Действие = "Создать документ" ИЛИ Параметры.Действие = "Создать и провести" Тогда
      ЗаписатьИсториюОбмена("ЭДО", "Загрузка УПД", "Ошибка", Ошибка, "", "", "", Загрузка);
    КонецЕсли;
    ВызватьИсключение(Ошибка);
  КонецПопытки;
КонецПроцедуры

Процедура ВыполнитьИмпортУПД(Загрузка)
	ФайлТекст = Параметры.ФайлЭДО;
	Если НЕ ЗначениеЗаполнено(ФайлТекст) Тогда
		ВызватьИсключение("ОШИБКА: Укажите файл УПД (XML) для загрузки!");
	КонецЕсли;

	ТекстФайла = ФайлТекст;
	Если ТекстФайла = "" Тогда
		ВызватьИсключение("ОШИБКА: Файл пуст!");
	КонецЕсли;

	Вариант = ?(ЗначениеЗаполнено(Параметры.ВариантПоиска), Параметры.ВариантПоиска, "Умный поиск (все варианты)");
	Префикс = Параметры.ПрефиксАртикула;
	ОчищатьСпец = ?(Параметры.ОчищатьСпецсимволы = Ложь, Ложь, Истина);
	СоздаватьНедост = ?(Параметры.СоздаватьНедостающую = Истина, Истина, Ложь);
	СохранятьСопост = ?(Параметры.СохранятьСопоставления = Ложь, Ложь, Истина);
	ДействиеЗнач = ?(ЗначениеЗаполнено(Параметры.Действие), Параметры.Действие, "Предпросмотр");

	ДанныеУПД = РазобратьXML_УПД(ТекстФайла);
	ТранзакцияИмпорта = ДействиеЗнач = "Создать документ" ИЛИ ДействиеЗнач = "Создать и провести";
	ОргСсылка = ОрганизацияПокупателяУПД(ДанныеУПД.ПокупательИНН, Параметры.Организация);
	СоздаватьНедост = СоздаватьНедост И ТранзакцияИмпорта;
	СохранятьСопост = СохранятьСопост И ТранзакцияИмпорта;
	Если ТранзакцияИмпорта Тогда
		НачатьЗащищенныйИмпортУПД(ДанныеУПД, Параметры.Организация, Параметры.Поставщик);
	КонецЕсли;

	Сообщить("======================================================================");
	Сообщить("ЗАГРУЗКА И СОПОСТАВЛЕНИЕ ЭДО (УПД):");
	Сообщить("Документ №: " + ДанныеУПД.НомерДок + " от " + ДанныеУПД.ДатаДок);
	Сообщить("Продавец (по файлу): " + ДанныеУПД.ПродавецНаим + " (ИНН: " + ДанныеУПД.ПродавецИНН + ")");
	Сообщить("Покупатель (по файлу): " + ДанныеУПД.ПокупательНаим + " (ИНН: " + ДанныеУПД.ПокупательИНН + ")");
	Сообщить("Позиций в документе: " + Строка(ДанныеУПД.Товары.Количество()));
	Сообщить("======================================================================");

	// Определение Поставщика
	ПостСсылка = Параметры.Поставщик;
	Если НЕ ЗначениеЗаполнено(ПостСсылка) Тогда
		ПостСсылка = НайтиПоставщикаПоИННКПП(ДанныеУПД.ПродавецИНН, ДанныеУПД.ПродавецКПП);
	КонецЕсли;

	// Для уже известной пары участников повтор отсекается до любых создающих
	// операций. После ожидания блокировки поиск выполняется заново.
	Если ТранзакцияИмпорта И ЗначениеЗаполнено(ОргСсылка) И ЗначениеЗаполнено(ПостСсылка) Тогда
		Существующий = НайтиЗагруженныйУПД(ДанныеУПД, ОргСсылка, ПостСсылка);
		Если ЗначениеЗаполнено(Существующий) Тогда
			ОтменитьТранзакцию();
			ЗаписатьИсториюОбмена("ЭДО", ДанныеУПД.НомерДок, "Пропущено", "УПД уже загружен", "", "", "", Загрузка);
			Сообщить("УПД «" + ДанныеУПД.НомерДок + "» этой организации и поставщика уже загружен — создание отменено без побочных эффектов.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПостСсылка) И СоздаватьНедост И ЗначениеЗаполнено(ДанныеУПД.ПродавецИНН) Тогда
		НовПост = Справочники.Контрагент.Создать();
		НовПост.Наименование = ?(ДанныеУПД.ПродавецНаим <> "", ДанныеУПД.ПродавецНаим, "Поставщик ИНН " + ДанныеУПД.ПродавецИНН);
		НовПост.ИНН = ДанныеУПД.ПродавецИНН;
		НовПост.КПП = ДанныеУПД.ПродавецКПП;
		НовПост.Вид = "Поставщик";
		НовПост.Записать();
		ПостСсылка = НовПост.Ссылка;
		Сообщить("Создан новый контрагент: " + НовПост.Наименование);
	КонецЕсли;

	Если ТранзакцияИмпорта Тогда
		Если НЕ ЗначениеЗаполнено(ОргСсылка) Тогда
			ОтменитьТранзакцию();
			ВызватьИсключение("ОШИБКА: Не определена организация для создания поступления!");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПостСсылка) Тогда
			ОтменитьТранзакцию();
			ВызватьИсключение("ОШИБКА: Не определен поставщик для создания поступления!");
		КонецЕсли;
		Существующий = НайтиЗагруженныйУПД(ДанныеУПД, ОргСсылка, ПостСсылка);
		Если ЗначениеЗаполнено(Существующий) Тогда
			ОтменитьТранзакцию();
			ЗаписатьИсториюОбмена("ЭДО", ДанныеУПД.НомерДок, "Пропущено", "УПД уже загружен", "", "", "", Загрузка);
			Сообщить("УПД «" + ДанныеУПД.НомерДок + "» этой организации и поставщика уже загружен — создание отменено без побочных эффектов.");
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Определение Склада
	СкладСсылка = Параметры.Склад;
	Если НЕ ЗначениеЗаполнено(СкладСсылка) Тогда
		ЗапросПервСкл = Новый Запрос;
		ЗапросПервСкл.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Склад";
		РезПервСкл = ЗапросПервСкл.Выполнить();
		Если РезПервСкл.Количество() > 0 Тогда
			СкладСсылка = РезПервСкл[0].Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Сопоставление строк
	Сопоставлено = 0;
	НеНайдено = 0;
	Создано = 0;
	ВсегоСумма = 0;

	Для Каждого Товар Из ДанныеУПД.Товары Цикл
		Подбор = ПодобратьНоменклатуруБазы(ПостСсылка, Товар.Артикул, Товар.НаимТов, Товар.КодТов, Вариант, Префикс, ОчищатьСпец);

		ТомСсылка = Подбор.Номенклатура;
		Статус = Подбор.Статус;

		Если НЕ ЗначениеЗаполнено(ТомСсылка) И СоздаватьНедост Тогда
			ТомСсылка = СоздатьНовуюНоменклатуру(Товар.НаимТов, Товар.Артикул, Товар.ЕдИзм, Товар.СтавкаНДС);
			Статус = "✨ Создано автоматически";
			Создано = Создано + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(ТомСсылка) Тогда
			Сопоставлено = Сопоставлено + 1;
			Товар.Вставить("Номенклатура", ТомСсылка);
			Если СохранятьСопост И ЗначениеЗаполнено(ПостСсылка) Тогда
				ЗаписатьВРегистрСопоставлений(ПостСсылка, Товар.Артикул, Товар.НаимТов, ТомСсылка);
			КонецЕсли;
		Иначе
			НеНайдено = НеНайдено + 1;
			Товар.Вставить("Номенклатура", Неопределено);
		КонецЕсли;

		Товар.Вставить("Статус", Статус);
		ВсегоСумма = ВсегоСумма + Товар.Всего;

		Сообщить("[" + Товар.НомСтр + "] " + Товар.НаимТов + " (Арт: " + Товар.Артикул + ") -> " + Статус + ?(ЗначениеЗаполнено(ТомСсылка), " (" + Строка(ТомСсылка) + ")", ""));
	КонецЦикла;

	Сообщить("----------------------------------------------------------------------");
	Сообщить("ИТОГИ СОПОСТАВЛЕНИЯ: Всего " + Строка(ДанныеУПД.Товары.Количество()) + ", Сопоставлено: " + Строка(Сопоставлено) + ", Создано: " + Строка(Создано) + ", Не найдено: " + Строка(НеНайдено));
	Сообщить("----------------------------------------------------------------------");

	// Создание документа
	Если ДействиеЗнач = "Создать документ" ИЛИ ДействиеЗнач = "Создать и провести" Тогда
		Если НЕ ЗначениеЗаполнено(ОргСсылка) Тогда
			ВызватьИсключение("ОШИБКА: Не определена организация для создания поступления!");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПостСсылка) Тогда
			ВызватьИсключение("ОШИБКА: Не определен поставщик для создания поступления!");
		КонецЕсли;

		// Повторная проверка под той же транзакционной блокировкой — прямо перед insert.
		Существующий = НайтиЗагруженныйУПД(ДанныеУПД, ОргСсылка, ПостСсылка);
		Если ЗначениеЗаполнено(Существующий) Тогда
			ОтменитьТранзакцию();
			ЗаписатьИсториюОбмена("ЭДО", ДанныеУПД.НомерДок, "Пропущено", "УПД уже загружен", "", "", "", Загрузка);
			Сообщить("УПД «" + ДанныеУПД.НомерДок + "» этой организации и поставщика уже загружен — создание отменено без побочных эффектов.");
			Возврат;
		КонецЕсли;

		Если НеНайдено > 0 ИЛИ ДанныеУПД.Товары.Количество() = 0 Тогда
			ВызватьИсключение("Нужно сопоставить все строки УПД перед созданием документа");
		КонецЕсли;
		Док = Документы.ПоступлениеТоваров.Создать();
		Док.Номер = ?(ДанныеУПД.НомерДок <> "", ДанныеУПД.НомерДок, "ЭДО-" + Формат(ТекущаяДатаВремя(), "ДФ=yyyyMMddHHmmss"));
		Док.Идентификатор1С = КлючИмпортаУПД(ДанныеУПД, ОргСсылка, ПостСсылка);
		// Дата — из УПД, а не дата загрузки: иначе съезжают партии и периоды.
		Док.Дата = Дата(ДанныеУПД.ДатаДок);
		Если НЕ ЗначениеЗаполнено(Док.Дата) Тогда
			Док.Дата = ТекущаяДатаВремя();
		КонецЕсли;
		Док.Организация = ОргСсылка;
		Док.Поставщик = ПостСсылка;
		Док.Склад = СкладСсылка;
		// Суммы УПД — нетто + НДС сверху. Без этого хук ПриЗаписи пересчитает
		// НДС «в том числе» и исказит суммы документа.
		Док.СпособУчетаНДС = "Сверху";

		СуммаБезНДСИтог = 0;
		СуммаНДСИтог = 0;
		СуммаИтог = 0;

		Для Каждого Товар Из ДанныеУПД.Товары Цикл
			Если ЗначениеЗаполнено(Товар.Номенклатура) Тогда
				СтрТЧ = Док.Товары.Добавить();
				СтрТЧ.Номенклатура = Товар.Номенклатура;
				СтрТЧ.Количество = Товар.Количество;
				СтрТЧ.Цена = Товар.Цена;
				СтрТЧ.Сумма = Товар.Сумма;
				СтрТЧ.СуммаНДС = Товар.СуммаНДС;

				СтавкаСсылка = ОбеспечитьСтавкуНДС(Товар.СтавкаНДС);
				Если ЗначениеЗаполнено(СтавкаСсылка) Тогда
					СтрТЧ.СтавкаНДС = СтавкаСсылка;
				КонецЕсли;

				СуммаБезНДСИтог = СуммаБезНДСИтог + Товар.Сумма;
				СуммаНДСИтог = СуммаНДСИтог + Товар.СуммаНДС;
				СуммаИтог = СуммаИтог + Товар.Всего;
			КонецЕсли;
		КонецЦикла;

		Док.СуммаБезНДС = СуммаБезНДСИтог;
		Док.СуммаНДС = СуммаНДСИтог;
		Док.Сумма = СуммаИтог;

		Док.Записать();
		ПроверитьИтогиУПД(Док, СуммаБезНДСИтог, СуммаНДСИтог, СуммаИтог);
		Сообщить("✅ Документ «Поступление товаров» № " + Док.Номер + " успешно создан! (Ссылка: " + Строка(Док.Ссылка) + ")");

		Если ДействиеЗнач = "Создать и провести" Тогда
			Попытка
				Док.Провести();
				Сообщить("🚀 Документ «Поступление товаров» успешно ПРОВЕДЕН!");
			Исключение
				ВызватьИсключение;
			КонецПопытки;
		КонецЕсли;

		ЗаписатьИсториюОбмена("ЭДО", ДанныеУПД.НомерДок, "Выполнено", "Поступление " + Док.Номер, "", "", "", Загрузка);
		ЗафиксироватьТранзакцию();
	КонецЕсли;
КонецПроцедуры

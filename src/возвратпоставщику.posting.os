// Проведение возврата поставщику — реверс поступления.
// Товары списываются из конкретной партии по документу-основанию.
// Взаиморасчёты с поставщиком сторнируются.

Процедура ОбработкаПроведения()
  ПроверитьДатуЗапрета(this.Дата);

  ПроверитьРеквизитШапки(this.Поставщик, "Поставщик");
  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.ОстаткиТоваров.Очистить();
  Движения.Взаиморасчеты.Очистить();
  Движения.ПартииТоваров.Очистить();

  ПроверитьЗаполнениеСтрокТоваров(this.Товары, "Товары");

  ЗаблокироватьПартии(this.Товары);

  Если ЗначениеЗаполнено(this.Основание) Тогда
    // 1. Суммы строк и сводная потребность по номенклатуре и складу.
    //    Ключи — идентификаторы, а не представления: два товара или склада с
    //    одинаковым именем иначе склеились бы в одну потребность.
    ПотребностьПоКлючу = Новый Соответствие;
    Для Каждого Строка Из this.Товары Цикл
      СкладСтроки = ?(ЗначениеЗаполнено(Строка.Склад), Строка.Склад, this.Склад);
      Строка.Сумма = Строка.Количество * Строка.Цена;
      Если ЗначениеЗаполнено(Строка.СуммаНДС) = Ложь Тогда
        Строка.СуммаНДС = 0;
      КонецЕсли;

      Ключ = УИДСсылки(Строка.Номенклатура) + "#" + УИДСсылки(СкладСтроки);
      Текущая = ПотребностьПоКлючу.Получить(Ключ);
      Если Текущая = Неопределено Тогда
        Текущая = 0;
      КонецЕсли;
      ПотребностьПоКлючу.Вставить(Ключ, Текущая + Строка.Количество);
    КонецЦикла;

    // Нельзя вернуть поставщику зарезервированный под заказы покупателя товар —
    // иначе заказы останутся без обеспечения. СвойЗаказ нет → все резервы чужие.
    ПроверитьСвободныйОстаток(this.Склад, this.Организация, this.Товары,
      Неопределено, this.МоментВремени());

    // 2. Остатки партий документа-основания. Партия в регистре нарезана и по
    //    дате поставки, поэтому дата берётся из остатка и уходит в движение:
    //    расход без неё попадал в отдельную строку с пустой датой, а партия
    //    поступления не уменьшалась.
    СписокНом = Новый Массив;
    Для Каждого Строка Из this.Товары Цикл
      СписокНом.Добавить(Строка.Номенклатура);
    КонецЦикла;

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                      Номенклатура.Ссылка КАК НомИД,
                      Склад.Ссылка КАК СкладИД,
                      ДатаПоставки,
                      КоличествоОстаток,
                      СуммаОстаток,
                      СуммаСНДСОстаток
                    ИЗ РегистрНакопления.ПартииТоваров.Остатки(&МоментВремени)
                    ГДЕ Номенклатура В (&СписокНом)
                      И Организация = &Организация
                      И ДокументПоступления = &ДокПоступления
                      И КоличествоОстаток > 0
                    УПОРЯДОЧИТЬ ПО ДатаПоставки";
    Запрос.УстановитьПараметр("СписокНом", СписокНом);
    Запрос.УстановитьПараметр("Организация", this.Организация);
    Запрос.УстановитьПараметр("ДокПоступления", this.Основание);
    Запрос.УстановитьПараметр("МоментВремени", this.МоментВремени());

    // 3. Кэш партий: ключ → массив остатков партии основания по порядку поставки.
    ПартииПоКлючу = Новый Соответствие;
    Для Каждого Стр Из Запрос.Выполнить() Цикл
      СуммаСНДС = ?(ЗначениеЗаполнено(Стр.СуммаСНДСОстаток) И Стр.СуммаСНДСОстаток <> 0, Стр.СуммаСНДСОстаток, Стр.СуммаОстаток);
      Ключ = УИДСсылки(Стр.НомИД) + "#" + УИДСсылки(Стр.СкладИД);
      Список = ПартииПоКлючу.Получить(Ключ);
      Если Список = Неопределено Тогда
        Список = Новый Массив;
        ПартииПоКлючу.Вставить(Ключ, Список);
      КонецЕсли;
      Список.Добавить(Новый Структура("ДатаПоставки, КоличествоОстаток, СуммаОстаток, СуммаСНДСОстаток",
        Стр.ДатаПоставки, Стр.КоличествоОстаток, Стр.СуммаОстаток, СуммаСНДС));
    КонецЦикла;

    // 4. Проверка достаточности партии основания
    РазрешитьОтриц = Ложь;
    Если ЗначениеЗаполнено(Константы.РазрешитьОтрицательныеОстатки) Тогда
      РазрешитьОтриц = Константы.РазрешитьОтрицательныеОстатки;
    КонецЕсли;

    Если РазрешитьОтриц = Ложь Тогда
      Для Каждого Строка Из this.Товары Цикл
        СкладСтроки = ?(ЗначениеЗаполнено(Строка.Склад), Строка.Склад, this.Склад);
        Ключ = УИДСсылки(Строка.Номенклатура) + "#" + УИДСсылки(СкладСтроки);
        Надо = ПотребностьПоКлючу.Получить(Ключ);
        Доступно = 0;
        Список = ПартииПоКлючу.Получить(Ключ);
        Если Список <> Неопределено Тогда
          Для Каждого П Из Список Цикл
            Доступно = Доступно + П.КоличествоОстаток;
          КонецЦикла;
        КонецЕсли;
        Если Доступно < Надо Тогда
          ВызватьИсключение("Недостаточно остатков партии поступления «"
            + Строка(this.Основание) + "» по «" + Строка(Строка.Номенклатура)
            + "» на складе «" + Строка(СкладСтроки) + "»: нужно " + Строка(Надо)
            + ", доступно " + Строка(Доступно) + ".");
        КонецЕсли;
      КонецЦикла;
    КонецЕсли;

    // Дата поставки партии основания, когда остатка нет (разрешён минус):
    // расход пишется в ключ той же партии, а не в строку с пустой датой.
    ДатаПоставкиОснования = ЗначениеРеквизитаОбъекта(this.Основание, "Дата");

    // 5. Движения по строкам: расход по партиям основания в порядке поставки.
    Для Каждого Строка Из this.Товары Цикл
      СкладСтроки = ?(ЗначениеЗаполнено(Строка.Склад), Строка.Склад, this.Склад);
      НеттоСтроки = НеттоСуммы(Строка.Сумма, Строка.СуммаНДС, this.СпособУчетаНДС);
      СуммаСНДСВозврата = Строка.Сумма;
      Если this.СпособУчетаНДС = "Сверху" Тогда
        СуммаСНДСВозврата = Строка.Сумма + Строка.СуммаНДС;
      КонецЕсли;

      Ключ = УИДСсылки(Строка.Номенклатура) + "#" + УИДСсылки(СкладСтроки);
      Список = ПартииПоКлючу.Получить(Ключ);
      ОстатокКСписанию = Строка.Количество;
      СебестоимостьСтроки = 0;
      СебестоимостьСтрокиСНДС = 0;
      Если Список <> Неопределено Тогда
        Для Каждого Партия Из Список Цикл
          Если ОстатокКСписанию <= 0 Тогда
            Прервать;
          КонецЕсли;
          Если Партия.КоличествоОстаток <= 0 Тогда
            Продолжить;
          КонецЕсли;
          Кол = Мин(ОстатокКСписанию, Партия.КоличествоОстаток);
          Если Кол = Партия.КоличествоОстаток Тогда
            СуммаЧасти = Партия.СуммаОстаток;
            СуммаЧастиСНДС = Партия.СуммаСНДСОстаток;
          Иначе
            СуммаЧасти = Окр(Кол * Партия.СуммаОстаток / Партия.КоличествоОстаток, 2);
            СуммаЧастиСНДС = Окр(Кол * Партия.СуммаСНДСОстаток / Партия.КоличествоОстаток, 2);
          КонецЕсли;
          Партия.КоличествоОстаток = Партия.КоличествоОстаток - Кол;
          Партия.СуммаОстаток = Партия.СуммаОстаток - СуммаЧасти;
          Партия.СуммаСНДСОстаток = Партия.СуммаСНДСОстаток - СуммаЧастиСНДС;
          ОстатокКСписанию = ОстатокКСписанию - Кол;
          СебестоимостьСтроки = СебестоимостьСтроки + СуммаЧасти;
          СебестоимостьСтрокиСНДС = СебестоимостьСтрокиСНДС + СуммаЧастиСНДС;

          ДвП = Движения.ПартииТоваров.Добавить();
          ДвП.ВидДвижения         = "Расход";
          ДвП.Номенклатура        = Строка.Номенклатура;
          ДвП.Склад               = СкладСтроки;
          ДвП.Организация         = this.Организация;
          ДвП.ДокументПоступления = this.Основание;
          ДвП.ДатаПоставки        = Партия.ДатаПоставки;
          ДвП.Количество          = Кол;
          ДвП.Сумма               = СуммаЧасти;
          ДвП.СуммаСНДС           = СуммаЧастиСНДС;
        КонецЦикла;
      КонецЕсли;

      // Остаток партии кончился (разрешён минус): хвост — по цене возврата,
      // в ключ партии основания.
      Если ОстатокКСписанию > 0 Тогда
        ДоляХвоста = ОстатокКСписанию / Строка.Количество;
        СуммаЧасти = Окр(НеттоСтроки * ДоляХвоста, 2);
        СуммаЧастиСНДС = Окр(СуммаСНДСВозврата * ДоляХвоста, 2);
        СебестоимостьСтроки = СебестоимостьСтроки + СуммаЧасти;
        СебестоимостьСтрокиСНДС = СебестоимостьСтрокиСНДС + СуммаЧастиСНДС;

        ДвП = Движения.ПартииТоваров.Добавить();
        ДвП.ВидДвижения         = "Расход";
        ДвП.Номенклатура        = Строка.Номенклатура;
        ДвП.Склад               = СкладСтроки;
        ДвП.Организация         = this.Организация;
        ДвП.ДокументПоступления = this.Основание;
        ДвП.ДатаПоставки        = ДатаПоставкиОснования;
        ДвП.Количество          = ОстатокКСписанию;
        ДвП.Сумма               = СуммаЧасти;
        ДвП.СуммаСНДС           = СуммаЧастиСНДС;
      КонецЕсли;

      // ОстаткиТоваров: списание со склада
      ДвО = Движения.ОстаткиТоваров.Добавить();
      ДвО.ВидДвижения  = "Расход";
      ДвО.Номенклатура = Строка.Номенклатура;
      ДвО.Склад        = СкладСтроки;
      ДвО.Организация  = this.Организация;
      ДвО.Количество   = Строка.Количество;
      ДвО.Сумма        = СебестоимостьСтроки;
      ДвО.СуммаСНДС    = СебестоимостьСтрокиСНДС;
    КонецЦикла;

  Иначе
    // ФИФО-списание себестоимости без привязки к конкретной партии
    ПроверитьСвободныйОстаток(this.Склад, this.Организация, this.Товары,
      Неопределено, this.МоментВремени());

    Результаты = СписатьТоварыФИФО(this.Склад, this.Организация, this.Товары,
      this.МоментВремени(), "возврата поставщику", Истина);

    Индекс = 0;
    Для Каждого Строка Из this.Товары Цикл
      Рез = Результаты[Индекс];
      Индекс = Индекс + 1;
      СкладСтроки = ?(ЗначениеЗаполнено(Строка.Склад), Строка.Склад, this.Склад);

      ДобавитьДвиженияПартий(Движения.ПартииТоваров, "Расход", Рез.ДвиженияПартий,
        Строка.Номенклатура, СкладСтроки, this.Организация);

      ДвО = Движения.ОстаткиТоваров.Добавить();
      ДвО.ВидДвижения  = "Расход";
      ДвО.Номенклатура = Строка.Номенклатура;
      ДвО.Склад        = СкладСтроки;
      ДвО.Организация  = this.Организация;
      ДвО.Количество   = Строка.Количество;
      ДвО.Сумма        = Рез.Себестоимость;
      ДвО.СуммаСНДС    = Рез.СебестоимостьСНДС;
    КонецЦикла;
  КонецЕсли;

  // 6. Взаиморасчёты: уменьшение долга поставщику
  ДвВз = Движения.Взаиморасчеты.Добавить();
  ДвВз.ВидДвижения         = "Приход";
  ДвВз.Контрагент          = this.Поставщик;
  ДвВз.Организация         = this.Организация;
  ДвВз.ТипКонтрагента      = "Поставщик";
  ДвВз.ДокументПоступления = this.Основание;
  ДвВз.Сумма               = this.Сумма;
КонецПроцедуры

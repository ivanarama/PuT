// Учитывает сумму и НДС каждой строки продажи и уже проведённых возвратов.
Функция ОстаткиДляВозврата(Реализация, ЭтотВозврат) Экспорт
  Продажа = Реализация.ПолучитьОбъект();
  Позиции = Новый Массив;
  Для Каждого Стр Из Продажа.Товары Цикл
    ЦенаСоСкидкой = ?(Стр.Количество > 0, Стр.Сумма / Стр.Количество, 0);
    Позиции.Добавить(Новый Структура("Номер, Товар, Цена, ЦенаСоСкидкой, Количество, Сумма, НДС",
      Позиции.Количество() + 1, УИДСсылки(Стр.Номенклатура), Стр.Цена, ЦенаСоСкидкой,
      Стр.Количество, Стр.Сумма, Стр.СуммаНДС + 0));
  КонецЦикла;

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Вр.Ссылка КАК ИД ИЗ Документ.ВозвратОтПокупателя КАК Вр
                  ГДЕ Вр.Основание = &Реализация И Вр.posted = Истина";
  Если ЗначениеЗаполнено(ЭтотВозврат) Тогда
    Запрос.Текст = Запрос.Текст + " И Вр.Ссылка <> &Этот";
    Запрос.УстановитьПараметр("Этот", ЭтотВозврат);
  КонецЕсли;
  Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО Вр.Дата, Вр.Ссылка";
  Запрос.УстановитьПараметр("Реализация", Реализация);
  Для Каждого Запись Из Запрос.Выполнить() Цикл
    Док = Документы.ВозвратОтПокупателя.НайтиПоИдентификатору(УИДСсылки(Запись.ИД)).ПолучитьОбъект();
    Для Каждого Стр Из Док.Товары Цикл
      РаспределитьВозвратПоСтрокам(Позиции, Стр, Истина);
    КонецЦикла;
  КонецЦикла;
  Возврат Позиции;
КонецФункции

// Номер исходной строки сохраняется при вводе на основании. Для старых
// документов сначала сопоставляем товар по цене, затем распределяем остаток
// количества между строками этой номенклатуры в порядке исходной продажи.
Процедура РаспределитьВозвратПоСтрокам(Позиции, Стр, УжеПроведён)
  Количество = Стр.Количество;
  Осталось = Количество;
  Товар = УИДСсылки(Стр.Номенклатура);
  Сумма = 0;
  НДС = 0;
  Для Проход = 1 По 2 Цикл
    Для Каждого Поз Из Позиции Цикл
      Если Осталось <= 0 Тогда Прервать; КонецЕсли;
      Если Поз.Товар <> Товар ИЛИ Поз.Количество <= 0 Тогда Продолжить; КонецЕсли;
      Если Стр.СтрокаРеализации > 0 Тогда
        Если Поз.Номер <> Стр.СтрокаРеализации Тогда Продолжить; КонецЕсли;
      ИначеЕсли Проход = 1 И Стр.Цена <> Поз.Цена И Окр(Стр.Цена, 2) <> Окр(Поз.ЦенаСоСкидкой, 2) Тогда
        Продолжить;
      КонецЕсли;
      Часть = Мин(Осталось, Поз.Количество);
      Если УжеПроведён Тогда
        // Вычитаем фактически сторнированные суммы с последней копейкой.
        СуммаЧасти = ?(Часть = Осталось, Стр.Сумма - Сумма, Окр(Стр.Сумма * Часть / Количество, 2));
        НДСЧасти = ?(Часть = Осталось, Стр.СуммаНДС - НДС, Окр(Стр.СуммаНДС * Часть / Количество, 2));
      Иначе
        СуммаЧасти = ?(Часть = Поз.Количество, Поз.Сумма, Окр(Поз.Сумма * Часть / Поз.Количество, 2));
        НДСЧасти = ?(Часть = Поз.Количество, Поз.НДС, Окр(Поз.НДС * Часть / Поз.Количество, 2));
      КонецЕсли;
      Поз.Количество = Окр(Поз.Количество - Часть, 2);
      Поз.Сумма = Окр(Поз.Сумма - СуммаЧасти, 2);
      Поз.НДС = Окр(Поз.НДС - НДСЧасти, 2);
      Если Поз.Сумма < 0 ИЛИ Поз.НДС < 0 Тогда
        ВызватьИсключение("По товару «" + Строка(Стр.Номенклатура) + "» уже возвращено больше стоимости строки реализации. Проверьте прежние возвраты.");
      КонецЕсли;
      Сумма = Сумма + СуммаЧасти;
      НДС = НДС + НДСЧасти;
      Осталось = Окр(Осталось - Часть, 2);
    КонецЦикла;
  КонецЦикла;
  Если Осталось > 0 Тогда
    ВызватьИсключение("По «" + Строка(Стр.Номенклатура) + "» возвращается больше, чем продано по строкам реализации с учётом прежних возвратов.");
  КонецЕсли;
  Если НЕ УжеПроведён Тогда
    Стр.Сумма = Окр(Сумма, 2);
    Стр.СуммаНДС = Окр(НДС, 2);
    Если Количество > 0 Тогда Стр.Цена = Стр.Сумма / Количество; КонецЕсли;
  КонецЕсли;
КонецПроцедуры

Процедура ПересчитатьВозвратПоРеализации(Док) Экспорт
  Позиции = ОстаткиДляВозврата(Док.Основание, Док.Ссылка);
  Док.СпособУчетаНДС = ЗначениеРеквизитаОбъекта(Док.Основание, "СпособУчетаНДС");
  СуммаСтрок = 0;
  НДС = 0;
  Для Каждого Стр Из Док.Товары Цикл
    РаспределитьВозвратПоСтрокам(Позиции, Стр, Ложь);
    СуммаСтрок = СуммаСтрок + Стр.Сумма;
    НДС = НДС + Стр.СуммаНДС;
  КонецЦикла;
  Док.СуммаНДС = НДС;
  Док.Сумма = ?(Док.СпособУчетаНДС = "Сверху", СуммаСтрок + НДС, СуммаСтрок);
  Док.СуммаБезНДС = Док.Сумма - НДС;
КонецПроцедуры

// Закрытый период и перепроведение для расчёта себестоимости:
// - дата запрета закрывает любое изменение документа — проведение, отмену
//   проведения, удаление и перенос даты из закрытого периода в открытый; день
//   запрета закрыт целиком;
// - перепроведение идёт сквозной хронологией: при группах по видам документов
//   перемещение, перепроведённое раньше более ранней продажи, забирало ту же
//   партию, что и она.
// Запуск:
//   onebase test --project . --sqlite <база> --run ЗакрытогоПериода

Функция НовыйСклад(Имя)
  Объект = Справочники.Склад.Создать();
  Объект.Наименование = Имя;
  Возврат Объект.Записать();
КонецФункции

Функция Поступление(Организация, Склад, Поставщик, Номенклатура, Количество, Цена, ДатаДокумента)
  Документ = Документы.ПоступлениеТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Поставщик = Поставщик;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = Количество;
  СтрокаТЧ.Цена = Цена;
  Документ.Провести();
  Возврат Документ.Ссылка;
КонецФункции

// Пустая строка — действие выполнено, иначе текст отказа.
Функция ПровестиПоступление(Ссылка, НоваяДата = Неопределено)
  Попытка
    Документ = Документы.ПоступлениеТоваров.НайтиПоИдентификатору(УИДСсылки(Ссылка)).ПолучитьОбъект();
    Если НоваяДата <> Неопределено Тогда
      Документ.Дата = НоваяДата;
    КонецЕсли;
    Документ.Провести();
    Возврат "";
  Исключение
    Возврат ОписаниеОшибки();
  КонецПопытки;
КонецФункции

Функция ОтменитьПроведениеПоступления(Ссылка)
  Попытка
    Документы.ПоступлениеТоваров.ОтменитьПроведение(Ссылка);
    Возврат "";
  Исключение
    Возврат ОписаниеОшибки();
  КонецПопытки;
КонецФункции

Функция УдалитьПоступление(Ссылка)
  Попытка
    Документы.ПоступлениеТоваров.Удалить(Ссылка);
    Возврат "";
  Исключение
    Возврат ОписаниеОшибки();
  КонецПопытки;
КонецФункции

Функция ОтрицательныхПартий(Номенклатура)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ КоличествоОстаток ИЗ РегистрНакопления.ПартииТоваров.Остатки()
                  ГДЕ Номенклатура = &Ном И КоличествоОстаток < 0";
  Запрос.УстановитьПараметр("Ном", Номенклатура);
  Всего = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Всего = Всего + 1;
  КонецЦикла;
  Возврат Всего;
КонецФункции

Функция Остаток(ИмяРегистра, Номенклатура, Склад)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ КоличествоОстаток ИЗ РегистрНакопления." + ИмяРегистра + ".Остатки()
                  ГДЕ Номенклатура = &Ном И Склад = &Склад";
  Запрос.УстановитьПараметр("Ном", Номенклатура);
  Запрос.УстановитьПараметр("Склад", Склад);
  Итог = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Итог = Итог + Стр.КоличествоОстаток;
  КонецЦикла;
  Возврат Итог;
КонецФункции

Процедура Выполнить()
  Орг = Справочники.Организация.Создать();
  Орг.Наименование = "Тест закрытия: организация";
  Организация = Орг.Записать();
  Пост = Справочники.Контрагент.Создать();
  Пост.Наименование = "Тест закрытия: поставщик";
  Пост.Вид = "Поставщик";
  Поставщик = Пост.Записать();
  Пок = Справочники.Контрагент.Создать();
  Пок.Наименование = "Тест закрытия: покупатель";
  Пок.Вид = "Покупатель";
  Покупатель = Пок.Записать();
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест закрытия: товар";
  Номенклатура = Ном.Записать();
  Склад1 = НовыйСклад("Тест закрытия: склад 1");
  Склад2 = НовыйСклад("Тест закрытия: склад 2");

  // ── 1. Хронологическое перепроведение ─────────────────────────────────
  Р1 = Поступление(Организация, Склад1, Поставщик, Номенклатура, 10, 100, Дата(2026, 9, 10, 11, 0, 0));
  Поступление(Организация, Склад1, Поставщик, Номенклатура, 10, 200, Дата(2026, 9, 10, 12, 0, 0));

  Продажа = Документы.РеализацияТоваров.Создать();
  Продажа.Дата = Дата(2026, 9, 11, 10, 0, 0);
  Продажа.Организация = Организация;
  Продажа.Покупатель = Покупатель;
  Продажа.Склад = Склад1;
  СтрокаТЧ = Продажа.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = 10;
  СтрокаТЧ.Цена = 300;
  Продажа.Провести();

  Перемещение = Документы.ПеремещениеТоваров.Создать();
  Перемещение.Дата = Дата(2026, 9, 12, 10, 0, 0);
  Перемещение.Организация = Организация;
  Перемещение.СкладОтправитель = Склад1;
  Перемещение.СкладПолучатель = Склад2;
  СтрокаТЧ = Перемещение.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = 10;
  Перемещение.Провести();

  // Первое поступление перенесли на время после продажи: продажа списала
  // партию, которой на её момент уже нет. Партии рассогласованы, пока
  // документы не перепроведут.
  Утверждать.Равно(ПровестиПоступление(Р1, Дата(2026, 9, 11, 12, 0, 0)), "", "поступление перенесено на более позднее время");
  Утверждать.Истина(ОтрицательныхПартий(Номенклатура) > 0, "до перепроведения партии рассогласованы");

  Итоги = ПерепровестиДокументыХронологически(Дата(2026, 9, 10), Дата(2026, 9, 12), Организация);
  Утверждать.Равно(Итоги.Ошибок, 0, "перепроведение без ошибок");
  Утверждать.Равно(ОтрицательныхПартий(Номенклатура), 0, "после перепроведения отрицательных партий нет");
  Утверждать.Равно(Остаток("ПартииТоваров", Номенклатура, Склад1), Остаток("ОстаткиТоваров", Номенклатура, Склад1),
    "склад 1: партии равны остатку");
  Утверждать.Равно(Остаток("ПартииТоваров", Номенклатура, Склад2), 10, "склад 2: перемещённая партия");

  // ── 2. Закрытый период ────────────────────────────────────────────────
  Закрытый = Поступление(Организация, Склад1, Поставщик, Номенклатура, 1, 100, Дата(2026, 8, 15, 10, 0, 0));
  Константы.ДатаЗапретаРедактирования = Дата(2026, 8, 31);

  Утверждать.Истина(СтрНайти(ПровестиПоступление(Закрытый), "закрытый период") > 0, "перепроведение в закрытом периоде отклонено");
  Утверждать.Истина(СтрНайти(ОтменитьПроведениеПоступления(Закрытый), "закрытый период") > 0, "отмена проведения в закрытом периоде отклонена");
  Утверждать.Истина(СтрНайти(УдалитьПоступление(Закрытый), "закрытый период") > 0, "удаление документа закрытого периода отклонено");
  Утверждать.Истина(СтрНайти(ПровестиПоступление(Закрытый, Дата(2026, 9, 5, 10, 0, 0)), "закрытый период") > 0,
    "перенос документа из закрытого периода в открытый отклонён");

  Отказ = "";
  Попытка
    Поступление(Организация, Склад1, Поставщик, Номенклатура, 1, 100, Дата(2026, 8, 31, 15, 0, 0));
  Исключение
    Отказ = ОписаниеОшибки();
  КонецПопытки;
  Утверждать.Истина(СтрНайти(Отказ, "закрытый период") > 0, "день запрета закрыт целиком, включая 15:00");

  Утверждать.Равно(ПровестиПоступление(Поступление(Организация, Склад1, Поставщик, Номенклатура, 1, 100,
    Дата(2026, 9, 1, 10, 0, 0))), "", "первый день после запрета открыт");
КонецПроцедуры

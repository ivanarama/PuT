// Модуль объекта ТипЦен

Процедура ПередЗаписью() Экспорт
  Если this.ВидРасчета = "Расчетный" Тогда
    Если ЗначениеЗаполнено(this.БазовыйТип) И this.БазовыйТип = this.Ссылка Тогда
      ВызватьИсключение("Тип цен не может быть базовым для самого себя.");
    КонецЕсли;
  КонецЕсли;
КонецПроцедуры

Функция ОбработатьБанковскуюВыписку(ТекстВыгрузки, Счёт, Формат, Действие, ВыбраннаяОрганизация = Неопределено, Источник = "", Загрузка = Неопределено) Экспорт
  Запись = Действие = "Записать" ИЛИ Действие = "ЗаписатьИПровести";
  Если Запись И НЕ ЗначениеЗаполнено(Загрузка) Тогда Загрузка = НачатьЗагрузкуОбмена("Банк", Источник); КонецЕсли;
  Попытка
    Возврат РазобратьИОбработатьВыписку(ТекстВыгрузки, Счёт, Формат, Действие, ВыбраннаяОрганизация, Загрузка);
  Исключение
    Ошибка = ОписаниеОшибки();
    Если Запись Тогда ЗаписатьИсториюОбмена("Банк", "Файл выписки", "Ошибка", Ошибка, "", "", "", Загрузка); КонецЕсли;
    ВызватьИсключение(Ошибка);
  КонецПопытки;
КонецФункции

Функция РазобратьИОбработатьВыписку(ТекстВыгрузки, Счёт, Формат, Действие, ВыбраннаяОрганизация, Загрузка)
  Если НЕ ЗначениеЗаполнено(Счёт) Тогда ВызватьИсключение("Укажите банковский счёт"); КонецЕсли;
  Если ТипЗнч(Счёт) = Тип("Строка") Тогда Счёт = Справочники.Касса.НайтиПоИдентификатору(Счёт); КонецЕсли;
  Если НЕ ЗначениеЗаполнено(Счёт) Тогда ВызватьИсключение("Банковский счёт не найден"); КонецЕсли;
  Если НЕ ЗначениеЗаполнено(ТекстВыгрузки) Тогда ВызватьИсключение("Выберите файл выписки"); КонецЕсли;
  Текст = СокрЛП(ТекстВыгрузки);
  Строки = СтрРазделить(СтрЗаменить(Текст, Символ(13), ""), Символ(10));
  Если НЕ ЗначениеЗаполнено(Формат) ИЛИ Формат = "Авто" Тогда Формат = ОпределитьФормат(Строки); КонецЕсли;
  Если Формат = "JSON" Тогда
    Платежи = Новый Массив;
    Для Каждого СтрJSON Из ReadJSON(Текст) Цикл
      Платёж = Новый Структура;
      Для Каждого Поле Из СтрJSON Цикл Платёж.Вставить(Поле.Ключ, Поле.Значение); КонецЦикла;
      Если НЕ Платёж.Свойство("НазначениеПлатежа") Тогда Платёж.Вставить("НазначениеПлатежа", ""); КонецЕсли;
      Платежи.Добавить(Платёж);
    КонецЦикла;
  ИначеЕсли Формат = "1CClientBankExchange" Тогда
    Разбор = Разобрать1CClientBankExchange(Строки, ЗначениеРеквизитаОбъекта(Счёт, "НомерСчёта"));
    Платежи = Разбор.Платежи;
  Иначе
    ВызватьИсключение("Неизвестный формат выписки");
  КонецЕсли;
  Если НЕ ЗначениеЗаполнено(Действие) ИЛИ Действие = "Предпросмотр" Тогда Возврат ПостроитьПредпросмотр(Платежи); КонецЕсли;
  Если Действие <> "Записать" И Действие <> "ЗаписатьИПровести" Тогда ВызватьИсключение("Неизвестное действие выписки"); КонецЕсли;
  Организация = ОрганизацияБанковскойВыписки(ВыбраннаяОрганизация, Счёт);
  Итоги = Новый Структура("Поступлений, Списаний, Проведено, Пропущено, Ошибки", 0, 0, 0, 0, Новый Массив);
  Для Каждого Платёж Из Платежи Цикл
    ИмпортироватьБанковскийПлатёж(Счёт, Организация, Платёж, Действие, Итоги, Загрузка);
  КонецЦикла;
  Возврат Итоги;
КонецФункции

Функция ОрганизацияБанковскойВыписки(Выбор, Счёт)
  Если ТипЗнч(Выбор) = Тип("Строка") И ЗначениеЗаполнено(Выбор) Тогда
    Выбор = Справочники.Организация.НайтиПоИдентификатору(Выбор);
    Если НЕ ЗначениеЗаполнено(Выбор) Тогда ВызватьИсключение("Выбранная организация не найдена"); КонецЕсли;
  КонецЕсли;
  НомерСчёта = ЗначениеРеквизитаОбъекта(Счёт, "НомерСчёта");
  Запрос = Новый Запрос;
  Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 О.Ссылка КАК Ид ИЗ Справочник.Организация КАК О ГДЕ О.deletion_mark = Ложь";
  Если ЗначениеЗаполнено(НомерСчёта) Тогда
    Запрос.Текст = Текст + " И О.РасчётныйСчёт = &Счёт";
    Запрос.УстановитьПараметр("Счёт", НомерСчёта);
    Найдены = Запрос.Выполнить();
    Если Найдены.Количество() = 1 Тогда
      Владелец = Найдены[0].Ид;
      Если ЗначениеЗаполнено(Выбор) И УИДСсылки(Выбор) <> УИДСсылки(Владелец) Тогда ВызватьИсключение("Банковский счёт указан в карточке другой организации"); КонецЕсли;
      Возврат Справочники.Организация.НайтиПоИдентификатору(УИДСсылки(Владелец));
    КонецЕсли;
  КонецЕсли;
  Если ЗначениеЗаполнено(Выбор) Тогда Возврат Выбор; КонецЕсли;
  Запрос.Текст = Текст;
  Найдены = Запрос.Выполнить();
  Если Найдены.Количество() <> 1 Тогда ВызватьИсключение("Укажите организацию для банковской выписки"); КонецЕсли;
  Возврат Справочники.Организация.НайтиПоИдентификатору(УИДСсылки(Найдены[0].Ид));
КонецФункции

Процедура ИмпортироватьБанковскийПлатёж(Счёт, Организация, Платёж, Действие, Итоги, Загрузка, ПовторПослеГонки = Ложь)
  Название = "";
  Ключ = ""; Повтор = Ложь;
  Попытка
    НачатьТранзакцию();
    Блок = БлокировкаДанных();
    Элемент = Блок.Добавить("ДенежныеСредства");
    Элемент.УстановитьЗначение("Касса", УИДСсылки(Счёт));
    Блок.Заблокировать();
    ТипПлатежа = Платёж.Тип;
    Если ТипПлатежа = "Поступление" Тогда
      ВидДок = "ПоступлениеНаРасчётныйСчёт";
      Менеджер = Документы.ПоступлениеНаРасчётныйСчёт;
    ИначеЕсли ТипПлатежа = "Списание" Тогда
      ВидДок = "СписаниеСРасчётногоСчёта";
      Менеджер = Документы.СписаниеСРасчётногоСчёта;
    Иначе
      ВызватьИсключение("Неизвестное направление платежа");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Платёж.Контрагент) ИЛИ НЕ ЗначениеЗаполнено(Платёж.Дата) ИЛИ Платёж.Сумма <= 0 Тогда
      ВызватьИсключение("Для платежа нужны дата, контрагент и положительная сумма");
    КонецЕсли;
    Номер = ?(Платёж.Свойство("НомерПлатёжки"), СокрЛП(Строка(Платёж.НомерПлатёжки)), "");
    ДатаПлатежа = Дата(Платёж.Дата);
    Название = ТипПлатежа + " " + Номер + " от " + Формат(ДатаПлатежа, "ДФ=yyyy-MM-dd");
    Имя = СокрЛП(Платёж.Контрагент);
    Если НЕ Платёж.Свойство("НазначениеПлатежа") Тогда Платёж.Вставить("НазначениеПлатежа", ""); КонецЕсли;
    Ключ = УИДСсылки(Счёт) + "." + Формат(ДатаПлатежа, "ДФ=yyyyMMdd") + "." + Base64Строка(Имя) + "." + Base64Строка(Номер);
    Если Номер = "" Тогда Ключ = Ключ + "." + Строка(Платёж.Сумма) + "." + Base64Строка(Платёж.НазначениеПлатежа); КонецЕсли;
    Ключ = УИДСсылки(Организация) + "." + Ключ;
    Ссылка = Менеджер.НайтиПоРеквизиту("КлючИмпортаБанка", Ключ);
    Контрагент = Справочники.Контрагент.НайтиПоНаименованию(Имя);
    Если НЕ ЗначениеЗаполнено(Ссылка) И ЗначениеЗаполнено(Контрагент) Тогда
      Запрос = Новый Запрос;
      Запрос.Текст = "ВЫБРАТЬ Ссылка КАК Ид ИЗ Документ." + ВидДок + " ГДЕ (Организация = &Организация ИЛИ Организация ЕСТЬ NULL) И БанковскийСчёт = &Счёт И Дата >= &Начало И Дата <= &Конец И Контрагент = &Контрагент";
      Если Номер <> "" Тогда
        Запрос.Текст = Запрос.Текст + " И НомерПлатёжки = &Номер";
        Запрос.УстановитьПараметр("Номер", Номер);
      Иначе
        Запрос.Текст = Запрос.Текст + " И (НомерПлатёжки ЕСТЬ NULL ИЛИ НомерПлатёжки = &Пусто) И Сумма = &Сумма И НазначениеПлатежа = &Назначение";
        Запрос.УстановитьПараметр("Пусто", "");
        Запрос.УстановитьПараметр("Сумма", Платёж.Сумма);
        Запрос.УстановитьПараметр("Назначение", Платёж.НазначениеПлатежа);
      КонецЕсли;
      Запрос.УстановитьПараметр("Счёт", Счёт);
      Запрос.УстановитьПараметр("Организация", Организация);
      Запрос.УстановитьПараметр("Начало", НачалоДня(ДатаПлатежа));
      Запрос.УстановитьПараметр("Конец", КонецДня(ДатаПлатежа));
      Запрос.УстановитьПараметр("Контрагент", Контрагент);
      Строки = Запрос.Выполнить();
      Если Строки.Количество() > 1 Тогда ВызватьИсключение("Несколько документов соответствуют платёжке. Сверьте ранее созданные документы"); КонецЕсли;
      Если Строки.Количество() = 1 Тогда Ссылка = Менеджер.НайтиПоИдентификатору(УИДСсылки(Строки[0].Ид)); КонецЕсли;
    КонецЕсли;
    Повтор = ЗначениеЗаполнено(Ссылка);
    Если Повтор Тогда
      Док = Ссылка.ПолучитьОбъект();
      Если НЕ ЗначениеЗаполнено(Док.Организация) Тогда ВызватьИсключение("У ранее записанной платёжки не указана организация. Сначала сверьте документ"); КонецЕсли;
      Если Док.Сумма <> Платёж.Сумма ИЛИ Док.ПометкаУдаления Тогда ВызватьИсключение("Платёжка совпала с изменённым или удалённым документом. Требуется сверка"); КонецЕсли;
    Иначе
      Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
        НовыйКонтрагент = Справочники.Контрагент.Создать();
        НовыйКонтрагент.Наименование = Имя; НовыйКонтрагент.Записать(); Контрагент = НовыйКонтрагент.Ссылка;
      КонецЕсли;
      Док = Менеджер.Создать();
      Док.Организация = Организация;
      Док.БанковскийСчёт = Счёт; Док.Контрагент = Контрагент;
      Док.Дата = ДатаПлатежа; Док.Сумма = Платёж.Сумма; Док.НомерПлатёжки = Номер;
      Док.КлючИмпортаБанка = Ключ; Док.НазначениеПлатежа = Платёж.НазначениеПлатежа;
      Если Платёж.Свойство("ДатаПлатёжки") Тогда Док.ДатаПлатёжки = Платёж.ДатаПлатёжки; КонецЕсли;
      Док.Записать();
    КонецЕсли;
    Проведено = Действие = "ЗаписатьИПровести" И НЕ Док.Проведён;
    Если Проведено Тогда Док.Провести(); КонецЕсли;
    Состояние = ?(Повтор И НЕ Проведено, "Пропущено", "Выполнено");
    ЗаписатьИсториюОбмена("Банк", Название, Состояние, Строка(Док.Номер), "", "", "", Загрузка);
    ЗафиксироватьТранзакцию();
    Если Повтор Тогда
      Итоги.Пропущено = Итоги.Пропущено + 1;
    ИначеЕсли ТипПлатежа = "Поступление" Тогда
      Итоги.Поступлений = Итоги.Поступлений + 1;
    Иначе
      Итоги.Списаний = Итоги.Списаний + 1;
    КонецЕсли;
    Если Проведено Тогда Итоги.Проведено = Итоги.Проведено + 1; КонецЕсли;
  Исключение
    Ошибка = ОписаниеОшибки();
    ОтменитьТранзакцию();
    Если НЕ ПовторПослеГонки И НЕ Повтор И ЗначениеЗаполнено(Ключ) Тогда
      Если ЗначениеЗаполнено(Менеджер.НайтиПоРеквизиту("КлючИмпортаБанка", Ключ)) Тогда
        ИмпортироватьБанковскийПлатёж(Счёт, Организация, Платёж, Действие, Итоги, Загрузка, Истина);
        Возврат;
      КонецЕсли;
    КонецЕсли;
    Платёж.Вставить("ОрганизацияИмпорта", УИДСсылки(Организация));
    Итоги.Ошибки.Добавить(Ошибка);
    ЗаписатьИсториюОбмена("Банк", Название, "Ошибка", Ошибка, УИДСсылки(Счёт), Действие, ЗаписатьJSON(Платёж), Загрузка);
  КонецПопытки;
КонецПроцедуры

Функция ПостроитьПредпросмотр(Платежи)
  Результат = Новый Структура;
  СуммаПоступлений = 0;
  СуммаСписаний = 0;
  КолПоступлений = 0;
  КолСписаний = 0;
  МинДата = "";
  МаксДата = "";

  Детали = Новый Массив;
  Для Каждого Платёж Из Платежи Цикл
    Строка = Новый Структура;
    Строка.Дата = Платёж.Дата;
    Строка.Тип = Платёж.Тип;
    Строка.Контрагент = Платёж.Контрагент;
    Строка.Сумма = Платёж.Сумма;
    Строка.НазначениеПлатежа = Платёж.НазначениеПлатежа;
    Если Платёж.Свойство("НомерПлатёжки") И Платёж.НомерПлатёжки <> "" Тогда
      Строка.Номер = Платёж.НомерПлатёжки;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Справочники.Контрагент.НайтиПоНаименованию(Платёж.Контрагент)) Тогда
      Строка.Ошибка = "Новый контрагент";
    КонецЕсли;
    Детали.Добавить(Строка);

    Если Платёж.Тип = "Поступление" Тогда
      КолПоступлений = КолПоступлений + 1;
      СуммаПоступлений = СуммаПоступлений + Платёж.Сумма;
    ИначеЕсли Платёж.Тип = "Списание" Тогда
      КолСписаний = КолСписаний + 1;
      СуммаСписаний = СуммаСписаний + Платёж.Сумма;
    КонецЕсли;

    Если МинДата = "" ИЛИ Платёж.Дата < МинДата Тогда
      МинДата = Платёж.Дата;
    КонецЕсли;
    Если МаксДата = "" ИЛИ Платёж.Дата > МаксДата Тогда
      МаксДата = Платёж.Дата;
    КонецЕсли;
  КонецЦикла;

  Результат.ПериодС = МинДата;
  Результат.ПериодПо = МаксДата;
  Результат.Поступлений = КолПоступлений;
  Результат.СуммаПоступлений = СуммаПоступлений;
  Результат.Списаний = КолСписаний;
  Результат.СуммаСписаний = СуммаСписаний;
  Результат.Всего = Платежи.Количество();
  Результат.Платежи = Детали;
  Возврат Результат;
КонецФункции

Функция ОпределитьФормат(Строки)
  Если Строки.Количество() = 0 Тогда
    Возврат "JSON";
  КонецЕсли;
  ПерваяСтрока = СокрЛП(Строки[0]);
  Если СтрНачинаетсяС(ПерваяСтрока, "1CClientBankExchange") Тогда
    Возврат "1CClientBankExchange";
  КонецЕсли;
  Возврат "JSON";
КонецФункции

// Парсер формата 1CClientBankExchange.
// Определяет поступление/списание по совпадению ПлательщикСчет с РасчСчет заголовка.
// Контрагент = Плательщик (для поступлений) или Получатель (для списаний).
// НазначениеПлатежа склеивается из НазначениеПлатежа + НазначениеПлатежа1 + ... + НазначениеПлатежаN.
// Возвращает структуру: Платежи (массив) + РасчСчет (строка из файла).

Функция Разобрать1CClientBankExchange(Строки, НомерСчёта)
  НашСчёт = "";
  ЧислоСтрок = Строки.Количество();

  // Ищем РасчСчет в заголовке (до секций документов)
  Для Ном = 0 По ЧислоСтрок - 1 Цикл
    Стр = СокрЛП(Строки[Ном]);
    Если СтрНачинаетсяС(Стр, "РасчСчет=") Тогда
      НашСчёт = СокрЛП(Сред(Стр, 10));
      Прервать;
    КонецЕсли;
    Если СтрНачинаетсяС(Стр, "СекцияДокумент") Тогда
      Прервать;
    КонецЕсли;
  КонецЦикла;

  Платежи = Новый Массив;
  ВДокументе = Ложь;
  Платёж = Неопределено;

  Для Ном = 0 По ЧислоСтрок - 1 Цикл
    Стр = СокрЛП(Строки[Ном]);

    Если СтрНачинаетсяС(Стр, "СекцияДокумент") Тогда
      ВДокументе = Истина;
      Платёж = Новый Структура;
      Платёж.НазначениеПлатежа = "";
      Платёж.НомерПлатёжки = "";
      Платёж.Плательщик = "";
      Платёж.Получатель = "";
      Платёж.ПлательщикСчет = "";
      Платёж.ПолучательСчет = "";
      Продолжить;
    КонецЕсли;

    Если СтрНачинаетсяС(Стр, "КонецДокумента") Тогда
      Если Платёж <> Неопределено Тогда
        Платежи.Добавить(Платёж);
      КонецЕсли;
      ВДокументе = Ложь;
      Платёж = Неопределено;
      Продолжить;
    КонецЕсли;

    Если ВДокументе = Ложь Тогда
      Продолжить;
    КонецЕсли;

    ПозРавно = СтрНайти(Стр, "=");
    Если ПозРавно = 0 Тогда
      Продолжить;
    КонецЕсли;

    Ключ = Лев(Стр, ПозРавно - 1);
    Значение = Сред(Стр, ПозРавно + 1);

    Если Ключ = "Номер" Тогда
      Платёж.НомерПлатёжки = Значение;
    ИначеЕсли Ключ = "Дата" Тогда
      Платёж.Дата = Сред(Значение, 7, 4) + "-" + Сред(Значение, 4, 2) + "-" + Лев(Значение, 2);
    ИначеЕсли Ключ = "Сумма" Тогда
      Платёж.Сумма = Число(Значение);
    ИначеЕсли Ключ = "ПлательщикСчет" Тогда
      Платёж.ПлательщикСчет = Значение;
    ИначеЕсли Ключ = "ПолучательСчет" Тогда
      Платёж.ПолучательСчет = Значение;
    ИначеЕсли Ключ = "Получатель" Тогда
      Платёж.Получатель = Значение;
    ИначеЕсли Ключ = "Плательщик" Тогда
      Платёж.Плательщик = Значение;
    ИначеЕсли СтрНачинаетсяС(Ключ, "НазначениеПлатежа") Тогда
      Если Платёж.НазначениеПлатежа = "" Тогда
        Платёж.НазначениеПлатежа = Значение;
      Иначе
        Платёж.НазначениеПлатежа = Платёж.НазначениеПлатежа + " " + Значение;
      КонецЕсли;
    КонецЕсли;
  КонецЦикла;

  Если ЗначениеЗаполнено(НомерСчёта) Тогда
    Если НашСчёт <> "" И НашСчёт <> НомерСчёта Тогда
      ВызватьИсключение("Счёт в выписке не совпадает с выбранным банковским счётом");
    КонецЕсли;
    НашСчёт = НомерСчёта;
  КонецЕсли;
  Если НашСчёт = "" Тогда ВызватьИсключение("В выписке и карточке не указан расчётный счёт"); КонецЕсли;

  // Определяем тип и контрагента для каждого платежа
  Для Каждого Платёж Из Платежи Цикл
    Если Платёж.ПлательщикСчет = НашСчёт Тогда
      Платёж.Тип = "Списание";
      Платёж.Контрагент = Платёж.Получатель;
    ИначеЕсли Платёж.ПолучательСчет = НашСчёт Тогда
      Платёж.Тип = "Поступление";
      Платёж.Контрагент = Платёж.Плательщик;
    Иначе
      ВызватьИсключение("Платёж не относится к выбранному банковскому счёту");
    КонецЕсли;
  КонецЦикла;

  Результат = Новый Структура;
  Результат.Платежи = Платежи;
  Результат.РасчСчет = НашСчёт;
  Возврат Результат;
КонецФункции

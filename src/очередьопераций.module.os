// При занятом ключе платформа возвращает ранее поставленную задачу.
// Сверяем параметры прежде, чем показывать оператору её номер.
Функция ПоставитьОперациюПуТ(Имя, ПараметрыОперации, Ключ) Экспорт
  Номер = ФоновыеЗадания.Поставить(Имя, ПараметрыОперации, Ключ);
  Задача = ФоновыеЗадания.Задача(Номер);
  Если Задача = Неопределено Тогда
    ВызватьИсключение("Не удалось прочитать поставленное задание.");
  КонецЕсли;
  Если ЗаписатьJSON(Задача.Параметры) <> ЗаписатьJSON(ПараметрыОперации) Тогда
    ВызватьИсключение("Эта обработка занята заданием с другими параметрами. Ваш запрос не поставлен. Повторите после завершения задания.");
  КонецЕсли;
  Возврат Номер;
КонецФункции

// Проведение поступления:
//   - Каждая строка создаёт партию (Номенклатура, Склад, Организация,
//     ДатаПоставки = Дата документа) и запись остатков.
//   - Себестоимость (Остатки/Партии) и закупочная цена пишутся БЕЗ НДС:
//     при способе «в том числе» НДС вычитается из строки.
//   - В ЦеныНоменклатуры пишется только нетто-Закупочная; расчётные типы
//     вычисляются на лету в утилиты.ПолучитьЦену по цепочке БазовыйТип.
//   - Взаиморасчёты с поставщиком — одной строкой на итог С НДС (this.Сумма).

Процедура ОбработкаПроведения()
  ПроверитьЗакрытыйПериод(this);

  ПроверитьРеквизитШапки(this.Поставщик, "Поставщик");
  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.ОстаткиТоваров.Очистить();
  Движения.Взаиморасчеты.Очистить();
  Движения.ПартииТоваров.Очистить();
  Движения.ЦеныНоменклатуры.Очистить();
  Движения.ТоварыВПути.Очистить();

  ТипЗакупочной = Справочники.ТипЦен.Закупочная;
  Если ЗначениеЗаполнено(ТипЗакупочной) = Ложь Тогда
    ТипЗакупочной = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");
  КонецЕсли;
  Если ЗначениеЗаполнено(ТипЗакупочной) = Ложь Тогда
    Error("Не найден тип цен «Закупочная». Запустите обработку «Настройка типов цен».");
  КонецЕсли;

  ПроверитьЗаполнениеСтрокТоваров(this.Товары, "Товары", Ложь);

  Для Каждого Строка Из this.Товары Цикл
    Строка.Сумма = Строка.Количество * Строка.Цена;

    Если ЗначениеЗаполнено(Строка.СуммаНДС) = Ложь Тогда
      Строка.СуммаНДС = 0;
    КонецЕсли;

    НеттоСтроки = НеттоСуммы(Строка.Сумма, Строка.СуммаНДС, this.СпособУчетаНДС);
    НеттоЦена   = ?(Строка.Количество > 0, Окр(НеттоСтроки / Строка.Количество, 2), 0);
    Если this.СпособУчетаНДС = "Сверху" Тогда
      НеттоЦена = Строка.Цена;
    КонецЕсли;

    СуммаСНДС = Строка.Сумма;
    Если this.СпособУчетаНДС = "Сверху" Тогда
      СуммаСНДС = Строка.Сумма + Строка.СуммаНДС;
    КонецЕсли;

    СкладСтроки = ?(ЗначениеЗаполнено(Строка.Склад), Строка.Склад, this.Склад);

    ДвО = Движения.ОстаткиТоваров.Добавить();
    ДвО.ВидДвижения  = "Приход";
    ДвО.Номенклатура = Строка.Номенклатура;
    ДвО.Склад        = СкладСтроки;
    ДвО.Организация  = this.Организация;
    ДвО.Количество   = Строка.Количество;
    ДвО.Сумма        = НеттоСтроки;
    ДвО.СуммаСНДС    = СуммаСНДС;

    ДвП = Движения.ПартииТоваров.Добавить();
    ДвП.ВидДвижения  = "Приход";
    ДвП.Номенклатура = Строка.Номенклатура;
    ДвП.Склад        = СкладСтроки;
    ДвП.Организация  = this.Организация;
    ДвП.ДокументПоступления = this;
    ДвП.ДатаПоставки = this.Дата;
    ДвП.Количество   = Строка.Количество;
    ДвП.Сумма        = НеттоСтроки;
    ДвП.СуммаСНДС    = СуммаСНДС;

    // У регистра сведений одна запись на ключ (дата, номенклатура, тип цен).
    // Второе поступление того же дня забирало запись первого, а отмена его
    // проведения удаляла цену совсем. Цену дня задаёт первый документ; ключ,
    // занятый другим документом, не перезаписывается.
    Если КлючЦеныЗанятДругим(this.Дата, Строка.Номенклатура, ТипЗакупочной) Тогда
      Сообщить("Закупочная цена «" + Строка(Строка.Номенклатура) + "» на "
        + Формат(this.Дата, "ДФ=dd.MM.yyyy HH:mm") + " уже установлена другим документом — не перезаписывается.");
    Иначе
      ДвЦ = Движения.ЦеныНоменклатуры.Добавить();
      ДвЦ.Период       = this.Дата;
      ДвЦ.Номенклатура = Строка.Номенклатура;
      ДвЦ.ТипЦен       = ТипЗакупочной;
      ДвЦ.Цена         = НеттоЦена;
    КонецЕсли;
  КонецЦикла;

  ДвВз = Движения.Взаиморасчеты.Добавить();
  ДвВз.ВидДвижения        = "Расход";
  ДвВз.Контрагент         = this.Поставщик;
  ДвВз.Организация        = this.Организация;
  ДвВз.ТипКонтрагента     = "Поставщик";
  ДвВз.ДокументПоступления = this;
  ДвВз.Сумма              = this.Сумма;

  // Снять ожидание товаров в пути (если указан заказ)
  Если ЗначениеЗаполнено(this.ЗаказПоставщику) Тогда
    // Проверка: количество поступления не должно превышать заказанное
    ЗапросЛим = Новый Запрос;
    ЗапросЛим.Текст = "ВЫБРАТЬ
                        Номенклатура.Ссылка КАК НомИД,
                        Номенклатура,
                        КоличествоОстаток КАК Осталось
                      ИЗ РегистрНакопления.ТоварыВПути.Остатки(&МоментВремени)
                      ГДЕ ЗаказПоставщику = &Заказ
                        И Склад = &Склад";
    ЗапросЛим.УстановитьПараметр("Заказ", this.ЗаказПоставщику);
    ЗапросЛим.УстановитьПараметр("Склад", this.Склад);
    ЗапросЛим.УстановитьПараметр("МоментВремени", this.МоментВремени());

    ОстаткиЗаказа = Новый Соответствие;
    Для Каждого СтрЛим Из ЗапросЛим.Выполнить() Цикл
      Ключ = утилиты.УИДНоменклатуры(СтрЛим.НомИД);
      Тек = ОстаткиЗаказа.Получить(Ключ);
      Если Тек = Неопределено Тогда
        Тек = 0;
      КонецЕсли;
      ОстаткиЗаказа.Вставить(Ключ, Тек + СтрЛим.Осталось);
    КонецЦикла;

    Для Каждого Строка Из this.Товары Цикл
      НеттоСтроки = НеттоСуммы(Строка.Сумма, Строка.СуммаНДС, this.СпособУчетаНДС);

      Ключ = утилиты.УИДНоменклатуры(Строка.Номенклатура);

      // Проверка лимита: строка относится к заказу, только если номенклатура была в заказе
      ОсталосьВПути = ОстаткиЗаказа.Получить(Ключ);
      Если ОсталосьВПути = Неопределено ИЛИ ОсталосьВПути <= 0 Тогда
        // Товар не ожидался по данному заказу поставщику (сверх заказа) — не списываем ТоварыВПути
        Продолжить;
      КонецЕсли;

      Если Строка.Количество > ОсталосьВПути Тогда
        ВызватьИсключение("Количество поступления «" + Строка(Строка.Номенклатура)
          + "» (" + Строка(Строка.Количество) + ") превышает ожидаемое по заказу ("
          + Строка(ОсталосьВПути) + ").");
      КонецЕсли;

      ОстаткиЗаказа.Вставить(Ключ, ОсталосьВПути - Строка.Количество);

      ДвТП = Движения.ТоварыВПути.Добавить();
      ДвТП.ВидДвижения     = "Расход";
      ДвТП.Номенклатура    = Строка.Номенклатура;
      ДвТП.Склад           = this.Склад;
      ДвТП.ЗаказПоставщику = this.ЗаказПоставщику;
      ДвТП.ЗаказПокупателя = Строка.ЗаказПокупателя;
      ДвТП.Количество      = Строка.Количество;
      ДвТП.Сумма           = НеттоСтроки;
    КонецЦикла;
  КонецЕсли;
КонецПроцедуры

// Запись цены с тем же периодом, номенклатурой и типом цен уже есть у другого
// документа.
Функция КлючЦеныЗанятДругим(Период, Номенклатура, ТипЦен)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Цена ИЗ РегистрСведений.ЦеныНоменклатуры
                  ГДЕ period = &Период И Номенклатура = &Ном И ТипЦен = &Тип
                    И Регистратор <> &Этот";
  Запрос.УстановитьПараметр("Период", Период);
  Запрос.УстановитьПараметр("Ном", Номенклатура);
  Запрос.УстановитьПараметр("Тип", ТипЦен);
  Запрос.УстановитьПараметр("Этот", this);
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Возврат Истина;
  КонецЦикла;
  Возврат Ложь;
КонецФункции

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

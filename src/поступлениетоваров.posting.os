// Проведение поступления:
//   - Каждая строка создаёт партию (Номенклатура, Склад, ДатаПоставки = Дата документа)
//     и запись остатков.
//   - В периодический регистр ЦеныНоменклатуры пишется ТОЛЬКО закупочная цена
//     (предопределённая «Закупочная»). Расчётные типы (Розничная, Оптовая и пр.)
//     вычисляются на лету в утилиты.ПолучитьЦену по цепочке БазовыйТип.
//   - Взаиморасчёты с поставщиком — одной строкой на итог.

Процедура ОбработкаПроведения()
  Движения.ОстаткиТоваров.Очистить();
  Движения.Взаиморасчеты.Очистить();
  Движения.ПартииТоваров.Очистить();
  Движения.ЦеныНоменклатуры.Очистить();

  ТипЗакупочной = Справочники.ТипЦен.Закупочная;

  ИтогСумма = 0;

  Для Каждого Строка Из this.Товары Цикл
    Строка.Сумма = Строка.Количество * Строка.Цена;
    ИтогСумма = ИтогСумма + Строка.Сумма;

    ДвО = Движения.ОстаткиТоваров.Добавить();
    ДвО.ВидДвижения  = "Приход";
    ДвО.Номенклатура = Строка.Номенклатура;
    ДвО.Склад        = this.Склад;
    ДвО.Количество   = Строка.Количество;
    ДвО.Сумма        = Строка.Сумма;

    ДвП = Движения.ПартииТоваров.Добавить();
    ДвП.ВидДвижения  = "Приход";
    ДвП.Номенклатура = Строка.Номенклатура;
    ДвП.Склад        = this.Склад;
    ДвП.ДатаПоставки = this.Дата;
    ДвП.Количество   = Строка.Количество;
    ДвП.Сумма        = Строка.Сумма;

    ДвЦ = Движения.ЦеныНоменклатуры.Добавить();
    ДвЦ.Период       = this.Дата;
    ДвЦ.Номенклатура = Строка.Номенклатура;
    ДвЦ.ТипЦен       = ТипЗакупочной;
    ДвЦ.Цена         = Строка.Цена;
  КонецЦикла;

  this.Сумма = ИтогСумма;

  ДвВз = Движения.Взаиморасчеты.Добавить();
  ДвВз.ВидДвижения        = "Расход";
  ДвВз.Контрагент         = this.Поставщик;
  ДвВз.ТипКонтрагента     = "Поставщик";
  ДвВз.ДокументПоступления = this;
  ДвВз.Сумма              = ИтогСумма;
КонецПроцедуры

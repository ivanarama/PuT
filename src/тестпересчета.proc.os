// Пересчёт товаров (инвентаризация документом).
// - Учётные остатки — ссылки на номенклатуру (не наименования), по организации
//   и на дату пересчёта: чужая организация на том же складе и поступление
//   после даты в учёт не попадают.
// - Излишки оценивают по партиям своей организации.
// - Оформление создаёт оприходование и списание со ссылкой на пересчёт;
//   повторное оформление отклоняется.
// Запуск:
//   onebase test --project . --sqlite <база> --run Пересчета

Процедура Поступление(Организация, Склад, Поставщик, Номенклатура, Количество, Цена, ДатаДокумента)
  Документ = Документы.ПоступлениеТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Поставщик = Поставщик;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = Количество;
  СтрокаТЧ.Цена = Цена;
  Документ.Провести();
КонецПроцедуры

Функция Остаток(Остатки, Номенклатура)
  Для Каждого Стр Из Остатки Цикл
    Если УИДСсылки(Стр.Номенклатура) = УИДСсылки(Номенклатура) Тогда
      Возврат Стр.Остаток;
    КонецЕсли;
  КонецЦикла;
  Возврат 0;
КонецФункции

Процедура Выполнить()
  Орг = Справочники.Организация.Создать();
  Орг.Наименование = "Тест пересчёта: организация А";
  ОргА = Орг.Записать();
  Орг = Справочники.Организация.Создать();
  Орг.Наименование = "Тест пересчёта: организация Б";
  ОргБ = Орг.Записать();
  Скл = Справочники.Склад.Создать();
  Скл.Наименование = "Тест пересчёта: склад";
  Склад = Скл.Записать();
  Пост = Справочники.Контрагент.Создать();
  Пост.Наименование = "Тест пересчёта: поставщик";
  Пост.Вид = "Поставщик";
  Поставщик = Пост.Записать();
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест пересчёта: шуруп";
  Шуруп = Ном.Записать();
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест пересчёта: гайка";
  Гайка = Ном.Записать();

  Поступление(ОргА, Склад, Поставщик, Шуруп, 10, 100, Дата(2026, 9, 1, 9, 0, 0));
  Поступление(ОргА, Склад, Поставщик, Гайка, 5, 50, Дата(2026, 9, 1, 9, 30, 0));
  Поступление(ОргБ, Склад, Поставщик, Шуруп, 7, 120, Дата(2026, 9, 1, 10, 0, 0));
  // После даты пересчёта — в его учётный остаток не входит.
  Поступление(ОргА, Склад, Поставщик, Шуруп, 4, 100, Дата(2026, 9, 20, 9, 0, 0));

  ДатаПересчета = Дата(2026, 9, 15, 18, 0, 0);
  Остатки = УчетныеОстаткиСклада(Склад, ОргА, ДатаПересчета);
  Утверждать.Равно(Остатки.Количество(), 2, "учёт организации А на складе — две позиции");
  Для Каждого Стр Из Остатки Цикл
    Утверждать.Истина(ТипЗнч(Стр.Номенклатура) <> Тип("Строка"), "в учёте ссылка, а не наименование: " + ТипЗнч(Стр.Номенклатура));
  КонецЦикла;
  Утверждать.Равно(Остаток(Остатки, Шуруп), 10, "шурупы: только организация А и только до даты пересчёта");
  Утверждать.Равно(Остаток(Остатки, Гайка), 5, "гайки организации А");
  Утверждать.Равно(СредняяЦенаПартии(Шуруп, Склад, ОргА, ДатаПересчета), 100, "излишки оцениваются по партиям своей организации");

  Документ = Документы.ПересчетТоваров.Создать();
  Документ.Дата = ДатаПересчета;
  Документ.Организация = ОргА;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Шуруп;
  СтрокаТЧ.КоличествоУчёт = 10;
  СтрокаТЧ.КоличествоФакт = 12;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Гайка;
  СтрокаТЧ.КоличествоУчёт = 5;
  СтрокаТЧ.КоличествоФакт = 3;
  Документ.Записать();
  Пересчет = Документ.Ссылка;

  Итог = ОформитьОтклоненияПересчета(Пересчет);
  Утверждать.Истина(СтрНайти(Итог, "Оприходование") > 0 И СтрНайти(Итог, "Списание") > 0,
    "оформлены и излишки, и недостачи: " + Итог);
  Утверждать.Истина(ОформленоПоПересчету(Пересчет) <> "", "документы ссылаются на пересчёт");
  После = УчетныеОстаткиСклада(Склад, ОргА, ДатаПересчета);
  Утверждать.Равно(Остаток(После, Шуруп), 12, "излишек шурупов оприходован");
  Утверждать.Равно(Остаток(После, Гайка), 3, "недостача гаек списана");
  Утверждать.Равно(Остаток(УчетныеОстаткиСклада(Склад, ОргБ, ДатаПересчета), Шуруп), 7,
    "остаток организации Б не тронут");

  Отказ = "";
  Попытка
    ОформитьОтклоненияПересчета(Пересчет);
  Исключение
    Отказ = ОписаниеОшибки();
  КонецПопытки;
  Утверждать.Истина(СтрНайти(Отказ, "уже оформлены") > 0, "повторное оформление отклонено: " + Отказ);
  Утверждать.Равно(Остаток(УчетныеОстаткиСклада(Склад, ОргА, ДатаПересчета), Шуруп), 12,
    "после отказа остаток не изменился");

  // Оба документа — в одной транзакции: списание не проводится (недостача
  // больше остатка), значит и оприходование того же пересчёта откатывается.
  Документ = Документы.ПересчетТоваров.Создать();
  Документ.Дата = Дата(2026, 9, 16, 18, 0, 0);
  Документ.Организация = ОргА;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Шуруп;
  СтрокаТЧ.КоличествоУчёт = 12;
  СтрокаТЧ.КоличествоФакт = 13;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Гайка;
  СтрокаТЧ.КоличествоУчёт = 100;
  СтрокаТЧ.КоличествоФакт = 0;
  Документ.Записать();
  Сбойный = Документ.Ссылка;
  Отказ = "";
  Попытка
    ОформитьОтклоненияПересчета(Сбойный);
  Исключение
    Отказ = ОписаниеОшибки();
  КонецПопытки;
  Утверждать.Истина(Отказ <> "", "списание сверх остатка не проведено");
  Утверждать.Равно(ОформленоПоПересчету(Сбойный), "", "оприходование этого пересчёта откатилось вместе со списанием");
  Утверждать.Равно(Остаток(УчетныеОстаткиСклада(Склад, ОргА, Дата(2026, 9, 16, 23, 0, 0)), Шуруп), 12,
    "излишек сбойного пересчёта не оприходован");
КонецПроцедуры

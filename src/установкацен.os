Процедура ПриЗаписи()
  Если ЗначениеЗаполнено(this.Организация) = Ложь Тогда
    this.Организация = ОрганизацияПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.ТипЦен) = Ложь Тогда
    Error("Укажите тип цен");
  КонецЕсли;
  Если this.ТипЦен.ВидРасчета <> "Хранимый" Тогда
    Error("Устанавливать значения можно только для хранимых типов цен. «"
      + Строка(this.ТипЦен) + "» — расчётный, его значение вычисляется автоматически");
  КонецЕсли;
  Если this.Цены.Количество() = 0 Тогда
    Error("Добавьте хотя бы одну строку в табличную часть Цены");
  КонецЕсли;
  Для Каждого Строка Из this.Цены Цикл
    Если ЗначениеЗаполнено(Строка.Номенклатура) = Ложь Тогда
      Error("В табличной части есть строка без номенклатуры");
    КонецЕсли;
    Если Строка.Цена < 0 Тогда
      Error("Цена не может быть отрицательной: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;
  КонецЦикла;
КонецПроцедуры

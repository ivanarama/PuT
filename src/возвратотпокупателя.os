// Ввод на основании РеализацииТоваров. Поля шапки и строки ТЧ копируются
// из источника, ссылка на источник кладётся в реквизит Основание.
Процедура ОбработкаЗаполнения(ДанныеЗаполнения)
  this.Организация     = ДанныеЗаполнения.Организация;
  this.Покупатель      = ДанныеЗаполнения.Покупатель;
  this.Склад           = ДанныеЗаполнения.Склад;
  this.Основание       = ДанныеЗаполнения.Ссылка;
  this.СпособУчетаНДС  = ДанныеЗаполнения.СпособУчетаНДС;
  this.СуммаБезНДС     = ДанныеЗаполнения.СуммаБезНДС;
  this.СуммаНДС        = ДанныеЗаполнения.СуммаНДС;
  this.Сумма           = ДанныеЗаполнения.Сумма;

  Позиции = ОстаткиДляВозврата(this.Основание, this.Ссылка);
  Индекс = 0;
  Для Каждого Стр Из ДанныеЗаполнения.Товары Цикл
    Поз = Позиции[Индекс];
    Индекс = Индекс + 1;
    Если Поз.Количество <= 0 Тогда Продолжить; КонецЕсли;
    Нов = this.Товары.Добавить();
    Нов.СтрокаРеализации = Поз.Номер;
    Нов.Номенклатура = Стр.Номенклатура;
    Нов.Количество   = Поз.Количество;
    Нов.Цена         = Поз.Сумма / Поз.Количество;
    Нов.Склад        = Стр.Склад;
    Нов.СтавкаНДС    = Стр.СтавкаНДС;
    Нов.СуммаНДС     = Поз.НДС;
    Нов.Сумма        = Поз.Сумма;
  КонецЦикла;
  ПересчитатьВозвратПоРеализации(this);
КонецПроцедуры

Процедура ПриЗаписи()
  ПроверитьЗакрытыйПериод(this);

  Если ЗначениеЗаполнено(this.Организация) = Ложь Тогда
    this.Организация = ОрганизацияПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Покупатель) = Ложь Тогда
    Error("Укажите покупателя");
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    this.Склад = СкладПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    Error("Укажите склад");
  КонецЕсли;
  Если this.Товары.Количество() = 0 Тогда
    Error("Добавьте хотя бы одну строку в табличную часть Товары");
  КонецЕсли;

  Способ = this.СпособУчетаНДС;
  Если ЗначениеЗаполнено(Способ) = Ложь Тогда
    Способ = "ВТомЧисле";
    this.СпособУчетаНДС = Способ;
  КонецЕсли;

  Если ЗначениеЗаполнено(this.Основание) Тогда
    ПроверитьЗаполнениеСтрокТоваров(this.Товары, "Товары", Ложь);
    ПересчитатьВозвратПоРеализации(this);
    Возврат;
  КонецЕсли;

  ИтогБезНДС = 0;
  ИтогНДС = 0;
  Для Каждого Строка Из this.Товары Цикл
    Если ЗначениеЗаполнено(Строка.Номенклатура) = Ложь Тогда
      Error("В табличной части есть строка без номенклатуры");
    КонецЕсли;
    Если Строка.Количество <= 0 Тогда
      Error("Количество должно быть больше нуля: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;
    Если Строка.Цена < 0 Тогда
      Error("Цена не может быть отрицательной: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;

    Если ЗначениеЗаполнено(Строка.СтавкаНДС) = Ложь Тогда
      Строка.СтавкаНДС = ЗначениеРеквизитаОбъекта(Строка.Номенклатура, "СтавкаНДС");
    КонецЕсли;

    Строка.Сумма    = Окр(Строка.Количество * Строка.Цена, 2);
    Строка.СуммаНДС = СуммаНДСстроки(Строка.Сумма, Строка.СтавкаНДС, Способ);

    Если Способ = "Сверху" Тогда
      ИтогБезНДС = ИтогБезНДС + Строка.Сумма;
    Иначе
      ИтогБезНДС = ИтогБезНДС + (Строка.Сумма - Строка.СуммаНДС);
    КонецЕсли;
    ИтогНДС = ИтогНДС + Строка.СуммаНДС;
  КонецЦикла;

  this.СуммаНДС    = ИтогНДС;
  this.СуммаБезНДС = ИтогБезНДС;
  this.Сумма       = ИтогБезНДС + ИтогНДС;
КонецПроцедуры

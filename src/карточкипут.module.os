// Все сводки читают реальные движения. Имя контрагента/товара никогда не служит ключом.
Функция ЗапросКарточкиПУТ(Текст, Ссылка) Экспорт
  З = Новый Запрос;
  З.Текст = Текст;
  З.УстановитьПараметр("Ссылка", Ссылка);
  З.УстановитьПараметр("Момент", КонецДня(ТекущаяДата()));
  Результат = З.Выполнить();
  Для Каждого Стр Из Результат Цикл
    Если ЗначениеЗаполнено(Стр.Дата) Тогда
      Стр.Дата = Формат(Дата(Стр.Дата), "ДФ=dd.MM.yyyy");
    КонецЕсли;
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция СводкаКонтрагентаПУТ(Контрагент) Экспорт
  Итог = Новый Структура;
  Итог.Вставить("ДолгПокупателя", 0);
  Итог.Вставить("ДолгПоставщику", 0);
  Итог.Вставить("Просрочено", 0);
  ДолгПоДокументам = 0;
  Результат = ЗапросКарточкиПУТ(
    "ВЫБРАТЬ Р.ТипКонтрагента КАК Вид,
       СУММА(ВЫБОР КОГДА Р.вид_движения = ""Приход"" ТОГДА Р.Сумма ИНАЧЕ -Р.Сумма КОНЕЦ) КАК Долг
     ИЗ РегистрНакопления.Взаиморасчеты КАК Р
     ГДЕ Р.Контрагент = &Ссылка И Р.period <= &Момент
     СГРУППИРОВАТЬ ПО Р.ТипКонтрагента", Контрагент);
  Для Каждого Стр Из Результат Цикл
    Если Стр.Вид = "Покупатель" Тогда Итог.ДолгПокупателя = Стр.Долг; КонецЕсли;
    Если Стр.Вид = "Поставщик" Тогда Итог.ДолгПоставщику = -Стр.Долг; КонецЕсли;
  КонецЦикла;
  Неоплаченные = ЗапросКарточкиПУТ(
    "ВЫБРАТЬ Д.Номер КАК Номер, Д.Дата КАК Дата, Д.СрокОплаты КАК СрокОплаты,
       СУММА(ВЫБОР КОГДА Р.вид_движения = ""Приход"" ТОГДА Р.Сумма ИНАЧЕ -Р.Сумма КОНЕЦ) КАК Долг
     ИЗ РегистрНакопления.Взаиморасчеты КАК Р
     ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваров КАК Д ПО Р.ДокументРеализации = Д.Ссылка
     ГДЕ Р.Контрагент = &Ссылка И Р.period <= &Момент
     СГРУППИРОВАТЬ ПО Д.Ссылка, Д.Номер, Д.Дата, Д.СрокОплаты
     ИМЕЯ СУММА(ВЫБОР КОГДА Р.вид_движения = ""Приход"" ТОГДА Р.Сумма ИНАЧЕ -Р.Сумма КОНЕЦ) > 0
     УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ", Контрагент);
  Для Каждого Стр Из Неоплаченные Цикл
    ДолгПоДокументам = ДолгПоДокументам + Стр.Долг;
    Если ЗначениеЗаполнено(Стр.СрокОплаты) И Дата(Стр.СрокОплаты) < ТекущаяДата() Тогда
      Итог.Просрочено = Итог.Просрочено + Стр.Долг;
    КонецЕсли;
    Стр.Дата = Формат(Дата(Стр.Дата), "ДФ=dd.MM.yyyy");
    Если ЗначениеЗаполнено(Стр.СрокОплаты) Тогда
      Стр.СрокОплаты = Формат(Дата(Стр.СрокОплаты), "ДФ=dd.MM.yyyy");
    Иначе
      Стр.СрокОплаты = "";
    КонецЕсли;
  КонецЦикла;
  Итог.Вставить("Неоплаченные", Неоплаченные);
  Итог.Вставить("НераспределённыеОплаты", МАКС(0, ДолгПоДокументам - Итог.ДолгПокупателя));
  Возврат Итог;
КонецФункции

Функция ЗаказыКонтрагентаПУТ(Контрагент) Экспорт
  Возврат ЗапросКарточкиПУТ(
    "ВЫБРАТЬ ПЕРВЫЕ 30 Д.Номер КАК Номер, Д.Дата КАК Дата,
       ВЫБОР КОГДА Д.Состояние ЕСТЬ NULL ИЛИ Д.Состояние = """" ТОГДА ""Новый"" ИНАЧЕ Д.Состояние КОНЕЦ КАК Этап,
       CAST(Д.Сумма AS NUMERIC) КАК Сумма, Д.Проведен КАК Проведен
     ИЗ Документ.ЗаказПокупателя КАК Д ГДЕ Д.Покупатель = &Ссылка
       И (Д.Состояние ЕСТЬ NULL ИЛИ Д.Состояние = """" ИЛИ (Д.Состояние <> ""Завершён"" И Д.Состояние <> ""Отменён""))
     УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ", Контрагент);
КонецФункции

Функция ИсторияКонтрагентаПУТ(Контрагент) Экспорт
  Возврат ЗапросКарточкиПУТ(
    "ВЫБРАТЬ ""Реализация"" КАК Вид, Д.Номер КАК Номер, Д.Дата КАК Дата,
       CAST(Д.Сумма AS NUMERIC) КАК Сумма
     ИЗ Документ.РеализацияТоваров КАК Д ГДЕ Д.Покупатель = &Ссылка
     ОБЪЕДИНИТЬ ВСЕ
     ВЫБРАТЬ ""Поступление"" КАК Вид, П.Номер, П.Дата, CAST(П.Сумма AS NUMERIC) КАК Сумма
     ИЗ Документ.ПоступлениеТоваров КАК П ГДЕ П.Поставщик = &Ссылка
     ОБЪЕДИНИТЬ ВСЕ
     ВЫБРАТЬ ""Заказ"" КАК Вид, З.Номер, З.Дата, CAST(З.Сумма AS NUMERIC) КАК Сумма
     ИЗ Документ.ЗаказПокупателя КАК З ГДЕ З.Покупатель = &Ссылка
     УПОРЯДОЧИТЬ ПО Дата УБЫВ", Контрагент);
КонецФункции

Функция ОстаткиТовараПУТ(Товар) Экспорт
  Возврат ЗапросКарточкиПУТ(
    "ВЫБРАТЬ Д.Склад КАК Склад, СУММА(Д.Остаток) КАК Остаток,
       СУММА(Д.Резерв) КАК Резерв, СУММА(Д.Остаток) - СУММА(Д.Резерв) КАК Свободно,
       СУММА(Д.Ожидается) КАК Ожидается
     ИЗ (
       ВЫБРАТЬ Р.Склад.Ссылка КАК ИдСклада, Р.Склад.Наименование КАК Склад,
         СУММА(ВЫБОР КОГДА Р.вид_движения = ""Приход"" ТОГДА Р.Количество ИНАЧЕ -Р.Количество КОНЕЦ) КАК Остаток,
         0 КАК Резерв, 0 КАК Ожидается
       ИЗ РегистрНакопления.ОстаткиТоваров КАК Р
       ГДЕ Р.Номенклатура = &Ссылка И Р.period <= &Момент
      СГРУППИРОВАТЬ ПО Р.Склад.Ссылка, Р.Склад.Наименование
       ОБЪЕДИНИТЬ ВСЕ
       ВЫБРАТЬ З.Склад.Ссылка КАК ИдСклада, З.Склад.Наименование КАК Склад, 0 КАК Остаток,
         СУММА(ВЫБОР КОГДА З.вид_движения = ""Приход"" ТОГДА З.Количество ИНАЧЕ -З.Количество КОНЕЦ) КАК Резерв, 0 КАК Ожидается
       ИЗ РегистрНакопления.РезервыТоваров КАК З
       ГДЕ З.Номенклатура = &Ссылка И З.period <= &Момент
      СГРУППИРОВАТЬ ПО З.Склад.Ссылка, З.Склад.Наименование
       ОБЪЕДИНИТЬ ВСЕ
       ВЫБРАТЬ П.Склад.Ссылка КАК ИдСклада, П.Склад.Наименование КАК Склад, 0 КАК Остаток, 0 КАК Резерв,
         СУММА(ВЫБОР КОГДА П.вид_движения = ""Приход"" ТОГДА П.Количество ИНАЧЕ -П.Количество КОНЕЦ) КАК Ожидается
       ИЗ РегистрНакопления.ТоварыВПути КАК П
       ГДЕ П.Номенклатура = &Ссылка И П.period <= &Момент
      СГРУППИРОВАТЬ ПО П.Склад.Ссылка, П.Склад.Наименование
     ) КАК Д
     СГРУППИРОВАТЬ ПО Д.ИдСклада, Д.Склад
     УПОРЯДОЧИТЬ ПО Д.Склад", Товар);
КонецФункции

Функция ЦеныТовараПУТ(Товар) Экспорт
  // Расчётные типы цен не имеют собственных записей среза. Используем тот же
  // расчёт цены, что и в рабочем месте продавца.
  Типы = ЗапросКарточкиПУТ("ВЫБРАТЬ Ссылка КАК Ид, Наименование КАК ТипЦен
    ИЗ Справочник.ТипЦен УПОРЯДОЧИТЬ ПО Наименование", Товар);
  Результат = Новый Массив;
  Для Каждого Стр Из Типы Цикл
    ТипЦены = Справочники.ТипЦен.НайтиПоИдентификатору(Стр.Ид);
    Цена = ПолучитьЦену(Товар, ТипЦены, ТекущаяДатаВремя());
    Результат.Добавить(Новый Структура("ТипЦен,Цена", Стр.ТипЦен, Цена));
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция ДвиженияТовараПУТ(Товар) Экспорт
  Возврат ЗапросКарточкиПУТ(
    "ВЫБРАТЬ ПЕРВЫЕ 30 Р.period КАК Дата, Р.Склад.Наименование КАК Склад,
       Р.вид_движения КАК Вид, CAST(Р.Количество AS NUMERIC) КАК Количество
     ИЗ РегистрНакопления.ОстаткиТоваров КАК Р
     ГДЕ Р.Номенклатура = &Ссылка И Р.period <= &Момент
     УПОРЯДОЧИТЬ ПО Р.period УБЫВ", Товар);
КонецФункции

Процедура ПроверитьЗавершениеЗаказаПУТ(Заказ, Регистр, Измерение) Экспорт
  Если Заказ.Состояние <> "Завершён" И Заказ.Состояние <> "Отменён" Тогда Возврат; КонецЕсли;
  Если НЕ ЗначениеЗаполнено(Заказ.Ссылка) Тогда
    ВызватьИсключение("Новый заказ нельзя сразу завершить или отменить");
  КонецЕсли;
  З = Новый Запрос;
  // Регистр и измерение заданы кодом, никогда не приходят из формы.
  З.Текст = "ВЫБРАТЬ КоличествоОстаток КАК Осталось ИЗ РегистрНакопления."
    + Регистр + ".Остатки() ГДЕ " + Измерение + " = &Заказ И КоличествоОстаток <> 0";
  З.УстановитьПараметр("Заказ", Заказ.Ссылка);
  Для Каждого Стр Из З.Выполнить() Цикл
    ВызватьИсключение("У заказа осталось обеспечение. Сначала оформите отгрузку/приёмку или документ закрытия заказа");
  КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьТаблицуКарточкиПУТ(Таблица, Данные, Колонки) Экспорт
  Таблица.Очистить();
  Количество = 0;
  Для Каждого Стр Из Данные Цикл
    Новая = Таблица.Добавить();
    ЗаполнитьЗначенияСвойств(Новая, Стр, Колонки);
    Количество = Количество + 1;
    Если Количество >= 30 Тогда Прервать; КонецЕсли;
  КонецЦикла;
КонецПроцедуры

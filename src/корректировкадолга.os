// Модуль документа «Корректировка долга».

Процедура ПриЗаписи()
  Если ЗначениеЗаполнено(this.Организация) = Ложь Тогда
    this.Организация = ОрганизацияПоУмолчанию();
  КонецЕсли;

  Если ЗначениеЗаполнено(this.Контрагент) = Ложь
     ИЛИ ТипЗнч(this.Контрагент) = "Строка"
     ИЛИ ПустаяСсылка(this.Контрагент) Тогда
    Error("Укажите контрагента");
  КонецЕсли;

  Если ЗначениеЗаполнено(this.ВидОперации) = Ложь Тогда
    Error("Укажите вид операции");
  КонецЕсли;

  Если this.ВидОперации = "ПереносЗадолженности" Тогда
    Если ЗначениеЗаполнено(this.КонтрагентПолучатель) = Ложь
       ИЛИ ТипЗнч(this.КонтрагентПолучатель) = "Строка"
       ИЛИ ПустаяСсылка(this.КонтрагентПолучатель) Тогда
      Error("Для переноса задолженности укажите контрагента-получателя");
    КонецЕсли;
  КонецЕсли;

  Если ЗначениеЗаполнено(this.Сумма) = Ложь ИЛИ this.Сумма <= 0 Тогда
    Error("Укажите положительную сумму корректировки");
  КонецЕсли;
КонецПроцедуры

// Возврат поставщику по документу-основанию уменьшает ту же партию, из
// которой товар поступил. Раньше расход писался без даты поставки, попадал в
// отдельную строку с пустой датой, а партия поступления оставалась целой.
// Запуск:
//   onebase test --project . --sqlite <база> --run ВозвратаПоставщику

Процедура Выполнить()
  Организация = Справочники.Организация.Создать();
  Организация.Наименование = "Тест возврата: организация";
  СсылкаОрганизации = Организация.Записать();

  Склад = Справочники.Склад.Создать();
  Склад.Наименование = "Тест возврата: склад";
  СсылкаСклада = Склад.Записать();

  Поставщик = Справочники.Контрагент.Создать();
  Поставщик.Наименование = "Тест возврата: поставщик";
  Поставщик.Вид = "Поставщик";
  СсылкаПоставщика = Поставщик.Записать();

  Товар = Справочники.Номенклатура.Создать();
  Товар.Наименование = "Тест возврата: полка";
  СсылкаТовара = Товар.Записать();

  Поступление = Документы.ПоступлениеТоваров.Создать();
  Поступление.Дата = Дата(2026, 9, 3, 10, 0, 0);
  Поступление.Организация = СсылкаОрганизации;
  Поступление.Поставщик = СсылкаПоставщика;
  Поступление.Склад = СсылкаСклада;
  СтрокаТЧ = Поступление.Товары.Добавить();
  СтрокаТЧ.Номенклатура = СсылкаТовара;
  СтрокаТЧ.Количество = 10;
  СтрокаТЧ.Цена = 100;
  Поступление.Провести();

  ДокВозврата = Документы.ВозвратПоставщику.Создать();
  ДокВозврата.Дата = Дата(2026, 9, 3, 12, 0, 0);
  ДокВозврата.Организация = СсылкаОрганизации;
  ДокВозврата.Поставщик = СсылкаПоставщика;
  ДокВозврата.Склад = СсылкаСклада;
  ДокВозврата.Основание = Поступление.Ссылка;
  СтрокаТЧ = ДокВозврата.Товары.Добавить();
  СтрокаТЧ.Номенклатура = СсылкаТовара;
  СтрокаТЧ.Количество = 4;
  СтрокаТЧ.Цена = 100;
  ДокВозврата.Провести();

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ КоличествоОстаток, СуммаОстаток
                  ИЗ РегистрНакопления.ПартииТоваров.Остатки()
                  ГДЕ Номенклатура = &Ном";
  Запрос.УстановитьПараметр("Ном", СсылкаТовара);
  Строк = 0;
  Количество = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Строк = Строк + 1;
    Количество = Количество + Стр.КоличествоОстаток;
    Утверждать.Истина(Стр.КоличествоОстаток >= 0,
      "в партиях нет отрицательной строки (получено " + Строка(Стр.КоличествоОстаток) + ")");
  КонецЦикла;
  Утверждать.Равно(Строк, 1, "возврат списан из партии поступления, а не отдельной строкой");
  Утверждать.Равно(Количество, 6, "в партии осталось 10 − 4");
КонецПроцедуры

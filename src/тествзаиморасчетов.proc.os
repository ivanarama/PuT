// Взаиморасчёты и денежные документы:
// - «Корректировка долга» проводится и гасит долг в нужную сторону: списание
//   долга поставщику раньше его удваивало, а сам документ не проводился вовсе;
// - оплата по основанию не больше долга по нему;
// - тип расчётов в движении оплаты — по операции, а не по виду контрагента;
// - из кассы нельзя выдать больше остатка.
// Запуск:
//   onebase test --project . --sqlite <база> --run Взаиморасчетов

Функция НовыйКонтрагент(Имя, Вид)
  Объект = Справочники.Контрагент.Создать();
  Объект.Наименование = Имя;
  Объект.Вид = Вид;
  Возврат Объект.Записать();
КонецФункции

Функция НоваяКасса(Имя, Вид)
  Объект = Справочники.Касса.Создать();
  Объект.Наименование = Имя;
  Объект.Вид = Вид;
  Возврат Объект.Записать();
КонецФункции

Функция Поступление(Организация, Склад, Поставщик, Номенклатура, Количество, Цена, ДатаДокумента)
  Документ = Документы.ПоступлениеТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Поставщик = Поставщик;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = Количество;
  СтрокаТЧ.Цена = Цена;
  Документ.Провести();
  Возврат Документ.Ссылка;
КонецФункции

Функция Реализация(Организация, Склад, Покупатель, Номенклатура, Количество, Цена, ДатаДокумента)
  Документ = Документы.РеализацияТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Покупатель = Покупатель;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = Количество;
  СтрокаТЧ.Цена = Цена;
  Документ.Провести();
  Возврат Документ.Ссылка;
КонецФункции

// Пустая строка — документ проведён, иначе текст отказа.
Функция Корректировка(Организация, Вид, Контрагент, Получатель, Сумма, ДатаДокумента)
  Документ = Документы.КорректировкаДолга.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.ВидОперации = Вид;
  Документ.Контрагент = Контрагент;
  Если Получатель <> Неопределено Тогда
    Документ.КонтрагентПолучатель = Получатель;
  КонецЕсли;
  Документ.Сумма = Сумма;
  Попытка
    Документ.Провести();
    Возврат "";
  Исключение
    Возврат ОписаниеОшибки();
  КонецПопытки;
КонецФункции

Функция Сальдо(Организация, Контрагент, ТипКонтрагента = Неопределено)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ ТипКонтрагента, ВидДвижения, Сумма
                  ИЗ РегистрНакопления.Взаиморасчеты
                  ГДЕ Контрагент = &К И Организация = &О";
  Запрос.УстановитьПараметр("К", Контрагент);
  Запрос.УстановитьПараметр("О", Организация);
  Итог = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Если ТипКонтрагента <> Неопределено И Стр.ТипКонтрагента <> ТипКонтрагента Тогда
      Продолжить;
    КонецЕсли;
    Если Стр.ВидДвижения = "Приход" Тогда
      Итог = Итог + Стр.Сумма;
    Иначе
      Итог = Итог - Стр.Сумма;
    КонецЕсли;
  КонецЦикла;
  Возврат Итог;
КонецФункции

Функция Оплата(ИмяДокумента, Организация, Касса, Контрагент, ДокРеализации, ДокПоступления, Сумма, ДатаДокумента)
  Если ИмяДокумента = "ПКО" Тогда
    Документ = Документы.ПриходныйКассовыйОрдер.Создать();
  Иначе
    Документ = Документы.РасходныйКассовыйОрдер.Создать();
  КонецЕсли;
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Касса = Касса;
  Документ.Контрагент = Контрагент;
  Если ДокРеализации <> Неопределено Тогда
    Документ.ДокументРеализации = ДокРеализации;
  КонецЕсли;
  Если ДокПоступления <> Неопределено Тогда
    Документ.ДокументПоступления = ДокПоступления;
  КонецЕсли;
  Документ.Сумма = Сумма;
  Попытка
    Документ.Провести();
    Возврат "";
  Исключение
    Возврат ОписаниеОшибки();
  КонецПопытки;
КонецФункции

Процедура Выполнить()
  Орг = Справочники.Организация.Создать();
  Орг.Наименование = "Тест расчётов: организация";
  Организация = Орг.Записать();
  Скл = Справочники.Склад.Создать();
  Скл.Наименование = "Тест расчётов: склад";
  Склад = Скл.Записать();
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест расчётов: товар";
  Номенклатура = Ном.Записать();
  Касса = НоваяКасса("Тест расчётов: касса", "Касса");

  // 1. Списание долга поставщику гасит его, а не удваивает.
  Поставщик = НовыйКонтрагент("Тест расчётов: поставщик", "Поставщик");
  Поступление(Организация, Склад, Поставщик, Номенклатура, 10, 100, Дата(2026, 9, 10, 10, 0, 0));
  Утверждать.Равно(Сальдо(Организация, Поставщик), -1000, "после поступления мы должны поставщику 1000");
  Утверждать.Равно(Корректировка(Организация, "СписаниеЗадолженности", Поставщик, Неопределено, 400,
    Дата(2026, 9, 10, 11, 0, 0)), "", "списание долга поставщику проводится");
  Утверждать.Равно(Сальдо(Организация, Поставщик), -600, "долг поставщику уменьшился на 400");

  // 2. Списание долга покупателя и больше долга — отказ.
  Покупатель = НовыйКонтрагент("Тест расчётов: покупатель", "Покупатель");
  Продажа = Реализация(Организация, Склад, Покупатель, Номенклатура, 2, 150, Дата(2026, 9, 10, 12, 0, 0));
  Утверждать.Равно(Сальдо(Организация, Покупатель), 300, "после реализации покупатель должен 300");
  Утверждать.Равно(Корректировка(Организация, "СписаниеЗадолженности", Покупатель, Неопределено, 100,
    Дата(2026, 9, 10, 13, 0, 0)), "", "списание долга покупателя проводится");
  Утверждать.Равно(Сальдо(Организация, Покупатель), 200, "долг покупателя уменьшился на 100");
  Отказ = Корректировка(Организация, "СписаниеЗадолженности", Покупатель, Неопределено, 500,
    Дата(2026, 9, 10, 14, 0, 0));
  Утверждать.Истина(СтрНайти(Отказ, "больше долга") > 0, "списание больше долга отклонено: " + Отказ);

  // 3. Перенос долга покупателя на другого контрагента.
  Получатель = НовыйКонтрагент("Тест расчётов: получатель долга", "Покупатель");
  Утверждать.Равно(Корректировка(Организация, "ПереносЗадолженности", Покупатель, Получатель, 200,
    Дата(2026, 9, 10, 15, 0, 0)), "", "перенос долга проводится");
  Утверждать.Равно(Сальдо(Организация, Покупатель), 0, "долг ушёл от покупателя");
  Утверждать.Равно(Сальдо(Организация, Получатель), 200, "долг перешёл к получателю");

  // 4. Взаимозачёт встречных долгов: итоговое сальдо не меняется.
  Партнёр = НовыйКонтрагент("Тест расчётов: партнёр", "Покупатель");
  Поступление(Организация, Склад, Партнёр, Номенклатура, 1, 100, Дата(2026, 9, 11, 10, 0, 0));
  Реализация(Организация, Склад, Партнёр, Номенклатура, 1, 150, Дата(2026, 9, 11, 11, 0, 0));
  Утверждать.Равно(Сальдо(Организация, Партнёр), 50, "партнёр должен 150, мы ему 100");
  Утверждать.Равно(Корректировка(Организация, "Взаимозачет", Партнёр, Неопределено, 100,
    Дата(2026, 9, 11, 12, 0, 0)), "", "взаимозачёт проводится");
  Утверждать.Равно(Сальдо(Организация, Партнёр), 50, "итоговое сальдо после зачёта не изменилось");
  Утверждать.Равно(Сальдо(Организация, Партнёр, "Поставщик"), 0, "наш долг партнёру зачтён");
  Утверждать.Равно(Сальдо(Организация, Партнёр, "Покупатель"), 50, "долг партнёра уменьшился на сумму зачёта");

  // 5. Оплата по основанию — не больше долга; тип расчётов — по операции.
  Продажа2 = Реализация(Организация, Склад, Покупатель, Номенклатура, 1, 150, Дата(2026, 9, 12, 10, 0, 0));
  Отказ = Оплата("ПКО", Организация, Касса, Покупатель, Продажа2, Неопределено, 1000000, Дата(2026, 9, 12, 11, 0, 0));
  Утверждать.Истина(СтрНайти(Отказ, "переплата") > 0, "оплата сверх долга по реализации отклонена: " + Отказ);
  Утверждать.Равно(Оплата("ПКО", Организация, Касса, Покупатель, Продажа2, Неопределено, 150,
    Дата(2026, 9, 12, 12, 0, 0)), "", "оплата долга по реализации проводится");

  // Партнёр в справочнике — «Покупатель», но РКО оплачивает его поступление:
  // движение ложится строкой поставщика.
  ПоступлениеПартнёра = Поступление(Организация, Склад, Партнёр, Номенклатура, 1, 80, Дата(2026, 9, 12, 13, 0, 0));
  Утверждать.Равно(Оплата("РКО", Организация, Касса, Партнёр, Неопределено, ПоступлениеПартнёра, 80,
    Дата(2026, 9, 12, 14, 0, 0)), "", "оплата поступления из кассы проводится");
  Утверждать.Равно(Сальдо(Организация, Партнёр, "Поставщик"), 0, "оплата поступления закрыла строку поставщика");

  // 6. Из пустой кассы выдать нельзя.
  ПустаяКасса = НоваяКасса("Тест расчётов: пустая касса", "Касса");
  Отказ = Оплата("РКО", Организация, ПустаяКасса, Поставщик, Неопределено, Неопределено, 10, Дата(2026, 9, 12, 15, 0, 0));
  Утверждать.Истина(СтрНайти(Отказ, "Недостаточно денег") > 0, "выдача из пустой кассы отклонена: " + Отказ);
КонецПроцедуры

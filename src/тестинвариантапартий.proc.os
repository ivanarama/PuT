// Инвариант партионного учёта на данных базы: по каждой номенклатуре, складу
// и организации остаток регистра ПартииТоваров равен остатку ОстаткиТоваров —
// и количеством, и суммой, — а отрицательных партий нет, пока минус не
// разрешён константой. Именно этот инвариант был нарушен, когда движения
// партий писали номер документа вместо ссылки: в демо-базе по табурету на
// складе было 46 штук, а в партиях — 103.
// Запуск на заполненной базе (в CI — после ЗаполнитьТестовуюБазу):
//   onebase test --project . --sqlite <база> --run ИнвариантаПартий

Функция Ключ(Стр)
  Возврат УИДСсылки(Стр.НомИД) + "#" + УИДСсылки(Стр.СкладИД) + "#" + УИДСсылки(Стр.ОргИД);
КонецФункции

Процедура Выполнить()
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ
                    Номенклатура.Ссылка КАК НомИД,
                    Склад.Ссылка КАК СкладИД,
                    Организация.Ссылка КАК ОргИД,
                    Номенклатура,
                    КоличествоОстаток,
                    СуммаОстаток
                  ИЗ РегистрНакопления.ОстаткиТоваров.Остатки()";
  Товары = Новый Соответствие;
  Имена = Новый Соответствие;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Товары.Вставить(Ключ(Стр), Новый Структура("Количество, Сумма", Стр.КоличествоОстаток, Стр.СуммаОстаток));
    Имена.Вставить(Ключ(Стр), Стр.Номенклатура);
  КонецЦикла;

  Запрос.Текст = "ВЫБРАТЬ
                    Номенклатура.Ссылка КАК НомИД,
                    Склад.Ссылка КАК СкладИД,
                    Организация.Ссылка КАК ОргИД,
                    Номенклатура,
                    КоличествоОстаток,
                    СуммаОстаток
                  ИЗ РегистрНакопления.ПартииТоваров.Остатки()";
  Партии = Новый Соответствие;
  МинусРазрешён = (Константы.РазрешитьОтрицательныеОстатки = Истина);
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Если МинусРазрешён = Ложь Тогда
      Утверждать.Истина(Стр.КоличествоОстаток >= 0,
        "отрицательная партия по «" + Строка(Стр.Номенклатура) + "»: " + Строка(Стр.КоличествоОстаток));
    КонецЕсли;
    Тек = Партии.Получить(Ключ(Стр));
    Если Тек = Неопределено Тогда
      Тек = Новый Структура("Количество, Сумма", 0, 0);
      Партии.Вставить(Ключ(Стр), Тек);
      Имена.Вставить(Ключ(Стр), Стр.Номенклатура);
    КонецЕсли;
    Тек.Количество = Тек.Количество + Стр.КоличествоОстаток;
    Тек.Сумма = Тек.Сумма + Стр.СуммаОстаток;
  КонецЦикла;

  Проверено = Новый Соответствие;
  Для Каждого Пара Из Товары Цикл
    Проверено.Вставить(Пара.Ключ, Истина);
    Партия = Партии.Получить(Пара.Ключ);
    Количество = 0;
    Сумма = 0;
    Если Партия <> Неопределено Тогда
      Количество = Партия.Количество;
      Сумма = Партия.Сумма;
    КонецЕсли;
    Имя = Строка(Имена.Получить(Пара.Ключ));
    Утверждать.Равно(Количество, Пара.Значение.Количество, "количество партий = остаток товара «" + Имя + "»");
    Утверждать.Равно(Окр(Сумма, 2), Окр(Пара.Значение.Сумма, 2), "сумма партий = стоимость остатка «" + Имя + "»");
  КонецЦикла;
  Для Каждого Пара Из Партии Цикл
    Если Проверено.Получить(Пара.Ключ) = Неопределено Тогда
      Утверждать.Равно(Пара.Значение.Количество, 0,
        "партия без остатка товара «" + Строка(Имена.Получить(Пара.Ключ)) + "»");
    КонецЕсли;
  КонецЦикла;
КонецПроцедуры

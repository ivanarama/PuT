						НовСтр.Количество = Кол;
						НовСтр.Цена = Знч(СтрТЧ, "price");
						НовСтр.Сумма = Знч(СтрТЧ, "amountWithVAT", "amount", "total");
						СклСтр = MapСклад.Получить(Знч(СтрТЧ, "warehouse", "warehouseId"));
						Если СклСтр <> Неопределено И ЗначениеЗаполнено(СклСтр) Тогда
							НовСтр.Склад = СклСтр;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Если Док.Товары.Количество() > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "КомплектацияНоменклатуры" Тогда
				ВидОп = Знч(ДокJSON, "operationType");
				Если ВидОп = "Разборка" Тогда
					Док = Документы.РазборкаТоваров.Создать();
					Док.Номер = Знч(ДокJSON, "number", "Номер");
					Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
					
					Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
					Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
					Док.Организация = Орг;
					Док.Склад = ПолучитьСкладДокумента(ДокJSON, MapСклад, ПервыйСклад);
					
					// Разбираемая продукция (Расход)
					НомКомплект = MapНом.Получить(Знч(ДокJSON, "item", "setNomenclatureId"));
					Если НомКомплект <> Неопределено И ЗначениеЗаполнено(НомКомплект) Тогда
						НовСтр = Док.Расход.Добавить();
						НовСтр.Номенклатура = НомКомплект;
						НовСтр.Количество = Знч(ДокJSON, "quantity");
					КонецЕсли;
					
					// Комплектующие (Приход)
					ТЧ = Знч(ДокJSON, "lines", "items", "Товары");
					Если ТЧ <> Неопределено Тогда
						Для Каждого СтрТЧ Из ТЧ Цикл
							Ном = MapНом.Получить(Знч(СтрТЧ, "item", "nomenclatureId"));
							Если Ном = Неопределено Или Не ЗначениеЗаполнено(Ном) Тогда
								Продолжить;
							КонецЕсли;
							Кол = Знч(СтрТЧ, "quantity");
							Если Кол <= 0 Тогда
								Продолжить;
							КонецЕсли;
							НовСтр = Док.Приход.Добавить();
							НовСтр.Номенклатура = Ном;
							НовСтр.Количество = Кол;
						КонецЦикла;
					КонецЕсли;
					
					Если Док.Расход.Количество() > 0 И Док.Приход.Количество() > 0 Тогда
						Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
					КонецЕсли;
				Иначе
					Док = Документы.СборкаТоваров.Создать();
					Док.Номер = Знч(ДокJSON, "number", "Номер");
					Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
					
					Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
					Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
					Док.Организация = Орг;
					Док.Склад = ПолучитьСкладДокумента(ДокJSON, MapСклад, ПервыйСклад);
					
					// Готовая продукция (Приход)
					НомКомплект = MapНом.Получить(Знч(ДокJSON, "item", "setNomenclatureId"));
					Если НомКомплект <> Неопределено И ЗначениеЗаполнено(НомКомплект) Тогда
						НовСтр = Док.Приход.Добавить();
						НовСтр.Номенклатура = НомКомплект;
						НовСтр.Количество = Знч(ДокJSON, "quantity");
					КонецЕсли;
					
					// Комплектующие (Расход)
					ТЧ = Знч(ДокJSON, "lines", "items", "Товары");
					Если ТЧ <> Неопределено Тогда
						Для Каждого СтрТЧ Из ТЧ Цикл
							Ном = MapНом.Получить(Знч(СтрТЧ, "item", "nomenclatureId"));
							Если Ном = Неопределено Или Не ЗначениеЗаполнено(Ном) Тогда
								Продолжить;
							КонецЕсли;
							Кол = Знч(СтрТЧ, "quantity");
							Если Кол <= 0 Тогда
								Продолжить;
							КонецЕсли;
							НовСтр = Док.Расход.Добавить();
							НовСтр.Номенклатура = Ном;
							НовСтр.Количество = Кол;
						КонецЦикла;
					КонецЕсли;
					
					Если Док.Расход.Количество() > 0 И Док.Приход.Количество() > 0 Тогда
						Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
					КонецЕсли;
				КонецЕсли;

			ИначеЕсли ТипДок = "ПриходныйКассовыйОрдер" Тогда
				Док = Документы.ПриходныйКассовыйОрдер.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				
				Контр = MapКонтр.Получить(Знч(ДокJSON, "counterparty", "counterpartyId"));
				Если Контр = Неопределено Или Не ЗначениеЗаполнено(Контр) Тогда
					Контр = КонтрРозничный;
				КонецЕсли;
				Док.Контрагент = Контр;
				Док.Касса = КассаНаличная;
				
				СуммаДок = Знч(ДокJSON, "totalAmount", "amountTotal", "amount");
				Док.Сумма = СуммаДок;
				Док.Основание = Знч(ДокJSON, "operationType", "comment");
				
				Если Док.Сумма > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "РасходныйКассовыйОрдер" Тогда
				Док = Документы.РасходныйКассовыйОрдер.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				
				Контр = MapКонтр.Получить(Знч(ДокJSON, "counterparty", "counterpartyId"));
				Если Контр = Неопределено Или Не ЗначениеЗаполнено(Контр) Тогда
					Контр = КонтрРозничный;
				КонецЕсли;
				Док.Контрагент = Контр;
				Док.Касса = КассаНаличная;
				
				СуммаДок = Знч(ДокJSON, "totalAmount", "amountTotal", "amount");
				Док.Сумма = СуммаДок;
				Док.Основание = Знч(ДокJSON, "operationType", "comment");
				
				Если Док.Сумма > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "ПоступлениеНаРасчётныйСчёт" Тогда
				Док = Документы.ПоступлениеНаРасчётныйСчёт.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				
				Контр = MapКонтр.Получить(Знч(ДокJSON, "counterparty", "counterpartyId"));
				Если Контр = Неопределено Или Не ЗначениеЗаполнено(Контр) Тогда
					Контр = КонтрРозничный;
				КонецЕсли;
				Док.Контрагент = Контр;
				Док.БанковскийСчёт = СчетБезналичный;
				
				СуммаДок = Знч(ДокJSON, "totalAmount", "amountTotal", "amount");
				Док.Сумма = СуммаДок;
				Док.НазначениеПлатежа = Знч(ДокJSON, "operationType", "comment");
				
				Если Док.Сумма > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "СписаниеСРасчётногоСчёта" Тогда
				Док = Документы.СписаниеСРасчётногоСчёта.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				
				Контр = MapКонтр.Получить(Знч(ДокJSON, "counterparty", "counterpartyId"));
				Если Контр = Неопределено Или Не ЗначениеЗаполнено(Контр) Тогда
					Контр = КонтрРозничный;
				КонецЕсли;
				Док.Контрагент = Контр;
				Док.БанковскийСчёт = СчетБезналичный;
				
				СуммаДок = Знч(ДокJSON, "totalAmount", "amountTotal", "amount");
				Док.Сумма = СуммаДок;
				Док.НазначениеПлатежа = Знч(ДокJSON, "operationType", "comment");
				
				Если Док.Сумма > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;
			КонецЕсли;

		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("Ошибка проведения " + ТипДок + " " + Знч(ДокJSON, "number", "Номер") + " от " + Знч(ДокJSON, "date", "Дата") + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Сообщить("=== ИТОГИ ЗАГРУЗКИ ===");
	Сообщить("Успешно проведено: " + Успешно + " документов");
	Сообщить("Ошибок: " + Ошибок);
КонецПроцедуры

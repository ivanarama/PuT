// Обработка загрузки дампа данных из 1С (УТ 10.3 и УТ 11.5) в OneBase (PuT)
//
// Идемпотентность: сущности сопоставляются по реквизиту «Идентификатор1С»
// (GUID из дампа). Повторный запуск не создаёт дубли: уже загруженные
// документы пропускаются, справочники находятся по идентификатору.
// Документы с признаком deletionMark (ПометкаУдаления) не загружаются.

Функция Знч(Стр, К1, К2 = "", К3 = "", К4 = "")
	Если Стр = Неопределено Или Стр = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	Знач1 = Стр.Получить(К1);
	Если Знач1 <> Неопределено И Знач1 <> Null Тогда
		Возврат Знач1;
	КонецЕсли;
	Если К2 <> "" Тогда
		Знач2 = Стр.Получить(К2);
		Если Знач2 <> Неопределено И Знач2 <> Null Тогда
			Возврат Знач2;
		КонецЕсли;
	КонецЕсли;
	Если К3 <> "" Тогда
		Знач3 = Стр.Получить(К3);
		Если Знач3 <> Неопределено И Знач3 <> Null Тогда
			Возврат Знач3;
		КонецЕсли;
	КонецЕсли;
	Если К4 <> "" Тогда
		Знач4 = Стр.Получить(К4);
		Если Знач4 <> Неопределено И Знач4 <> Null Тогда
			Возврат Знач4;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Поиск элемента справочника сначала по GUID из 1С, затем по наименованию.
Функция НайтиПоИд1С(Менеджер, Ид1С, Имя)
	Если Ид1С <> Неопределено И ЗначениеЗаполнено(Ид1С) Тогда
		Найденный = Менеджер.НайтиПоРеквизиту("Идентификатор1С", Ид1С);
		Если ЗначениеЗаполнено(Найденный) Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Имя) Тогда
		Возврат Менеджер.НайтиПоНаименованию(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьСкладДокумента(ДокJSON, MapСклад, ПервыйСклад)
	СклID = Знч(ДокJSON, "warehouse", "warehouseId");
	Если СклID <> Неопределено И СклID <> "00000000-0000-0000-0000-000000000000" Тогда
		Скл = MapСклад.Получить(СклID);
		Если Скл <> Неопределено И ЗначениеЗаполнено(Скл) Тогда
			Возврат Скл;
		КонецЕсли;
	КонецЕсли;
	ТЧ = Знч(ДокJSON, "lines", "items", "Товары");
	Если ТЧ <> Неопределено И ТЧ.Количество() > 0 Тогда
		Для Каждого Стр Из ТЧ Цикл
			СклСтрокиID = Знч(Стр, "warehouse");
			Если СклСтрокиID <> Неопределено И СклСтрокиID <> "00000000-0000-0000-0000-000000000000" Тогда
				СклСтроки = MapСклад.Получить(СклСтрокиID);
				Если СклСтроки <> Неопределено И ЗначениеЗаполнено(СклСтроки) Тогда
					Возврат СклСтроки;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ПервыйСклад;
КонецФункции

Функция ЗаписатьИПровестиДокумент(Док, ДокJSON)
	Док.Записать();
	ПризнакПроведен = Знч(ДокJSON, "posted", "Проведен");
	Если ПризнакПроведен = Неопределено Или ПризнакПроведен = Истина Или ПризнакПроведен = 1 Или Строка(ПризнакПроведен) = "True" Или Строка(ПризнакПроведен) = "Истина" Или Строка(ПризнакПроведен) = "Да" Тогда
		Док.Провести();
	КонецЕсли;
	Возврат 1;
КонецФункции

// Сортировка слиянием документов по дате из дампа (строки ISO сравнимы лексикографически).
Функция СортироватьДокументыПоДате(МассивДок)
	Если МассивДок.Количество() < 2 Тогда
		Возврат МассивДок;
	КонецЕсли;
	Середина = Цел(МассивДок.Количество() / 2);
	Левый = Новый Массив;
	Правый = Новый Массив;
	Для Индекс = 0 По Середина - 1 Цикл
		Левый.Добавить(МассивДок[Индекс]);
	КонецЦикла;
	Для Индекс = Середина По МассивДок.Количество() - 1 Цикл
		Правый.Добавить(МассивДок[Индекс]);
	КонецЦикла;
	Левый = СортироватьДокументыПоДате(Левый);
	Правый = СортироватьДокументыПоДате(Правый);

	Результат = Новый Массив;
	ИЛ = 0;
	ИП = 0;
	Пока ИЛ < Левый.Количество() И ИП < Правый.Количество() Цикл
		Если Левый[ИЛ].date <= Правый[ИП].date Тогда
			Результат.Добавить(Левый[ИЛ]);
			ИЛ = ИЛ + 1;
		Иначе
			Результат.Добавить(Правый[ИП]);
			ИП = ИП + 1;
		КонецЕсли;
	КонецЦикла;
	Пока ИЛ < Левый.Количество() Цикл
		Результат.Добавить(Левый[ИЛ]);
		ИЛ = ИЛ + 1;
	КонецЦикла;
	Пока ИП < Правый.Количество() Цикл
		Результат.Добавить(Правый[ИП]);
		ИП = ИП + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, ИмяСекции1С, ИмяТипаOneBase)
	Если ДокументыJSON = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Список = ДокументыJSON.Получить(ИмяСекции1С);
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ДокJSON Из Список Цикл
		Элм = Новый Структура;
		Элм.Вставить("type", ИмяТипаOneBase);
		Элм.Вставить("data", ДокJSON);
		Элм.Вставить("date", Знч(ДокJSON, "date", "Дата"));
		ВсеДокументы.Добавить(Элм);
	КонецЦикла;
КонецПроцедуры

// Заполнение товарной ТЧ из JSON. Режим:
//   "Продажа"       — Цена, Сумма, СуммаНДС, СтавкаНДС, Склад
//   "Оприходование" — Цена, Сумма, Склад
//   "Простой"       — Количество, Склад
Процедура ЗаполнитьСтрокиТоваров(Док, ДокJSON, MapНом, MapСклад, MapСтавки, Режим)
	ТЧ = Знч(ДокJSON, "lines", "items", "Товары");
	Если ТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрТЧ Из ТЧ Цикл
		Ном = MapНом.Получить(Знч(СтрТЧ, "item", "nomenclatureId"));
		Если Ном = Неопределено Или Не ЗначениеЗаполнено(Ном) Тогда
			Продолжить;
		КонецЕсли;
		Кол = Знч(СтрТЧ, "quantity");
		Если Не ЗначениеЗаполнено(Кол) Или Кол <= 0 Тогда
			Продолжить;
		КонецЕсли;
		НовСтр = Док.Товары.Добавить();
		НовСтр.Номенклатура = Ном;
		НовСтр.Количество = Кол;
		Если Режим = "Продажа" Или Режим = "Оприходование" Тогда
			НовСтр.Цена = Знч(СтрТЧ, "price");
			НовСтр.Сумма = Знч(СтрТЧ, "amountWithVAT", "amount", "total");
		КонецЕсли;
		Если Режим = "Продажа" Тогда
			НовСтр.СуммаНДС = Знч(СтрТЧ, "vatAmount");
			Ставка = MapСтавки.Получить(Знч(СтрТЧ, "vatRate"));
			Если Ставка <> Неопределено Тогда
				НовСтр.СтавкаНДС = Ставка;
			КонецЕсли;
		КонецЕсли;
		СклСтр = MapСклад.Получить(Знч(СтрТЧ, "warehouse", "warehouseId"));
		Если СклСтр <> Неопределено И ЗначениеЗаполнено(СклСтр) Тогда
			НовСтр.Склад = СклСтр;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Шапка товарного документа: номер, дата, организация, контрагент, склад, НДС.
Процедура ЗаполнитьШапкуТоварногоДокумента(Док, ДокJSON, Контекст, ИмяКонтрагентаПоля)
	Док.Номер = Знч(ДокJSON, "number", "Номер");
	Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
	Орг = Контекст.MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
	Если Орг = Неопределено Тогда
		Орг = Контекст.ПерваяОрг;
	КонецЕсли;
	Док.Организация = Орг;
	Если ИмяКонтрагентаПоля = "Поставщик" Тогда
		Док.Поставщик = Контекст.КонтрагентПоУмолчанию;
	Иначе
		Док.Покупатель = Контекст.КонтрагентПоУмолчанию;
	КонецЕсли;
	Контр = Контекст.MapКонтр.Получить(Знч(ДокJSON, "counterparty", "counterpartyId"));
	Если ЗначениеЗаполнено(Контр) Тогда
		Если ИмяКонтрагентаПоля = "Поставщик" Тогда
			Док.Поставщик = Контр;
		Иначе
			Док.Покупатель = Контр;
		КонецЕсли;
	КонецЕсли;
	Док.Склад = ПолучитьСкладДокумента(ДокJSON, Контекст.MapСклад, Контекст.ПервыйСклад);
	Если Знч(ДокJSON, "priceIncludesVAT", "vatIncluded") = Истина Тогда
		Док.СпособУчетаНДС = Перечисления.СпособУчетаНДС.ВТомЧисле;
	Иначе
		Док.СпособУчетаНДС = Перечисления.СпособУчетаНДС.Сверху;
	КонецЕсли;
КонецПроцедуры

Процедура Выполнить()
	ФайлJSON = Параметры.ФайлJSON;
	Если ФайлJSON = "" Или ФайлJSON = Неопределено Тогда
		ВызватьИсключение "Параметр ФайлJSON не задан";
	КонецЕсли;

	Сообщить("Чтение JSON-дампа: " + ФайлJSON + "...");
	Константы.РазрешитьОтрицательныеОстатки = Истина;
	Данные = ReadJSON(ФайлJSON);

	СправочникиJSON = Данные.Получить("catalogs");
	ДокументыJSON = Данные.Получить("documents");

	Контекст = Новый Структура;

	// 1. Ставки НДС
	MapСтавки = Новый Соответствие;
	СтавкиСписок = Новый Массив;
	СтавкиСписок.Добавить("Без НДС");
	СтавкиСписок.Добавить("0%");
	СтавкиСписок.Добавить("10%");
	СтавкиСписок.Добавить("18%");
	СтавкиСписок.Добавить("20%");

	Для Каждого ИмяСтавки Из СтавкиСписок Цикл
		Ставка = Справочники.СтавкаНДС.НайтиПоНаименованию(ИмяСтавки);
		Если Ставка = Неопределено Или Не ЗначениеЗаполнено(Ставка) Тогда
			НовСтавка = Справочники.СтавкаНДС.Создать();
			НовСтавка.Наименование = ИмяСтавки;
			Если ИмяСтавки = "20%" Тогда
				НовСтавка.Ставка = 20;
			ИначеЕсли ИмяСтавки = "18%" Тогда
				НовСтавка.Ставка = 18;
			ИначеЕсли ИмяСтавки = "10%" Тогда
				НовСтавка.Ставка = 10;
			Иначе
				НовСтавка.Ставка = 0;
			КонецЕсли;
			НовСтавка.Записать();
			Ставка = НовСтавка.Ссылка;
		КонецЕсли;
		MapСтавки.Вставить(ИмяСтавки, Ставка);
	КонецЦикла;

	// 2. Единицы измерения
	MapЕдИзм = Новый Соответствие;
	ЕдШт = Справочники.ЕдиницаИзмерения.НайтиПоНаименованию("шт");
	Если ЕдШт = Неопределено Или Не ЗначениеЗаполнено(ЕдШт) Тогда
		НовЕд = Справочники.ЕдиницаИзмерения.Создать();
		НовЕд.Наименование = "шт";
		НовЕд.Записать();
		ЕдШт = НовЕд.Ссылка;
	КонецЕсли;
	MapЕдИзм.Вставить("шт", ЕдШт);

	// Типы цен
	Закупочная = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");
	Если Не ЗначениеЗаполнено(Закупочная) Тогда
		Запись = Справочники.ТипЦен.Создать();
		Запись.Наименование = "Закупочная";
		Запись.ВидРасчета   = "Хранимый";
		Запись.Округление   = 2;
		Запись.Записать();
		Закупочная = Запись.Ссылка;
	КонецЕсли;
	Розничная = Справочники.ТипЦен.НайтиПоНаименованию("Розничная");
	Если Не ЗначениеЗаполнено(Розничная) Тогда
		Запись = Справочники.ТипЦен.Создать();
		Запись.Наименование = "Розничная";
		Запись.ВидРасчета   = "Расчетный";
		Запись.БазовыйТип   = Закупочная;
		Запись.Процент      = 30;
		Запись.Округление   = 2;
		Запись.Записать();
	КонецЕсли;
	Оптовая = Справочники.ТипЦен.НайтиПоНаименованию("Оптовая");
	Если Не ЗначениеЗаполнено(Оптовая) Тогда
		Запись = Справочники.ТипЦен.Создать();
		Запись.Наименование = "Оптовая";
		Запись.ВидРасчета   = "Расчетный";
		Запись.БазовыйТип   = Закупочная;
		Запись.Процент      = 10;
		Запись.Округление   = 2;
		Запись.Записать();
	КонецЕсли;

	// 3. Организации
	MapОрг = Новый Соответствие;
	ОрганизацииСписок = СправочникиJSON.Получить("Организации");
	ПерваяОрг = Неопределено;
	Если ОрганизацииСписок <> Неопределено Тогда
		Для Каждого ОргJSON Из ОрганизацииСписок Цикл
			ИмяОрг = Знч(ОргJSON, "name", "Наименование");
			ИдОрг = Знч(ОргJSON, "id", "Ссылка");
			Орг = НайтиПоИд1С(Справочники.Организация, ИдОрг, ИмяОрг);
			Если Орг = Неопределено Или Не ЗначениеЗаполнено(Орг) Тогда
				НовОрг = Справочники.Организация.Создать();
				НовОрг.Наименование = ИмяОрг;
				НовОрг.ПолноеНаименование = Знч(ОргJSON, "nameFull", "НаименованиеПолное");
				НовОрг.ИНН = Знч(ОргJSON, "inn", "ИНН");
				НовОрг.КПП = Знч(ОргJSON, "kpp", "КПП");
				НовОрг.Идентификатор1С = ИдОрг;
				НовОрг.Записать();
				Орг = НовОрг.Ссылка;
			КонецЕсли;
			MapОрг.Вставить(ИдОрг, Орг);
			Если ПерваяОрг = Неопределено Тогда
				ПерваяОрг = Орг;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Сообщить("Загружено организаций: " + MapОрг.Количество());

	// 4. Склады
	MapСклад = Новый Соответствие;
	СкладыСписок = СправочникиJSON.Получить("Склады");
	ПервыйСклад = Неопределено;
	Если СкладыСписок <> Неопределено Тогда
		Для Каждого СкладJSON Из СкладыСписок Цикл
			ИмяСкл = Знч(СкладJSON, "name", "Наименование");
			Если ИмяСкл = Неопределено Или СокрЛП(Строка(ИмяСкл)) = "" Тогда
				Продолжить;
			КонецЕсли;
			ИдСкл = Знч(СкладJSON, "id", "Ссылка");
			Скл = НайтиПоИд1С(Справочники.Склад, ИдСкл, ИмяСкл);
			Если Скл = Неопределено Или Не ЗначениеЗаполнено(Скл) Тогда
				НовСкл = Справочники.Склад.Создать();
				НовСкл.Наименование = ИмяСкл;
				НовСкл.Идентификатор1С = ИдСкл;
				НовСкл.Записать();
				Скл = НовСкл.Ссылка;
			КонецЕсли;
			MapСклад.Вставить(ИдСкл, Скл);
			Если ПервыйСклад = Неопределено Тогда
				ПервыйСклад = Скл;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Сообщить("Загружено складов: " + MapСклад.Количество());

	// Кассы и банковские счета
	КассаНаличная = Справочники.Касса.НайтиПоНаименованию("Основная касса");
	Если КассаНаличная = Неопределено Или Не ЗначениеЗаполнено(КассаНаличная) Тогда
		НовКасса = Справочники.Касса.Создать();
		НовКасса.Наименование = "Основная касса";
		НовКасса.Вид = Перечисления.ВидКассы.Касса;
		НовКасса.Записать();
		КассаНаличная = НовКасса.Ссылка;
	КонецЕсли;

	СчетБезналичный = Справочники.Касса.НайтиПоНаименованию("Основной расчетный счет");
	Если СчетБезналичный = Неопределено Или Не ЗначениеЗаполнено(СчетБезналичный) Тогда
		НовСчет = Справочники.Касса.Создать();
		НовСчет.Наименование = "Основной расчетный счет";
		НовСчет.Вид = Перечисления.ВидКассы.БанковскийСчёт;
		НовСчет.Записать();
		СчетБезналичный = НовСчет.Ссылка;
	КонецЕсли;

	// 5. Контрагенты
	MapКонтр = Новый Соответствие;
	КонтрРозничный = Справочники.Контрагент.НайтиПоНаименованию("Розничный покупатель");
	Если КонтрРозничный = Неопределено Или Не ЗначениеЗаполнено(КонтрРозничный) Тогда
		НовКонтр = Справочники.Контрагент.Создать();
		НовКонтр.Наименование = "Розничный покупатель";
		НовКонтр.ПолноеНаименование = "Розничный покупатель";
		НовКонтр.Вид = Перечисления.ВидКонтрагента.Покупатель;
		НовКонтр.Покупатель = Истина;
		НовКонтр.Поставщик = Ложь;
		НовКонтр.Записать();
		КонтрРозничный = НовКонтр.Ссылка;
	КонецЕсли;

	КонтрагентыСписок = СправочникиJSON.Получить("Контрагенты");
	Если КонтрагентыСписок <> Неопределено Тогда
		Для Каждого КонтрJSON Из КонтрагентыСписок Цикл
			Если Знч(КонтрJSON, "isFolder", "ЭтоГруппа") = Истина Тогда
				Продолжить;
			КонецЕсли;
			ИмяКонтр = Знч(КонтрJSON, "name", "Наименование");
			ИдКонтр = Знч(КонтрJSON, "id", "Ссылка");
			Контр = НайтиПоИд1С(Справочники.Контрагент, ИдКонтр, ИмяКонтр);
			Если Контр = Неопределено Или Не ЗначениеЗаполнено(Контр) Тогда
				НовКонтр = Справочники.Контрагент.Создать();
				НовКонтр.Наименование = ИмяКонтр;
				НовКонтр.ПолноеНаименование = Знч(КонтрJSON, "nameFull", "НаименованиеПолное");
				НовКонтр.ИНН = Знч(КонтрJSON, "inn", "ИНН");
				НовКонтр.КПП = Знч(КонтрJSON, "kpp", "КПП");

				IsCust = Знч(КонтрJSON, "isCustomer", "Покупатель");
				IsVend = Знч(КонтрJSON, "isVendor", "Поставщик");
				Если IsCust = Истина И IsVend = Истина Тогда
					НовКонтр.Вид = Перечисления.ВидКонтрагента.Покупатель;
					НовКонтр.Покупатель = Истина;
					НовКонтр.Поставщик = Истина;
				ИначеЕсли IsCust = Истина Тогда
					НовКонтр.Вид = Перечисления.ВидКонтрагента.Покупатель;
					НовКонтр.Покупатель = Истина;
					НовКонтр.Поставщик = Ложь;
				ИначеЕсли IsVend = Истина Тогда
					НовКонтр.Вид = Перечисления.ВидКонтрагента.Поставщик;
					НовКонтр.Покупатель = Ложь;
					НовКонтр.Поставщик = Истина;
				Иначе
					НовКонтр.Вид = Перечисления.ВидКонтрагента.Прочее;
					НовКонтр.Покупатель = Ложь;
					НовКонтр.Поставщик = Ложь;
				КонецЕсли;

				НовКонтр.Идентификатор1С = ИдКонтр;
				НовКонтр.Записать();
				Контр = НовКонтр.Ссылка;
			КонецЕсли;
			MapКонтр.Вставить(ИдКонтр, Контр);
		КонецЦикла;
	КонецЕсли;
	Сообщить("Загружено контрагентов: " + MapКонтр.Количество());

	// 6. Номенклатура
	MapНом = Новый Соответствие;
	НоменклатураСписок = СправочникиJSON.Получить("Номенклатура");
	Если НоменклатураСписок <> Неопределено Тогда
		Для Каждого НомJSON Из НоменклатураСписок Цикл
			Если Знч(НомJSON, "isFolder", "ЭтоГруппа") = Истина Тогда
				Продолжить;
			КонецЕсли;
			ИмяНом = Знч(НомJSON, "name", "Наименование");
			ИдНом = Знч(НомJSON, "id", "Ссылка");
			Ном = НайтиПоИд1С(Справочники.Номенклатура, ИдНом, ИмяНом);
			Если Ном = Неопределено Или Не ЗначениеЗаполнено(Ном) Тогда
				НовНом = Справочники.Номенклатура.Создать();
				НовНом.Наименование = ИмяНом;
				НовНом.Артикул = Знч(НомJSON, "article", "Артикул");

				Тип1С = Знч(НомJSON, "type", "ТипНоменклатуры");
				Если Тип1С <> Неопределено И СтрНайти(Тип1С, "Услуга") > 0 Тогда
					НовНом.Услуга = Истина;
				Иначе
					НовНом.Услуга = Ложь;
				КонецЕсли;

				Ставка = MapСтавки.Получить(Знч(НомJSON, "vatRate", "СтавкаНДС"));
				Если Ставка <> Неопределено Тогда
					НовНом.СтавкаНДС = Ставка;
				КонецЕсли;

				НовНом.ЕдиницаИзмерения = ЕдШт;
				НовНом.Идентификатор1С = ИдНом;
				НовНом.Записать();
				Ном = НовНом.Ссылка;
			КонецЕсли;
			MapНом.Вставить(ИдНом, Ном);
		КонецЦикла;
	КонецЕсли;
	Сообщить("Загружено номенклатуры: " + MapНом.Количество());

	// 7. Сбор всех документов в хронологический массив
	ВсеДокументы = Новый Массив;

	Если ТипЗнч(ДокументыJSON) = Тип("Массив") Тогда
		Для Каждого ДокJSON Из ДокументыJSON Цикл
			Тип1С = Знч(ДокJSON, "type", "Тип");
			ТипOneBase = Тип1С;
			Если Тип1С = "ПоступлениеТоваровУслуг" Тогда
				ТипOneBase = "ПоступлениеТоваров";
			ИначеЕсли Тип1С = "РеализацияТоваровУслуг" Тогда
				ТипOneBase = "РеализацияТоваров";
			ИначеЕсли Тип1С = "ВозвратТоваровПоставщику" Тогда
				ТипOneBase = "ВозвратПоставщику";
			ИначеЕсли Тип1С = "ВозвратТоваровОтПокупателя" Тогда
				ТипOneBase = "ВозвратОтПокупателя";
			ИначеЕсли Тип1С = "ПКО" Или Тип1С = "ПриходныйКассовыйОрдер" Тогда
				ТипOneBase = "ПриходныйКассовыйОрдер";
			ИначеЕсли Тип1С = "РКО" Или Тип1С = "РасходныйКассовыйОрдер" Тогда
				ТипOneBase = "РасходныйКассовыйОрдер";
			ИначеЕсли Тип1С = "ПоступлениеНаРасчетныйСчет" Или Тип1С = "ПлатежноеПоручениеВходящее" Тогда
				ТипOneBase = "ПоступлениеНаРасчётныйСчёт";
			ИначеЕсли Тип1С = "СписаниеСРасчетногоСчета" Или Тип1С = "ПлатежноеПоручениеИсходящее" Тогда
				ТипOneBase = "СписаниеСРасчётногоСчёта";
			КонецЕсли;

			Элм = Новый Структура;
			Элм.Вставить("type", ТипOneBase);
			Элм.Вставить("data", ДокJSON);
			Элм.Вставить("date", Знч(ДокJSON, "date", "Дата"));
			ВсеДокументы.Добавить(Элм);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокументыJSON) = Тип("Соответствие") Или ТипЗнч(ДокументыJSON) = Тип("Структура") Тогда
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ПоступлениеТоваровУслуг", "ПоступлениеТоваров");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "РеализацияТоваровУслуг", "РеализацияТоваров");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ВозвратТоваровПоставщику", "ВозвратПоставщику");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ВозвратТоваровОтПокупателя", "ВозвратОтПокупателя");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ПеремещениеТоваров", "ПеремещениеТоваров");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "СписаниеТоваров", "СписаниеТоваров");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ОприходованиеТоваров", "ОприходованиеТоваров");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "КомплектацияНоменклатуры", "КомплектацияНоменклатуры");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ПриходныйКассовыйОрдер", "ПриходныйКассовыйОрдер");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "РасходныйКассовыйОрдер", "РасходныйКассовыйОрдер");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ПлатежноеПоручениеВходящее", "ПоступлениеНаРасчётныйСчёт");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ПлатежноеПоручениеИсходящее", "СписаниеСРасчётногоСчёта");
	КонецЕсли;

	Сообщить("Всего документов к проведению: " + ВсеДокументы.Количество());

	// Сортировка документов по дате
	ВсеДокументы = СортироватьДокументыПоДате(ВсеДокументы);

	// 8. Создание и проведение документов
	Контекст.Вставить("MapОрг", MapОрг);
	Контекст.Вставить("MapКонтр", MapКонтр);
	Контекст.Вставить("MapСклад", MapСклад);
	Контекст.Вставить("ПерваяОрг", ПерваяОрг);
	Контекст.Вставить("ПервыйСклад", ПервыйСклад);
	Контекст.Вставить("КонтрагентПоУмолчанию", КонтрРозничный);

	Успешно = 0;
	Ошибок = 0;
	Пропущено = 0;

	Для Каждого Элемент Из ВсеДокументы Цикл
		ТипДок = Элемент.type;
		ДокJSON = Элемент.data;

		// Помеченные на удаление не загружаем
		Если Знч(ДокJSON, "deletionMark", "ПометкаУдаления") = Истина Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Ид1СДок = Знч(ДокJSON, "id", "Ссылка");

		Попытка
			Если ТипДок = "ПоступлениеТоваров" Тогда
				// Идемпотентность: документ с этим GUID уже загружен — пропускаем
				Существующий = НайтиПоИд1С(Документы.ПоступлениеТоваров, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.ПоступлениеТоваров.Создать();
				ЗаполнитьШапкуТоварногоДокумента(Док, ДокJSON, Контекст, "Поставщик");
				Док.Идентификатор1С = Ид1СДок;
				ЗаполнитьСтрокиТоваров(Док, ДокJSON, MapНом, MapСклад, MapСтавки, "Продажа");
				Если Док.Товары.Количество() > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "РеализацияТоваров" Тогда
				Существующий = НайтиПоИд1С(Документы.РеализацияТоваров, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.РеализацияТоваров.Создать();
				ЗаполнитьШапкуТоварногоДокумента(Док, ДокJSON, Контекст, "Покупатель");
				Док.Идентификатор1С = Ид1СДок;
				ЗаполнитьСтрокиТоваров(Док, ДокJSON, MapНом, MapСклад, MapСтавки, "Продажа");
				Если Док.Товары.Количество() > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "ВозвратПоставщику" Тогда
				Существующий = НайтиПоИд1С(Документы.ВозвратПоставщику, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.ВозвратПоставщику.Создать();
				ЗаполнитьШапкуТоварногоДокумента(Док, ДокJSON, Контекст, "Поставщик");
				Док.Идентификатор1С = Ид1СДок;
				ЗаполнитьСтрокиТоваров(Док, ДокJSON, MapНом, MapСклад, MapСтавки, "Продажа");
				Если Док.Товары.Количество() > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "ВозвратОтПокупателя" Тогда
				Существующий = НайтиПоИд1С(Документы.ВозвратОтПокупателя, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.ВозвратОтПокупателя.Создать();
				ЗаполнитьШапкуТоварногоДокумента(Док, ДокJSON, Контекст, "Покупатель");
				Док.Идентификатор1С = Ид1СДок;
				ЗаполнитьСтрокиТоваров(Док, ДокJSON, MapНом, MapСклад, MapСтавки, "Продажа");
				Если Док.Товары.Количество() > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "ПеремещениеТоваров" Тогда
				Существующий = НайтиПоИд1С(Документы.ПеремещениеТоваров, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.ПеремещениеТоваров.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				Док.СкладОтправитель = MapСклад.Получить(Знч(ДокJSON, "sourceWarehouse", "warehouseSender", "warehouseSourceId", "warehouse"));
				Док.СкладПолучатель = MapСклад.Получить(Знч(ДокJSON, "targetWarehouse", "warehouseReceiver", "warehouseDestId"));
				Док.Идентификатор1С = Ид1СДок;

				Если Док.СкладОтправитель <> Док.СкладПолучатель И ЗначениеЗаполнено(Док.СкладОтправитель) И ЗначениеЗаполнено(Док.СкладПолучатель) Тогда
					ЗаполнитьСтрокиТоваров(Док, ДокJSON, MapНом, MapСклад, MapСтавки, "Простой");
					Если Док.Товары.Количество() > 0 Тогда
						Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
					КонецЕсли;
				КонецЕсли;

			ИначеЕсли ТипДок = "СписаниеТоваров" Тогда
				Существующий = НайтиПоИд1С(Документы.СписаниеТоваров, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.СписаниеТоваров.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				Док.Склад = ПолучитьСкладДокумента(ДокJSON, MapСклад, ПервыйСклад);
				Док.Идентификатор1С = Ид1СДок;
				ЗаполнитьСтрокиТоваров(Док, ДокJSON, MapНом, MapСклад, MapСтавки, "Простой");
				Если Док.Товары.Количество() > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "ОприходованиеТоваров" Тогда
				Существующий = НайтиПоИд1С(Документы.ОприходованиеТоваров, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.ОприходованиеТоваров.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				Док.Склад = ПолучитьСкладДокумента(ДокJSON, MapСклад, ПервыйСклад);
				Док.Идентификатор1С = Ид1СДок;
				ЗаполнитьСтрокиТоваров(Док, ДокJSON, MapНом, MapСклад, MapСтавки, "Оприходование");
				Если Док.Товары.Количество() > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "КомплектацияНоменклатуры" Тогда
				Существующий = Неопределено;
				ВидОп = Знч(ДокJSON, "operationType");
				Если ВидОп = "Разборка" Тогда
					Существующий = НайтиПоИд1С(Документы.РазборкаТоваров, Ид1СДок, "");
					Если ЗначениеЗаполнено(Существующий) Тогда
						Пропущено = Пропущено + 1;
						Продолжить;
					КонецЕсли;
					Док = Документы.РазборкаТоваров.Создать();
					Док.Номер = Знч(ДокJSON, "number", "Номер");
					Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
					Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
					Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
					Док.Организация = Орг;
					Док.Склад = ПолучитьСкладДокумента(ДокJSON, MapСклад, ПервыйСклад);
					Док.Идентификатор1С = Ид1СДок;

					// Разбираемая продукция (Расход)
					НомКомплект = MapНом.Получить(Знч(ДокJSON, "item", "setNomenclatureId"));
					Если НомКомплект <> Неопределено И ЗначениеЗаполнено(НомКомплект) Тогда
						НовСтр = Док.Расход.Добавить();
						НовСтр.Номенклатура = НомКомплект;
						НовСтр.Количество = Знч(ДокJSON, "quantity");
					КонецЕсли;

					// Комплектующие (Приход)
					ТЧ = Знч(ДокJSON, "lines", "items", "Товары");
					Если ТЧ <> Неопределено Тогда
						Для Каждого СтрТЧ Из ТЧ Цикл
							Ном = MapНом.Получить(Знч(СтрТЧ, "item", "nomenclatureId"));
							Если Ном = Неопределено Или Не ЗначениеЗаполнено(Ном) Тогда
								Продолжить;
							КонецЕсли;
							Кол = Знч(СтрТЧ, "quantity");
							Если Не ЗначениеЗаполнено(Кол) Или Кол <= 0 Тогда
								Продолжить;
							КонецЕсли;
							НовСтр = Док.Приход.Добавить();
							НовСтр.Номенклатура = Ном;
							НовСтр.Количество = Кол;
						КонецЦикла;
					КонецЕсли;

					Если Док.Расход.Количество() > 0 И Док.Приход.Количество() > 0 Тогда
						Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
					КонецЕсли;
				Иначе
					Существующий = НайтиПоИд1С(Документы.СборкаТоваров, Ид1СДок, "");
					Если ЗначениеЗаполнено(Существующий) Тогда
						Пропущено = Пропущено + 1;
						Продолжить;
					КонецЕсли;
					Док = Документы.СборкаТоваров.Создать();
					Док.Номер = Знч(ДокJSON, "number", "Номер");
					Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
					Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
					Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
					Док.Организация = Орг;
					Док.Склад = ПолучитьСкладДокумента(ДокJSON, MapСклад, ПервыйСклад);
					Док.Идентификатор1С = Ид1СДок;

					// Готовая продукция (Приход)
					НомКомплект = MapНом.Получить(Знч(ДокJSON, "item", "setNomenclatureId"));
					Если НомКомплект <> Неопределено И ЗначениеЗаполнено(НомКомплект) Тогда
						НовСтр = Док.Приход.Добавить();
						НовСтр.Номенклатура = НомКомплект;
						НовСтр.Количество = Знч(ДокJSON, "quantity");
					КонецЕсли;

					// Комплектующие (Расход)
					ТЧ = Знч(ДокJSON, "lines", "items", "Товары");
					Если ТЧ <> Неопределено Тогда
						Для Каждого СтрТЧ Из ТЧ Цикл
							Ном = MapНом.Получить(Знч(СтрТЧ, "item", "nomenclatureId"));
							Если Ном = Неопределено Или Не ЗначениеЗаполнено(Ном) Тогда
								Продолжить;
							КонецЕсли;
							Кол = Знч(СтрТЧ, "quantity");
							Если Не ЗначениеЗаполнено(Кол) Или Кол <= 0 Тогда
								Продолжить;
							КонецЕсли;
							НовСтр = Док.Расход.Добавить();
							НовСтр.Номенклатура = Ном;
							НовСтр.Количество = Кол;
						КонецЦикла;
					КонецЕсли;

					Если Док.Расход.Количество() > 0 И Док.Приход.Количество() > 0 Тогда
						Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
					КонецЕсли;
				КонецЕсли;

			ИначеЕсли ТипДок = "ПриходныйКассовыйОрдер" Тогда
				Существующий = НайтиПоИд1С(Документы.ПриходныйКассовыйОрдер, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.ПриходныйКассовыйОрдер.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				// В демо-дампах розничные платежи бывают без контрагента — подставляем заглушку.
				Контр = MapКонтр.Получить(Знч(ДокJSON, "counterparty", "counterpartyId"));
				Если ЗначениеЗаполнено(Контр) Тогда
					Док.Контрагент = Контр;
				Иначе
					Док.Контрагент = КонтрРозничный;
				КонецЕсли;
				Док.Касса = КассаНаличная;
				Док.Сумма = Знч(ДокJSON, "totalAmount", "amountTotal", "amount");
				Док.Основание = Знч(ДокJSON, "operationType", "comment");
				Док.Идентификатор1С = Ид1СДок;

				Если Док.Сумма > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "РасходныйКассовыйОрдер" Тогда
				Существующий = НайтиПоИд1С(Документы.РасходныйКассовыйОрдер, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.РасходныйКассовыйОрдер.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				// В демо-дампах розничные платежи бывают без контрагента — подставляем заглушку.
				Контр = MapКонтр.Получить(Знч(ДокJSON, "counterparty", "counterpartyId"));
				Если ЗначениеЗаполнено(Контр) Тогда
					Док.Контрагент = Контр;
				Иначе
					Док.Контрагент = КонтрРозничный;
				КонецЕсли;
				Док.Касса = КассаНаличная;
				Док.Сумма = Знч(ДокJSON, "totalAmount", "amountTotal", "amount");
				Док.Основание = Знч(ДокJSON, "operationType", "comment");
				Док.Идентификатор1С = Ид1СДок;

				Если Док.Сумма > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "ПоступлениеНаРасчётныйСчёт" Тогда
				Существующий = НайтиПоИд1С(Документы.ПоступлениеНаРасчётныйСчёт, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.ПоступлениеНаРасчётныйСчёт.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				// В демо-дампах розничные платежи бывают без контрагента — подставляем заглушку.
				Контр = MapКонтр.Получить(Знч(ДокJSON, "counterparty", "counterpartyId"));
				Если ЗначениеЗаполнено(Контр) Тогда
					Док.Контрагент = Контр;
				Иначе
					Док.Контрагент = КонтрРозничный;
				КонецЕсли;
				Док.БанковскийСчёт = СчетБезналичный;
				Док.Сумма = Знч(ДокJSON, "totalAmount", "amountTotal", "amount");
				Док.НазначениеПлатежа = Знч(ДокJSON, "operationType", "comment");
				Док.Идентификатор1С = Ид1СДок;

				Если Док.Сумма > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;

			ИначеЕсли ТипДок = "СписаниеСРасчётногоСчёта" Тогда
				Существующий = НайтиПоИд1С(Документы.СписаниеСРасчётногоСчёта, Ид1СДок, "");
				Если ЗначениеЗаполнено(Существующий) Тогда
					Пропущено = Пропущено + 1;
					Продолжить;
				КонецЕсли;
				Док = Документы.СписаниеСРасчётногоСчёта.Создать();
				Док.Номер = Знч(ДокJSON, "number", "Номер");
				Док.Дата = Дата(Знч(ДокJSON, "date", "Дата"));
				Орг = MapОрг.Получить(Знч(ДокJSON, "organization", "organizationId"));
				Если Орг = Неопределено Тогда Орг = ПерваяОрг; КонецЕсли;
				Док.Организация = Орг;
				// В демо-дампах розничные платежи бывают без контрагента — подставляем заглушку.
				Контр = MapКонтр.Получить(Знч(ДокJSON, "counterparty", "counterpartyId"));
				Если ЗначениеЗаполнено(Контр) Тогда
					Док.Контрагент = Контр;
				Иначе
					Док.Контрагент = КонтрРозничный;
				КонецЕсли;
				Док.БанковскийСчёт = СчетБезналичный;
				Док.Сумма = Знч(ДокJSON, "totalAmount", "amountTotal", "amount");
				Док.НазначениеПлатежа = Знч(ДокJSON, "operationType", "comment");
				Док.Идентификатор1С = Ид1СДок;

				Если Док.Сумма > 0 Тогда
					Успешно = Успешно + ЗаписатьИПровестиДокумент(Док, ДокJSON);
				КонецЕсли;
			КонецЕсли;

		Исключение
			Ошибок = Ошибок + 1;
			Сообщить("Ошибка проведения " + ТипДок + " " + Знч(ДокJSON, "number", "Номер") + " от " + Знч(ДокJSON, "date", "Дата") + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Сообщить("=== ИТОГИ ЗАГРУЗКИ ===");
	Сообщить("Успешно проведено: " + Успешно + " документов");
	Сообщить("Пропущено (уже загружены или помечены на удаление): " + Пропущено);
	Сообщить("Ошибок: " + Ошибок);
КонецПроцедуры

// Обработка загрузки дампа данных из 1С (УТ 10.3 и УТ 11.5) в OneBase (PuT)

Функция Знч(Стр, К1, К2 = "", К3 = "", К4 = "")
	Если Стр = Неопределено Или Стр = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	Знач1 = Стр.Получить(К1);
	Если Знач1 <> Неопределено И Знач1 <> Null Тогда
		Возврат Знач1;
	КонецЕсли;
	Если К2 <> "" Тогда
		Знач2 = Стр.Получить(К2);
		Если Знач2 <> Неопределено И Знач2 <> Null Тогда
			Возврат Знач2;
		КонецЕсли;
	КонецЕсли;
	Если К3 <> "" Тогда
		Знач3 = Стр.Получить(К3);
		Если Знач3 <> Неопределено И Знач3 <> Null Тогда
			Возврат Знач3;
		КонецЕсли;
	КонецЕсли;
	Если К4 <> "" Тогда
		Знач4 = Стр.Получить(К4);
		Если Знач4 <> Неопределено И Знач4 <> Null Тогда
			Возврат Знач4;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьСкладДокумента(ДокJSON, MapСклад, ПервыйСклад)
	СклID = Знч(ДокJSON, "warehouse", "warehouseId");
	Если СклID <> Неопределено И СклID <> "00000000-0000-0000-0000-000000000000" Тогда
		Скл = MapСклад.Получить(СклID);
		Если Скл <> Неопределено И ЗначениеЗаполнено(Скл) Тогда
			Возврат Скл;
		КонецЕсли;
	КонецЕсли;
	ТЧ = Знч(ДокJSON, "lines", "items", "Товары");
	Если ТЧ <> Неопределено И ТЧ.Количество() > 0 Тогда
		Для Каждого Стр Из ТЧ Цикл
			СклСтрокиID = Знч(Стр, "warehouse");
			Если СклСтрокиID <> Неопределено И СклСтрокиID <> "00000000-0000-0000-0000-000000000000" Тогда
				СклСтроки = MapСклад.Получить(СклСтрокиID);
				Если СклСтроки <> Неопределено И ЗначениеЗаполнено(СклСтроки) Тогда
					Возврат СклСтроки;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ПервыйСклад;
КонецФункции

Функция ЗаписатьИПровестиДокумент(Док, ДокJSON)
	Док.Записать();
	ПризнакПроведен = Знч(ДокJSON, "posted", "Проведен");
	Если ПризнакПроведен = Неопределено Или ПризнакПроведен = Истина Или ПризнакПроведен = 1 Или Строка(ПризнакПроведен) = "True" Или Строка(ПризнакПроведен) = "Истина" Или Строка(ПризнакПроведен) = "Да" Тогда
		Док.Провести();
	КонецЕсли;
	Возврат 1;
КонецФункции

Функция СортироватьДокументыПоДате(МассивДок)
	Кол = МассивДок.Количество();
	Для Индекс1 = 0 По Кол - 1 Цикл
		Для Индекс2 = Индекс1 + 1 По Кол - 1 Цикл
			Если МассивДок[Индекс1].date > МассивДок[Индекс2].date Тогда
				Врем = МассивДок[Индекс1];
				МассивДок[Индекс1] = МассивДок[Индекс2];
				МассивДок[Индекс2] = Врем;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат МассивДок;
КонецФункции

Процедура ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, ИмяСекции1С, ИмяТипаOneBase)
	Если ДокументыJSON = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Список = ДокументыJSON.Получить(ИмяСекции1С);
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ДокJSON Из Список Цикл
		Элм = Новый Структура;
		Элм.Вставить("type", ИмяТипаOneBase);
		Элм.Вставить("data", ДокJSON);
		Элм.Вставить("date", Знч(ДокJSON, "date", "Дата"));
		ВсеДокументы.Добавить(Элм);
	КонецЦикла;
КонецПроцедуры

Процедура Выполнить()
	ФайлJSON = Параметры.ФайлJSON;
	Если ФайлJSON = "" Или ФайлJSON = Неопределено Тогда
		ВызватьИсключение "Параметр ФайлJSON не задан";
	КонецЕсли;

	Сообщить("Чтение JSON-дампа: " + ФайлJSON + "...");
	Константы.РазрешитьОтрицательныеОстатки = Истина;
	Данные = ReadJSON(ФайлJSON);

	СправочникиJSON = Данные.Получить("catalogs");
	ДокументыJSON = Данные.Получить("documents");

	// 1. Ставки НДС
	MapСтавки = Новый Соответствие;
	СтавкиСписок = Новый Массив;
	СтавкиСписок.Добавить("Без НДС");
	СтавкиСписок.Добавить("0%");
	СтавкиСписок.Добавить("10%");
	СтавкиСписок.Добавить("18%");
	СтавкиСписок.Добавить("20%");

	Для Каждого ИмяСтавки Из СтавкиСписок Цикл
		Ставка = Справочники.СтавкаНДС.НайтиПоНаименованию(ИмяСтавки);
		Если Ставка = Неопределено Или Не ЗначениеЗаполнено(Ставка) Тогда
			НовСтавка = Справочники.СтавкаНДС.Создать();
			НовСтавка.Наименование = ИмяСтавки;
			Если ИмяСтавки = "20%" Тогда
				НовСтавка.Ставка = 20;
			ИначеЕсли ИмяСтавки = "18%" Тогда
				НовСтавка.Ставка = 18;
			ИначеЕсли ИмяСтавки = "10%" Тогда
				НовСтавка.Ставка = 10;
			Иначе
				НовСтавка.Ставка = 0;
			КонецЕсли;
			НовСтавка.Записать();
			Ставка = НовСтавка.Ссылка;
		КонецЕсли;
		MapСтавки.Вставить(ИмяСтавки, Ставка);
	КонецЦикла;

	// 2. Единицы измерения
	MapЕдИзм = Новый Соответствие;
	ЕдШт = Справочники.ЕдиницаИзмерения.НайтиПоНаименованию("шт");
	Если ЕдШт = Неопределено Или Не ЗначениеЗаполнено(ЕдШт) Тогда
		НовЕд = Справочники.ЕдиницаИзмерения.Создать();
		НовЕд.Наименование = "шт";
		НовЕд.Записать();
		ЕдШт = НовЕд.Ссылка;
	КонецЕсли;
	MapЕдИзм.Вставить("шт", ЕдШт);

	// Типы цен
	MapТипыЦен = Новый Соответствие;
	Закупочная = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");
	Если Не ЗначениеЗаполнено(Закупочная) Тогда
		Запись = Справочники.ТипЦен.Создать();
		Запись.Наименование = "Закупочная";
		Запись.ВидРасчета   = "Хранимый";
		Запись.Округление   = 2;
		Запись.Записать();
		Закупочная = Запись.Ссылка;
	КонецЕсли;
	Розничная = Справочники.ТипЦен.НайтиПоНаименованию("Розничная");
	Если Не ЗначениеЗаполнено(Розничная) Тогда
		Запись = Справочники.ТипЦен.Создать();
		Запись.Наименование = "Розничная";
		Запись.ВидРасчета   = "Расчетный";
		Запись.БазовыйТип   = Закупочная;
		Запись.Процент      = 30;
		Запись.Округление   = 2;
		Запись.Записать();
	КонецЕсли;
	Оптовая = Справочники.ТипЦен.НайтиПоНаименованию("Оптовая");
	Если Не ЗначениеЗаполнено(Оптовая) Тогда
		Запись = Справочники.ТипЦен.Создать();
		Запись.Наименование = "Оптовая";
		Запись.ВидРасчета   = "Расчетный";
		Запись.БазовыйТип   = Закупочная;
		Запись.Процент      = 10;
		Запись.Округление   = 2;
		Запись.Записать();
	КонецЕсли;

	// 3. Организации
	MapОрг = Новый Соответствие;
	ОрганизацииСписок = СправочникиJSON.Получить("Организации");
	ПерваяОрг = Неопределено;
	Если ОрганизацииСписок <> Неопределено Тогда
		Для Каждого ОргJSON Из ОрганизацииСписок Цикл
			ИмяОрг = Знч(ОргJSON, "name", "Наименование");
			Орг = Справочники.Организация.НайтиПоНаименованию(ИмяОрг);
			Если Орг = Неопределено Или Не ЗначениеЗаполнено(Орг) Тогда
				НовОрг = Справочники.Организация.Создать();
				НовОрг.Наименование = ИмяОрг;
				НовОрг.ПолноеНаименование = Знч(ОргJSON, "nameFull", "НаименованиеПолное");
				НовОрг.ИНН = Знч(ОргJSON, "inn", "ИНН");
				НовОрг.КПП = Знч(ОргJSON, "kpp", "КПП");
				НовОрг.Записать();
				Орг = НовОрг.Ссылка;
			КонецЕсли;
			MapОрг.Вставить(Знч(ОргJSON, "id", "Ссылка"), Орг);
			Если ПерваяОрг = Неопределено Тогда
				ПерваяОрг = Орг;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Сообщить("Загружено организаций: " + MapОрг.Количество());

	// 4. Склады
	MapСклад = Новый Соответствие;
	СкладыСписок = СправочникиJSON.Получить("Склады");
	ПервыйСклад = Неопределено;
	Если СкладыСписок <> Неопределено Тогда
		Для Каждого СкладJSON Из СкладыСписок Цикл
			ИмяСкл = Знч(СкладJSON, "name", "Наименование");
			Если ИмяСкл = Неопределено Или СокрЛП(Строка(ИмяСкл)) = "" Тогда
				Продолжить;
			КонецЕсли;
			Скл = Справочники.Склад.НайтиПоНаименованию(ИмяСкл);
			Если Скл = Неопределено Или Не ЗначениеЗаполнено(Скл) Тогда
				НовСкл = Справочники.Склад.Создать();
				НовСкл.Наименование = ИмяСкл;
				НовСкл.Записать();
				Скл = НовСкл.Ссылка;
			КонецЕсли;
			MapСклад.Вставить(Знч(СкладJSON, "id", "Ссылка"), Скл);
			Если ПервыйСклад = Неопределено Тогда
				ПервыйСклад = Скл;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Сообщить("Загружено складов: " + MapСклад.Количество());

	// Кассы и банковские счета
	КассаНаличная = Справочники.Касса.НайтиПоНаименованию("Основная касса");
	Если КассаНаличная = Неопределено Или Не ЗначениеЗаполнено(КассаНаличная) Тогда
		НовКасса = Справочники.Касса.Создать();
		НовКасса.Наименование = "Основная касса";
		НовКасса.Вид = Перечисления.ВидКассы.Касса;
		НовКасса.Записать();
		КассаНаличная = НовКасса.Ссылка;
	КонецЕсли;

	СчетБезналичный = Справочники.Касса.НайтиПоНаименованию("Основной расчетный счет");
	Если СчетБезналичный = Неопределено Или Не ЗначениеЗаполнено(СчетБезналичный) Тогда
		НовСчет = Справочники.Касса.Создать();
		НовСчет.Наименование = "Основной расчетный счет";
		НовСчет.Вид = Перечисления.ВидКассы.БанковскийСчёт;
		НовСчет.Записать();
		СчетБезналичный = НовСчет.Ссылка;
	КонецЕсли;

	// 5. Контрагенты
	MapКонтр = Новый Соответствие;
	КонтрРозничный = Справочники.Контрагент.НайтиПоНаименованию("Розничный покупатель");
	Если КонтрРозничный = Неопределено Или Не ЗначениеЗаполнено(КонтрРозничный) Тогда
		НовКонтр = Справочники.Контрагент.Создать();
		НовКонтр.Наименование = "Розничный покупатель";
		НовКонтр.ПолноеНаименование = "Розничный покупатель";
		НовКонтр.Вид = Перечисления.ВидКонтрагента.Покупатель;
		НовКонтр.Покупатель = Истина;
		НовКонтр.Поставщик = Ложь;
		НовКонтр.Записать();
		КонтрРозничный = НовКонтр.Ссылка;
	КонецЕсли;

	КонтрагентыСписок = СправочникиJSON.Получить("Контрагенты");
	Если КонтрагентыСписок <> Неопределено Тогда
		Для Каждого КонтрJSON Из КонтрагентыСписок Цикл
			Если Знч(КонтрJSON, "isFolder", "ЭтоГруппа") = Истина Тогда
				Продолжить;
			КонецЕсли;
			ИмяКонтр = Знч(КонтрJSON, "name", "Наименование");
			Контр = Справочники.Контрагент.НайтиПоНаименованию(ИмяКонтр);
			Если Контр = Неопределено Или Не ЗначениеЗаполнено(Контр) Тогда
				НовКонтр = Справочники.Контрагент.Создать();
				НовКонтр.Наименование = ИмяКонтр;
				НовКонтр.ПолноеНаименование = Знч(КонтрJSON, "nameFull", "НаименованиеПолное");
				НовКонтр.ИНН = Знч(КонтрJSON, "inn", "ИНН");
				НовКонтр.КПП = Знч(КонтрJSON, "kpp", "КПП");
				
				IsCust = Знч(КонтрJSON, "isCustomer", "Покупатель");
				IsVend = Знч(КонтрJSON, "isVendor", "Поставщик");
				Если IsCust = Истина И IsVend = Истина Тогда
					НовКонтр.Вид = Перечисления.ВидКонтрагента.Покупатель;
					НовКонтр.Покупатель = Истина;
					НовКонтр.Поставщик = Истина;
				ИначеЕсли IsCust = Истина Тогда
					НовКонтр.Вид = Перечисления.ВидКонтрагента.Покупатель;
					НовКонтр.Покупатель = Истина;
					НовКонтр.Поставщик = Ложь;
				ИначеЕсли IsVend = Истина Тогда
					НовКонтр.Вид = Перечисления.ВидКонтрагента.Поставщик;
					НовКонтр.Покупатель = Ложь;
					НовКонтр.Поставщик = Истина;
				Иначе
					НовКонтр.Вид = Перечисления.ВидКонтрагента.Прочее;
					НовКонтр.Покупатель = Ложь;
					НовКонтр.Поставщик = Ложь;
				КонецЕсли;
				
				НовКонтр.Записать();
				Контр = НовКонтр.Ссылка;
			КонецЕсли;
			MapКонтр.Вставить(Знч(КонтрJSON, "id", "Ссылка"), Контр);
		КонецЦикла;
	КонецЕсли;
	Сообщить("Загружено контрагентов: " + MapКонтр.Количество());

	// 6. Номенклатура
	MapНом = Новый Соответствие;
	НоменклатураСписок = СправочникиJSON.Получить("Номенклатура");
	Если НоменклатураСписок <> Неопределено Тогда
		Для Каждого НомJSON Из НоменклатураСписок Цикл
			Если Знч(НомJSON, "isFolder", "ЭтоГруппа") = Истина Тогда
				Продолжить;
			КонецЕсли;
			ИмяНом = Знч(НомJSON, "name", "Наименование");
			Ном = Справочники.Номенклатура.НайтиПоНаименованию(ИмяНом);
			Если Ном = Неопределено Или Не ЗначениеЗаполнено(Ном) Тогда
				НовНом = Справочники.Номенклатура.Создать();
				НовНом.Наименование = ИмяНом;
				НовНом.Артикул = Знч(НомJSON, "article", "Артикул");
				
				Тип1С = Знч(НомJSON, "type", "ТипНоменклатуры");
				Если Тип1С <> Неопределено И СтрНайти(Тип1С, "Услуга") > 0 Тогда
					НовНом.Услуга = Истина;
				Иначе
					НовНом.Услуга = Ложь;
				КонецЕсли;
				
				Ставка = MapСтавки.Получить(Знч(НомJSON, "vatRate", "СтавкаНДС"));
				Если Ставка <> Неопределено Тогда
					НовНом.СтавкаНДС = Ставка;
				КонецЕсли;
				
				НовНом.ЕдиницаИзмерения = ЕдШт;
				НовНом.Записать();
				Ном = НовНом.Ссылка;
			КонецЕсли;
			MapНом.Вставить(Знч(НомJSON, "id", "Ссылка"), Ном);
		КонецЦикла;
	КонецЕсли;
	Сообщить("Загружено номенклатуры: " + MapНом.Количество());

	// 7. Сбор всех документов в хронологический массив
	ВсеДокументы = Новый Массив;

	Если ТипЗнч(ДокументыJSON) = Тип("Массив") Тогда
		Для Каждого ДокJSON Из ДокументыJSON Цикл
			Тип1С = Знч(ДокJSON, "type", "Тип");
			ТипOneBase = Тип1С;
			Если Тип1С = "ПоступлениеТоваровУслуг" Тогда
				ТипOneBase = "ПоступлениеТоваров";
			ИначеЕсли Тип1С = "РеализацияТоваровУслуг" Тогда
				ТипOneBase = "РеализацияТоваров";
			ИначеЕсли Тип1С = "ВозвратТоваровПоставщику" Тогда
				ТипOneBase = "ВозвратПоставщику";
			ИначеЕсли Тип1С = "ВозвратТоваровОтПокупателя" Тогда
				ТипOneBase = "ВозвратОтПокупателя";
			ИначеЕсли Тип1С = "ПКО" Или Тип1С = "ПриходныйКассовыйОрдер" Тогда
				ТипOneBase = "ПриходныйКассовыйОрдер";
			ИначеЕсли Тип1С = "РКО" Или Тип1С = "РасходныйКассовыйОрдер" Тогда
				ТипOneBase = "РасходныйКассовыйОрдер";
			ИначеЕсли Тип1С = "ПоступлениеНаРасчетныйСчет" Или Тип1С = "ПлатежноеПоручениеВходящее" Тогда
				ТипOneBase = "ПоступлениеНаРасчётныйСчёт";
			ИначеЕсли Тип1С = "СписаниеСРасчетногоСчета" Или Тип1С = "ПлатежноеПоручениеИсходящее" Тогда
				ТипOneBase = "СписаниеСРасчётногоСчёта";
			КонецЕсли;

			Элм = Новый Структура;
			Элм.Вставить("type", ТипOneBase);
			Элм.Вставить("data", ДокJSON);
			Элм.Вставить("date", Знч(ДокJSON, "date", "Дата"));
			ВсеДокументы.Добавить(Элм);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДокументыJSON) = Тип("Соответствие") Или ТипЗнч(ДокументыJSON) = Тип("Структура") Тогда
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ПоступлениеТоваровУслуг", "ПоступлениеТоваров");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "РеализацияТоваровУслуг", "РеализацияТоваров");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ВозвратТоваровПоставщику", "ВозвратПоставщику");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ВозвратТоваровОтПокупателя", "ВозвратОтПокупателя");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ПеремещениеТоваров", "ПеремещениеТоваров");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "СписаниеТоваров", "СписаниеТоваров");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ОприходованиеТоваров", "ОприходованиеТоваров");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "КомплектацияНоменклатуры", "КомплектацияНоменклатуры");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ПриходныйКассовыйОрдер", "ПриходныйКассовыйОрдер");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "РасходныйКассовыйОрдер", "РасходныйКассовыйОрдер");
		ПроцедураДобавитьДокументы(ВсеДокументы, ДокументыJSON, "ПлатежноеПоручениеВходящее", "ПоступлениеНаРасчётныйСчёт");

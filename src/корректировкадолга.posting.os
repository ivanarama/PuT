// Проведение документа «Корректировка долга».
//
// Сальдо взаиморасчётов по контрагенту одно на организацию: Приход — долг
// контрагента нам (дебиторская задолженность), Расход — наш долг ему
// (кредиторская). Поэтому направление движения берётся из сальдо на момент
// документа, а не фиксируется: «Списание задолженности» всегда писало Расход и
// долг поставщику не гасило, а удваивало. Тип контрагента в движении — по
// направлению долга («Покупатель» — дебиторская, «Поставщик» — кредиторская),
// как у документов продажи и поступления.
//
// Виды операций:
//   СписаниеЗадолженности — списание долга контрагента (в любую сторону);
//   ПереносЗадолженности  — перенос долга на КонтрагентаПолучателя;
//   Взаимозачет           — зачёт встречных долгов контрагента: дебиторской
//                           (как покупатель) и кредиторской (как поставщик);
//                           итоговое сальдо не меняется.

// Сальдо контрагента на момент документа: > 0 — он должен нам, < 0 — мы ему.
Функция СальдоКонтрагента(Контрагент)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ СуммаОстаток
                  ИЗ РегистрНакопления.Взаиморасчеты.Остатки(&Момент)
                  ГДЕ Контрагент = &Контрагент И Организация = &Организация";
  Запрос.УстановитьПараметр("Момент", this.МоментВремени());
  Запрос.УстановитьПараметр("Контрагент", Контрагент);
  Запрос.УстановитьПараметр("Организация", this.Организация);
  Итог = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Итог = Итог + Стр.СуммаОстаток;
  КонецЦикла;
  Возврат Итог;
КонецФункции

// Сальдо по одному типу расчётов (строке «Покупатель» или «Поставщик») на дату
// документа, без движений самого документа. Тип — реквизит регистра, а не
// измерение, поэтому считается по движениям.
Функция СальдоПоТипу(Контрагент, ТипКонтрагента)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ ВидДвижения, Сумма
                  ИЗ РегистрНакопления.Взаиморасчеты
                  ГДЕ Контрагент = &Контрагент
                    И Организация = &Организация
                    И ТипКонтрагента = &Тип
                    И period <= &Дата
                    И Регистратор <> &ЭтотДокумент";
  Запрос.УстановитьПараметр("Контрагент", Контрагент);
  Запрос.УстановитьПараметр("Организация", this.Организация);
  Запрос.УстановитьПараметр("Тип", ТипКонтрагента);
  Запрос.УстановитьПараметр("Дата", this.Дата);
  Запрос.УстановитьПараметр("ЭтотДокумент", this);
  Итог = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Если Стр.ВидДвижения = "Приход" Тогда
      Итог = Итог + Стр.Сумма;
    Иначе
      Итог = Итог - Стр.Сумма;
    КонецЕсли;
  КонецЦикла;
  Возврат Итог;
КонецФункции

Процедура Движение(ВидДвижения, Контрагент, ТипКонтрагента)
  Дв = Движения.Взаиморасчеты.Добавить();
  Дв.Период         = this.Дата;
  Дв.ВидДвижения    = ВидДвижения;
  Дв.Организация    = this.Организация;
  Дв.Контрагент     = Контрагент;
  Дв.ТипКонтрагента = ТипКонтрагента;
  Дв.Сумма          = this.Сумма;
КонецПроцедуры

// Долг контрагента, который списывается или переносится: сальдо не нулевое и
// не меньше суммы корректировки.
Функция ПроверенноеСальдо()
  Сальдо = СальдоКонтрагента(this.Контрагент);
  Если Сальдо = 0 Тогда
    ВызватьИсключение("У контрагента «" + Строка(this.Контрагент)
      + "» нет долга на дату документа — корректировать нечего.");
  КонецЕсли;
  Если this.Сумма > ?(Сальдо > 0, Сальдо, -Сальдо) Тогда
    ВызватьИсключение("Сумма корректировки " + Строка(this.Сумма) + " больше долга «"
      + Строка(this.Контрагент) + "» на дату документа (" + Строка(?(Сальдо > 0, Сальдо, -Сальдо)) + ").");
  КонецЕсли;
  Возврат Сальдо;
КонецФункции

Процедура ОбработкаПроведения()
  ПроверитьЗакрытыйПериод(this);
  ПроверитьРеквизитШапки(this.Контрагент, "Контрагент");

  Движения.Взаиморасчеты.Очистить();

  Если this.ВидОперации = "СписаниеЗадолженности" Тогда
    Сальдо = ПроверенноеСальдо();
    Если Сальдо > 0 Тогда
      // Контрагент должен нам — списываем дебиторскую.
      Движение("Расход", this.Контрагент, "Покупатель");
    Иначе
      // Мы должны контрагенту — списываем кредиторскую.
      Движение("Приход", this.Контрагент, "Поставщик");
    КонецЕсли;

  ИначеЕсли this.ВидОперации = "ПереносЗадолженности" Тогда
    ПроверитьРеквизитШапки(this.КонтрагентПолучатель, "Контрагент-получатель");
    Сальдо = ПроверенноеСальдо();
    Если Сальдо > 0 Тогда
      // Долг перед нами переходит к получателю.
      Движение("Расход", this.Контрагент, "Покупатель");
      Движение("Приход", this.КонтрагентПолучатель, "Покупатель");
    Иначе
      // Наш долг переходит к получателю.
      Движение("Приход", this.Контрагент, "Поставщик");
      Движение("Расход", this.КонтрагентПолучатель, "Поставщик");
    КонецЕсли;

  ИначеЕсли this.ВидОперации = "Взаимозачет" Тогда
    Дебиторская = СальдоПоТипу(this.Контрагент, "Покупатель");
    Кредиторская = -СальдоПоТипу(this.Контрагент, "Поставщик");
    Если this.Сумма > Дебиторская ИЛИ this.Сумма > Кредиторская Тогда
      ВызватьИсключение("Зачесть можно не больше меньшего из встречных долгов «"
        + Строка(this.Контрагент) + "»: он должен нам " + Строка(Дебиторская)
        + ", мы ему " + Строка(Кредиторская) + ", к зачёту " + Строка(this.Сумма) + ".");
    КонецЕсли;
    // Гасим оба долга на одну сумму: сальдо контрагента не меняется.
    Движение("Расход", this.Контрагент, "Покупатель");
    Движение("Приход", this.Контрагент, "Поставщик");
  КонецЕсли;
КонецПроцедуры

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

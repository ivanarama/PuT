// Проведение документа «Корректировка долга».

// Тип контрагента для регистра Взаиморасчеты («Покупатель»/«Поставщик»/«Прочее»)
// по булевым реквизитам справочника. Без него движения выпадают из баланса
// и акта сверки: NULL-тип не проходит ни один отбор по ТипКонтрагента.
Функция ТипКонтрагентаДляРегистра(Контрагент)
  Если ЗначениеРеквизитаОбъекта(Контрагент, "Покупатель") = Истина Тогда
    Возврат "Покупатель";
  ИначеЕсли ЗначениеРеквизитаОбъекта(Контрагент, "Поставщик") = Истина Тогда
    Возврат "Поставщик";
  КонецЕсли;
  Возврат "Прочее";
КонецФункции

Процедура ОбработкаПроведения()
  ПроверитьДатуЗапрета(this.Дата);

  Движения.Взаиморасчеты.Очистить();

  // Виды операций:
  // 1. Взаимозачет (списание дебиторской / кредиторской задолженности)
  // 2. ПереносЗадолженности (перенос долга с Контрагента на КонтрагентаПолучателя)
  // 3. СписаниеЗадолженности (списание безнадёжной задолженности)

  Если this.ВидОперации = "Взаимозачет" ИЛИ this.ВидОперации = "СписаниеЗадолженности" Тогда
    Дв = Движения.Взаиморасчеты.Добавить();
    Дв.Период       = this.Дата;
    Дв.ВидДвижения  = "Расход";
    Дв.Организация  = this.Организация;
    Дв.Контрагент   = this.Контрагент;
    Дв.ТипКонтрагента = ТипКонтрагентаДляРегистра(this.Контрагент);
    Дв.Сумма        = this.Сумма;
  ИначеЕсли this.ВидОперации = "ПереносЗадолженности" Тогда
    // Списание с исходного контрагента
    ДвСпис = Движения.Взаиморасчеты.Добавить();
    ДвСпис.Период       = this.Дата;
    ДвСпис.ВидДвижения  = "Расход";
    ДвСпис.Организация  = this.Организация;
    ДвСпис.Контрагент   = this.Контрагент;
    ДвСпис.ТипКонтрагента = ТипКонтрагентаДляРегистра(this.Контрагент);
    ДвСпис.Сумма        = this.Сумма;

    // Начисление на контрагента-получателя
    ДвНачисл = Движения.Взаиморасчеты.Добавить();
    ДвНачисл.Период       = this.Дата;
    ДвНачисл.ВидДвижения  = "Приход";
    ДвНачисл.Организация  = this.Организация;
    ДвНачисл.Контрагент   = this.КонтрагентПолучатель;
    ДвНачисл.ТипКонтрагента = ТипКонтрагентаДляРегистра(this.КонтрагентПолучатель);
    ДвНачисл.Сумма        = this.Сумма;
  КонецЕсли;
КонецПроцедуры

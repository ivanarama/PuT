Процедура ПриФормировании(Страница, Параметры) Экспорт
  Страница.Абзац("Показатели с начала месяца по сегодня. Резервы и ожидаемые поставки — на текущий момент.");
  З = Новый Запрос;
  З.Текст = "ВЫБРАТЬ
    СУММА(ВЫБОР КОГДА вид_движения = ""Приход"" ТОГДА Выручка ИНАЧЕ -Выручка КОНЕЦ) КАК Выручка,
    СУММА(ВЫБОР КОГДА вид_движения = ""Приход"" ТОГДА Выручка - Себестоимость ИНАЧЕ Себестоимость - Выручка КОНЕЦ) КАК Прибыль
    ИЗ РегистрНакопления.ВаловаяПрибыль ГДЕ period >= &Начало И period <= &Конец";
  З.УстановитьПараметр("Начало", НачалоМесяца(ТекущаяДата()));
  З.УстановитьПараметр("Конец", КонецДня(ТекущаяДата()));
  Для Каждого Стр Из З.Выполнить() Цикл
    Страница.Показатель("Выручка без НДС", Стр.Выручка, "money");
    Страница.Показатель("Валовая прибыль без НДС", Стр.Прибыль, "money");
  КонецЦикла;
  Страница.Кнопка("Продажи и прибыль", "/ui/report/ВаловаяПрибыль");
  Страница.Кнопка("Долги и оплаты", "/ui/report/Взаиморасчеты");
  Страница.Кнопка("Платёжный календарь", "/ui/report/ПлатежныйКалендарь");
  Страница.Кнопка("Анализ заказов покупателей", "/ui/report/АнализЗаказовПокупателей");
  Страница.Кнопка("Ожидаемые поставки", "/ui/report/ТоварыВПути");
  Таб = Страница.Таблица("Заказы покупателей в работе");
  Таб.Колонки("Заказ", "Покупатель", "Этап", "Сумма");
  З.Текст = "ВЫБРАТЬ ПЕРВЫЕ 20 Ссылка КАК Ид, Номер, Покупатель, Состояние,
    CAST(Сумма AS NUMERIC) КАК Сумма ИЗ Документ.ЗаказПокупателя
    ГДЕ Состояние ЕСТЬ NULL ИЛИ Состояние = """" ИЛИ (Состояние <> ""Завершён"" И Состояние <> ""Отменён"")
    УПОРЯДОЧИТЬ ПО Дата УБЫВ";
  Для Каждого Стр Из З.Выполнить() Цикл
    Ряд = Таб.ДобавитьСтроку();
    Ряд.Установить("Заказ", Стр.Номер);
    Ряд.Ссылка("Заказ", СсылкаНаОбъект("ЗаказПокупателя", Стр.Ид));
    Ряд.Установить("Покупатель", Стр.Покупатель);
    Ряд.Установить("Этап", ?(ЗначениеЗаполнено(Стр.Состояние), Стр.Состояние, "Новый"));
    Ряд.Установить("Сумма", Формат(Стр.Сумма, "ЧДЦ=2"));
  КонецЦикла;
  Страница.КнопкаДействие("Обновить показатели", "Обновить");
КонецПроцедуры

Процедура Обновить(Страница, Параметры) Экспорт
  Сообщить("Показатели обновлены на " + Формат(ТекущаяДатаВремя(), "ДФ=dd.MM.yyyy HH:mm"));
КонецПроцедуры

// Модуль документа «Закрытие заказов покупателей».
// Позволяет снять зависшие резервы по отменённым или частично выполненным заказам.

Процедура ОбработкаЗаполнения(ДанныеЗаполнения)
  Если ЗначениеЗаполнено(ДанныеЗаполнения) = Ложь Тогда
    Возврат;
  КонецЕсли;

  this.Организация = ДанныеЗаполнения.Организация;
  this.Склад       = ДанныеЗаполнения.Склад;
  this.Покупатель  = ДанныеЗаполнения.Покупатель;
  this.Комментарий = "Закрытие остатков по заказу покупателя № " + Строка(ДанныеЗаполнения.Номер);
  Момент = ?(ЗначениеЗаполнено(this.Дата), this.Дата, ТекущаяДатаВремя());

  // Получаем текущие открытые остатки в резерве по данному заказу
  ЗапросРезервы = Новый Запрос;
  ЗапросРезервы.Текст = "ВЫБРАТЬ
                            Номенклатура,
                            КоличествоОстаток
                          ИЗ РегистрНакопления.РезервыТоваров.Остатки(&Момент)
                          ГДЕ ЗаказПокупателя = &Заказ";
  ЗапросРезервы.УстановитьПараметр("Момент", Момент);
  ЗапросРезервы.УстановитьПараметр("Заказ", ДанныеЗаполнения.Ссылка);
  Рез = ЗапросРезервы.Выполнить();

  Добавлено = 0;
  Для Каждого Стр Из Рез Цикл
    Если Стр.КоличествоОстаток > 0 Тогда
      СтрЗаказ = this.Заказы.Добавить();
      СтрЗаказ.ЗаказПокупателя = ДанныеЗаполнения.Ссылка;
      СтрЗаказ.Номенклатура    = Стр.Номенклатура;
      СтрЗаказ.Количество      = Стр.КоличествоОстаток;
      СтрЗаказ.ПричинаЗакрытия = "Отказ покупателя / корректировка остатка";
      Добавлено = Добавлено + 1;
    КонецЕсли;
  КонецЦикла;

  Если Добавлено = 0 Тогда
    Сообщить("По заказу покупателя № " + Строка(ДанныеЗаполнения.Номер) + " нет открытых резервов.");
  КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи()
  Если ЗначениеЗаполнено(this.Организация) = Ложь Тогда
    this.Организация = ОрганизацияПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    this.Склад = СкладПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    Error("Укажите склад");
  КонецЕсли;
  Если this.Заказы.Количество() = 0 Тогда
    Error("Табличная часть не содержит строк для закрытия");
  КонецЕсли;

  Для Каждого Строка Из this.Заказы Цикл
    Если ЗначениеЗаполнено(Строка.Номенклатура) = Ложь
       ИЛИ ТипЗнч(Строка.Номенклатура) = "Строка"
       ИЛИ ПустаяСсылка(Строка.Номенклатура) Тогда
      Error("В табличной части есть строка без номенклатуры (или передана строка вместо ссылки)");
    КонецЕсли;
    Если ЗначениеЗаполнено(Строка.ЗаказПокупателя) = Ложь
       ИЛИ ТипЗнч(Строка.ЗаказПокупателя) = "Строка"
       ИЛИ ПустаяСсылка(Строка.ЗаказПокупателя) Тогда
      Error("В табличной части не указан закрываемый заказ покупателя");
    КонецЕсли;
    Если Строка.Количество <= 0 Тогда
      Error("Количество к закрытию должно быть больше нуля: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;
  КонецЦикла;
КонецПроцедуры

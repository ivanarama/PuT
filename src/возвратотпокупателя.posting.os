// Проведение возврата от покупателя — реверс продажи.
// Товары возвращаются на склад новой партией, валовая прибыль и взаиморасчёты
// сторнируются.
//
// Себестоимость возврата по основанию (реализации) — себестоимость этой
// продажи: товар возвращается по той цене, по которой списывался, и валовая
// прибыль сторнируется ровно на свою сумму. Раньше она бралась ФИФО из текущих
// партий склада — при изменении закупочных цен сторно не совпадало с продажей.
// Вернуть можно не больше проданного за вычетом прежних возвратов.
//
// Без основания — оценка ФИФО по текущим партиям (мягкий режим: партий может
// не хватать), а если партий нет — закупочная нетто-цена на дату документа.

Процедура ОбработкаПроведения()
  ПроверитьЗакрытыйПериод(this);

  ПроверитьРеквизитШапки(this.Покупатель, "Покупатель");
  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.ОстаткиТоваров.Очистить();
  Движения.Взаиморасчеты.Очистить();
  Движения.ПартииТоваров.Очистить();
  Движения.ВаловаяПрибыль.Очистить();

  ПроверитьЗаполнениеСтрокТоваров(this.Товары, "Товары");

  Для Каждого Строка Из this.Товары Цикл
    Строка.Сумма = Строка.Количество * Строка.Цена;
    Если ЗначениеЗаполнено(Строка.СуммаНДС) = Ложь Тогда
      Строка.СуммаНДС = 0;
    КонецЕсли;
  КонецЦикла;

  // Себестоимость по ФИФО (мягкий режим: партий может не хватать) — только
  // для возврата без основания. ДвиженияПартий из результата игнорируем —
  // возврат не списывает старые партии, а создаёт новую.
  Результаты = СписатьТоварыФИФО(this.Склад, this.Организация, this.Товары,
    this.МоментВремени(), "возврата от покупателя", Истина);

  // По основанию — себестоимость и количество исходной продажи.
  Продано = Неопределено;
  Если ЗначениеЗаполнено(this.Основание) Тогда
    Продано = ПроданоПоРеализации(this.Основание);
    Возвращено = ВозвращеноПоРеализации(this.Основание, this);
    ВозвратПоНом = Новый Соответствие;
    Для Каждого Строка Из this.Товары Цикл
      Ключ = УИДСсылки(Строка.Номенклатура);
      Тек = ВозвратПоНом.Получить(Ключ);
      Если Тек = Неопределено Тогда
        Тек = 0;
      КонецЕсли;
      ВозвратПоНом.Вставить(Ключ, Тек + Строка.Количество);
    КонецЦикла;
    Для Каждого Строка Из this.Товары Цикл
      Ключ = УИДСсылки(Строка.Номенклатура);
      Продажа = Продано.Получить(Ключ);
      ПроданоКол = ?(Продажа = Неопределено, 0, Продажа.Количество);
      Ранее = Возвращено.Получить(Ключ);
      Ранее = ?(Ранее = Неопределено, 0, Ранее);
      Если ВозвратПоНом.Получить(Ключ) + Ранее > ПроданоКол Тогда
        ВызватьИсключение("По «" + Строка(Строка.Номенклатура) + "» возвращается больше, чем продано по «"
          + Строка(this.Основание) + "»: продано " + Строка(ПроданоКол) + ", уже возвращено "
          + Строка(Ранее) + ", в этом документе " + Строка(ВозвратПоНом.Получить(Ключ)) + ".");
      КонецЕсли;
    КонецЦикла;
  КонецЕсли;

  // Тип цен для fallback-себестоимости (закупочная нетто)
  ТипЗакупочной = Справочники.ТипЦен.Закупочная;
  Если ЗначениеЗаполнено(ТипЗакупочной) = Ложь Тогда
    ТипЗакупочной = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");
  КонецЕсли;

  Индекс = 0;
  Для Каждого Строка Из this.Товары Цикл
    Рез = Результаты[Индекс];
    Индекс = Индекс + 1;

    СуммарнаяСебестоимость    = Рез.Себестоимость;
    СуммарнаяСебестоимостьСНДС = Рез.СебестоимостьСНДС;
    ИзПродажи = Ложь;
    Если Продано <> Неопределено Тогда
      Продажа = Продано.Получить(УИДСсылки(Строка.Номенклатура));
      Если Продажа <> Неопределено И Продажа.Количество > 0 Тогда
        ИзПродажи = Истина;
        СуммарнаяСебестоимость     = Окр(Продажа.Себестоимость * Строка.Количество / Продажа.Количество, 2);
        СуммарнаяСебестоимостьСНДС = Окр(Продажа.СебестоимостьСНДС * Строка.Количество / Продажа.Количество, 2);
      КонецЕсли;
    КонецЕсли;

    // Fallback: партий по ФИФО не нашлось — берём закупочную нетто-цену
    // (НЕ продажную: продажная завысила бы себестоимость и исказила прибыль).
    Если СуммарнаяСебестоимость = 0 И ИзПродажи = Ложь Тогда
      ЗакупЦена = ПолучитьЦену(Строка.Номенклатура, ТипЗакупочной, this.Дата);
      СуммарнаяСебестоимость     = Окр(Строка.Количество * ЗакупЦена, 2);
      СуммарнаяСебестоимостьСНДС = СуммарнаяСебестоимость;
      Сообщить("Внимание: для «" + Строка(Строка.Номенклатура)
        + "» партии ФИФО не найдены, себестоимость взята по закупочной цене ("
        + Строка(СуммарнаяСебестоимость) + ").");
    КонецЕсли;

    СкладСтроки = ?(ЗначениеЗаполнено(Строка.Склад), Строка.Склад, this.Склад);

    // ОстаткиТоваров: возврат на склад
    ДвО = Движения.ОстаткиТоваров.Добавить();
    ДвО.ВидДвижения  = "Приход";
    ДвО.Номенклатура = Строка.Номенклатура;
    ДвО.Склад        = СкладСтроки;
    ДвО.Организация  = this.Организация;
    ДвО.Количество   = Строка.Количество;
    ДвО.Сумма        = СуммарнаяСебестоимость;
    ДвО.СуммаСНДС    = СуммарнаяСебестоимостьСНДС;

    // ПартииТоваров: новая партия на дату возврата
    ДвП = Движения.ПартииТоваров.Добавить();
    ДвП.ВидДвижения  = "Приход";
    ДвП.Номенклатура = Строка.Номенклатура;
    ДвП.Склад        = СкладСтроки;
    ДвП.Организация  = this.Организация;
    ДвП.ДатаПоставки = this.Дата;
    ДвП.Количество   = Строка.Количество;
    ДвП.Сумма        = СуммарнаяСебестоимость;
    ДвП.СуммаСНДС    = СуммарнаяСебестоимостьСНДС;

    // ВаловаяПрибыль: сторно выручки и себестоимости
    ВыручкаСтроки = НеттоСуммы(Строка.Сумма, Строка.СуммаНДС, this.СпособУчетаНДС);
    СуммаСНДС = Строка.Сумма;
    Если this.СпособУчетаНДС = "Сверху" Тогда
      СуммаСНДС = Строка.Сумма + Строка.СуммаНДС;
    КонецЕсли;

    ДвВП = Движения.ВаловаяПрибыль.Добавить();
    ДвВП.ВидДвижения       = "Расход";
    ДвВП.Номенклатура      = Строка.Номенклатура;
    ДвВП.Склад             = СкладСтроки;
    ДвВП.Организация       = this.Организация;
    ДвВП.Количество        = Строка.Количество;
    ДвВП.Выручка           = ВыручкаСтроки;
    ДвВП.СуммаСНДС         = СуммаСНДС;
    ДвВП.СуммаНДС          = Строка.СуммаНДС;
    ДвВП.Себестоимость     = СуммарнаяСебестоимость;
    ДвВП.СебестоимостьСНДС = СуммарнаяСебестоимостьСНДС;
  КонецЦикла;

  // Взаиморасчёты: уменьшение долга покупателя
  ДвВз = Движения.Взаиморасчеты.Добавить();
  ДвВз.ВидДвижения        = "Расход";
  ДвВз.Контрагент         = this.Покупатель;
  ДвВз.Организация        = this.Организация;
  ДвВз.ТипКонтрагента     = "Покупатель";
  ДвВз.ДокументРеализации = this.Основание;
  ДвВз.Сумма              = this.Сумма;
КонецПроцедуры

// Проданное по реализации: номенклатура → Структура(Количество, Себестоимость,
// СебестоимостьСНДС) по движениям валовой прибыли этой реализации.
Функция ПроданоПоРеализации(Реализация)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Номенклатура.Ссылка КАК НомИД, Количество, Себестоимость, СебестоимостьСНДС
                  ИЗ РегистрНакопления.ВаловаяПрибыль
                  ГДЕ Регистратор = &Реализация И ВидДвижения = 'Приход'";
  Запрос.УстановитьПараметр("Реализация", Реализация);
  Результат = Новый Соответствие;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Ключ = УИДСсылки(Стр.НомИД);
    Тек = Результат.Получить(Ключ);
    Если Тек = Неопределено Тогда
      Тек = Новый Структура("Количество, Себестоимость, СебестоимостьСНДС", 0, 0, 0);
      Результат.Вставить(Ключ, Тек);
    КонецЕсли;
    Тек.Количество = Тек.Количество + Стр.Количество;
    Тек.Себестоимость = Тек.Себестоимость + Стр.Себестоимость;
    Тек.СебестоимостьСНДС = Тек.СебестоимостьСНДС + ?(ЗначениеЗаполнено(Стр.СебестоимостьСНДС), Стр.СебестоимостьСНДС, Стр.Себестоимость);
  КонецЦикла;
  Возврат Результат;
КонецФункции

// Уже возвращённое по реализации другими проведёнными возвратами:
// номенклатура → количество.
Функция ВозвращеноПоРеализации(Реализация, ЭтотДокумент)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ ВП.Ссылка КАК ИД ИЗ Документ.ВозвратОтПокупателя КАК ВП
                  ГДЕ ВП.Основание = &Реализация И ВП.posted = Истина И ВП.Ссылка <> &Этот";
  Запрос.УстановитьПараметр("Реализация", Реализация);
  Запрос.УстановитьПараметр("Этот", ЭтотДокумент);
  Результат = Новый Соответствие;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    ЗапросДвижений = Новый Запрос;
    ЗапросДвижений.Текст = "ВЫБРАТЬ Номенклатура.Ссылка КАК НомИД, Количество
                            ИЗ РегистрНакопления.ВаловаяПрибыль
                            ГДЕ Регистратор = &Возврат И ВидДвижения = 'Расход'";
    ЗапросДвижений.УстановитьПараметр("Возврат", Стр.ИД);
    Для Каждого Дв Из ЗапросДвижений.Выполнить() Цикл
      Ключ = УИДСсылки(Дв.НомИД);
      Тек = Результат.Получить(Ключ);
      Если Тек = Неопределено Тогда
        Тек = 0;
      КонецЕсли;
      Результат.Вставить(Ключ, Тек + Дв.Количество);
    КонецЦикла;
  КонецЦикла;
  Возврат Результат;
КонецФункции

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

// Срок оплаты реализации в движениях взаиморасчётов.
// - Заполненный срок уходит в движение концом дня: «до 10.10 включительно».
// - Пустой срок в движение не пишется (NULL): раньше он уходил как 0001-01-01,
//   и отчёт «Оплаты по реализациям» считал документ без срока просроченным.
// - Срок объявлен после Дата: движения ложатся на дату документа, а не на срок
//   (платформа до onebase#1827 брала период из первого реквизита-даты).
// Запуск:
//   onebase test --project . --sqlite <база> --run СрокаОплаты

Функция Продажа(Организация, Склад, Покупатель, Номенклатура, ДатаДокумента, СрокОплаты)
  Документ = Документы.РеализацияТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Покупатель = Покупатель;
  Документ.Склад = Склад;
  Если СрокОплаты <> Неопределено Тогда
    Документ.СрокОплаты = СрокОплаты;
  КонецЕсли;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = 1;
  СтрокаТЧ.Цена = 500;
  Документ.Провести();
  Возврат Документ.Ссылка;
КонецФункции

Функция ДвижениеДолга(Реализация)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ СрокОплаты, period КАК ДатаДвижения ИЗ РегистрНакопления.Взаиморасчеты
                  ГДЕ ДокументРеализации = &Док И ВидДвижения = 'Приход'";
  Запрос.УстановитьПараметр("Док", Реализация);
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Возврат Стр;
  КонецЦикла;
  Возврат Неопределено;
КонецФункции

Процедура Выполнить()
  Орг = Справочники.Организация.Создать();
  Орг.Наименование = "Тест срока: организация";
  Организация = Орг.Записать();
  Скл = Справочники.Склад.Создать();
  Скл.Наименование = "Тест срока: склад";
  Склад = Скл.Записать();
  Пост = Справочники.Контрагент.Создать();
  Пост.Наименование = "Тест срока: поставщик";
  Пост.Вид = "Поставщик";
  Поставщик = Пост.Записать();
  Пок = Справочники.Контрагент.Создать();
  Пок.Наименование = "Тест срока: покупатель";
  Пок.Вид = "Покупатель";
  Покупатель = Пок.Записать();
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест срока: вешалка";
  Вешалка = Ном.Записать();

  Поступление = Документы.ПоступлениеТоваров.Создать();
  Поступление.Дата = Дата(2026, 9, 1, 9, 0, 0);
  Поступление.Организация = Организация;
  Поступление.Поставщик = Поставщик;
  Поступление.Склад = Склад;
  СтрокаТЧ = Поступление.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Вешалка;
  СтрокаТЧ.Количество = 10;
  СтрокаТЧ.Цена = 100;
  Поступление.Провести();

  СоСроком = Продажа(Организация, Склад, Покупатель, Вешалка, Дата(2026, 9, 10, 12, 0, 0), Дата(2026, 10, 10, 0, 0, 0));
  Дв = ДвижениеДолга(СоСроком);
  Утверждать.Истина(Дв <> Неопределено, "реализация со сроком записала долг");
  Утверждать.Равно(Формат(Дв.СрокОплаты, "ДФ=дд.ММ.гггг ЧЧ:мм:сс"), "10.10.2026 23:59:59", "срок оплаты ушёл в движение концом дня");
  Утверждать.Равно(Формат(Дв.ДатаДвижения, "ДФ=дд.ММ.гггг"), "10.09.2026", "период движения — дата документа, а не срок оплаты");

  БезСрока = Продажа(Организация, Склад, Покупатель, Вешалка, Дата(2026, 9, 11, 12, 0, 0), Неопределено);
  Дв = ДвижениеДолга(БезСрока);
  Утверждать.Истина(Дв <> Неопределено, "реализация без срока записала долг");
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(СрокОплаты) КАК СоСроком, КОЛИЧЕСТВО(Сумма) КАК Всего
                  ИЗ РегистрНакопления.Взаиморасчеты ГДЕ ДокументРеализации = &Док";
  Запрос.УстановитьПараметр("Док", БезСрока);
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    // КОЛИЧЕСТВО(поле) не считает NULL: срок записан NULL, а не 0001-01-01.
    Утверждать.Равно(Стр.СоСроком, 0, "пустой срок записан NULL, а не нулевой датой");
    Утверждать.Равно(Стр.Всего, 1, "у реализации без срока одно движение долга");
  КонецЦикла;
КонецПроцедуры

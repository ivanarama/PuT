// Штрихкоды номенклатуры (АРМ продавца).
// - Поиск по штрихкоду возвращает ссылку на номенклатуру, а не наименование:
//   со строкой не подбиралась цена и не записывался документ.
// - Один штрихкод — один товар: повтор отклоняется при записи.
// Запуск:
//   onebase test --project . --sqlite <база> --run Штрихкодов

Функция ЗаписатьШтрихкод(Штрихкод, Номенклатура)
  Эл = Справочники.Штрихкоды.Создать();
  Эл.Штрихкод = Штрихкод;
  Эл.Номенклатура = Номенклатура;
  Попытка
    Эл.Записать();
    Возврат "";
  Исключение
    Возврат ОписаниеОшибки();
  КонецПопытки;
КонецФункции

Процедура Выполнить()
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест штрихкодов: зонт";
  Зонт = Ном.Записать();
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест штрихкодов: плащ";
  Плащ = Ном.Записать();

  Утверждать.Равно(ЗаписатьШтрихкод("2900000000017", Зонт), "", "штрихкод зонта записан");
  Найдено = НоменклатураПоШтрихкоду("2900000000017");
  Утверждать.Истина(ЗначениеЗаполнено(Найдено), "товар по штрихкоду найден");
  Утверждать.Истина(ТипЗнч(Найдено) <> Тип("Строка"), "найдена ссылка, а не наименование: " + ТипЗнч(Найдено));
  Утверждать.Равно(УИДСсылки(Найдено), УИДСсылки(Зонт), "найден именно зонт");
  Утверждать.Равно(ЗначениеРеквизитаОбъекта(Найдено, "Наименование"), "Тест штрихкодов: зонт",
    "по найденной ссылке читаются реквизиты");
  Утверждать.Ложь(ЗначениеЗаполнено(НоменклатураПоШтрихкоду("2900000000099")), "неизвестный штрихкод — Неопределено");

  Отказ = ЗаписатьШтрихкод("2900000000017", Плащ);
  Утверждать.Истина(СтрНайти(Отказ, "уже назначен номенклатуре «Тест штрихкодов: зонт»") > 0,
    "повтор штрихкода отклонён с именем товара: " + Отказ);
  Утверждать.Равно(УИДСсылки(НоменклатураПоШтрихкоду("2900000000017")), УИДСсылки(Зонт),
    "после отказа штрихкод по-прежнему указывает на зонт");
КонецПроцедуры

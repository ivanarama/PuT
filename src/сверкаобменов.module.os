Функция НачатьЗагрузкуОбмена(Вид, Источник) Экспорт
  Загрузка = Справочники.ЗагрузкиОбменов.Создать();
  Загрузка.Момент = ТекущаяДатаВремя();
  Загрузка.ВидОбмена = Вид;
  Загрузка.Источник = ?(ЗначениеЗаполнено(Источник), Источник, "");
  Загрузка.Наименование = Вид + " " + Формат(Загрузка.Момент, "ДФ=yyyy-MM-dd HH:mm:ss") + " " + Загрузка.Источник;
  Загрузка.Записать();
  Загрузка.Наименование = Загрузка.Наименование + " · " + Лев(УИДСсылки(Загрузка.Ссылка), 8);
  Загрузка.Записать();
  Возврат Загрузка.Ссылка;
КонецФункции

Процедура ЗаписатьИсториюОбмена(Вид, Название, Статус, Описание, Счёт, Действие, Данные, Загрузка) Экспорт
  Запись = Справочники.ЖурналОбменов.Создать();
  Запись.Наименование = ?(ЗначениеЗаполнено(Название), Название, Вид);
  Запись.Момент = ТекущаяДатаВремя();
  Запись.Загрузка = Загрузка;
  Запись.ДоступенПовтор = Вид = "Банк" И Статус = "Ошибка" И ЗначениеЗаполнено(Данные);
  Запись.Обмен = Вид; Запись.Статус = Статус; Запись.Описание = Описание;
  Запись.СчётБанка = Счёт; Запись.Действие = Действие; Запись.СтрокаВыписки = Данные;
  Запись.Записать();
КонецПроцедуры

Функция ПовторитьОшибкуОбмена(Ссылка) Экспорт
  Если НЕ ЗначениеЗаполнено(Ссылка) Тогда ВызватьИсключение("Выберите ошибку импорта"); КонецЕсли;
  Если ТипЗнч(Ссылка) = Тип("Строка") Тогда Ссылка = Справочники.ЖурналОбменов.НайтиПоИдентификатору(Ссылка); КонецЕсли;
  Запись = Ссылка.ПолучитьОбъект();
  Если Запись.Обмен <> "Банк" ИЛИ Запись.Статус <> "Ошибка" ИЛИ НЕ ЗначениеЗаполнено(Запись.СтрокаВыписки) Тогда
    ВызватьИсключение("Из журнала можно повторить ошибочную строку банка. Для ЭДО и 1С повторите загрузку исправленного файла");
  КонецЕсли;
  Данные = ReadJSON(Запись.СтрокаВыписки);
  Организация = Данные.Получить("организацияимпорта");
  Итоги = ОбработатьБанковскуюВыписку("[" + Запись.СтрокаВыписки + "]", Запись.СчётБанка, "JSON", Запись.Действие, Организация, "", Запись.Загрузка);
  Если Итоги.Ошибки.Количество() = 0 Тогда
    Запись.Статус = "Исправлено"; Запись.ДоступенПовтор = Ложь;
    Запись.Записать();
  КонецЕсли;
  Возврат Итоги;
КонецФункции

Функция ОрганизацияПокупателяУПД(ИНН, Выбор) Экспорт
  Если ЗначениеЗаполнено(Выбор) Тогда
    Если ТипЗнч(Выбор) = Тип("Строка") Тогда Выбор = Справочники.Организация.НайтиПоИдентификатору(Выбор); КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Выбор) Тогда ВызватьИсключение("Выбранная организация не найдена"); КонецЕсли;
    Если ЗначениеЗаполнено(ИНН) И СокрЛП(Строка(ЗначениеРеквизитаОбъекта(Выбор, "ИНН"))) <> СокрЛП(ИНН) Тогда
      ВызватьИсключение("ИНН выбранной организации отличается от ИНН покупателя УПД " + ИНН);
    КонецЕсли;
    Возврат Выбор;
  КонецЕсли;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 2 О.Ссылка КАК Ид ИЗ Справочник.Организация КАК О ГДЕ О.deletion_mark = Ложь";
  Если ЗначениеЗаполнено(ИНН) Тогда
    Запрос.Текст = Запрос.Текст + " И О.ИНН = &ИНН";
    Запрос.УстановитьПараметр("ИНН", ИНН);
  КонецЕсли;
  Рез = Запрос.Выполнить();
  Если Рез.Количество() <> 1 Тогда
    ВызватьИсключение("Не удалось однозначно определить покупателя УПД. Проверьте ИНН " + Строка(ИНН) + " и выберите организацию");
  КонецЕсли;
  Возврат Справочники.Организация.НайтиПоИдентификатору(УИДСсылки(Рез[0].Ид));
КонецФункции

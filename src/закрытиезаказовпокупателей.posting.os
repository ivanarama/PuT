// Проведение документа «Закрытие заказов покупателей».
// Списывает невыполненные остатки резервов (вид движения: Расход).

Процедура ОбработкаПроведения()
  ПроверитьЗакрытыйПериод(this);

  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.РезервыТоваров.Очистить();

  // Закрывается не больше открытого остатка резерва: после заполнения по
  // заказу могли пройти отгрузки, и прежнее количество увело бы резерв в минус.
  Остатки = ОстаткиПоЗаказам("РезервыТоваров", "ЗаказПокупателя", this.Склад, this.МоментВремени());
  Для Каждого Строка Из this.Заказы Цикл
    Ключ = УИДСсылки(Строка.ЗаказПокупателя) + "#" + УИДСсылки(Строка.Номенклатура);
    Открыто = Остатки.Получить(Ключ);
    Если Открыто = Неопределено ИЛИ Открыто <= 0 Тогда
      Сообщить("«" + Строка(Строка.Номенклатура) + "» по заказу «" + Строка(Строка.ЗаказПокупателя)
        + "»: открытого резерва нет — строка пропущена.");
      Продолжить;
    КонецЕсли;
    Количество = Мин(Строка.Количество, Открыто);
    Остатки.Вставить(Ключ, Открыто - Количество);
    Если Количество < Строка.Количество Тогда
      Сообщить("«" + Строка(Строка.Номенклатура) + "»: закрыт остаток резерва " + Строка(Количество)
        + " вместо " + Строка(Строка.Количество) + ".");
    КонецЕсли;

    Дв = Движения.РезервыТоваров.Добавить();
    Дв.Период          = this.Дата;
    Дв.ВидДвижения     = "Расход";
    Дв.Номенклатура    = Строка.Номенклатура;
    Дв.Склад           = this.Склад;
    Дв.ЗаказПокупателя = Строка.ЗаказПокупателя;
    Дв.Количество      = Количество;
  КонецЦикла;
КонецПроцедуры

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

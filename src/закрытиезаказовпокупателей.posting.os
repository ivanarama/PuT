// Проведение документа «Закрытие заказов покупателей».
// Списывает невыполненные остатки резервов (вид движения: Расход).

Процедура ОбработкаПроведения()
  ПроверитьЗакрытыйПериод(this);

  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.РезервыТоваров.Очистить();

  // Закрывается не больше открытого остатка резерва: после заполнения по
  // заказу могли пройти отгрузки, и прежнее количество увело бы резерв в минус.
  ЗаблокироватьПартии(this.Заказы);
  ОстаткиЗаказов = Новый Соответствие;
  Для Каждого Строка Из this.Заказы Цикл
    Если Строка.Количество <= 0 Тогда ВызватьИсключение("Количество к закрытию должно быть больше нуля."); КонецЕсли;
    ИДЗаказа = УИДСсылки(Строка.ЗаказПокупателя);
    Остатки = ОстаткиЗаказов.Получить(ИДЗаказа);
    Если Остатки = Неопределено Тогда
      Если УИДСсылки(ЗначениеРеквизитаОбъекта(Строка.ЗаказПокупателя, "Организация")) <> УИДСсылки(this.Организация) Тогда
        ВызватьИсключение("Закрываемый заказ принадлежит другой организации.");
      КонецЕсли;
      Остатки = ОстаткиОдногоЗаказа(Строка.ЗаказПокупателя, this.МоментВремени(), Ложь);
      ОстаткиЗаказов.Вставить(ИДЗаказа, Остатки);
    КонецЕсли;
    СкладСтроки = ?(ЗначениеЗаполнено(Строка.Склад), Строка.Склад, this.Склад);
    Остаток = Остатки.Получить(КлючСтрокиЗаказа(СкладСтроки, Строка.Номенклатура, Неопределено));
    Если Остаток = Неопределено ИЛИ Остаток.Количество <= 0 Тогда
      Сообщить("«" + Строка(Строка.Номенклатура) + "» по заказу «" + Строка(Строка.ЗаказПокупателя)
        + "»: открытого резерва нет — строка пропущена.");
      Продолжить;
    КонецЕсли;
    Количество = Мин(Строка.Количество, Остаток.Количество);
    Остаток.Количество = Остаток.Количество - Количество;
    Если Количество < Строка.Количество Тогда
      Сообщить("«" + Строка(Строка.Номенклатура) + "»: закрыт остаток резерва " + Строка(Количество)
        + " вместо " + Строка(Строка.Количество) + ".");
    КонецЕсли;

    Дв = Движения.РезервыТоваров.Добавить();
    Дв.Период          = this.Дата;
    Дв.ВидДвижения     = "Расход";
    Дв.Номенклатура    = Строка.Номенклатура;
    Дв.Склад           = СкладСтроки;
    Дв.ЗаказПокупателя = Строка.ЗаказПокупателя;
    Дв.КлючОрганизации = УИДСсылки(this.Организация);
    Дв.Количество      = Количество;
  КонецЦикла;
КонецПроцедуры

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

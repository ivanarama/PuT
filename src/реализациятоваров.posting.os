// Проведение реализации по методу ФИФО.
//
// Партии нарезаны по (Номенклатура, Склад, ДатаПоставки), поэтому ФИФО-списание
// (общая функция утилит) идёт только по складу документа.

Процедура ОбработкаПроведения()
  ПроверитьДатуЗапрета(this.Дата);
  Движения.ОстаткиТоваров.Очистить();
  Движения.Взаиморасчеты.Очистить();
  Движения.ПартииТоваров.Очистить();
  Движения.ВаловаяПрибыль.Очистить();

  // Итоги строк и сумма документа (this.Сумма уже посчитана в ПриЗаписи)
  Для Каждого Строка Из this.Товары Цикл
    Строка.Сумма = Строка.Количество * Строка.Цена;
    Если ЗначениеЗаполнено(Строка.СуммаНДС) = Ложь Тогда
      Строка.СуммаНДС = 0;
    КонецЕсли;
  КонецЦикла;

  // Контроль свободного остатка — нельзя продать зарезервированное под чужой заказ
  ПроверитьСвободныйОстаток(this.Склад, this.Организация, this.Товары,
    this.ЗаказПокупателя, this.МоментВремени());

  // ФИФО-списание себестоимости — одной общей функцией
  Результаты = СписатьТоварыФИФО(this.Склад, this.Организация, this.Товары,
    this.МоментВремени(), "реализации");

  Индекс = 0;
  Для Каждого Строка Из this.Товары Цикл
    Рез = Результаты[Индекс];
    Индекс = Индекс + 1;

    Для Каждого Дв Из Рез.ДвиженияПартий Цикл
      ДвП = Движения.ПартииТоваров.Добавить();
      ДвП.ВидДвижения  = "Расход";
      ДвП.Номенклатура = Строка.Номенклатура;
      ДвП.Склад        = this.Склад;
      ДвП.Организация  = this.Организация;
      ДвП.ДатаПоставки = Дв.ДатаПоставки;
      ДвП.Количество   = Дв.Количество;
      ДвП.Сумма        = Дв.Сумма;
    КонецЦикла;

    // ФИФО-себестоимость строки — для построчного анализа маржи и возвратов
    Строка.Себестоимость = Рез.Себестоимость;

    ВыручкаСтроки = Строка.Сумма - Строка.СуммаНДС;
    Если this.СпособУчетаНДС = "Сверху" Тогда
      ВыручкаСтроки = Строка.Сумма;
    КонецЕсли;

    ДвО = Движения.ОстаткиТоваров.Добавить();
    ДвО.ВидДвижения  = "Расход";
    ДвО.Номенклатура = Строка.Номенклатура;
    ДвО.Склад        = this.Склад;
    ДвО.Организация  = this.Организация;
    ДвО.Количество   = Строка.Количество;
    ДвО.Сумма        = Рез.Себестоимость;

    ДвВП = Движения.ВаловаяПрибыль.Добавить();
    ДвВП.ВидДвижения   = "Приход";
    ДвВП.Номенклатура  = Строка.Номенклатура;
    ДвВП.Организация   = this.Организация;
    ДвВП.Выручка       = ВыручкаСтроки;
    ДвВП.Себестоимость = Рез.Себестоимость;
  КонецЦикла;

  // Взаиморасчёты — одной строкой, с привязкой к самой реализации.
  // Сумма к получению — с НДС (this.Сумма рассчитана в ПриЗаписи).
  ДвВз = Движения.Взаиморасчеты.Добавить();
  ДвВз.ВидДвижения       = "Приход";
  ДвВз.Контрагент        = this.Покупатель;
  ДвВз.Организация       = this.Организация;
  ДвВз.ТипКонтрагента    = "Покупатель";
  ДвВз.ДокументРеализации = this;
  ДвВз.Сумма             = this.Сумма;

  // Снять резерв по заказу покупателя (если указан)
  Если ЗначениеЗаполнено(this.ЗаказПокупателя) Тогда
    Для Каждого Строка Из this.Товары Цикл
      ДвР = Движения.РезервыТоваров.Добавить();
      ДвР.ВидДвижения    = "Расход";
      ДвР.Номенклатура   = Строка.Номенклатура;
      ДвР.Склад          = this.Склад;
      ДвР.ЗаказПокупателя = this.ЗаказПокупателя;
      ДвР.Количество     = Строка.Количество;
    КонецЦикла;
  КонецЕсли;
КонецПроцедуры

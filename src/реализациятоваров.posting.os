// Проведение реализации по методу ФИФО.
//
// Партии нарезаны по (Номенклатура, Склад, ДатаПоставки), поэтому списываем
// только из остатков того склада, который указан в документе.

Процедура ОбработкаПроведения()
  Движения.ОстаткиТоваров.Очистить();
  Движения.Взаиморасчеты.Очистить();
  Движения.ПартииТоваров.Очистить();
  Движения.ВаловаяПрибыль.Очистить();

  // 1. Сводная потребность по номенклатуре и итог документа
  ПотребностьПоНом = Новый Соответствие;
  ИтогСумма = 0;

  Для Каждого Строка Из this.Товары Цикл
    Строка.Сумма = Строка.Количество * Строка.Цена;
    Если ЗначениеЗаполнено(Строка.СуммаНДС) = Ложь Тогда
      Строка.СуммаНДС = 0;
    КонецЕсли;
    ИтогСумма = ИтогСумма + Строка.Сумма;

    Текущая = ПотребностьПоНом.Получить(Строка.Номенклатура);
    Если Текущая = Неопределено Тогда
      Текущая = 0;
    КонецЕсли;
    ПотребностьПоНом.Вставить(Строка.Номенклатура, Текущая + Строка.Количество);
  КонецЦикла;

  // 2. Один запрос остатков партий — только по этому складу
  СписокНом = Новый Массив;
  Для Каждого Пара Из ПотребностьПоНом Цикл
    СписокНом.Добавить(Пара.Ключ);
  КонецЦикла;

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ
                    Номенклатура,
                    ДатаПоставки,
                    КоличествоОстаток,
                    СуммаОстаток
                  ИЗ РегистрНакопления.ПартииТоваров.Остатки(&МоментВремени)
                  ГДЕ Номенклатура В (&СписокНом)
                    И Склад = &Склад
                    И Организация = &Организация
                    И КоличествоОстаток > 0
                  УПОРЯДОЧИТЬ ПО Номенклатура, ДатаПоставки";
  Запрос.УстановитьПараметр("СписокНом", СписокНом);
  Запрос.УстановитьПараметр("Склад", Строка(this.Склад));
  Запрос.УстановитьПараметр("Организация", this.Организация);
  Запрос.УстановитьПараметр("МоментВремени", this.МоментВремени());
  Результат = Запрос.Выполнить();

  // 3. Раскладываем партии в локальный кэш: Номенклатура -> Массив<Структура>
  ПартииПоНом = Новый Соответствие;
  Для Каждого Стр Из Результат Цикл
    Список = ПартииПоНом.Получить(Стр.Номенклатура);
    Если Список = Неопределено Тогда
      Список = Новый Массив;
      ПартииПоНом.Вставить(Стр.Номенклатура, Список);
    КонецЕсли;
    Список.Добавить(Новый Структура(
      "ДатаПоставки, КоличествоОстаток, СуммаОстаток",
      Стр.ДатаПоставки, Стр.КоличествоОстаток, Стр.СуммаОстаток));
  КонецЦикла;

  // 4. Up-front проверка достаточности по каждой номенклатуре
  Для Каждого Пара Из ПотребностьПоНом Цикл
    Ном = Пара.Ключ;
    Надо = Пара.Значение;

    Доступно = 0;
    Список = ПартииПоНом.Получить(Ном);
    Если Список <> Неопределено Тогда
      Для Каждого П Из Список Цикл
        Доступно = Доступно + П.КоличествоОстаток;
      КонецЦикла;
    КонецЕсли;

    Если Доступно < Надо Тогда
      ВызватьИсключение("Недостаточно остатков на складе «" + Строка(this.Склад)
        + "» для «" + Строка(Ном) + "»: нужно " + Строка(Надо)
        + ", доступно " + Строка(Доступно) + ".");
    КонецЕсли;
  КонецЦикла;

  // 5. ФИФО-списание из локального кэша (кэш уменьшается между строками)
  Для Каждого Строка Из this.Товары Цикл
    ОстатокКСписанию = Строка.Количество;
    СуммарнаяСебестоимость = 0;
    Список = ПартииПоНом.Получить(Строка.Номенклатура);

    Если Список <> Неопределено Тогда
      Для Каждого ТекПартия Из Список Цикл
        Если ОстатокКСписанию <= 0 Тогда
          Прервать;
        КонецЕсли;
        Если ТекПартия.КоличествоОстаток <= 0 Тогда
          Продолжить;
        КонецЕсли;

        КолВоИзПартии   = Мин(ОстатокКСписанию, ТекПартия.КоличествоОстаток);
        ЦенаПартии      = ТекПартия.СуммаОстаток / ТекПартия.КоличествоОстаток;
        СтоимостьПартии = Окр(КолВоИзПартии * ЦенаПартии, 2);

        СуммарнаяСебестоимость = СуммарнаяСебестоимость + СтоимостьПартии;
        ОстатокКСписанию       = ОстатокКСписанию - КолВоИзПартии;

        ТекПартия.КоличествоОстаток = ТекПартия.КоличествоОстаток - КолВоИзПартии;
        ТекПартия.СуммаОстаток      = ТекПартия.СуммаОстаток - СтоимостьПартии;

        ДвП = Движения.ПартииТоваров.Добавить();
        ДвП.ВидДвижения  = "Расход";
        ДвП.Номенклатура = Строка.Номенклатура;
        ДвП.Склад        = this.Склад;
        ДвП.Организация  = this.Организация;
        ДвП.ДатаПоставки = ТекПартия.ДатаПоставки;
        ДвП.Количество   = КолВоИзПартии;
        ДвП.Сумма        = СтоимостьПартии;
      КонецЦикла;
    КонецЕсли;

    ВыручкаСтроки = Строка.Сумма - Строка.СуммаНДС;
    Если this.СпособУчетаНДС = "Сверху" Тогда
      ВыручкаСтроки = Строка.Сумма;
    КонецЕсли;

    ДвО = Движения.ОстаткиТоваров.Добавить();
    ДвО.ВидДвижения  = "Расход";
    ДвО.Номенклатура = Строка.Номенклатура;
    ДвО.Склад        = this.Склад;
    ДвО.Организация  = this.Организация;
    ДвО.Количество   = Строка.Количество;
    ДвО.Сумма        = СуммарнаяСебестоимость;

    ДвВП = Движения.ВаловаяПрибыль.Добавить();
    ДвВП.ВидДвижения   = "Приход";
    ДвВП.Номенклатура  = Строка.Номенклатура;
    ДвВП.Организация   = this.Организация;
    ДвВП.Выручка       = ВыручкаСтроки;
    ДвВП.Себестоимость = СуммарнаяСебестоимость;
  КонецЦикла;

  // 6. Взаиморасчёты — одной строкой, с привязкой к самой реализации.
  //    Сумма к получению — с НДС (this.Сумма рассчитана в ПриЗаписи).
  ДвВз = Движения.Взаиморасчеты.Добавить();
  ДвВз.ВидДвижения       = "Приход";
  ДвВз.Контрагент        = this.Покупатель;
  ДвВз.ТипКонтрагента    = "Покупатель";
  ДвВз.ДокументРеализации = this;
  ДвВз.Сумма             = this.Сумма;

  // 7. Снять резерв по заказу покупателя (если указан)
  Если ЗначениеЗаполнено(this.ЗаказПокупателя) Тогда
    Для Каждого Строка Из this.Товары Цикл
      ДвР = Движения.РезервыТоваров.Добавить();
      ДвР.ВидДвижения    = "Расход";
      ДвР.Номенклатура   = Строка.Номенклатура;
      ДвР.Склад          = this.Склад;
      ДвР.ЗаказПокупателя = this.ЗаказПокупателя;
      ДвР.Количество     = Строка.Количество;
    КонецЦикла;
  КонецЕсли;
КонецПроцедуры

// Проведение реализации по методу ФИФО.
//
// Партии нарезаны по (Номенклатура, Склад, ДокументПоступления, ДатаПоставки), поэтому ФИФО-списание
// (общая функция утилит) идёт только по складу документа.

Процедура ОбработкаПроведения()
  ПроверитьДатуЗапрета(this.Дата);

  ПроверитьРеквизитШапки(this.Покупатель, "Покупатель");
  ПроверитьРеквизитШапки(this.Склад, "Склад");

  // Контроль кредитного лимита покупателя
  КредитныйЛимит = ЗначениеРеквизитаОбъекта(this.Покупатель, "КредитныйЛимит");
  Если ЗначениеЗаполнено(КредитныйЛимит) И КредитныйЛимит > 0 Тогда
    ЗапросДолг = Новый Запрос;
    ЗапросДолг.Текст = "ВЫБРАТЬ
                           СуммаОстаток КАК ТекущийДолг
                         ИЗ РегистрНакопления.Взаиморасчеты.Остатки(&Момент)
                         ГДЕ Контрагент = &Контрагент
                           И Организация = &Организация";
    ЗапросДолг.УстановитьПараметр("Контрагент", this.Покупатель);
    ЗапросДолг.УстановитьПараметр("Организация", this.Организация);
    ЗапросДолг.УстановитьПараметр("Момент", this.МоментВремени());
    
    ТекущийДолг = 0;
    Для Каждого СтрДолг Из ЗапросДолг.Выполнить() Цикл
      Если ЗначениеЗаполнено(СтрДолг.ТекущийДолг) Тогда
        ТекущийДолг = СтрДолг.ТекущийДолг;
      КонецЕсли;
    КонецЦикла;

    Если (ТекущийДолг + this.Сумма) > КредитныйЛимит Тогда
      Error("Превышен допустимый кредитный лимит покупателя «" + Строка(this.Покупатель) + "»! Лимит: " + Строка(КредитныйЛимит) + ", текущий долг с отгрузкой: " + Строка(ТекущийДолг + this.Сумма));
    КонецЕсли;
  КонецЕсли;

  Движения.ОстаткиТоваров.Очистить();
  Движения.Взаиморасчеты.Очистить();
  Движения.ПартииТоваров.Очистить();
  Движения.ВаловаяПрибыль.Очистить();
  Движения.РезервыТоваров.Очистить();

  ПроверитьЗаполнениеСтрокТоваров(this.Товары, "Товары");

  // Итоги строк с учётом скидки (this.Сумма уже посчитана в ПриЗаписи)
  Для Каждого Строка Из this.Товары Цикл
    СуммаБезСкидки = Строка.Количество * Строка.Цена;
    Если ЗначениеЗаполнено(Строка.ПроцентСкидки) И Строка.ПроцентСкидки > 0 Тогда
      Строка.СуммаСкидки = Окр(СуммаБезСкидки * (Строка.ПроцентСкидки / 100), 2);
    ИначеЕсли ЗначениеЗаполнено(Строка.СуммаСкидки) = Ложь Тогда
      Строка.СуммаСкидки = 0;
    КонецЕсли;
    Строка.Сумма = СуммаБезСкидки - Строка.СуммаСкидки;
    Если ЗначениеЗаполнено(Строка.СуммаНДС) = Ложь Тогда
      Строка.СуммаНДС = 0;
    КонецЕсли;
  КонецЦикла;

  // Контроль свободного остатка — нельзя продать зарезервированное под чужой заказ
  ПроверитьСвободныйОстаток(this.Склад, this.Организация, this.Товары,
    this.ЗаказПокупателя, this.МоментВремени());

  // ФИФО-списание себестоимости — одной общей функцией
  Результаты = СписатьТоварыФИФО(this.Склад, this.Организация, this.Товары,
    this.МоментВремени(), "реализации");

  Индекс = 0;
  Для Каждого Строка Из this.Товары Цикл
    Рез = Результаты[Индекс];
    Индекс = Индекс + 1;

    ДобавитьДвиженияПартий(Движения.ПартииТоваров, "Расход", Рез.ДвиженияПартий,
      Строка.Номенклатура, this.Склад, this.Организация);

    ВыручкаСтроки = НеттоСуммы(Строка.Сумма, Строка.СуммаНДС, this.СпособУчетаНДС);

    ДвО = Движения.ОстаткиТоваров.Добавить();
    ДвО.ВидДвижения  = "Расход";
    ДвО.Номенклатура = Строка.Номенклатура;
    ДвО.Склад        = this.Склад;
    ДвО.Организация  = this.Организация;
    ДвО.Количество   = Строка.Количество;
    ДвО.Сумма        = Рез.Себестоимость;

    ДвВП = Движения.ВаловаяПрибыль.Добавить();
    ДвВП.ВидДвижения   = "Приход";
    ДвВП.Номенклатура  = Строка.Номенклатура;
    ДвВП.Склад         = this.Склад;
    ДвВП.Организация   = this.Организация;
    ДвВП.Выручка       = ВыручкаСтроки;
    ДвВП.Себестоимость = Рез.Себестоимость;
  КонецЦикла;

  // Взаиморасчёты — одной строкой, с привязкой к самой реализации.
  // Сумма к получению — с НДС (this.Сумма рассчитана в ПриЗаписи).
  ДвВз = Движения.Взаиморасчеты.Добавить();
  ДвВз.ВидДвижения       = "Приход";
  ДвВз.Контрагент        = this.Покупатель;
  ДвВз.Организация       = this.Организация;
  ДвВз.ТипКонтрагента    = "Покупатель";
  ДвВз.ДокументРеализации = this;
  ДвВз.Сумма             = this.Сумма;

  // Снять резерв по заказу покупателя (если указан)
  Если ЗначениеЗаполнено(this.ЗаказПокупателя) Тогда
    Для Каждого Строка Из this.Товары Цикл
      ДвР = Движения.РезервыТоваров.Добавить();
      ДвР.ВидДвижения    = "Расход";
      ДвР.Номенклатура   = Строка.Номенклатура;
      ДвР.Склад          = this.Склад;
      ДвР.ЗаказПокупателя = this.ЗаказПокупателя;
      ДвР.Количество     = Строка.Количество;
    КонецЦикла;
  КонецЕсли;
КонецПроцедуры

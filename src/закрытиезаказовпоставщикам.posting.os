// Проведение документа «Закрытие заказов поставщикам».
// Списывает невыполненные остатки ожидаемых товаров в пути (вид движения: Расход).

Процедура ОбработкаПроведения()
  ПроверитьЗакрытыйПериод(this);

  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.ТоварыВПути.Очистить();

  // Закрывается не больше открытого остатка товаров в пути: после заполнения
  // по заказу могли прийти поступления.
  ЗаблокироватьПартии(this.Заказы);
  ОстаткиЗаказов = Новый Соответствие;
  Для Каждого Строка Из this.Заказы Цикл
    Если Строка.Количество <= 0 Тогда ВызватьИсключение("Количество к закрытию должно быть больше нуля."); КонецЕсли;
    ИДЗаказа = УИДСсылки(Строка.ЗаказПоставщику);
    Остатки = ОстаткиЗаказов.Получить(ИДЗаказа);
    Если Остатки = Неопределено Тогда
      Если УИДСсылки(ЗначениеРеквизитаОбъекта(Строка.ЗаказПоставщику, "Организация")) <> УИДСсылки(this.Организация) Тогда
        ВызватьИсключение("Закрываемый заказ принадлежит другой организации.");
      КонецЕсли;
      Остатки = ОстаткиОдногоЗаказа(Строка.ЗаказПоставщику, this.МоментВремени(), Истина);
      ОстаткиЗаказов.Вставить(ИДЗаказа, Остатки);
    КонецЕсли;
    СкладСтроки = ?(ЗначениеЗаполнено(Строка.Склад), Строка.Склад, this.Склад);
    Остаток = Остатки.Получить(КлючСтрокиЗаказа(СкладСтроки, Строка.Номенклатура, Строка.ЗаказПокупателя));
    Если Остаток = Неопределено ИЛИ Остаток.Количество <= 0 Тогда
      Сообщить("«" + Строка(Строка.Номенклатура) + "» по заказу «" + Строка(Строка.ЗаказПоставщику)
        + "»: открытых товаров в пути нет — строка пропущена.");
      Продолжить;
    КонецЕсли;
    Количество = Мин(Строка.Количество, Остаток.Количество);
    Сумма = СписатьЧастьОжидания(Остаток, Количество);

    Дв = Движения.ТоварыВПути.Добавить();
    Дв.Период          = this.Дата;
    Дв.ВидДвижения     = "Расход";
    Дв.Номенклатура    = Строка.Номенклатура;
    Дв.Склад           = СкладСтроки;
    Дв.ЗаказПоставщику = Строка.ЗаказПоставщику;
    Дв.ЗаказПокупателя = Строка.ЗаказПокупателя;
    Дв.Количество      = Количество;
    Дв.Сумма           = Сумма;
  КонецЦикла;
КонецПроцедуры

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

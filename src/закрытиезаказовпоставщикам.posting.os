// Проведение документа «Закрытие заказов поставщикам».
// Списывает невыполненные остатки ожидаемых товаров в пути (вид движения: Расход).

Процедура ОбработкаПроведения()
  ПроверитьЗакрытыйПериод(this);

  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.ТоварыВПути.Очистить();

  // Закрывается не больше открытого остатка товаров в пути: после заполнения
  // по заказу могли прийти поступления.
  Остатки = ОстаткиПоЗаказам("ТоварыВПути", "ЗаказПоставщику", this.Склад, this.МоментВремени());
  Для Каждого Строка Из this.Заказы Цикл
    Ключ = УИДСсылки(Строка.ЗаказПоставщику) + "#" + УИДСсылки(Строка.Номенклатура);
    Открыто = Остатки.Получить(Ключ);
    Если Открыто = Неопределено ИЛИ Открыто <= 0 Тогда
      Сообщить("«" + Строка(Строка.Номенклатура) + "» по заказу «" + Строка(Строка.ЗаказПоставщику)
        + "»: открытых товаров в пути нет — строка пропущена.");
      Продолжить;
    КонецЕсли;
    Количество = Мин(Строка.Количество, Открыто);
    Остатки.Вставить(Ключ, Открыто - Количество);

    Дв = Движения.ТоварыВПути.Добавить();
    Дв.Период          = this.Дата;
    Дв.ВидДвижения     = "Расход";
    Дв.Номенклатура    = Строка.Номенклатура;
    Дв.Склад           = this.Склад;
    Дв.ЗаказПоставщику = Строка.ЗаказПоставщику;
    Дв.ЗаказПокупателя = Строка.ЗаказПокупателя;
    Дв.Количество      = Количество;
    Дв.Сумма           = 0;
  КонецЦикла;
КонецПроцедуры

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

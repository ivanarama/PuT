// Демонстрация: Объект Запрос, Массив, Структура, Попытка/Исключение.
// Показывает, как изменились бы закупочные цены при изменении на Процент.
// Источник — срез последних регистра ЦеныНоменклатуры по типу «Закупочная».
Процедура Выполнить()
  Процент = Параметры.Процент;
  Если Процент = 0 Тогда
    Error("Процент не может быть нулевым");
  КонецЕсли;

  ТипЗакупочной = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");
  Если ЗначениеЗаполнено(ТипЗакупочной) = Ложь Тогда
    Error("Не найден тип цен «Закупочная»");
  КонецЕсли;

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Номенклатура, Цена
                  ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата)
                  ГДЕ ТипЦен = &Тип И Цена > 0
                  УПОРЯДОЧИТЬ ПО Номенклатура";
  Запрос.УстановитьПараметр("Дата", ТекущаяДата());
  Запрос.УстановитьПараметр("Тип", ТипЗакупочной);

  Попытка
    Результат = Запрос.Выполнить();
  Исключение
    Сообщить("Ошибка запроса: " + ОписаниеОшибки());
    Возврат;
  КонецПопытки;

  Изменения = Новый Массив;
  Для Каждого Строка Из Результат Цикл
    Элемент = Новый Структура;
    Элемент.Номенклатура = Строка.Номенклатура;
    Элемент.Было = Строка.Цена;
    Элемент.Стало = Окр(Строка.Цена * (1 + Процент / 100), 2);
    Изменения.Добавить(Элемент);
  КонецЦикла;

  Если Изменения.Количество() = 0 Тогда
    Сообщить("Нет закупочных цен — пересчёт не требуется");
    Возврат;
  КонецЕсли;

  Сообщить("Пересчёт закупочных цен на " + Строка(Процент) + "%:");
  Для Каждого Эл Из Изменения Цикл
    Сообщить("  " + Строка(Эл.Номенклатура) + ": " + Строка(Эл.Было) + " → " + Строка(Эл.Стало));
  КонецЦикла;
  Сообщить("Итого позиций: " + Строка(Изменения.Количество()));
КонецПроцедуры

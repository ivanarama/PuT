// Разборка делит себестоимость изделия между комплектующими. Сумма долей
// обязана точно равняться списанной себестоимости: 100 на три равные части —
// это 33,33 + 33,33 + 33,34, а не 99,99 с потерянной копейкой. Доли берутся
// по закупочной стоимости комплектующих, а без цен — по количеству.
// Запуск:
//   onebase test --project . --sqlite <база> --run СборкиРазборки

Функция НоваяНоменклатура(Имя)
  Объект = Справочники.Номенклатура.Создать();
  Объект.Наименование = Имя;
  Возврат Объект.Записать();
КонецФункции

Процедура Поступление(Организация, Склад, Поставщик, Номенклатура, Цена, ДатаДокумента)
  Документ = Документы.ПоступлениеТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Поставщик = Поставщик;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = 1;
  СтрокаТЧ.Цена = Цена;
  Документ.Провести();
КонецПроцедуры

Функция Разобрать(Организация, Склад, Изделие, Части, ДатаДокумента)
  Документ = Документы.РазборкаТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Расход.Добавить();
  СтрокаТЧ.Номенклатура = Изделие;
  СтрокаТЧ.Количество = 1;
  Для Каждого Часть Из Части Цикл
    СтрокаТЧ = Документ.Приход.Добавить();
    СтрокаТЧ.Номенклатура = Часть;
    СтрокаТЧ.Количество = 1;
  КонецЦикла;
  Документ.Провести();
  Возврат Документ.Ссылка;
КонецФункции

Функция СтоимостьПрихода(Регистратор, Номенклатура)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Сумма ИЗ РегистрНакопления.ПартииТоваров
                  ГДЕ Регистратор = &Р И Номенклатура = &Ном И ВидДвижения = 'Приход'";
  Запрос.УстановитьПараметр("Р", Регистратор);
  Запрос.УстановитьПараметр("Ном", Номенклатура);
  Итог = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Итог = Итог + Стр.Сумма;
  КонецЦикла;
  Возврат Итог;
КонецФункции

Функция ИзменениеСтоимостиЗапасов(Регистратор)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ ВидДвижения, Сумма ИЗ РегистрНакопления.ОстаткиТоваров ГДЕ Регистратор = &Р";
  Запрос.УстановитьПараметр("Р", Регистратор);
  Итог = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Если Стр.ВидДвижения = "Приход" Тогда
      Итог = Итог + Стр.Сумма;
    Иначе
      Итог = Итог - Стр.Сумма;
    КонецЕсли;
  КонецЦикла;
  Возврат Окр(Итог, 2);
КонецФункции

Процедура Выполнить()
  Организация = Справочники.Организация.Создать();
  Организация.Наименование = "Тест разборки: организация";
  СсылкаОрганизации = Организация.Записать();
  Склад = Справочники.Склад.Создать();
  Склад.Наименование = "Тест разборки: склад";
  СсылкаСклада = Склад.Записать();
  Поставщик = Справочники.Контрагент.Создать();
  Поставщик.Наименование = "Тест разборки: поставщик";
  Поставщик.Вид = "Поставщик";
  СсылкаПоставщика = Поставщик.Записать();

  // 1. Без закупочных цен у частей — поровну, без потери копейки.
  Диван = НоваяНоменклатура("Тест разборки: диван");
  Поступление(СсылкаОрганизации, СсылкаСклада, СсылкаПоставщика, Диван, 100, Дата(2026, 9, 4, 10, 0, 0));
  Части = Новый Массив;
  Части.Добавить(НоваяНоменклатура("Тест разборки: спинка"));
  Части.Добавить(НоваяНоменклатура("Тест разборки: сиденье"));
  Части.Добавить(НоваяНоменклатура("Тест разборки: ножки"));
  Разборка = Разобрать(СсылкаОрганизации, СсылкаСклада, Диван, Части, Дата(2026, 9, 4, 12, 0, 0));
  Утверждать.Равно(ИзменениеСтоимостиЗапасов(Разборка), 0,
    "разборка не меняет стоимость запасов: копейки округления не теряются");

  // 2. С закупочными ценами у частей — доли по закупочной стоимости.
  Шкаф = НоваяНоменклатура("Тест разборки: шкаф");
  Каркас = НоваяНоменклатура("Тест разборки: каркас");
  Винты = НоваяНоменклатура("Тест разборки: винты");
  Поступление(СсылкаОрганизации, СсылкаСклада, СсылкаПоставщика, Каркас, 90, Дата(2026, 9, 5, 9, 0, 0));
  Поступление(СсылкаОрганизации, СсылкаСклада, СсылкаПоставщика, Винты, 10, Дата(2026, 9, 5, 9, 30, 0));
  Поступление(СсылкаОрганизации, СсылкаСклада, СсылкаПоставщика, Шкаф, 200, Дата(2026, 9, 5, 10, 0, 0));
  ЧастиШкафа = Новый Массив;
  ЧастиШкафа.Добавить(Каркас);
  ЧастиШкафа.Добавить(Винты);
  Разборка = Разобрать(СсылкаОрганизации, СсылкаСклада, Шкаф, ЧастиШкафа, Дата(2026, 9, 5, 12, 0, 0));
  Утверждать.Равно(СтоимостьПрихода(Разборка, Каркас), 180,
    "каркас получил 90% себестоимости шкафа по закупочной стоимости");
  Утверждать.Равно(СтоимостьПрихода(Разборка, Винты), 20,
    "винты получили 10% себестоимости шкафа");
КонецПроцедуры

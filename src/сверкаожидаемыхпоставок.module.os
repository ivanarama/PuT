// Сверка строк заказа, поступления и закрытия с движениями каждого регистратора.
// На одинаковой дате остаток перед документом включает прочие движения и
// исключает собственные, как Остатки(МоментВремени документа).
Процедура СверитьКоличествоВПути(Результат, Граница) Экспорт
  События = Новый Массив;
  Разницы = Новый Соответствие;
  МаршрутыПрихода = Новый Соответствие;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Т.recorder_type КАК Вид, Т.recorder КАК ИД, Т.period КАК ДатаДок,
                    Т.ЗаказПоставщику.Ссылка КАК Заказ, Т.Склад.Ссылка КАК СкладИД,
                    Т.Номенклатура.Ссылка КАК Товар, Т.ЗаказПокупателя.Ссылка КАК Клиент,
                    Т.ВидДвижения КАК Направление, Т.Количество КАК Количество
                  ИЗ РегистрНакопления.ТоварыВПути КАК Т ГДЕ Т.period <= &До";
  Запрос.УстановитьПараметр("До", Граница);
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Ключ = УИДСсылки(Стр.Заказ) + "#" + КлючСтрокиЗаказа(Стр.СкладИД, Стр.Товар, Стр.Клиент);
    КлючДок = Стр.Вид + "#" + УИДСсылки(Стр.ИД) + "#" + Ключ;
    Кол = ?(Стр.Направление = "Приход", Стр.Количество, -Стр.Количество);
    Если Стр.Вид = "ЗаказПоставщику" И Стр.Направление = "Приход" Тогда МаршрутыПрихода.Вставить(Ключ, Истина); КонецЕсли;
    Данные = Разницы.Получить(КлючДок);
    Если Данные = Неопределено Тогда
      Данные = Новый Структура("Вид, ИД, Описание, Факт, Ожидается", Стр.Вид, Стр.ИД, Строка(Стр.ИД), 0, 0);
      Разницы.Вставить(КлючДок, Данные);
    КонецЕсли;
    Данные.Факт = Данные.Факт + Кол;
    События.Добавить(Новый Структура("ДатаДок, Порядок, Ключ, Количество", Дата(Стр.ДатаДок), 0, Ключ, Кол));
  КонецЦикла;

  СтарыеМаршруты = Новый Соответствие;
  СтрокиДокументов = Новый Соответствие;
  Для Каждого Вид Из СтрРазделить("ЗаказПоставщику,ПоступлениеТоваров,ЗакрытиеЗаказовПоставщикам", ",") Цикл
    Запрос.Текст = "ВЫБРАТЬ Д.Ссылка КАК ИД ИЗ Документ." + Вид + " КАК Д ГДЕ Д.posted = Истина И Д.Дата <= &До";
    Если Вид = "ПоступлениеТоваров" Тогда
      Менеджер = Документы.ПоступлениеТоваров;
      Запрос.Текст = Запрос.Текст + " И Д.ЗаказПоставщику ЕСТЬ НЕ ПУСТО";
    ИначеЕсли Вид = "ЗаказПоставщику" Тогда
      Менеджер = Документы.ЗаказПоставщику;
    Иначе
      Менеджер = Документы.ЗакрытиеЗаказовПоставщикам;
    КонецЕсли;
    Для Каждого Запись Из Запрос.Выполнить() Цикл
      Док = Менеджер.НайтиПоИдентификатору(УИДСсылки(Запись.ИД)).ПолучитьОбъект();
      Строки = ?(Вид = "ЗакрытиеЗаказовПоставщикам", Док.Заказы, Док.Товары);
      Для Каждого Стр Из Строки Цикл
        Если Вид = "ЗаказПоставщику" Тогда
          Заказ = Док.Ссылка;
        ИначеЕсли Вид = "ПоступлениеТоваров" Тогда
          Заказ = Док.ЗаказПоставщику;
        Иначе
          Заказ = Стр.ЗаказПоставщику;
        КонецЕсли;
        Склад = ?(ЗначениеЗаполнено(Стр.Склад), Стр.Склад, Док.Склад);
        Префикс = УИДСсылки(Заказ) + "#";
        Ключ = Префикс + КлючСтрокиЗаказа(Склад, Стр.Номенклатура, Стр.ЗаказПокупателя);
        Если Вид = "ЗаказПоставщику" Тогда
          КлючШапки = Префикс + КлючСтрокиЗаказа(Док.Склад, Стр.Номенклатура, Стр.ЗаказПокупателя);
          Если МаршрутыПрихода.Получить(Ключ) = Неопределено И МаршрутыПрихода.Получить(КлючШапки) = Истина Тогда
            СтарыеМаршруты.Вставить(Ключ, КлючШапки);
          КонецЕсли;
        КонецЕсли;
        Старый = СтарыеМаршруты.Получить(Ключ);
        Если ЗначениеЗаполнено(Старый) Тогда Ключ = Старый; КонецЕсли;
        КлючДок = Вид + "#" + УИДСсылки(Док.Ссылка) + "#" + Ключ;
        Событие = СтрокиДокументов.Получить(КлючДок);
        Если Событие = Неопределено Тогда
          Событие = Новый Структура("ДатаДок, Порядок, Ключ, КлючДок, Количество",
            Док.Дата, ?(Вид = "ЗаказПоставщику", 1, 2), Ключ, КлючДок, 0);
          СтрокиДокументов.Вставить(КлючДок, Событие);
          События.Добавить(Событие);
          Данные = Разницы.Получить(КлючДок);
          Если Данные = Неопределено Тогда
            Данные = Новый Структура("Вид, ИД, Описание, Факт, Ожидается", Вид, Док.Ссылка, Док.Номер, 0, 0);
            Разницы.Вставить(КлючДок, Данные);
          КонецЕсли;
          Данные.Описание = Док.Номер + ", " + Строка(Стр.Номенклатура);
        КонецЕсли;
        Событие.Количество = Событие.Количество + Стр.Количество;
      КонецЦикла;
    КонецЦикла;
  КонецЦикла;

  Остатки = Новый Соответствие;
  События.СортироватьПоПолю("ДатаДок, Порядок");
  Для Каждого С Из События Цикл
    Остаток = Остатки.Получить(С.Ключ) + 0;
    Если С.Порядок = 0 Тогда
      Остатки.Вставить(С.Ключ, Остаток + С.Количество);
    Иначе
      Данные = Разницы.Получить(С.КлючДок);
      Если С.Порядок = 1 Тогда
        Данные.Ожидается = С.Количество;
      Иначе
        // При устаревшем количестве в закрытии погашается доступная часть.
        Доступно = Макс(0, Остаток - Данные.Факт);
        Данные.Ожидается = -Мин(С.Количество, Доступно);
      КонецЕсли;
    КонецЕсли;
  КонецЦикла;
  Для Каждого Пара Из Разницы Цикл
    Д = Пара.Значение;
    Дельта = Окр(Д.Факт - Д.Ожидается, 6);
    Если Дельта <> 0 Тогда
      Результат.Добавить(Новый Структура("Проверка,Вид,ИД,Описание,Разница",
        "Количество в пути расходится со строками документа", Д.Вид, УИДСсылки(Д.ИД), Д.Описание, Дельта));
    КонецЕсли;
  КонецЦикла;
КонецПроцедуры

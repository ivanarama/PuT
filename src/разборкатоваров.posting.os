// Разборка товаров: списывает продукцию (ФИФО), оприходует комплектующие.

Процедура ОбработкаПроведения()
  ПроверитьЗакрытыйПериод(this);

  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.ОстаткиТоваров.Очистить();
  Движения.ПартииТоваров.Очистить();

  ПроверитьЗаполнениеСтрокТоваров(this.Расход, "Расход", Ложь);
  ПроверитьЗаполнениеСтрокТоваров(this.Приход, "Приход", Ложь);

  ЗаблокироватьПартии(this.Расход);

  // ── 1. ФИФО-списание разбираемой продукции (ТЧ Расход) ──────────────────

  Результаты = СписатьТоварыФИФО(this.Склад, this.Организация, this.Расход,
    this.МоментВремени(), "разборки");

  ИтогоеСебестоимость    = 0;
  ИтогоеСебестоимостьСНДС = 0;
  Индекс = 0;

  Для Каждого Строка Из this.Расход Цикл
    Рез = Результаты[Индекс];
    Индекс = Индекс + 1;

    ДобавитьДвиженияПартий(Движения.ПартииТоваров, "Расход", Рез.ДвиженияПартий,
      Строка.Номенклатура, this.Склад, this.Организация);

    ИтогоеСебестоимость     = ИтогоеСебестоимость + Рез.Себестоимость;
    ИтогоеСебестоимостьСНДС = ИтогоеСебестоимостьСНДС + Рез.СебестоимостьСНДС;

    ДвО = Движения.ОстаткиТоваров.Добавить();
    ДвО.ВидДвижения  = "Расход";
    ДвО.Номенклатура = Строка.Номенклатура;
    ДвО.Склад        = this.Склад;
    ДвО.Организация  = this.Организация;
    ДвО.Количество   = Строка.Количество;
    ДвО.Сумма        = Рез.Себестоимость;
    ДвО.СуммаСНДС    = Рез.СебестоимостьСНДС;
  КонецЦикла;

  // ── 2. Оприходование комплектующих (ТЧ Приход) ──────────────────────────

  // Себестоимость делится по закупочной стоимости строк (а без цен — по
  // количеству), последней строке достаётся остаток: сумма долей точно равна
  // списанной себестоимости, копейки округления не теряются.
  Веса = ВесаПоЗакупочнойСтоимости(this.Приход, this.Дата);
  Доли = РаспределитьСуммуПоВесам(ИтогоеСебестоимость, Веса);
  ДолиСНДС = РаспределитьСуммуПоВесам(ИтогоеСебестоимостьСНДС, Веса);
  НомерСтроки = 0;

  Для Каждого Строка Из this.Приход Цикл
    СебестоимостьСтроки = Доли[НомерСтроки];
    СебестоимостьСтрокиСНДС = ДолиСНДС[НомерСтроки];
    НомерСтроки = НомерСтроки + 1;

    ДвП = Движения.ПартииТоваров.Добавить();
    ДвП.ВидДвижения  = "Приход";
    ДвП.Номенклатура = Строка.Номенклатура;
    ДвП.Склад        = this.Склад;
    ДвП.Организация  = this.Организация;
    ДвП.ДатаПоставки = this.Дата;
    ДвП.Количество   = Строка.Количество;
    ДвП.Сумма        = СебестоимостьСтроки;
    ДвП.СуммаСНДС    = СебестоимостьСтрокиСНДС;

    ДвО = Движения.ОстаткиТоваров.Добавить();
    ДвО.ВидДвижения  = "Приход";
    ДвО.Номенклатура = Строка.Номенклатура;
    ДвО.Склад        = this.Склад;
    ДвО.Организация  = this.Организация;
    ДвО.Количество   = Строка.Количество;
    ДвО.Сумма        = СебестоимостьСтроки;
    ДвО.СуммаСНДС    = СебестоимостьСтрокиСНДС;
  КонецЦикла;

  this.Сумма = ИтогоеСебестоимость;
КонецПроцедуры

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

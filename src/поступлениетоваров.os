Процедура ОбработкаЗаполнения(ДанныеЗаполнения)
  // Источник единственный (based_on: ЗаказПоставщику) — ветвление не нужно.
  this.Организация = ДанныеЗаполнения.Организация;
  this.Поставщик = ДанныеЗаполнения.Поставщик;
  this.Склад = ДанныеЗаполнения.Склад;
  this.СпособУчетаНДС = ДанныеЗаполнения.СпособУчетаНДС;
  this.ЗаказПоставщику = ДанныеЗаполнения.Ссылка;
  Момент = ?(ЗначениеЗаполнено(this.Дата), this.Дата, ТекущаяДатаВремя());
  Остатки = ОстаткиОдногоЗаказа(this.ЗаказПоставщику, Момент, Истина);
  СкладыСтарого = СкладыСтарогоЗаказа(this.ЗаказПоставщику);
  Номер = 0;
  Для Каждого СтрИсточника Из ДанныеЗаполнения.Товары Цикл
    Номер = Номер + 1;
    СкладСтроки = ?(ЗначениеЗаполнено(СтрИсточника.Склад), СтрИсточника.Склад, this.Склад);
    Ключ = КлючСтрокиЗаказа(СкладСтроки, СтрИсточника.Номенклатура, СтрИсточника.ЗаказПокупателя);
    СтарыйСклад = СкладыСтарого.Получить(Ключ);
    Если ЗначениеЗаполнено(СтарыйСклад) Тогда
      Ключ = КлючСтрокиЗаказа(СтарыйСклад, СтрИсточника.Номенклатура, СтрИсточника.ЗаказПокупателя);
    КонецЕсли;
    Остаток = Остатки.Получить(Ключ);
    Если Остаток = Неопределено ИЛИ Остаток.Количество <= 0 Тогда Продолжить; КонецЕсли;
    СтрПриёмника = this.Товары.Добавить();
    СтрПриёмника.Номенклатура = СтрИсточника.Номенклатура;
    СтрПриёмника.Количество = Мин(СтрИсточника.Количество, Остаток.Количество);
    Остаток.Количество = Остаток.Количество - СтрПриёмника.Количество;
    СтрПриёмника.СтрокаЗаказа = Номер;
    СтрПриёмника.Цена = СтрИсточника.Цена;
    СтрПриёмника.СтавкаНДС = СтрИсточника.СтавкаНДС;
    СтрПриёмника.Склад = СтрИсточника.Склад;
    СтрПриёмника.ЗаказПокупателя = СтрИсточника.ЗаказПокупателя;
  КонецЦикла;

  // Суммы строк и итоги шапки — сразу в форме, а не только при записи.
  ПересчитатьИтоги();
КонецПроцедуры

Процедура ПриЗаписи()
  ПроверитьЗакрытыйПериод(this);

  Если ЗначениеЗаполнено(this.Организация) = Ложь Тогда
    this.Организация = ОрганизацияПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Поставщик) = Ложь Тогда
    Error("Укажите поставщика");
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    this.Склад = СкладПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    Error("Укажите склад");
  КонецЕсли;
  Если this.Товары.Количество() = 0 Тогда
    Error("Добавьте хотя бы одну строку в табличную часть Товары");
  КонецЕсли;

  Способ = this.СпособУчетаНДС;
  Если ЗначениеЗаполнено(Способ) = Ложь Тогда
    Способ = "ВТомЧисле";
    this.СпособУчетаНДС = Способ;
  КонецЕсли;

  Для Каждого Строка Из this.Товары Цикл
    Если ЗначениеЗаполнено(Строка.Номенклатура) = Ложь
       ИЛИ ТипЗнч(Строка.Номенклатура) = "Строка"
       ИЛИ ПустаяСсылка(Строка.Номенклатура) Тогда
      Error("В табличной части есть строка без номенклатуры (или передана строка вместо ссылки)");
    КонецЕсли;
    Если Строка.Количество <= 0 Тогда
      Error("Количество должно быть больше нуля: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;
    Если Строка.Цена < 0 Тогда
      Error("Цена не может быть отрицательной: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;

    Если ЗначениеЗаполнено(Строка.СтавкаНДС) = Ложь Тогда
      Строка.СтавкаНДС = ЗначениеРеквизитаОбъекта(Строка.Номенклатура, "СтавкаНДС");
    КонецЕсли;
  КонецЦикла;

  ПересчитатьИтоги();
КонецПроцедуры

// Пересчёт сумм строк и итогов шапки по СпособуУчетаНДС. Вызывается из
// ОбработкаЗаполнения (чтобы форма открывалась с готовыми суммами) и из
// ПриЗаписи (после валидаций).
Процедура ПересчитатьИтоги()
  Способ = this.СпособУчетаНДС;
  Если ЗначениеЗаполнено(Способ) = Ложь Тогда
    Способ = "ВТомЧисле";
    this.СпособУчетаНДС = Способ;
  КонецЕсли;

  ИтогБезНДС = 0;
  ИтогНДС = 0;
  ИмпортЭДО = ЗначениеЗаполнено(this.Идентификатор1С)
    И СтрНачинаетсяС(this.Идентификатор1С, "ЭДО:");
  Для Каждого Строка Из this.Товары Цикл
    // УПД задаёт финансовую сумму строки независимо от отображаемой цены.
    // Для количества 3 и нетто 100 округлённая цена не должна превращать
    // исходную сумму в 99,99 при записи документа. Поправленная после
    // загрузки строка пересчитывается как обычная (СуммаУПДАктуальна).
    СуммаИзУПД = ИмпортЭДО И СуммаУПДАктуальна(Строка.Количество, Строка.Цена, Строка.Сумма);
    Если НЕ СуммаИзУПД Тогда
      Строка.Сумма = Строка.Количество * Строка.Цена;
    КонецЕсли;
    Если НЕ СуммаИзУПД ИЛИ ТипЗнч(Строка.СуммаНДС) <> Тип("Число") Тогда
      Строка.СуммаНДС = СуммаНДСстроки(Строка.Сумма, Строка.СтавкаНДС, Способ);
    КонецЕсли;

    Если Способ = "Сверху" Тогда
      ИтогБезНДС = ИтогБезНДС + Строка.Сумма;
    Иначе
      ИтогБезНДС = ИтогБезНДС + (Строка.Сумма - Строка.СуммаНДС);
    КонецЕсли;
    ИтогНДС = ИтогНДС + Строка.СуммаНДС;
  КонецЦикла;

  this.СуммаНДС    = ИтогНДС;
  this.СуммаБезНДС = ИтогБезНДС;
  this.Сумма       = ИтогБезНДС + ИтогНДС;
КонецПроцедуры

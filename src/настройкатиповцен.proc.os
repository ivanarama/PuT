// Safety-net: создаёт стандартные типы цен, если их не создал блок predefined.
// Идемпотентно — повторный запуск не плодит дублей и не перезаписывает поля.
// Запускать вручную, если после первой установки в справочнике нет «Закупочной».

Процедура Выполнить()
  // --- Закупочная (хранимый, без базы) ---
  Закупочная = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");
  Если ЗначениеЗаполнено(Закупочная) = Ложь Тогда
    Запись = Справочники.ТипЦен.Создать();
    Запись.Наименование = "Закупочная";
    Запись.ВидРасчета   = "Хранимый";
    Запись.Округление   = 2;
    Запись.Записать();
    Закупочная = Запись.Ссылка;
    Сообщить("Создана «Закупочная»");
  Иначе
    Сообщить("«Закупочная» уже есть — пропуск");
  КонецЕсли;

  // --- Розничная (расчётная, +30% от Закупочной) ---
  Розничная = Справочники.ТипЦен.НайтиПоНаименованию("Розничная");
  Если ЗначениеЗаполнено(Розничная) = Ложь Тогда
    Запись = Справочники.ТипЦен.Создать();
    Запись.Наименование = "Розничная";
    Запись.ВидРасчета   = "Расчетный";
    Запись.БазовыйТип   = Закупочная;
    Запись.Процент      = 30;
    Запись.Округление   = 2;
    Запись.Записать();
    Сообщить("Создана «Розничная» (+30% от Закупочной)");
  Иначе
    Сообщить("«Розничная» уже есть — пропуск");
  КонецЕсли;

  // --- Оптовая (расчётная, +10% от Закупочной) ---
  Оптовая = Справочники.ТипЦен.НайтиПоНаименованию("Оптовая");
  Если ЗначениеЗаполнено(Оптовая) = Ложь Тогда
    Запись = Справочники.ТипЦен.Создать();
    Запись.Наименование = "Оптовая";
    Запись.ВидРасчета   = "Расчетный";
    Запись.БазовыйТип   = Закупочная;
    Запись.Процент      = 10;
    Запись.Округление   = 2;
    Запись.Записать();
    Сообщить("Создана «Оптовая» (+10% от Закупочной)");
  Иначе
    Сообщить("«Оптовая» уже есть — пропуск");
  КонецЕсли;

  Сообщить("Готово.");
КонецПроцедуры

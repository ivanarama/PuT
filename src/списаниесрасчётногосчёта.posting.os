// Банковский ордер на списание денег с расчётного счёта.
// Поведение симметрично РКО, но касса должна быть только банковским счётом.

Процедура ОбработкаПроведения()
  ПроверитьЗакрытыйПериод(this);
  ПроверитьЗаполнениеДенежногоДокумента(this.Сумма, this.Контрагент, this.БанковскийСчёт);
  // Контроль переплаты: оплатить основание можно не больше долга по нему
  ПроверитьНеПереплату(this.ДокументРеализации, this.ДокументПоступления, this, this.Сумма);
  ПроверитьВидКассы(this.БанковскийСчёт, "БанковскийСчёт");
  ПроверитьОстатокДенег(this.БанковскийСчёт, this.Организация, this.Сумма, this.МоментВремени());
  Движения.ДенежныеСредства.Очистить();
  Движения.Взаиморасчеты.Очистить();

  ДвДС = Движения.ДенежныеСредства.Добавить();
  ДвДС.ВидДвижения = "Расход";
  ДвДС.Касса       = this.БанковскийСчёт;
  ДвДС.Организация = this.Организация;
  ДвДС.Сумма       = this.Сумма;
  ДвДС.Контрагент  = this.Контрагент;
  ДвДС.Основание   = this.НазначениеПлатежа;
  ДвДС.Документ    = this;

  ДвВз = Движения.Взаиморасчеты.Добавить();
  ДвВз.ВидДвижения        = "Приход";
  ДвВз.Контрагент         = this.Контрагент;
  ДвВз.Организация        = this.Организация;
  ДвВз.ТипКонтрагента     = ТипКонтрагентаОплаты(this.Контрагент, this.ДокументРеализации, this.ДокументПоступления);
  ДвВз.ДокументРеализации = this.ДокументРеализации;
  ДвВз.ДокументПоступления = this.ДокументПоступления;
  ДвВз.Сумма              = this.Сумма;
КонецПроцедуры

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

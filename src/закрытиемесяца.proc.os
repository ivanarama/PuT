// Обработка «Закрытие месяца и расчёт себестоимости» (OneBase PuT)
//
// Выполняет регламентный пересчёт партионной себестоимости и проведение торговых
// и складских документов за указанный период (или по всей базе).
//
// Перепроводит ТОЛЬКО проведённые и не помеченные на удаление документы
// в правильной последовательности:
// 1. Приходные документы (Поступление товаров, Оприходование)
// 2. Складские перемещения и комплектация (Перемещение, Сборка, Разборка)
// 3. Расходные документы и продажи (Реализация товаров, Возвраты, Списание)

// Последовательность перепроведения: имя типа OneBase.
// 1. Приходные, 2. складские, 3. расходные и продажи.

Функция ДокументВПериоде(ДатаДок, ДатаН, ДатаК)
	Если ЗначениеЗаполнено(ДатаН) И ДатаДок < НачалоДня(ДатаН) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаК) И ДатаДок > КонецДня(ДатаК) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Процедура Выполнить()
	Орг = Параметры.Организация;
	ДатаН = Параметры.ДатаНачала;
	ДатаК = Параметры.ДатаОкончания;

	Сообщить("==================================================");
	Сообщить("Запуск процедуры: Закрытие месяца и расчёт себестоимости");
	Если ЗначениеЗаполнено(Орг) Тогда
		Сообщить("Организация: " + Строка(Орг));
	Иначе
		Сообщить("Организация: Все организации (холдинг)");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаН) Или ЗначениеЗаполнено(ДатаК) Тогда
		Сообщить("Период: с " + Строка(ДатаН) + " по " + Строка(ДатаК));
	Иначе
		Сообщить("Период: Все периоды");
	КонецЕсли;
	Сообщить("==================================================");

	ВсегоДокументов = 0;
	Успешно = 0;
	Ошибок = 0;

	ТипыДокументов = Новый Массив;
	ТипыДокументов.Добавить("ПоступлениеТоваров");
	ТипыДокументов.Добавить("ОприходованиеТоваров");
	ТипыДокументов.Добавить("ПеремещениеТоваров");
	ТипыДокументов.Добавить("СборкаТоваров");
	ТипыДокументов.Добавить("РазборкаТоваров");
	ТипыДокументов.Добавить("РеализацияТоваров");
	ТипыДокументов.Добавить("ВозвратОтПокупателя");
	ТипыДокументов.Добавить("ВозвратПоставщику");
	ТипыДокументов.Добавить("СписаниеТоваров");

	Менеджеры = Новый Соответствие;
	Менеджеры.Вставить("ПоступлениеТоваров", Документы.ПоступлениеТоваров);
	Менеджеры.Вставить("ОприходованиеТоваров", Документы.ОприходованиеТоваров);
	Менеджеры.Вставить("ПеремещениеТоваров", Документы.ПеремещениеТоваров);
	Менеджеры.Вставить("СборкаТоваров", Документы.СборкаТоваров);
	Менеджеры.Вставить("РазборкаТоваров", Документы.РазборкаТоваров);
	Менеджеры.Вставить("РеализацияТоваров", Документы.РеализацияТоваров);
	Менеджеры.Вставить("ВозвратОтПокупателя", Документы.ВозвратОтПокупателя);
	Менеджеры.Вставить("ВозвратПоставщику", Документы.ВозвратПоставщику);
	Менеджеры.Вставить("СписаниеТоваров", Документы.СписаниеТоваров);

	Для Каждого ИмяТипа Из ТипыДокументов Цикл
		Менеджер = Менеджеры.Получить(ИмяТипа);
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД, Дата ИЗ Документ." + ИмяТипа
			+ " ГДЕ posted = 1 И deletion_mark = 0 УПОРЯДОЧИТЬ ПО Дата";
		Для Каждого Стр Из Запрос.Выполнить() Цикл
			Если ДокументВПериоде(Стр.Дата, ДатаН, ДатаК) Тогда
				ВсегоДокументов = ВсегоДокументов + 1;
				Попытка
					Док = Менеджер.НайтиПоИдентификатору(Стр.ИД).ПолучитьОбъект();
					Если ЗначениеЗаполнено(Док) И (ЗначениеЗаполнено(Орг) = Ложь Или Док.Организация = Орг) Тогда
						Док.Провести();
						Успешно = Успешно + 1;
					КонецЕсли;
				Исключение
					Ошибок = Ошибок + 1;
					Сообщить("Ошибка проведения " + ИмяТипа + ": " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Сообщить("==================================================");
	Сообщить("ИТОГИ ЗАКРЫТИЯ МЕСЯЦА:");
	Сообщить("Всего документов в выборке: " + Строка(ВсегоДокументов));
	Сообщить("Успешно перепроведено:      " + Строка(Успешно));
	Сообщить("Ошибок:                     " + Строка(Ошибок));
	Если Ошибок > 0 Тогда
		Сообщить("ВНИМАНИЕ: были ошибки проведения — проверьте журнал сообщений.");
	КонецЕсли;
	Сообщить("Расчёт себестоимости и движений завершён.");
	Сообщить("==================================================");
КонецПроцедуры

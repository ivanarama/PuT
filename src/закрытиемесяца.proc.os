// Обработка «Закрытие месяца и расчёт себестоимости» (OneBase PuT)
//
// Перепроводит проведённые и не помеченные на удаление складские и торговые
// документы периода, чтобы пересчитать партионную себестоимость (ФИФО), и по
// флажку закрывает период датой запрета изменения.
//
// Порядок — сквозной по времени документа (ПерепровестиДокументыХронологически
// в общем модуле утилиты).

Процедура Выполнить()
  Орг = Параметры.Организация;
  ДатаН = Параметры.ДатаНачала;
  ДатаК = Параметры.ДатаОкончания;
  ЗакрытьПериод = (Параметры.УстановитьДатуЗапрета = Истина);

  Сообщить("==================================================");
  Сообщить("Запуск процедуры: Закрытие месяца и расчёт себестоимости");
  Если ЗначениеЗаполнено(Орг) Тогда
    Сообщить("Организация: " + Строка(Орг));
  Иначе
    Сообщить("Организация: Все организации (холдинг)");
  КонецЕсли;
  Если ЗначениеЗаполнено(ДатаН) Или ЗначениеЗаполнено(ДатаК) Тогда
    Сообщить("Период: с " + Строка(ДатаН) + " по " + Строка(ДатаК));
  Иначе
    Сообщить("Период: Все периоды");
  КонецЕсли;

  // Закрытый период не перепроводится: его документы менять нельзя.
  Запрет = Константы.ДатаЗапретаРедактирования;
  Если ЗначениеЗаполнено(Запрет) Тогда
    НачалоОткрытого = КонецДня(Запрет) + 1;
    Если ЗначениеЗаполнено(ДатаН) = Ложь ИЛИ НачалоДня(ДатаН) < НачалоОткрытого Тогда
      Сообщить("Период по " + Формат(Запрет, "ДФ=dd.MM.yyyy") + " закрыт — его документы не перепроводятся.");
      ДатаН = НачалоОткрытого;
    КонецЕсли;
  КонецЕсли;
  Сообщить("==================================================");

  Итоги = ПерепровестиДокументыХронологически(ДатаН, ДатаК, Орг);
  ВсегоДокументов = Итоги.Всего;
  Успешно = Итоги.Успешно;
  Ошибок = Итоги.Ошибок;

  Сообщить("==================================================");
  Сообщить("ИТОГИ ЗАКРЫТИЯ МЕСЯЦА:");
  Сообщить("Всего документов в выборке: " + Строка(ВсегоДокументов));
  Сообщить("Успешно перепроведено:      " + Строка(Успешно));
  Сообщить("Ошибок:                     " + Строка(Ошибок));
  Если Ошибок > 0 Тогда
    Сообщить("ВНИМАНИЕ: были ошибки проведения — проверьте журнал сообщений.");
  КонецЕсли;

  Если ЗакрытьПериод Тогда
    Если ЗначениеЗаполнено(ДатаК) = Ложь Тогда
      Сообщить("Период не закрыт: укажите дату окончания.");
    ИначеЕсли Ошибок > 0 Тогда
      Сообщить("Период не закрыт: сначала исправьте ошибки проведения.");
    Иначе
      Константы.ДатаЗапретаРедактирования = НачалоДня(ДатаК);
      Сообщить("Период закрыт: изменение документов по " + Формат(ДатаК, "ДФ=dd.MM.yyyy") + " запрещено.");
    КонецЕсли;
  КонецЕсли;
  Сообщить("Расчёт себестоимости и движений завершён.");
  Сообщить("==================================================");
КонецПроцедуры

// Обработка «Закрытие месяца и расчёт себестоимости» (OneBase PuT)
//
// Перепроводит проведённые и не помеченные на удаление складские и торговые
// документы периода, чтобы пересчитать партионную себестоимость (ФИФО), и по
// флажку закрывает период датой запрета изменения.
//
// Порядок — сквозной по времени документа (ПерепровестиДокументыХронологически
// в общем модуле утилиты).

Процедура Выполнить()
  Орг = Параметры.Организация;
  Если ТипЗнч(Орг) = "Строка" И ЗначениеЗаполнено(Орг) Тогда
    Орг = Справочники.Организация.НайтиПоИдентификатору(Орг);
    Если НЕ ЗначениеЗаполнено(Орг) Тогда ВызватьИсключение("Организация не найдена"); КонецЕсли;
  КонецЕсли;
  ДатаН = Параметры.ДатаНачала;
  Если ЗначениеЗаполнено(ДатаН) Тогда ДатаН = Дата(ДатаН); КонецЕсли;
  ДатаК = Параметры.ДатаОкончания;
  Если ЗначениеЗаполнено(ДатаК) Тогда ДатаК = Дата(ДатаК); КонецЕсли;
  Если Параметры.ТолькоСверка = Истина Тогда
    Если НЕ ЗначениеЗаполнено(ДатаК) Тогда ВызватьИсключение("Для сверки укажите дату окончания."); КонецЕсли;
    ВывестиСверкуУчетаПуТ(ДатаК);
    Возврат;
  КонецЕсли;
  ЗакрытьПериод = (Параметры.УстановитьДатуЗапрета = Истина);

  Сообщить("==================================================");
  Сообщить("Запуск процедуры: Закрытие месяца и расчёт себестоимости");
  Если ЗначениеЗаполнено(Орг) Тогда
    Сообщить("Организация: " + Строка(Орг));
  Иначе
    Сообщить("Организация: Все организации (холдинг)");
  КонецЕсли;
  Если ЗначениеЗаполнено(ДатаН) Или ЗначениеЗаполнено(ДатаК) Тогда
    Сообщить("Период: с " + Строка(ДатаН) + " по " + Строка(ДатаК));
  Иначе
    Сообщить("Период: Все периоды");
  КонецЕсли;

  // Закрытый период не перепроводится: его документы менять нельзя.
  Запрет = Константы.ДатаЗапретаРедактирования;
  Если ЗакрытьПериод Тогда
    Если НЕ ЗначениеЗаполнено(ДатаК) Тогда ВызватьИсключение("Для закрытия укажите дату окончания."); КонецЕсли;
    Если ЗначениеЗаполнено(Орг) Тогда
      ВызватьИсключение("Дата запрета общая для всех организаций. Очистите отбор по организации или снимите флажок закрытия.");
    КонецЕсли;
    Если ЗначениеЗаполнено(ДатаН) И НачалоДня(ДатаН) > КонецДня(ДатаК) Тогда
      ВызватьИсключение("Дата начала позже даты окончания.");
    КонецЕсли;
    Если ЗначениеЗаполнено(Запрет) И НачалоДня(ДатаК) <= НачалоДня(Запрет) Тогда
      Сообщить("Период уже закрыт по " + Формат(Запрет, "ДФ=dd.MM.yyyy") + ".");
      Возврат;
    КонецЕсли;
    // Глобальная граница требует проверки всего ещё открытого интервала.
    ДатаН = Неопределено;
    Сообщить("Для установки даты запрета проверяется весь открытый период по дату окончания.");
  КонецЕсли;
  Если ЗначениеЗаполнено(Запрет) Тогда
    НачалоОткрытого = КонецДня(Запрет) + 1;
    Если ЗначениеЗаполнено(ДатаН) = Ложь ИЛИ НачалоДня(ДатаН) < НачалоОткрытого Тогда
      Сообщить("Период по " + Формат(Запрет, "ДФ=dd.MM.yyyy") + " закрыт — его документы не перепроводятся.");
      ДатаН = НачалоОткрытого;
    КонецЕсли;
  КонецЕсли;
  Сообщить("==================================================");

  Итоги = ПерепровестиДокументыХронологически(ДатаН, ДатаК, Орг);
  ВсегоДокументов = Итоги.Всего;
  Успешно = Итоги.Успешно;
  Ошибок = Итоги.Ошибок;

  Сообщить("==================================================");
  Сообщить("ИТОГИ ЗАКРЫТИЯ МЕСЯЦА:");
  Сообщить("Всего документов в выборке: " + Строка(ВсегоДокументов));
  Сообщить("Успешно перепроведено:      " + Строка(Успешно));
  Сообщить("Ошибок:                     " + Строка(Ошибок));
  Если Ошибок > 0 Тогда
    Сообщить("ВНИМАНИЕ: были ошибки проведения — проверьте журнал сообщений.");
  КонецЕсли;

  Если ЗакрытьПериод И Ошибок = 0 Тогда
    Если ВывестиСверкуУчетаПуТ(ДатаК) > 0 Тогда
      ВызватьИсключение("Период открыт: сверка обнаружила ошибки учёта. Откройте сверку на дату окончания и проверьте указанные документы.");
    КонецЕсли;
    Блокировка = БлокировкаДанных();
    Попытка

      Блокировка.Добавить("ДатаЗапретаРедактирования");
      Блокировка.Заблокировать();
      ТекущаяГраница = Константы.ДатаЗапретаРедактирования;
      Если НЕ ЗначениеЗаполнено(ТекущаяГраница) ИЛИ НачалоДня(ДатаК) > НачалоДня(ТекущаяГраница) Тогда
        Константы.ДатаЗапретаРедактирования = НачалоДня(ДатаК);
      КонецЕсли;
      Блокировка.Разблокировать();
    Исключение
      Блокировка.Разблокировать();
      ВызватьИсключение;
    КонецПопытки;
    Сообщить("Период закрыт по " + Формат(Константы.ДатаЗапретаРедактирования, "ДФ=dd.MM.yyyy") + ".");
  КонецЕсли;
  Если Ошибок > 0 Тогда ВызватьИсключение("Закрытие завершилось с ошибками проведения: " + Строка(Ошибок)); КонецЕсли;
  Сообщить("Расчёт себестоимости и движений завершён.");
  Сообщить("==================================================");
КонецПроцедуры

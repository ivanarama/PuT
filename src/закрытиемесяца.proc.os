// Обработка «Закрытие месяца и расчёт себестоимости» (OneBase PuT)
//
// Выполняет регламентный пересчёт партионной себестоимости и проведение торговых
// и складских документов за указанный период (или по всей базе).
//
// Перепроводит документы в правильной последовательности:
// 1. Приходные документы (Поступление товаров, Оприходование)
// 2. Складские перемещения и комплектация (Перемещение, Сборка, Разборка)
// 3. Расходные документы и продажи (Реализация товаров, Возвраты, Списание)

Функция ДатаISO(Д)
	Если Д = Неопределено Или Д = Null Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Д);
КонецФункции

Функция ДокументВПериоде(ДатаДок, ДатаН, ДатаК)
	СтрД = ДатаISO(ДатаДок);
	Если ЗначениеЗаполнено(ДатаН) И СтрД < ДатаISO(ДатаН) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаК) И СтрД > ДатаISO(ДатаК) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Процедура Выполнить()
	Орг = Параметры.Организация;
	ДатаН = Параметры.ДатаНачала;
	ДатаК = Параметры.ДатаОкончания;

	Сообщить("==================================================");
	Сообщить("Запуск процедуры: Закрытие месяца и расчёт себестоимости");
	Если ЗначениеЗаполнено(Орг) Тогда
		Сообщить("Организация: " + Строка(Орг));
	Иначе
		Сообщить("Организация: Все организации (холдинг)");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаН) Или ЗначениеЗаполнено(ДатаК) Тогда
		Сообщить("Период: с " + Строка(ДатаН) + " по " + Строка(ДатаК));
	Иначе
		Сообщить("Период: Все периоды");
	КонецЕсли;
	Сообщить("==================================================");

	ВсегоДокументов = 0;
	Успешно = 0;
	Ошибок = 0;

	// 1. Поступление товаров
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД, Дата ИЗ Документ.ПоступлениеТоваров УПОРЯДОЧИТЬ ПО Дата";
	Для Каждого Стр Из Запрос.Выполнить() Цикл
		Если ДокументВПериоде(Стр.Дата, ДатаН, ДатаК) Тогда
			ВсегоДокументов = ВсегоДокументов + 1;
			Попытка
				Док = Документы.ПоступлениеТоваров.НайтиПоИдентификатору(Стр.ИД).ПолучитьОбъект();
				Если ЗначениеЗаполнено(Док) И (ЗначениеЗаполнено(Орг) = Ложь Или Док.Организация = Орг) Тогда
					Док.Провести();
					Успешно = Успешно + 1;
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка проведения ПоступлениеТоваров: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	// 2. Оприходование товаров
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД, Дата ИЗ Документ.ОприходованиеТоваров УПОРЯДОЧИТЬ ПО Дата";
	Для Каждого Стр Из Запрос.Выполнить() Цикл
		Если ДокументВПериоде(Стр.Дата, ДатаН, ДатаК) Тогда
			ВсегоДокументов = ВсегоДокументов + 1;
			Попытка
				Док = Документы.ОприходованиеТоваров.НайтиПоИдентификатору(Стр.ИД).ПолучитьОбъект();
				Если ЗначениеЗаполнено(Док) И (ЗначениеЗаполнено(Орг) = Ложь Или Док.Организация = Орг) Тогда
					Док.Провести();
					Успешно = Успешно + 1;
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка проведения ОприходованиеТоваров: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	// 3. Перемещение товаров
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД, Дата ИЗ Документ.ПеремещениеТоваров УПОРЯДОЧИТЬ ПО Дата";
	Для Каждого Стр Из Запрос.Выполнить() Цикл
		Если ДокументВПериоде(Стр.Дата, ДатаН, ДатаК) Тогда
			ВсегоДокументов = ВсегоДокументов + 1;
			Попытка
				Док = Документы.ПеремещениеТоваров.НайтиПоИдентификатору(Стр.ИД).ПолучитьОбъект();
				Если ЗначениеЗаполнено(Док) И (ЗначениеЗаполнено(Орг) = Ложь Или Док.Организация = Орг) Тогда
					Док.Провести();
					Успешно = Успешно + 1;
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка проведения ПеремещениеТоваров: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	// 4. Сборка товаров
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД, Дата ИЗ Документ.СборкаТоваров УПОРЯДОЧИТЬ ПО Дата";
	Для Каждого Стр Из Запрос.Выполнить() Цикл
		Если ДокументВПериоде(Стр.Дата, ДатаН, ДатаК) Тогда
			ВсегоДокументов = ВсегоДокументов + 1;
			Попытка
				Док = Документы.СборкаТоваров.НайтиПоИдентификатору(Стр.ИД).ПолучитьОбъект();
				Если ЗначениеЗаполнено(Док) И (ЗначениеЗаполнено(Орг) = Ложь Или Док.Организация = Орг) Тогда
					Док.Провести();
					Успешно = Успешно + 1;
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка проведения СборкаТоваров: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	// 5. Разборка товаров
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД, Дата ИЗ Документ.РазборкаТоваров УПОРЯДОЧИТЬ ПО Дата";
	Для Каждого Стр Из Запрос.Выполнить() Цикл
		Если ДокументВПериоде(Стр.Дата, ДатаН, ДатаК) Тогда
			ВсегоДокументов = ВсегоДокументов + 1;
			Попытка
				Док = Документы.РазборкаТоваров.НайтиПоИдентификатору(Стр.ИД).ПолучитьОбъект();
				Если ЗначениеЗаполнено(Док) И (ЗначениеЗаполнено(Орг) = Ложь Или Док.Организация = Орг) Тогда
					Док.Провести();
					Успешно = Успешно + 1;
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка проведения РазборкаТоваров: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	// 6. Реализация товаров
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД, Дата ИЗ Документ.РеализацияТоваров УПОРЯДОЧИТЬ ПО Дата";
	Для Каждого Стр Из Запрос.Выполнить() Цикл
		Если ДокументВПериоде(Стр.Дата, ДатаН, ДатаК) Тогда
			ВсегоДокументов = ВсегоДокументов + 1;
			Попытка
				Док = Документы.РеализацияТоваров.НайтиПоИдентификатору(Стр.ИД).ПолучитьОбъект();
				Если ЗначениеЗаполнено(Док) И (ЗначениеЗаполнено(Орг) = Ложь Или Док.Организация = Орг) Тогда
					Док.Провести();
					Успешно = Успешно + 1;
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка проведения РеализацияТоваров: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	// 7. Возврат от покупателя
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД, Дата ИЗ Документ.ВозвратОтПокупателя УПОРЯДОЧИТЬ ПО Дата";
	Для Каждого Стр Из Запрос.Выполнить() Цикл
		Если ДокументВПериоде(Стр.Дата, ДатаН, ДатаК) Тогда
			ВсегоДокументов = ВсегоДокументов + 1;
			Попытка
				Док = Документы.ВозвратОтПокупателя.НайтиПоИдентификатору(Стр.ИД).ПолучитьОбъект();
				Если ЗначениеЗаполнено(Док) И (ЗначениеЗаполнено(Орг) = Ложь Или Док.Организация = Орг) Тогда
					Док.Провести();
					Успешно = Успешно + 1;
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка проведения ВозвратОтПокупателя: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	// 8. Возврат поставщику
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД, Дата ИЗ Документ.ВозвратПоставщику УПОРЯДОЧИТЬ ПО Дата";
	Для Каждого Стр Из Запрос.Выполнить() Цикл
		Если ДокументВПериоде(Стр.Дата, ДатаН, ДатаК) Тогда
			ВсегоДокументов = ВсегоДокументов + 1;
			Попытка
				Док = Документы.ВозвратПоставщику.НайтиПоИдентификатору(Стр.ИД).ПолучитьОбъект();
				Если ЗначениеЗаполнено(Док) И (ЗначениеЗаполнено(Орг) = Ложь Или Док.Организация = Орг) Тогда
					Док.Провести();
					Успешно = Успешно + 1;
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка проведения ВозвратПоставщику: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	// 9. Списание товаров
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД, Дата ИЗ Документ.СписаниеТоваров УПОРЯДОЧИТЬ ПО Дата";
	Для Каждого Стр Из Запрос.Выполнить() Цикл
		Если ДокументВПериоде(Стр.Дата, ДатаН, ДатаК) Тогда
			ВсегоДокументов = ВсегоДокументов + 1;
			Попытка
				Док = Документы.СписаниеТоваров.НайтиПоИдентификатору(Стр.ИД).ПолучитьОбъект();
				Если ЗначениеЗаполнено(Док) И (ЗначениеЗаполнено(Орг) = Ложь Или Док.Организация = Орг) Тогда
					Док.Провести();
					Успешно = Успешно + 1;
				КонецЕсли;
			Исключение
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка проведения СписаниеТоваров: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Сообщить("==================================================");
	Сообщить("ИТОГИ ЗАКРЫТИЯ МЕСЯЦА:");
	Сообщить("Всего документов в выборке: " + Строка(ВсегоДокументов));
	Сообщить("Успешно перепроведено:      " + Строка(Успешно));
	Сообщить("Ошибок:                     " + Строка(Ошибок));
	Сообщить("Расчёт себестоимости и движений завершён успешно.");
	Сообщить("==================================================");
КонецПроцедуры

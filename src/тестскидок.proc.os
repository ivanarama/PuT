// Скидка в строках товаров (счёт, заказ покупателя, реализация).
// - Скидку можно задать суммой: без процента введённая сумма сохраняется при
//   записи и проведении, а не обнуляется.
// - Заполненный процент выводит сумму скидки из суммы строки.
// - Скидка больше суммы строки и процент вне 0–100 отклоняются: строка
//   иначе уходила бы в минус.
// Запуск:
//   onebase test --project . --sqlite <база> --run Скидок

Процедура ДобавитьСтроку(Документ, Номенклатура, ПроцентСкидки, СуммаСкидки)
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = 2;
  СтрокаТЧ.Цена = 500;
  СтрокаТЧ.ПроцентСкидки = ПроцентСкидки;
  СтрокаТЧ.СуммаСкидки = СуммаСкидки;
КонецПроцедуры

// Пустая строка — счёт записан, иначе текст отказа.
Функция ЗаписатьСчёт(Организация, Покупатель, Номенклатура, ПроцентСкидки, СуммаСкидки)
  Документ = Документы.Счёт.Создать();
  Документ.Дата = Дата(2026, 9, 20, 10, 0, 0);
  Документ.Организация = Организация;
  Документ.Покупатель = Покупатель;
  ДобавитьСтроку(Документ, Номенклатура, ПроцентСкидки, СуммаСкидки);
  Попытка
    Документ.Записать();
    Возврат "";
  Исключение
    Возврат ОписаниеОшибки();
  КонецПопытки;
КонецФункции

Функция ДолгПокупателя(Реализация)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Сумма ИЗ РегистрНакопления.Взаиморасчеты
                  ГДЕ ДокументРеализации = &Док И ВидДвижения = 'Приход'";
  Запрос.УстановитьПараметр("Док", Реализация);
  Итог = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Итог = Итог + Стр.Сумма;
  КонецЦикла;
  Возврат Итог;
КонецФункции

Процедура Выполнить()
  Орг = Справочники.Организация.Создать();
  Орг.Наименование = "Тест скидок: организация";
  Организация = Орг.Записать();
  Скл = Справочники.Склад.Создать();
  Скл.Наименование = "Тест скидок: склад";
  Склад = Скл.Записать();
  Пост = Справочники.Контрагент.Создать();
  Пост.Наименование = "Тест скидок: поставщик";
  Пост.Вид = "Поставщик";
  Поставщик = Пост.Записать();
  Пок = Справочники.Контрагент.Создать();
  Пок.Наименование = "Тест скидок: покупатель";
  Пок.Вид = "Покупатель";
  Покупатель = Пок.Записать();
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест скидок: лампа";
  Лампа = Ном.Записать();

  // ── 1. Счёт: скидка суммой переживает запись ──────────────────────────
  Счёт = Документы.Счёт.Создать();
  Счёт.Дата = Дата(2026, 9, 20, 9, 0, 0);
  Счёт.Организация = Организация;
  Счёт.Покупатель = Покупатель;
  ДобавитьСтроку(Счёт, Лампа, 0, 150);
  Счёт.Записать();
  Прочитан = Счёт.Ссылка.ПолучитьОбъект();
  Для Каждого Стр Из Прочитан.Товары Цикл
    Утверждать.Равно(Стр.СуммаСкидки, 150, "счёт: скидка суммой не обнуляется при записи");
    Утверждать.Равно(Стр.Сумма, 850, "счёт: сумма строки 2 × 500 − 150");
  КонецЦикла;
  Утверждать.Равно(Прочитан.Сумма, 850, "счёт: итог документа учитывает скидку суммой");

  // ── 2. Заказ покупателя: процент выводит сумму скидки ─────────────────
  Заказ = Документы.ЗаказПокупателя.Создать();
  Заказ.Дата = Дата(2026, 9, 20, 9, 30, 0);
  Заказ.Организация = Организация;
  Заказ.Покупатель = Покупатель;
  Заказ.Склад = Склад;
  ДобавитьСтроку(Заказ, Лампа, 10, 0);
  Заказ.Записать();
  Прочитан = Заказ.Ссылка.ПолучитьОбъект();
  Для Каждого Стр Из Прочитан.Товары Цикл
    Утверждать.Равно(Стр.СуммаСкидки, 100, "заказ: 10 % от 1000");
    Утверждать.Равно(Стр.Сумма, 900, "заказ: сумма строки со скидкой процентом");
  КонецЦикла;

  // ── 3. Реализация: скидка суммой доезжает до взаиморасчётов ───────────
  Поступление = Документы.ПоступлениеТоваров.Создать();
  Поступление.Дата = Дата(2026, 9, 20, 8, 0, 0);
  Поступление.Организация = Организация;
  Поступление.Поставщик = Поставщик;
  Поступление.Склад = Склад;
  СтрокаТЧ = Поступление.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Лампа;
  СтрокаТЧ.Количество = 10;
  СтрокаТЧ.Цена = 100;
  Поступление.Провести();
  Продажа = Документы.РеализацияТоваров.Создать();
  Продажа.Дата = Дата(2026, 9, 20, 11, 0, 0);
  Продажа.Организация = Организация;
  Продажа.Покупатель = Покупатель;
  Продажа.Склад = Склад;
  ДобавитьСтроку(Продажа, Лампа, 0, 150);
  Продажа.Провести();
  Прочитан = Продажа.Ссылка.ПолучитьОбъект();
  Утверждать.Равно(Прочитан.Сумма, 850, "реализация: итог со скидкой суммой");
  Утверждать.Равно(ДолгПокупателя(Продажа.Ссылка), 850, "реализация: долг покупателя со скидкой суммой");

  // ── 4. Скидка, уводящая строку в минус, отклоняется ───────────────────
  Отказ = ЗаписатьСчёт(Организация, Покупатель, Лампа, 0, 1500);
  Утверждать.Истина(СтрНайти(Отказ, "больше суммы строки") > 0,
    "скидка 1500 при сумме строки 1000 отклонена: " + Отказ);
  Отказ = ЗаписатьСчёт(Организация, Покупатель, Лампа, 120, 0);
  Утверждать.Истина(СтрНайти(Отказ, "от 0 до 100") > 0,
    "процент скидки 120 отклонён: " + Отказ);
  Отказ = ЗаписатьСчёт(Организация, Покупатель, Лампа, 0, -10);
  Утверждать.Истина(СтрНайти(Отказ, "не может быть отрицательной") > 0,
    "отрицательная скидка отклонена: " + Отказ);
  Утверждать.Равно(ЗаписатьСчёт(Организация, Покупатель, Лампа, 100, 0), "",
    "скидка 100 % допустима");
КонецПроцедуры

// - Возврат от покупателя по реализации берёт себестоимость этой продажи, а не
//   текущих партий склада, и не возвращает больше проданного.
// - «Закрытие заказов покупателей» на основании заказа записывается (строки ТЧ
//   получали наименование вместо ссылки) и не уводит резерв в минус.
// - Два поступления одного товара в одну минуту: цену дня задаёт первое,
//   второе проводится, отмена его проведения цену первого не удаляет.
// Запуск:
//   onebase test --project . --sqlite <база> --run ВозвратовИЗаказов

Функция Поступление(Организация, Склад, Поставщик, Номенклатура, Количество, Цена, ДатаДокумента)
  Документ = Документы.ПоступлениеТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Поставщик = Поставщик;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = Количество;
  СтрокаТЧ.Цена = Цена;
  Документ.Провести();
  Возврат Документ.Ссылка;
КонецФункции

Функция Реализация(Организация, Склад, Покупатель, Номенклатура, Количество, ДатаДокумента, Заказ = Неопределено)
  Документ = Документы.РеализацияТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Покупатель = Покупатель;
  Документ.Склад = Склад;
  Если Заказ <> Неопределено Тогда
    Документ.ЗаказПокупателя = Заказ;
  КонецЕсли;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = Количество;
  СтрокаТЧ.Цена = 500;
  Документ.Провести();
  Возврат Документ.Ссылка;
КонецФункции

// Пустая строка — возврат проведён, иначе текст отказа.
Функция ОформитьВозврат(Организация, Склад, Покупатель, Номенклатура, Количество, Основание, ДатаДокумента)
  Документ = Документы.ВозвратОтПокупателя.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Покупатель = Покупатель;
  Документ.Склад = Склад;
  Документ.Основание = Основание;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = Количество;
  СтрокаТЧ.Цена = 500;
  Попытка
    Документ.Провести();
    Возврат "";
  Исключение
    Возврат ОписаниеОшибки();
  КонецПопытки;
КонецФункции

Функция СебестоимостьВозвратов(Номенклатура)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Себестоимость ИЗ РегистрНакопления.ВаловаяПрибыль
                  ГДЕ Номенклатура = &Ном И ВидДвижения = 'Расход'";
  Запрос.УстановитьПараметр("Ном", Номенклатура);
  Итог = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Итог = Итог + Стр.Себестоимость;
  КонецЦикла;
  Возврат Итог;
КонецФункции

Функция Резерв(Заказ)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ КоличествоОстаток ИЗ РегистрНакопления.РезервыТоваров.Остатки()
                  ГДЕ ЗаказПокупателя = &Заказ";
  Запрос.УстановитьПараметр("Заказ", Заказ);
  Итог = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Итог = Итог + Стр.КоличествоОстаток;
  КонецЦикла;
  Возврат Итог;
КонецФункции

Функция ЦенаЗакупочная(Номенклатура)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Цена ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних()
                  ГДЕ Номенклатура = &Ном";
  Запрос.УстановитьПараметр("Ном", Номенклатура);
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Возврат Стр.Цена;
  КонецЦикла;
  Возврат 0;
КонецФункции

Процедура Выполнить()
  Орг = Справочники.Организация.Создать();
  Орг.Наименование = "Тест возвратов: организация";
  Организация = Орг.Записать();
  Скл = Справочники.Склад.Создать();
  Скл.Наименование = "Тест возвратов: склад";
  Склад = Скл.Записать();
  Пост = Справочники.Контрагент.Создать();
  Пост.Наименование = "Тест возвратов: поставщик";
  Пост.Вид = "Поставщик";
  Поставщик = Пост.Записать();
  Пок = Справочники.Контрагент.Создать();
  Пок.Наименование = "Тест возвратов: покупатель";
  Пок.Вид = "Покупатель";
  Покупатель = Пок.Записать();

  // ── 1. Возврат по реализации — себестоимость продажи ──────────────────
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест возвратов: кресло";
  Кресло = Ном.Записать();
  Поступление(Организация, Склад, Поставщик, Кресло, 10, 100, Дата(2026, 9, 15, 9, 0, 0));
  Продажа = Реализация(Организация, Склад, Покупатель, Кресло, 10, Дата(2026, 9, 15, 10, 0, 0));
  // Новая партия дороже: оценка по текущим партиям дала бы 200 за штуку.
  Поступление(Организация, Склад, Поставщик, Кресло, 10, 200, Дата(2026, 9, 15, 11, 0, 0));
  Утверждать.Равно(ОформитьВозврат(Организация, Склад, Покупатель, Кресло, 3, Продажа, Дата(2026, 9, 15, 12, 0, 0)), "",
    "возврат 3 из 10 проведён");
  Утверждать.Равно(СебестоимостьВозвратов(Кресло), 300, "себестоимость возврата — по продаже: 3 × 100");
  Отказ = ОформитьВозврат(Организация, Склад, Покупатель, Кресло, 8, Продажа, Дата(2026, 9, 15, 13, 0, 0));
  Утверждать.Истина(СтрНайти(Отказ, "больше, чем продано") > 0,
    "возврат сверх проданного отклонён (3 уже возвращено, 8 ещё): " + Отказ);

  // ── 2. Закрытие заказа на основании ───────────────────────────────────
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест возвратов: полка";
  Полка = Ном.Записать();
  Поступление(Организация, Склад, Поставщик, Полка, 10, 100, Дата(2026, 9, 16, 9, 0, 0));
  ЗаказДок = Документы.ЗаказПокупателя.Создать();
  ЗаказДок.Дата = Дата(2026, 9, 16, 10, 0, 0);
  ЗаказДок.Организация = Организация;
  ЗаказДок.Покупатель = Покупатель;
  ЗаказДок.Склад = Склад;
  СтрокаТЧ = ЗаказДок.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Полка;
  СтрокаТЧ.Количество = 5;
  СтрокаТЧ.Цена = 500;
  ЗаказДок.Провести();
  Заказ = ЗаказДок.Ссылка;
  Утверждать.Равно(Резерв(Заказ), 5, "заказ зарезервировал 5");

  Закрытие = Документы.ЗакрытиеЗаказовПокупателей.Создать();
  Закрытие.Дата = Дата(2026, 9, 16, 11, 0, 0);
  Закрытие.Заполнить(Заказ);
  // Пока закрытие не проведено, по заказу отгрузили 2: закрыть остаётся 3.
  Реализация(Организация, Склад, Покупатель, Полка, 2, Дата(2026, 9, 16, 10, 30, 0), Заказ);
  Ошибка = "";
  Попытка
    Закрытие.Провести();
  Исключение
    Ошибка = ОписаниеОшибки();
  КонецПопытки;
  Утверждать.Равно(Ошибка, "", "закрытие заказа на основании проводится");
  Утверждать.Равно(Резерв(Заказ), 0, "резерв закрыт до нуля, а не в минус");

  // ── 3. Цена дня при двух поступлениях ─────────────────────────────────
  Ном = Справочники.Номенклатура.Создать();
  Ном.Наименование = "Тест возвратов: тумба";
  Тумба = Ном.Записать();
  Поступление(Организация, Склад, Поставщик, Тумба, 1, 100, Дата(2026, 9, 17, 10, 0, 0));
  Второе = Поступление(Организация, Склад, Поставщик, Тумба, 1, 120, Дата(2026, 9, 17, 10, 0, 0));
  Утверждать.Равно(ЦенаЗакупочная(Тумба), 100, "цену дня задаёт первое поступление");
  Документы.ПоступлениеТоваров.ОтменитьПроведение(Второе);
  Утверждать.Равно(ЦенаЗакупочная(Тумба), 100, "отмена второго поступления не удалила цену первого");
КонецПроцедуры

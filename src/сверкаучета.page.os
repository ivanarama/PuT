Процедура ПриФормировании(Страница, Параметры) Экспорт
  НаДату = ТекущаяДата();
  Если ЗначениеЗаполнено(Параметры.Получить("дата")) Тогда НаДату = Дата(Параметры.Получить("дата")); КонецЕсли;
  Строки = РасхожденияУчетаПуТ(НаДату);
  Страница.Абзац("На " + Формат(НаДату, "ДФ=dd.MM.yyyy") + ". Строк для проверки: " + Строка(Строки.Количество()));
  Если Строки.Количество() = 0 Тогда Возврат; КонецЕсли;
  Таб = Страница.Таблица("Документы для сверки");
  Таб.Колонки("Проверка", "Документ", "Реквизиты", "Значение");
  Для Каждого Стр Из Строки Цикл
    Ряд = Таб.ДобавитьСтроку();
    Ряд.Установить("Проверка", Стр.Проверка);
    Ряд.Установить("Документ", Стр.Вид);
    Ряд.Ссылка("Документ", СсылкаНаОбъект(Стр.Вид, Стр.ИД));
    Ряд.Установить("Реквизиты", Стр.Описание);
    Ряд.Установить("Значение", Стр.Разница);
  КонецЦикла;
КонецПроцедуры

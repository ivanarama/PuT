// Создаёт документ «Реализация товаров» на основании выбранного счёта:
// копирует шапку и табличную часть, проставляет ссылку на счёт-основание.
// Новый документ не проводится автоматически — пользователь проверяет
// и проводит вручную.

Процедура Выполнить()
  Счёт = Параметры.Счёт;
  Если ЗначениеЗаполнено(Счёт) = Ложь Тогда
    Error("Укажите счёт-основание");
  КонецЕсли;

  Реализация = Документы.РеализацияТоваров.Создать();
  Реализация.Дата          = ТекущаяДата();
  Реализация.Покупатель    = Счёт.Покупатель;
  Реализация.Склад         = Счёт.Склад;
  Реализация.ТипЦенПродажи = Счёт.ТипЦенПродажи;
  Реализация.Основание     = Счёт;

  Для Каждого СтрокаС Из Счёт.Товары Цикл
    СтрокаР = Реализация.Товары.Добавить();
    СтрокаР.Номенклатура = СтрокаС.Номенклатура;
    СтрокаР.Количество   = СтрокаС.Количество;
    СтрокаР.Цена         = СтрокаС.Цена;
    СтрокаР.Сумма        = СтрокаС.Сумма;
  КонецЦикла;

  Реализация.Записать();

  Сообщить("Создана реализация № " + Строка(Реализация.Номер) + " на сумму " + Строка(Реализация.Сумма) + " руб.");
  Сообщить("Проверьте и проведите документ вручную.");
КонецПроцедуры

// Сумма НДС с произвольной ставкой (например, 10), выделенного из суммы с НДС.
Функция РассчитатьНДСПоСтавке(Сумма, Ставка) Экспорт
  Возврат Окр(Сумма * Ставка / (100 + Ставка), 2);
КонецФункции

// Нетто-сумма строки (без НДС) по способу учёта.
//   "Сверху"            → НДС начисляется сверх суммы, поэтому нетто = вся Сумма.
//   иначе («ВТомЧисле») → НДС сидит внутри суммы, нетто = Сумма − СуммаНДС.
// Единый источник правды для всех проведений — не дублировать формулу в документах.
Функция НеттоСуммы(Сумма, СуммаНДС, СпособУчетаНДС) Экспорт
  Если СпособУчетаНДС = "Сверху" Тогда
    Возврат Сумма;
  КонецЕсли;
  Возврат Сумма - СуммаНДС;
КонецФункции

// Контроль заполнения товарной табличной части перед проведением.
// Бросает исключение, если ТЧ пуста или встречается неположительное количество —
// иначе можно было бы провести «пустой» документ или строку с нулём/минусом.
//   СтрокиТовары      — табличная часть/массив с полями .Номенклатура и .Количество;
//   ИмяТаблицы        — для текста ошибки («Товары», «Расход», «Приход», «Цены»…);
//   ПроверятьКоличество — Ложь для ТЧ без поля Количество (например, «Цены»):
//                         тогда проверяется только непустота таблицы.
Процедура ПроверитьЗаполнениеТоваров(СтрокиТовары, ИмяТаблицы, ПроверятьКоличество = Истина) Экспорт
  Если СтрокиТовары.Количество() = 0 Тогда
    ВызватьИсключение("Табличная часть «" + ИмяТаблицы
      + "» не заполнена — проводить нечего.");
  КонецЕсли;
  Если ПроверятьКоличество = Ложь Тогда
    Возврат;
  КонецЕсли;
  Для Каждого Строка Из СтрокиТовары Цикл
    Если Строка.Количество <= 0 Тогда
      ВызватьИсключение("Недопустимое количество (" + Строка(Строка.Количество)
        + ") по «" + Строка(Строка.Номенклатура) + "» в «" + ИмяТаблицы
        + "» — должно быть больше нуля.");
    КонецЕсли;
  КонецЦикла;
КонецПроцедуры

// Контроль заполнения денежного документа (ПКО/РКО/банковский ордер).
//   Касса — касса или банковский счёт (поле зависит от документа).
Процедура ПроверитьЗаполнениеДенежногоДокумента(Сумма, Контрагент, Касса) Экспорт
  Если ЗначениеЗаполнено(Контрагент) = Ложь Тогда
    ВызватьИсключение("Не указан контрагент.");
  КонецЕсли;
  Если ЗначениеЗаполнено(Касса) = Ложь Тогда
    ВызватьИсключение("Не указана касса / банковский счёт.");
  КонецЕсли;
  Если Сумма <= 0 Тогда
    ВызватьИсключение("Сумма платежа должна быть больше нуля (указано "
      + Строка(Сумма) + ").");
  КонецЕсли;
КонецПроцедуры

// Грубая «Сумма прописью» для подвалов печатных форм — без склонения.
Функция СуммаПрописью(Сумма) Экспорт
  Целая = Цел(Сумма);
  Копейки = Окр((Сумма - Целая) * 100, 0);
  Возврат Строка(Целая) + " руб. " + Строка(Копейки) + " коп.";
КонецФункции

// true, если ссылка не заполнена.
Функция ПустаяСсылка(Знач) Экспорт
  Возврат ЗначениеЗаполнено(Знач) = Ложь;
КонецФункции

// Запись настроек текущего пользователя: ищем по логину (ИмяПользователя()),
// при отсутствии — общую запись с наименованием «Общие».
Функция НастройкиПоУмолчанию() Экспорт
  Лог = ИмяПользователя();
  Если Лог <> "" Тогда
    Запись = Справочники.НастройкиПользователя.НайтиПоНаименованию(Лог);
    Если ЗначениеЗаполнено(Запись) Тогда
      Возврат Запись;
    КонецЕсли;
  КонецЕсли;
  Возврат Справочники.НастройкиПользователя.НайтиПоНаименованию("Общие");
КонецФункции

// Склад по умолчанию (или Неопределено, если не задан).
Функция СкладПоУмолчанию() Экспорт
  Н = НастройкиПоУмолчанию();
  Если ЗначениеЗаполнено(Н) Тогда
    Возврат Н.Склад;
  КонецЕсли;
  Возврат Неопределено;
КонецФункции

// Организация по умолчанию: сначала из настроек, иначе из константы НашаОрганизация.
Функция ОрганизацияПоУмолчанию() Экспорт
  Н = НастройкиПоУмолчанию();
  Если ЗначениеЗаполнено(Н) И ЗначениеЗаполнено(Н.Организация) Тогда
    Возврат Н.Организация;
  КонецЕсли;
  Возврат Константы.НашаОрганизация;
КонецФункции

// Сумма НДС из строки с учётом способа учёта.
//   Способ = "ВТомЧисле" → НДС выделяется из суммы: Сумма * Ставка/(100+Ставка).
//   Способ = "Сверху"    → НДС начисляется сверху:  Сумма * Ставка/100.
Функция СуммаНДСстроки(Сумма, СтавкаНДС, Способ) Экспорт
  Если ЗначениеЗаполнено(СтавкаНДС) = Ложь Тогда
    Возврат 0;
  КонецЕсли;
  Процент = ЗначениеРеквизитаОбъекта(СтавкаНДС, "Процент");
  Если ЗначениеЗаполнено(Процент) = Ложь Или Процент = 0 Тогда
    Возврат 0;
  КонецЕсли;
  Если Способ = "Сверху" Тогда
    Возврат Окр(Сумма * Процент / 100, 2);
  КонецЕсли;
  Возврат Окр(Сумма * Процент / (100 + Процент), 2);
КонецФункции

// Цена номенклатуры по типу цен на дату.
//   ВидРасчета = Хранимый   → срез последних из регистра ЦеныНоменклатуры.
//   ВидРасчета = Расчетный  → ПолучитьЦену(БазовыйТип) * (1 + Процент/100).
//                             Отрицательный Процент = скидка.
Функция ПолучитьЦену(Номенклатура, ТипЦен, Дата) Экспорт
  Если ЗначениеЗаполнено(ТипЦен) = Ложь Тогда
    Возврат 0;
  КонецЕсли;

  Если ТипЦен.ВидРасчета = "Хранимый" Тогда
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Цена
                    ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата)
                    ГДЕ Номенклатура = &Ном И ТипЦен = &Тип";
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("Ном", Номенклатура);
    Запрос.УстановитьПараметр("Тип", ТипЦен);
    Результат = Запрос.Выполнить();
    Для Каждого Стр Из Результат Цикл
      Возврат Стр.Цена;
    КонецЦикла;
    Возврат 0;
  КонецЕсли;

  Если ЗначениеЗаполнено(ТипЦен.БазовыйТип) = Ложь Тогда
    Возврат 0;
  КонецЕсли;
  База = ПолучитьЦену(Номенклатура, ТипЦен.БазовыйТип, Дата);
  Если База = 0 Тогда
    Возврат 0;
  КонецЕсли;

  Знаков = ?(ТипЦен.Округление > 0, ТипЦен.Округление, 2);
  Возврат Окр(База * (1 + ТипЦен.Процент / 100), Знаков);
КонецФункции

// Контроль даты запрета редактирования. Бросает исключение, если дата
// документа меньше или равна константе ДатаЗапретаРедактирования.
// Пустая константа = запрет не действует. Вызывать в начале ПриЗаписи/проведения.
Процедура ПроверитьДатуЗапрета(ДатаДокумента) Экспорт
  Запрет = Константы.ДатаЗапретаРедактирования;
  Если ЗначениеЗаполнено(Запрет) Тогда
    Если ДатаДокумента <= Запрет Тогда
      ВызватьИсключение("Дата документа (" + Строка(ДатаДокумента)
        + ") попадает в закрытый период — редактирование запрещено до "
        + Строка(Запрет) + ".");
    КонецЕсли;
  КонецЕсли;
КонецПроцедуры

// Хелпер: чужие резервы по складу (Соответствие Номенклатура → КоличествоОстаток).
// СвойЗаказ — заказ текущего документа (его резерв не вычитается, фильтр WHERE <>).
// Не заполен / Неопределено = все резервы считаются чужими.
// СписокНом — Неопределено = без фильтра (все позиции по складу).
// Примечание: ЗаказПокупателя НЕ выбирается в SELECT, т.к. автоджойн платформы
// ищет наименование у документа, которого нет — поэтому фильтруем только через WHERE.
Функция ЧужиеРезервыПоСкладу(Склад, СвойЗаказ, МоментВремени, СписокНом)
  Запрос = Новый Запрос;
  Фильтр = "";
  Если СписокНом <> Неопределено Тогда
    Фильтр = " И Номенклатура В (&СписокНом)";
    Запрос.УстановитьПараметр("СписокНом", СписокНом);
  КонецЕсли;
  Если ЗначениеЗаполнено(СвойЗаказ) Тогда
    Фильтр = Фильтр + " И ЗаказПокупателя <> &СвойЗаказ";
    Запрос.УстановитьПараметр("СвойЗаказ", СвойЗаказ);
  КонецЕсли;
  Запрос.Текст = "ВЫБРАТЬ
                     Номенклатура,
                     КоличествоОстаток
                   ИЗ РегистрНакопления.РезервыТоваров.Остатки(&МоментВремени)
                   ГДЕ Склад = &Склад
                     И КоличествоОстаток > 0"
                   + Фильтр;
  Запрос.УстановитьПараметр("Склад", Склад);
  Запрос.УстановитьПараметр("МоментВремени", МоментВремени);

  Результат = Новый Соответствие;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Тек = Результат.Получить(Стр.Номенклатура);
    Если Тек = Неопределено Тогда
      Тек = 0;
    КонецЕсли;
    Результат.Вставить(Стр.Номенклатура, Тек + Стр.КоличествоОстаток);
  КонецЦикла;
  Возврат Результат;
КонецФункции

// Хелпер: физические остатки партий по складу (Соответствие Номенклатура → КоличествоОстаток).
// Тот же источник, что ФИФО — подбор и проведение согласованы.
// Организация — Неопределено/пустая = без фильтра (при подборе может быть не указана).
// СписокНом — Неопределено = без фильтра (все позиции по складу).
Функция ОстаткиПартийПоСкладу(Склад, Организация, МоментВремени, СписокНом)
  Запрос = Новый Запрос;
  Фильтр = "";
  Если СписокНом <> Неопределено Тогда
    Фильтр = " И Номенклатура В (&СписокНом)";
    Запрос.УстановитьПараметр("СписокНом", СписокНом);
  КонецЕсли;
  Если ЗначениеЗаполнено(Организация) Тогда
    Фильтр = Фильтр + " И Организация = &Организация";
    Запрос.УстановитьПараметр("Организация", Организация);
  КонецЕсли;
  Запрос.Текст = "ВЫБРАТЬ
                     Номенклатура,
                     КоличествоОстаток
                   ИЗ РегистрНакопления.ПартииТоваров.Остатки(&МоментВремени)
                   ГДЕ Склад = &Склад
                     И КоличествоОстаток > 0"
                   + Фильтр;
  Запрос.УстановитьПараметр("Склад", Склад);
  Запрос.УстановитьПараметр("МоментВремени", МоментВремени);

  Результат = Новый Соответствие;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Тек = Результат.Получить(Стр.Номенклатура);
    Если Тек = Неопределено Тогда
      Тек = 0;
    КонецЕсли;
    Результат.Вставить(Стр.Номенклатура, Тек + Стр.КоличествоОстаток);
  КонецЦикла;
  Возврат Результат;
КонецФункции

// Контроль свободного остатка при отгрузке: продать можно не больше, чем
// (физический остаток − резервы под ЧУЖИЕ заказы). Собственный заказ документа
// (СвойЗаказ) из резервов исключается — отгрузка имеет право забрать свой резерв.
// СвойЗаказ может быть пустым (продажа без заказа) — тогда все резервы чужие.
Процедура ПроверитьСвободныйОстаток(Склад, Организация, СтрокиТовары, СвойЗаказ, МоментВремени) Экспорт
  ПотребностьПоНом = Новый Соответствие;
  Для Каждого Строка Из СтрокиТовары Цикл
    Текущая = ПотребностьПоНом.Получить(Строка.Номенклатура);
    Если Текущая = Неопределено Тогда
      Текущая = 0;
    КонецЕсли;
    ПотребностьПоНом.Вставить(Строка.Номенклатура, Текущая + Строка.Количество);
  КонецЦикла;

  СписокНом = Новый Массив;
  Для Каждого Пара Из ПотребностьПоНом Цикл
    СписокНом.Добавить(Пара.Ключ);
  КонецЦикла;
  Если СписокНом.Количество() = 0 Тогда
    Возврат;
  КонецЕсли;

  ЧужиеРезервы = ЧужиеРезервыПоСкладу(Склад, СвойЗаказ, МоментВремени, СписокНом);
  ОстаткиПоНом = ОстаткиПартийПоСкладу(Склад, Организация, МоментВремени, СписокНом);

  Для Каждого Пара Из ПотребностьПоНом Цикл
    Ном  = Пара.Ключ;
    Надо = Пара.Значение;

    Остаток = ОстаткиПоНом.Получить(Ном);
    Если Остаток = Неопределено Тогда
      Остаток = 0;
    КонецЕсли;
    Чужой = ЧужиеРезервы.Получить(Ном);
    Если Чужой = Неопределено Тогда
      Чужой = 0;
    КонецЕсли;

    Свободно = Остаток - Чужой;
    Если Надо > Свободно Тогда
      ВызватьИсключение("Товар «" + Строка(Ном) + "» зарезервирован под другие заказы: "
        + "на складе «" + Строка(Склад) + "» свободно " + Строка(Свободно)
        + " (остаток " + Строка(Остаток) + ", чужой резерв " + Строка(Чужой)
        + "), требуется " + Строка(Надо) + ".");
    КонецЕсли;
  КонецЦикла;
КонецПроцедуры

// Возвращает Массив структур {Номенклатура, Свободно} со свободным остатком > 0
// на складе. СвойЗаказ — заказ текущего документа (его резерв не вычитается),
// Неопределено если заказа нет.
// Использует те же хелперы, что ПроверитьСвободныйОстаток — формулы согласованы.
Функция СвободныеОстаткиСклада(Склад, Организация, СвойЗаказ, МоментВремени) Экспорт
  ЧужиеРезервы = ЧужиеРезервыПоСкладу(Склад, СвойЗаказ, МоментВремени, Неопределено);
  ОстаткиПоНом = ОстаткиПартийПоСкладу(Склад, Организация, МоментВремени, Неопределено);

  Результат = Новый Массив;
  Для Каждого Пара Из ОстаткиПоНом Цикл
    Ном = Пара.Ключ;
    Остаток = Пара.Значение;
    Чужой = ЧужиеРезервы.Получить(Ном);
    Если Чужой = Неопределено Тогда
      Чужой = 0;
    КонецЕсли;
    Свободно = Остаток - Чужой;
    Если Свободно > 0 Тогда
      Результат.Добавить(Новый Структура("Номенклатура, Свободно", Ном, Свободно));
    КонецЕсли;
  КонецЦикла;
  Возврат Результат;
КонецФункции

// Непогашенный долг по документу-основанию оплаты — для контроля повторной оплаты.
// Считается по базовой таблице Взаиморасчётов: ДокументРеализации/ДокументПоступления
// хранятся как атрибуты, а не измерения, поэтому виртуальная таблица остатков здесь
// не подходит. Текущий документ-оплата исключается по Регистратору — иначе при
// перепроведении он вычел бы сам себя и заблокировал бы корректную правку.
//
//   ВидОснования = "Реализация"  → долг покупателя  = Приход − Расход;
//   ВидОснования = "Поступление" → наш долг поставщику = Расход − Приход.
// Возврат: непогашенная сумма (>0 — ещё должны, <=0 — закрыто/переплата).
Функция НепогашенныйДолгОснования(Основание, ВидОснования, ЭтотДокумент) Экспорт
  Если ВидОснования = "Реализация" Тогда
    ПолеДок = "ДокументРеализации";
    Знак    = 1;
  Иначе
    ПолеДок = "ДокументПоступления";
    Знак    = -1;
  КонецЕсли;

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ ВидДвижения, Сумма
                  ИЗ РегистрНакопления.Взаиморасчеты
                  ГДЕ " + ПолеДок + " = &Основание
                    И Регистратор <> &ЭтотДокумент";
  Запрос.УстановитьПараметр("Основание", Основание);
  Запрос.УстановитьПараметр("ЭтотДокумент", ЭтотДокумент);

  Сальдо = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Если Стр.ВидДвижения = "Приход" Тогда
      Сальдо = Сальдо + Стр.Сумма;
    Иначе
      Сальдо = Сальдо - Стр.Сумма;
    КонецЕсли;
  КонецЦикла;

  Возврат Знак * Сальдо;
КонецФункции

// Контроль повторной оплаты для кассовых/банковских документов.
// Если в документе указано основание (реализация/поступление), которое уже
// полностью закрыто, — бросает исключение, не давая увести сальдо в переплату.
Процедура ПроверитьНеПереплату(ДокументРеализации, ДокументПоступления, ЭтотДокумент) Экспорт
  Если ЗначениеЗаполнено(ДокументРеализации) Тогда
    Если НепогашенныйДолгОснования(ДокументРеализации, "Реализация", ЭтотДокумент) <= 0 Тогда
      ВызватьИсключение("Реализация «" + Строка(ДокументРеализации)
        + "» уже полностью оплачена — повторная оплата отклонена.");
    КонецЕсли;
  КонецЕсли;
  Если ЗначениеЗаполнено(ДокументПоступления) Тогда
    Если НепогашенныйДолгОснования(ДокументПоступления, "Поступление", ЭтотДокумент) <= 0 Тогда
      ВызватьИсключение("Поступление «" + Строка(ДокументПоступления)
        + "» уже полностью оплачено — повторная оплата отклонена.");
    КонецЕсли;
  КонецЕсли;
КонецПроцедуры

// Запись движений по партиям из результата ФИФО (СписатьТоварыФИФО) — единый цикл
// для всех расходных документов, чтобы формула движения не расходилась по копиям.
//   РегистрПартии  — Движения.ПартииТоваров;
//   ВидДвижения    — "Расход" (списание) или "Приход" (склад-получатель перемещения);
//   ДвиженияПартий — массив структур {ДокументПоступления, ДатаПоставки, Количество, Сумма};
//   Склад          — склад движения (у перемещения у прихода и расхода он разный).
Процедура ДобавитьДвиженияПартий(РегистрПартии, ВидДвижения, ДвиженияПартий, Номенклатура, Склад, Организация) Экспорт
  Для Каждого Дв Из ДвиженияПартий Цикл
    ДвП = РегистрПартии.Добавить();
    ДвП.ВидДвижения  = ВидДвижения;
    ДвП.Номенклатура = Номенклатура;
    ДвП.Склад        = Склад;
    ДвП.Организация  = Организация;
    ДвП.ДокументПоступления = Дв.ДокументПоступления;
    ДвП.ДатаПоставки = Дв.ДатаПоставки;
    ДвП.Количество   = Дв.Количество;
    ДвП.Сумма        = Дв.Сумма;
  КонецЦикла;
КонецПроцедуры

// Доля общей себестоимости на строку пропорционально количеству (округление до копеек).
// Используется при распределении себестоимости в сборке/разборке.
Функция ДоляСебестоимости(ИтогоеСебестоимость, Количество, КоличествоВсего) Экспорт
  Если КоличествоВсего <= 0 Тогда
    Возврат 0;
  КонецЕсли;
  Возврат Окр(ИтогоеСебестоимость * Количество / КоличествоВсего, 2);
КонецФункции

// Распределение общей себестоимости по строкам прихода пропорционально количеству.
// Возвращает массив долей в порядке строк. Последней строке отдаётся ОСТАТОК
// (Итого − сумма предыдущих), чтобы сумма долей точно равнялась Итого и копейки
// округления не «терялись» (33.33 × 3 ≠ 100.00).
Функция РаспределитьСебестоимостьПоСтрокам(СтрокиПриход, ИтогоеСебестоимость) Экспорт
  КоличествоВсего = 0;
  Для Каждого Строка Из СтрокиПриход Цикл
    КоличествоВсего = КоличествоВсего + Строка.Количество;
  КонецЦикла;

  ВсегоСтрок = СтрокиПриход.Количество();
  Доли       = Новый Массив;
  Накоплено  = 0;
  Индекс     = 0;
  Для Каждого Строка Из СтрокиПриход Цикл
    Индекс = Индекс + 1;
    Если Индекс = ВсегоСтрок Тогда
      Доля = ИтогоеСебестоимость - Накоплено;
    Иначе
      Доля = ДоляСебестоимости(ИтогоеСебестоимость, Строка.Количество, КоличествоВсего);
    КонецЕсли;
    Накоплено = Накоплено + Доля;
    Доли.Добавить(Доля);
  КонецЦикла;
  Возврат Доли;
КонецФункции

// ФИФО-списание партий со склада — единая реализация для всех документов
// (реализация, списание, перемещение, сборка, разборка, возврат от покупателя).
//
//   Склад, Организация — измерения, по которым нарезаны партии;
//   СтрокиТовары       — табличная часть/массив с полями .Номенклатура и .Количество;
//   МоментВремени      — для среза остатков (this.МоментВремени());
//   ОписаниеОперации   — подставляется в текст исключения («списания», «перемещения»…).
//
// Возвращает массив результатов в порядке строк СтрокиТовары; каждый элемент —
// Структура("Себестоимость, ДвиженияПартий"), где ДвиженияПартий — массив
// Структур("ДокументПоступления, ДатаПоставки, Количество, Сумма").
//
//   МягкийРежим = Ложь  (по умолчанию для отгрузок) — при нехватке остатков
//                       бросает исключение, откатывающее всё проведение.
//   МягкийРежим = Истина (возврат от покупателя) — нехватка партий допустима
//                       (товар мог быть продан до партионного учёта): функция
//                       спишет сколько есть, себестоимость по найденным партиям,
//                       а недостачу вызывающий код покрывает своим fallback.
Функция СписатьТоварыФИФО(Склад, Организация, СтрокиТовары, МоментВремени, ОписаниеОперации, МягкийРежим = Ложь) Экспорт
  ПотребностьПоНом = Новый Соответствие;
  Для Каждого Строка Из СтрокиТовары Цикл
    Текущая = ПотребностьПоНом.Получить(Строка.Номенклатура);
    Если Текущая = Неопределено Тогда
      Текущая = 0;
    КонецЕсли;
    ПотребностьПоНом.Вставить(Строка.Номенклатура, Текущая + Строка.Количество);
  КонецЦикла;

  СписокНом = Новый Массив;
  Для Каждого Пара Из ПотребностьПоНом Цикл
    СписокНом.Добавить(Пара.Ключ);
  КонецЦикла;

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ
                    Номенклатура,
                    ДокументПоступления,
                    ДатаПоставки,
                    КоличествоОстаток,
                    СуммаОстаток
                  ИЗ РегистрНакопления.ПартииТоваров.Остатки(&МоментВремени)
                  ГДЕ Номенклатура В (&СписокНом)
                    И Склад = &Склад
                    И Организация = &Организация
                    И КоличествоОстаток > 0
                  УПОРЯДОЧИТЬ ПО Номенклатура, ДатаПоставки";
  Запрос.УстановитьПараметр("СписокНом", СписокНом);
  Запрос.УстановитьПараметр("Склад", Склад);
  Запрос.УстановитьПараметр("Организация", Организация);
  Запрос.УстановитьПараметр("МоментВремени", МоментВремени);
  Результат = Запрос.Выполнить();

  ПартииПоНом = Новый Соответствие;
  Для Каждого Стр Из Результат Цикл
    Список = ПартииПоНом.Получить(Стр.Номенклатура);
    Если Список = Неопределено Тогда
      Список = Новый Массив;
      ПартииПоНом.Вставить(Стр.Номенклатура, Список);
    КонецЕсли;
    Список.Добавить(Новый Структура(
      "ДокументПоступления, ДатаПоставки, КоличествоОстаток, СуммаОстаток",
      Стр.ДокументПоступления, Стр.ДатаПоставки, Стр.КоличествоОстаток, Стр.СуммаОстаток));
  КонецЦикла;

  // Проверка достаточности по каждой номенклатуре — до записи любых движений.
  // В мягком режиме проверка пропускается: списываем сколько есть.
  Если МягкийРежим = Ложь Тогда
    Для Каждого Пара Из ПотребностьПоНом Цикл
      Ном = Пара.Ключ;
      Надо = Пара.Значение;
      Доступно = 0;
      Список = ПартииПоНом.Получить(Ном);
      Если Список <> Неопределено Тогда
        Для Каждого П Из Список Цикл
          Доступно = Доступно + П.КоличествоОстаток;
        КонецЦикла;
      КонецЕсли;
      Если Доступно < Надо Тогда
        ВызватьИсключение("Недостаточно остатков на складе «" + Строка(Склад)
          + "» для " + ОписаниеОперации + " «" + Строка(Ном) + "»: нужно "
          + Строка(Надо) + ", доступно " + Строка(Доступно) + ".");
      КонецЕсли;
    КонецЦикла;
  КонецЕсли;

  // Построчное ФИФО-списание из локального кэша (кэш уменьшается между строками)
  Результаты = Новый Массив;
  Для Каждого Строка Из СтрокиТовары Цикл
    ОстатокКСписанию    = Строка.Количество;
    СтрокаСебестоимость = 0;
    ДвиженияПартий      = Новый Массив;
    Список = ПартииПоНом.Получить(Строка.Номенклатура);

    Если Список <> Неопределено Тогда
      Для Каждого ТекПартия Из Список Цикл
        Если ОстатокКСписанию <= 0 Тогда
          Прервать;
        КонецЕсли;
        Если ТекПартия.КоличествоОстаток <= 0 Тогда
          Продолжить;
        КонецЕсли;

        КолВоИзПартии = Мин(ОстатокКСписанию, ТекПартия.КоличествоОстаток);

        // При полном изъятии партии забираем остаток суммы целиком — иначе
        // пересчёт через цену оставляет «висячие» копейки на нулевом остатке.
        Если КолВоИзПартии = ТекПартия.КоличествоОстаток Тогда
          СтоимостьПартии = ТекПартия.СуммаОстаток;
        Иначе
          ЦенаПартии      = ТекПартия.СуммаОстаток / ТекПартия.КоличествоОстаток;
          СтоимостьПартии = Окр(КолВоИзПартии * ЦенаПартии, 2);
        КонецЕсли;

        СтрокаСебестоимость = СтрокаСебестоимость + СтоимостьПартии;
        ОстатокКСписанию    = ОстатокКСписанию - КолВоИзПартии;

        ТекПартия.КоличествоОстаток = ТекПартия.КоличествоОстаток - КолВоИзПартии;
        ТекПартия.СуммаОстаток      = ТекПартия.СуммаОстаток - СтоимостьПартии;

        ДвиженияПартий.Добавить(Новый Структура(
          "ДокументПоступления, ДатаПоставки, Количество, Сумма",
          ТекПартия.ДокументПоступления, ТекПартия.ДатаПоставки, КолВоИзПартии, СтоимостьПартии));
      КонецЦикла;
    КонецЕсли;

    Результаты.Добавить(Новый Структура(
      "Себестоимость, ДвиженияПартий",
      СтрокаСебестоимость, ДвиженияПартий));
  КонецЦикла;

  Возврат Результаты;
КонецФункции

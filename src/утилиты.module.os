// Сумма НДС, выделенного из суммы с НДС по ставке 20%.
Функция РассчитатьНДС(Сумма) Экспорт
  Возврат Окр(Сумма * 20 / 120, 2);
КонецФункции

// Сумма НДС с произвольной ставкой (например, 10).
Функция РассчитатьНДСПоСтавке(Сумма, Ставка) Экспорт
  Возврат Окр(Сумма * Ставка / (100 + Ставка), 2);
КонецФункции

// Грубая «Сумма прописью» для подвалов печатных форм — без склонения.
Функция СуммаПрописью(Сумма) Экспорт
  Целая = Цел(Сумма);
  Копейки = Окр((Сумма - Целая) * 100, 0);
  Возврат Строка(Целая) + " руб. " + Строка(Копейки) + " коп.";
КонецФункции

// true, если ссылка не заполнена.
Функция ПустаяСсылка(Знач) Экспорт
  Возврат ЗначениеЗаполнено(Знач) = Ложь;
КонецФункции

// Запись настроек текущего пользователя: ищем по логину (ИмяПользователя()),
// при отсутствии — общую запись с наименованием «Общие».
Функция НастройкиПоУмолчанию() Экспорт
  Лог = ИмяПользователя();
  Если Лог <> "" Тогда
    Запись = Справочники.НастройкиПользователя.НайтиПоНаименованию(Лог);
    Если ЗначениеЗаполнено(Запись) Тогда
      Возврат Запись;
    КонецЕсли;
  КонецЕсли;
  Возврат Справочники.НастройкиПользователя.НайтиПоНаименованию("Общие");
КонецФункции

// Склад по умолчанию (или Неопределено, если не задан).
Функция СкладПоУмолчанию() Экспорт
  Н = НастройкиПоУмолчанию();
  Если ЗначениеЗаполнено(Н) Тогда
    Возврат Н.Склад;
  КонецЕсли;
  Возврат Неопределено;
КонецФункции

// Организация по умолчанию: сначала из настроек, иначе из константы НашаОрганизация.
Функция ОрганизацияПоУмолчанию() Экспорт
  Н = НастройкиПоУмолчанию();
  Если ЗначениеЗаполнено(Н) И ЗначениеЗаполнено(Н.Организация) Тогда
    Возврат Н.Организация;
  КонецЕсли;
  Возврат Константы.НашаОрганизация;
КонецФункции

// Сумма НДС из строки с учётом способа учёта.
//   Способ = "ВТомЧисле" → НДС выделяется из суммы: Сумма * Ставка/(100+Ставка).
//   Способ = "Сверху"    → НДС начисляется сверху:  Сумма * Ставка/100.
Функция СуммаНДСстроки(Сумма, СтавкаНДС, Способ) Экспорт
  Если ЗначениеЗаполнено(СтавкаНДС) = Ложь Тогда
    Возврат 0;
  КонецЕсли;
  Процент = ЗначениеРеквизитаОбъекта(СтавкаНДС, "Процент");
  Если ЗначениеЗаполнено(Процент) = Ложь Или Процент = 0 Тогда
    Возврат 0;
  КонецЕсли;
  Если Способ = "Сверху" Тогда
    Возврат Окр(Сумма * Процент / 100, 2);
  КонецЕсли;
  Возврат Окр(Сумма * Процент / (100 + Процент), 2);
КонецФункции

// Цена номенклатуры по типу цен на дату.
//   ВидРасчета = Хранимый   → срез последних из регистра ЦеныНоменклатуры.
//   ВидРасчета = Расчетный  → ПолучитьЦену(БазовыйТип) * (1 + Процент/100).
//                             Отрицательный Процент = скидка.
Функция ПолучитьЦену(Номенклатура, ТипЦен, Дата) Экспорт
  Если ЗначениеЗаполнено(ТипЦен) = Ложь Тогда
    Возврат 0;
  КонецЕсли;

  Если ТипЦен.ВидРасчета = "Хранимый" Тогда
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Цена
                    ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата)
                    ГДЕ Номенклатура = &Ном И ТипЦен = &Тип";
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("Ном", Номенклатура);
    Запрос.УстановитьПараметр("Тип", ТипЦен);
    Результат = Запрос.Выполнить();
    Для Каждого Стр Из Результат Цикл
      Возврат Стр.Цена;
    КонецЦикла;
    Возврат 0;
  КонецЕсли;

  Если ЗначениеЗаполнено(ТипЦен.БазовыйТип) = Ложь Тогда
    Возврат 0;
  КонецЕсли;
  База = ПолучитьЦену(Номенклатура, ТипЦен.БазовыйТип, Дата);
  Если База = 0 Тогда
    Возврат 0;
  КонецЕсли;

  Знаков = ?(ТипЦен.Округление > 0, ТипЦен.Округление, 2);
  Возврат Окр(База * (1 + ТипЦен.Процент / 100), Знаков);
КонецФункции

// Контроль даты запрета редактирования. Бросает исключение, если дата
// документа меньше или равна константе ДатаЗапретаРедактирования.
// Пустая константа = запрет не действует. Вызывать в начале ПриЗаписи/проведения.
Процедура ПроверитьДатуЗапрета(ДатаДокумента) Экспорт
  Запрет = Константы.ДатаЗапретаРедактирования;
  Если ЗначениеЗаполнено(Запрет) Тогда
    Если ДатаДокумента <= Запрет Тогда
      ВызватьИсключение("Дата документа (" + Строка(ДатаДокумента)
        + ") попадает в закрытый период — редактирование запрещено до "
        + Строка(Запрет) + ".");
    КонецЕсли;
  КонецЕсли;
КонецПроцедуры

// Контроль свободного остатка при отгрузке: продать можно не больше, чем
// (физический остаток − резервы под ЧУЖИЕ заказы). Собственный заказ документа
// (СвойЗаказ) из резервов исключается — отгрузка имеет право забрать свой резерв.
// СвойЗаказ может быть пустым (продажа без заказа) — тогда все резервы чужие.
Процедура ПроверитьСвободныйОстаток(Склад, Организация, СтрокиТовары, СвойЗаказ, МоментВремени) Экспорт
  ПотребностьПоНом = Новый Соответствие;
  Для Каждого Строка Из СтрокиТовары Цикл
    Текущая = ПотребностьПоНом.Получить(Строка.Номенклатура);
    Если Текущая = Неопределено Тогда
      Текущая = 0;
    КонецЕсли;
    ПотребностьПоНом.Вставить(Строка.Номенклатура, Текущая + Строка.Количество);
  КонецЦикла;

  СписокНом = Новый Массив;
  Для Каждого Пара Из ПотребностьПоНом Цикл
    СписокНом.Добавить(Пара.Ключ);
  КонецЦикла;
  Если СписокНом.Количество() = 0 Тогда
    Возврат;
  КонецЕсли;

  // Чужие резервы по складу, сгруппированные по номенклатуре
  СвойКлюч = Строка(СвойЗаказ);
  ЧужиеРезервы = Новый Соответствие;
  ЗапросР = Новый Запрос;
  ЗапросР.Текст = "ВЫБРАТЬ
                     Номенклатура,
                     ЗаказПокупателя,
                     КоличествоОстаток
                   ИЗ РегистрНакопления.РезервыТоваров.Остатки(&МоментВремени)
                   ГДЕ Номенклатура В (&СписокНом)
                     И Склад = &Склад
                     И КоличествоОстаток > 0";
  ЗапросР.УстановитьПараметр("СписокНом", СписокНом);
  ЗапросР.УстановитьПараметр("Склад", Строка(Склад));
  ЗапросР.УстановитьПараметр("МоментВремени", МоментВремени);
  Для Каждого Стр Из ЗапросР.Выполнить() Цикл
    Если Строка(Стр.ЗаказПокупателя) = СвойКлюч Тогда
      Продолжить;
    КонецЕсли;
    Текущее = ЧужиеРезервы.Получить(Стр.Номенклатура);
    Если Текущее = Неопределено Тогда
      Текущее = 0;
    КонецЕсли;
    ЧужиеРезервы.Вставить(Стр.Номенклатура, Текущее + Стр.КоличествоОстаток);
  КонецЦикла;

  // Физический остаток по складу — из тех же партий, что используются в ФИФО
  // (надёжно совпадает с источником списания себестоимости).
  ОстаткиПоНом = Новый Соответствие;
  ЗапросО = Новый Запрос;
  ЗапросО.Текст = "ВЫБРАТЬ
                     Номенклатура,
                     КоличествоОстаток
                   ИЗ РегистрНакопления.ПартииТоваров.Остатки(&МоментВремени)
                   ГДЕ Номенклатура В (&СписокНом)
                     И Склад = &Склад
                     И Организация = &Организация
                     И КоличествоОстаток > 0";
  ЗапросО.УстановитьПараметр("СписокНом", СписокНом);
  ЗапросО.УстановитьПараметр("Склад", Строка(Склад));
  ЗапросО.УстановитьПараметр("Организация", Организация);
  ЗапросО.УстановитьПараметр("МоментВремени", МоментВремени);
  Для Каждого Стр Из ЗапросО.Выполнить() Цикл
    Текущий = ОстаткиПоНом.Получить(Стр.Номенклатура);
    Если Текущий = Неопределено Тогда
      Текущий = 0;
    КонецЕсли;
    ОстаткиПоНом.Вставить(Стр.Номенклатура, Текущий + Стр.КоличествоОстаток);
  КонецЦикла;

  Для Каждого Пара Из ПотребностьПоНом Цикл
    Ном  = Пара.Ключ;
    Надо = Пара.Значение;

    Остаток = ОстаткиПоНом.Получить(Ном);
    Если Остаток = Неопределено Тогда
      Остаток = 0;
    КонецЕсли;
    Чужой = ЧужиеРезервы.Получить(Ном);
    Если Чужой = Неопределено Тогда
      Чужой = 0;
    КонецЕсли;

    Свободно = Остаток - Чужой;
    Если Надо > Свободно Тогда
      ВызватьИсключение("Товар «" + Строка(Ном) + "» зарезервирован под другие заказы: "
        + "на складе «" + Строка(Склад) + "» свободно " + Строка(Свободно)
        + " (остаток " + Строка(Остаток) + ", чужой резерв " + Строка(Чужой)
        + "), требуется " + Строка(Надо) + ".");
    КонецЕсли;
  КонецЦикла;
КонецПроцедуры

// ФИФО-списание партий со склада — единая реализация для всех документов
// (реализация, списание, перемещение, сборка, разборка, возврат от покупателя).
//
//   Склад, Организация — измерения, по которым нарезаны партии;
//   СтрокиТовары       — табличная часть/массив с полями .Номенклатура и .Количество;
//   МоментВремени      — для среза остатков (this.МоментВремени());
//   ОписаниеОперации   — подставляется в текст исключения («списания», «перемещения»…).
//
// Возвращает массив результатов в порядке строк СтрокиТовары; каждый элемент —
// Структура("Себестоимость, ДвиженияПартий"), где ДвиженияПартий — массив
// Структур("ДатаПоставки, Количество, Сумма"). При нехватке остатков (проверка
// до возврата) бросает исключение, откатывающее всё проведение.
Функция СписатьТоварыФИФО(Склад, Организация, СтрокиТовары, МоментВремени, ОписаниеОперации) Экспорт
  ПотребностьПоНом = Новый Соответствие;
  Для Каждого Строка Из СтрокиТовары Цикл
    Текущая = ПотребностьПоНом.Получить(Строка.Номенклатура);
    Если Текущая = Неопределено Тогда
      Текущая = 0;
    КонецЕсли;
    ПотребностьПоНом.Вставить(Строка.Номенклатура, Текущая + Строка.Количество);
  КонецЦикла;

  СписокНом = Новый Массив;
  Для Каждого Пара Из ПотребностьПоНом Цикл
    СписокНом.Добавить(Пара.Ключ);
  КонецЦикла;

  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ
                    Номенклатура,
                    ДатаПоставки,
                    КоличествоОстаток,
                    СуммаОстаток
                  ИЗ РегистрНакопления.ПартииТоваров.Остатки(&МоментВремени)
                  ГДЕ Номенклатура В (&СписокНом)
                    И Склад = &Склад
                    И Организация = &Организация
                    И КоличествоОстаток > 0
                  УПОРЯДОЧИТЬ ПО Номенклатура, ДатаПоставки";
  Запрос.УстановитьПараметр("СписокНом", СписокНом);
  Запрос.УстановитьПараметр("Склад", Строка(Склад));
  Запрос.УстановитьПараметр("Организация", Организация);
  Запрос.УстановитьПараметр("МоментВремени", МоментВремени);
  Результат = Запрос.Выполнить();

  ПартииПоНом = Новый Соответствие;
  Для Каждого Стр Из Результат Цикл
    Список = ПартииПоНом.Получить(Стр.Номенклатура);
    Если Список = Неопределено Тогда
      Список = Новый Массив;
      ПартииПоНом.Вставить(Стр.Номенклатура, Список);
    КонецЕсли;
    Список.Добавить(Новый Структура(
      "ДатаПоставки, КоличествоОстаток, СуммаОстаток",
      Стр.ДатаПоставки, Стр.КоличествоОстаток, Стр.СуммаОстаток));
  КонецЦикла;

  // Проверка достаточности по каждой номенклатуре — до записи любых движений
  Для Каждого Пара Из ПотребностьПоНом Цикл
    Ном = Пара.Ключ;
    Надо = Пара.Значение;
    Доступно = 0;
    Список = ПартииПоНом.Получить(Ном);
    Если Список <> Неопределено Тогда
      Для Каждого П Из Список Цикл
        Доступно = Доступно + П.КоличествоОстаток;
      КонецЦикла;
    КонецЕсли;
    Если Доступно < Надо Тогда
      ВызватьИсключение("Недостаточно остатков на складе «" + Строка(Склад)
        + "» для " + ОписаниеОперации + " «" + Строка(Ном) + "»: нужно "
        + Строка(Надо) + ", доступно " + Строка(Доступно) + ".");
    КонецЕсли;
  КонецЦикла;

  // Построчное ФИФО-списание из локального кэша (кэш уменьшается между строками)
  Результаты = Новый Массив;
  Для Каждого Строка Из СтрокиТовары Цикл
    ОстатокКСписанию    = Строка.Количество;
    СтрокаСебестоимость = 0;
    ДвиженияПартий      = Новый Массив;
    Список = ПартииПоНом.Получить(Строка.Номенклатура);

    Если Список <> Неопределено Тогда
      Для Каждого ТекПартия Из Список Цикл
        Если ОстатокКСписанию <= 0 Тогда
          Прервать;
        КонецЕсли;
        Если ТекПартия.КоличествоОстаток <= 0 Тогда
          Продолжить;
        КонецЕсли;

        КолВоИзПартии = Мин(ОстатокКСписанию, ТекПартия.КоличествоОстаток);

        // При полном изъятии партии забираем остаток суммы целиком — иначе
        // пересчёт через цену оставляет «висячие» копейки на нулевом остатке.
        Если КолВоИзПартии = ТекПартия.КоличествоОстаток Тогда
          СтоимостьПартии = ТекПартия.СуммаОстаток;
        Иначе
          ЦенаПартии      = ТекПартия.СуммаОстаток / ТекПартия.КоличествоОстаток;
          СтоимостьПартии = Окр(КолВоИзПартии * ЦенаПартии, 2);
        КонецЕсли;

        СтрокаСебестоимость = СтрокаСебестоимость + СтоимостьПартии;
        ОстатокКСписанию    = ОстатокКСписанию - КолВоИзПартии;

        ТекПартия.КоличествоОстаток = ТекПартия.КоличествоОстаток - КолВоИзПартии;
        ТекПартия.СуммаОстаток      = ТекПартия.СуммаОстаток - СтоимостьПартии;

        ДвиженияПартий.Добавить(Новый Структура(
          "ДатаПоставки, Количество, Сумма",
          ТекПартия.ДатаПоставки, КолВоИзПартии, СтоимостьПартии));
      КонецЦикла;
    КонецЕсли;

    Результаты.Добавить(Новый Структура(
      "Себестоимость, ДвиженияПартий",
      СтрокаСебестоимость, ДвиженияПартий));
  КонецЦикла;

  Возврат Результаты;
КонецФункции

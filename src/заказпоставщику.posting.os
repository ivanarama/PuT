// Проведение заказа поставщику — регистрирует ожидаемые товары в пути.

Процедура ОбработкаПроведения()
  ПроверитьДатуЗапрета(this.Дата);

  ПроверитьРеквизитШапки(this.Поставщик, "Поставщик");
  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.ТоварыВПути.Очистить();

  ПроверитьЗаполнениеСтрокТоваров(this.Товары, "Товары", Ложь);

  Для Каждого Строка Из this.Товары Цикл
    Если ЗначениеЗаполнено(Строка.СуммаНДС) = Ложь Тогда
      Строка.СуммаНДС = 0;
    КонецЕсли;
    НеттоСтроки = НеттоСуммы(Строка.Сумма, Строка.СуммаНДС, this.СпособУчетаНДС);

    ДвТП = Движения.ТоварыВПути.Добавить();
    ДвТП.ВидДвижения     = "Приход";
    ДвТП.Номенклатура    = Строка.Номенклатура;
    ДвТП.Склад           = this.Склад;
    ДвТП.ЗаказПоставщику = this;
    ДвТП.ЗаказПокупателя = Строка.ЗаказПокупателя;
    ДвТП.Количество      = Строка.Количество;
    ДвТП.Сумма           = НеттоСтроки;
  КонецЦикла;
КонецПроцедуры

// Проведение заказа поставщику — регистрирует ожидаемые товары в пути.

Процедура ОбработкаПроведения()
  Если this.Состояние = "Завершён" ИЛИ this.Состояние = "Отменён" Тогда
    ВызватьИсключение("Завершённый или отменённый заказ нельзя проводить заново");
  КонецЕсли;

  ПроверитьЗакрытыйПериод(this);

  ПроверитьРеквизитШапки(this.Поставщик, "Поставщик");
  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.ТоварыВПути.Очистить();

  ПроверитьЗаполнениеСтрокТоваров(this.Товары, "Товары", Ложь);

  ЗаблокироватьПартии(this.Товары);

  // Контроль непревышения потребности по привязанным заказам покупателей (модель УТ 10.3)
  ПотребностьЗаказов = Новый Соответствие;
  Для Каждого Строка Из this.Товары Цикл
    Если НЕ ЗначениеЗаполнено(Строка.ЗаказПокупателя) Тогда Продолжить; КонецЕсли;
    ИДЗаказа = УИДСсылки(Строка.ЗаказПокупателя);
    Потребность = ПотребностьЗаказов.Получить(ИДЗаказа);
    Если Потребность = Неопределено Тогда
      Если УИДСсылки(ЗначениеРеквизитаОбъекта(Строка.ЗаказПокупателя, "Организация")) <> УИДСсылки(this.Организация) Тогда
        ВызватьИсключение("Заказ покупателя принадлежит другой организации.");
      КонецЕсли;
      Потребность = НеобеспеченнаяПотребностьЗаказа(Строка.ЗаказПокупателя, this.МоментВремени(), this.Ссылка);
      ПотребностьЗаказов.Вставить(ИДЗаказа, Потребность);
    КонецЕсли;
    СкладСтроки = ?(ЗначениеЗаполнено(Строка.Склад), Строка.Склад, this.Склад);
    Остаток = Потребность.Получить(КлючСтрокиЗаказа(СкладСтроки, Строка.Номенклатура));
    Если Остаток = Неопределено ИЛИ Строка.Количество > Остаток.Количество Тогда
      ВызватьИсключение("Превышен объём потребности по заказу покупателя «" + Строка(Строка.ЗаказПокупателя)
        + "» для «" + Строка(Строка.Номенклатура) + "» на складе «" + Строка(СкладСтроки) + "».");
    КонецЕсли;
    Остаток.Количество = Остаток.Количество - Строка.Количество;
  КонецЦикла;

  НомерСтроки = 0;
  Для Каждого Строка Из this.Товары Цикл
    НомерСтроки = НомерСтроки + 1;
    Если ЗначениеЗаполнено(Строка.СуммаНДС) = Ложь Тогда
      Строка.СуммаНДС = 0;
    КонецЕсли;
    НеттоСтроки = НеттоСуммы(Строка.Сумма, Строка.СуммаНДС, this.СпособУчетаНДС);

    ДвТП = Движения.ТоварыВПути.Добавить();
    ДвТП.ВидДвижения     = "Приход";
    ДвТП.Номенклатура    = Строка.Номенклатура;
    ДвТП.Склад           = ?(ЗначениеЗаполнено(Строка.Склад), Строка.Склад, this.Склад);
    ДвТП.ЗаказПоставщику = this;
    ДвТП.ЗаказПокупателя = Строка.ЗаказПокупателя;
    ДвТП.СтрокаЗаказа    = НомерСтроки;
    Если ЗначениеЗаполнено(Строка.ПодтвержденнаяДатаПоставки) Тогда
      ДвТП.ПодтвержденнаяДатаПоставки = КонецДня(Строка.ПодтвержденнаяДатаПоставки);
    КонецЕсли;
    ДвТП.Количество      = Строка.Количество;
    ДвТП.Сумма           = НеттоСтроки;
  КонецЦикла;
КонецПроцедуры

// Закрытый период: отмена проведения и удаление меняют движения документа так
// же, как проведение.
Процедура ОбработкаУдаленияПроведения()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

Процедура ПередУдалением()
  ПроверитьЗакрытыйПериод(this);
КонецПроцедуры

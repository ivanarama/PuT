// Проведение заказа поставщику — регистрирует ожидаемые товары в пути.

Процедура ОбработкаПроведения()
  ПроверитьДатуЗапрета(this.Дата);

  ПроверитьРеквизитШапки(this.Поставщик, "Поставщик");
  ПроверитьРеквизитШапки(this.Склад, "Склад");

  Движения.ТоварыВПути.Очистить();

  ПроверитьЗаполнениеСтрокТоваров(this.Товары, "Товары", Ложь);

  // Контроль непревышения потребности по привязанным заказам покупателей (модель УТ 10.3)
  ЗаказыПокупателей = Новый Массив;
  Для Каждого Строка Из this.Товары Цикл
    Если ЗначениеЗаполнено(Строка.ЗаказПокупателя) Тогда
      Если ЗаказыПокупателей.Найти(Строка.ЗаказПокупателя) = Неопределено Тогда
        ЗаказыПокупателей.Добавить(Строка.ЗаказПокупателя);
      КонецЕсли;
    КонецЕсли;
  КонецЦикла;

  Если ЗаказыПокупателей.Количество() > 0 Тогда
    Момент = this.Дата;
    Для Каждого ЗаказСсылка Из ЗаказыПокупателей Цикл
      // Потребность по заказу покупателя
      ЗапросРезервы = Новый Запрос;
      ЗапросРезервы.Текст = "ВЫБРАТЬ
                                Номенклатура,
                                КоличествоОстаток
                              ИЗ РегистрНакопления.РезервыТоваров.Остатки(&Момент)
                              ГДЕ ЗаказПокупателя = &Заказ";
      ЗапросРезервы.УстановитьПараметр("Момент", Момент);
      ЗапросРезервы.УстановитьПараметр("Заказ", ЗаказСсылка);
      РезРезервы = ЗапросРезервы.Выполнить();

      РезервыMap = Новый Соответствие;
      Для Каждого СтрРез Из РезРезервы Цикл
        РезервыMap.Вставить(СтрРез.Номенклатура, СтрРез.КоличествоОстаток);
      КонецЦикла;

      // Уже заказано в других заказах поставщикам (исключая текущий документ)
      ЗапросВПути = Новый Запрос;
      ЗапросВПути.Текст = "ВЫБРАТЬ
                              Номенклатура,
                              КоличествоОстаток
                            ИЗ РегистрНакопления.ТоварыВПути.Остатки(&Момент)
                            ГДЕ ЗаказПокупателя = &Заказ
                              И ЗаказПоставщику <> &ЭтотЗаказ";
      ЗапросВПути.УстановитьПараметр("Момент", Момент);
      ЗапросВПути.УстановитьПараметр("Заказ", ЗаказСсылка);
      ЗапросВПути.УстановитьПараметр("ЭтотЗаказ", this.Ссылка);
      РезВПути = ЗапросВПути.Выполнить();

      ВПутиMap = Новый Соответствие;
      Для Каждого СтрВП Из РезВПути Цикл
        ВПутиMap.Вставить(СтрВП.Номенклатура, СтрВП.КоличествоОстаток);
      КонецЦикла;

      // Считаем проводимое количество по каждой номенклатуре в этом документе под данный заказ
      ПроводитсяMap = Новый Соответствие;
      Для Каждого Строка Из this.Товары Цикл
        Если Строка.ЗаказПокупателя = ЗаказСсылка Тогда
          Тек = ПроводитсяMap.Получить(Строка.Номенклатура);
          Если Тек = Неопределено Тогда
            Тек = 0;
          КонецЕсли;
          ПроводитсяMap.Вставить(Строка.Номенклатура, Тек + Строка.Количество);
        КонецЕсли;
      КонецЦикла;

      Для Каждого КлючИЗначение Из ПроводитсяMap Цикл
        Ном = КлючИЗначение.Ключ;
        Кол = КлючИЗначение.Значение;

        Резерв = РезервыMap.Получить(Ном);
        Если Резерв = Неопределено Тогда
          Резерв = 0;
        КонецЕсли;

        УжеВПути = ВПутиMap.Получить(Ном);
        Если УжеВПути = Неопределено Тогда
          УжеВПути = 0;
        КонецЕсли;

        Доступно = Резерв - УжеВПути;
        Если Доступно < 0 Тогда
          Доступно = 0;
        КонецЕсли;

        Если Кол > Доступно Тогда
          НомерЗаказа = ЗначениеРеквизитаОбъекта(ЗаказСсылка, "Номер");
          ИмяНом = ЗначениеРеквизитаОбъекта(Ном, "Наименование");
          ВызватьИсключение("Превышен объём потребности по заказу покупателя № "
            + Строка(НомерЗаказа) + "! По номенклатуре «" + Строка(ИмяНом)
            + "» открытая потребность: " + Строка(Доступно)
            + " шт. (в заказе: " + Строка(Резерв) + ", уже в пути: " + Строка(УжеВПути) + ")"
            + ", а проводится: " + Строка(Кол) + " шт. Проведение отменено.");
        КонецЕсли;
      КонецЦикла;
    КонецЦикла;
  КонецЕсли;

  Для Каждого Строка Из this.Товары Цикл
    Если ЗначениеЗаполнено(Строка.СуммаНДС) = Ложь Тогда
      Строка.СуммаНДС = 0;
    КонецЕсли;
    НеттоСтроки = НеттоСуммы(Строка.Сумма, Строка.СуммаНДС, this.СпособУчетаНДС);

    ДвТП = Движения.ТоварыВПути.Добавить();
    ДвТП.ВидДвижения     = "Приход";
    ДвТП.Номенклатура    = Строка.Номенклатура;
    ДвТП.Склад           = this.Склад;
    ДвТП.ЗаказПоставщику = this;
    ДвТП.ЗаказПокупателя = Строка.ЗаказПокупателя;
    ДвТП.Количество      = Строка.Количество;
    ДвТП.Сумма           = НеттоСтроки;
  КонецЦикла;
КонецПроцедуры

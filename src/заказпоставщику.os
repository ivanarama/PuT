Процедура ОбработкаЗаполнения(ДанныеЗаполнения)
  Если ЗначениеЗаполнено(ДанныеЗаполнения) = Ложь Тогда
    Возврат;
  КонецЕсли;

  // Ввод на основании Заказа покупателя
  this.Организация = ДанныеЗаполнения.Организация;
  this.Склад = ДанныеЗаполнения.Склад;
  this.СпособУчетаНДС = ДанныеЗаполнения.СпособУчетаНДС;
  this.Комментарий = "Создан на основании заказа покупателя № " + Строка(ДанныеЗаполнения.Номер);
  ТипЗакуп = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");
  Момент = ?(ЗначениеЗаполнено(this.Дата), this.Дата, ТекущаяДатаВремя());

  Для Каждого СтрИсточника Из ДанныеЗаполнения.Товары Цикл
    СтрПриёмника = this.Товары.Добавить();
    СтрПриёмника.Номенклатура = СтрИсточника.Номенклатура;
    СтрПриёмника.Количество = СтрИсточника.Количество;
    СтрПриёмника.ЗаказПокупателя = ДанныеЗаполнения.Ссылка;
    СтрПриёмника.СтавкаНДС = СтрИсточника.СтавкаНДС;

    Цена = 0;
    Если ЗначениеЗаполнено(ТипЗакуп) Тогда
      Цена = ПолучитьЦену(СтрИсточника.Номенклатура, ТипЗакуп, Момент);
    КонецЕсли;
    СтрПриёмника.Цена = Цена;
    СтрПриёмника.Сумма = СтрПриёмника.Количество * СтрПриёмника.Цена;
    СтрПриёмника.СуммаНДС = СуммаНДСстроки(СтрПриёмника.Сумма, СтрПриёмника.СтавкаНДС, this.СпособУчетаНДС);
  КонецЦикла;

  ПересчитатьИтоги();
КонецПроцедуры

// Пересчёт сумм строк и итогов шапки
Процедура ПересчитатьИтоги()
  Способ = this.СпособУчетаНДС;
  Если ЗначениеЗаполнено(Способ) = Ложь Тогда
    Способ = "ВТомЧисле";
    this.СпособУчетаНДС = Способ;
  КонецЕсли;

  ИтогБезНДС = 0;
  ИтогНДС = 0;
  Для Каждого Строка Из this.Товары Цикл
    Строка.Сумма    = Строка.Количество * Строка.Цена;
    Строка.СуммаНДС = СуммаНДСстроки(Строка.Сумма, Строка.СтавкаНДС, Способ);

    Если Способ = "Сверху" Тогда
      ИтогБезНДС = ИтогБезНДС + Строка.Сумма;
    Иначе
      ИтогБезНДС = ИтогБезНДС + (Строка.Сумма - Строка.СуммаНДС);
    КонецЕсли;
    ИтогНДС = ИтогНДС + Строка.СуммаНДС;
  КонецЦикла;

  this.СуммаНДС    = ИтогНДС;
  this.СуммаБезНДС = ИтогБезНДС;
  this.Сумма       = ИтогБезНДС + ИтогНДС;
КонецПроцедуры

Процедура ПриЗаписи()
  Если ЗначениеЗаполнено(this.Организация) = Ложь Тогда
    this.Организация = ОрганизацияПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Поставщик) = Ложь Тогда
    Error("Укажите поставщика");
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    this.Склад = СкладПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    Error("Укажите склад");
  КонецЕсли;
  Если this.Товары.Количество() = 0 Тогда
    Error("Добавьте хотя бы одну строку в табличную часть Товары");
  КонецЕсли;

  Способ = this.СпособУчетаНДС;
  Если ЗначениеЗаполнено(Способ) = Ложь Тогда
    Способ = "ВТомЧисле";
    this.СпособУчетаНДС = Способ;
  КонецЕсли;

  ИтогБезНДС = 0;
  ИтогНДС = 0;
  Для Каждого Строка Из this.Товары Цикл
    Если ЗначениеЗаполнено(Строка.Номенклатура) = Ложь
       ИЛИ ТипЗнч(Строка.Номенклатура) = "Строка"
       ИЛИ ПустаяСсылка(Строка.Номенклатура) Тогда
      Error("В табличной части есть строка без номенклатуры (или передана строка вместо ссылки)");
    КонецЕсли;
    Если Строка.Количество <= 0 Тогда
      Error("Количество должно быть больше нуля: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;
    Если Строка.Цена < 0 Тогда
      Error("Цена не может быть отрицательной: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;

    Если ЗначениеЗаполнено(Строка.СтавкаНДС) = Ложь Тогда
      Строка.СтавкаНДС = ЗначениеРеквизитаОбъекта(Строка.Номенклатура, "СтавкаНДС");
    КонецЕсли;

    Строка.Сумма    = Строка.Количество * Строка.Цена;
    Строка.СуммаНДС = СуммаНДСстроки(Строка.Сумма, Строка.СтавкаНДС, Способ);

    Если Способ = "Сверху" Тогда
      ИтогБезНДС = ИтогБезНДС + Строка.Сумма;
    Иначе
      ИтогБезНДС = ИтогБезНДС + (Строка.Сумма - Строка.СуммаНДС);
    КонецЕсли;
    ИтогНДС = ИтогНДС + Строка.СуммаНДС;
  КонецЦикла;

  this.СуммаНДС    = ИтогНДС;
  this.СуммаБезНДС = ИтогБезНДС;
  this.Сумма       = ИтогБезНДС + ИтогНДС;
КонецПроцедуры

Процедура ПриДобавленииСтрокиТовары(Строка)
  Если ЗначениеЗаполнено(Строка.СтавкаНДС) = Ложь
     И ЗначениеЗаполнено(Строка.Номенклатура) Тогда
    Строка.СтавкаНДС = ЗначениеРеквизитаОбъекта(Строка.Номенклатура, "СтавкаНДС");
  КонецЕсли;
КонецПроцедуры

Процедура Выполнить() Экспорт
    НачалоДня = НачалоДня(ТекущаяДата());

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
    |  Номер,
    |  Дата,
    |  Сумма
    |ИЗ Документ.РеализацияТоваров
    |ГДЕ Дата >= &НачалоДня
    |УПОРЯДОЧИТЬ ПО Дата";
    Запрос.УстановитьПараметр("НачалоДня", НачалоДня);
    Реализации = Запрос.Выполнить();

    Если Реализации.Количество() = 0 Тогда
        ОтправитьПисьмо(
            Параметры.Кому,
            "Продажи за " + Строка(НачалоДня),
            "Сегодня продаж не было."
        );
        Возврат;
    КонецЕсли;

    Текст = "Продажи за " + Строка(НачалоДня) + ":" + Символы.ПС;
    Итог = 0;
    Для Каждого Р Из Реализации Цикл
        Текст = Текст + "  №" + Строка(Р.Номер) + "  " + Строка(Р.Сумма) + " руб." + Символы.ПС;
        Итог = Итог + Р.Сумма;
    КонецЦикла;
    Текст = Текст + Символы.ПС + "Итого: " + Строка(Итог) + " руб.";

    ОтправитьПисьмо(
        Параметры.Кому,
        "Продажи за " + Строка(НачалоДня) + " — " + Строка(Реализации.Количество()) + " документов",
        Текст
    );

    Сообщить("Email отправлен: " + Строка(Реализации.Количество()) + " реализаций, итого " + Строка(Итог) + " руб.");
КонецПроцедуры

// Модуль документа «Разборка товаров»

// Заполнение комплектующих и разбираемой продукции по выбранной спецификации
Процедура ЗаполнитьПоСпецификации()
  Если ЗначениеЗаполнено(this.Спецификация) = Ложь Тогда
    Возврат;
  КонецЕсли;

  НомПродукции = ЗначениеРеквизитаОбъекта(this.Спецификация, "Номенклатура");
  КолПродукции = ЗначениеРеквизитаОбъекта(this.Спецификация, "Количество");
  Если КолПродукции = Неопределено ИЛИ КолПродукции <= 0 Тогда
    КолПродукции = 1;
  КонецЕсли;

  // Если ТЧ Расход пустая, добавим разбираемую продукцию
  Если this.Расход.Количество() = 0 И ЗначениеЗаполнено(НомПродукции) Тогда
    СтрР = this.Расход.Добавить();
    СтрР.Номенклатура = НомПродукции;
    СтрР.Количество = КолПродукции;
  КонецЕсли;

  СпецОбъект = this.Спецификация;
  Если ЗначениеЗаполнено(СпецОбъект.Состав) Тогда
    this.Приход.Очистить();
    Для Каждого СтрСостава Из СпецОбъект.Состав Цикл
      СтрП = this.Приход.Добавить();
      СтрП.Номенклатура = СтрСостава.Номенклатура;
      СтрП.Количество = СтрСостава.Количество;
    КонецЦикла;
  КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи()
  Если ЗначениеЗаполнено(this.Организация) = Ложь Тогда
    this.Организация = ОрганизацияПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    this.Склад = СкладПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    Error("Укажите склад");
  КонецЕсли;

  // Если указана спецификация, а комплектующие ещё не заполнены
  Если ЗначениеЗаполнено(this.Спецификация) И this.Приход.Количество() = 0 Тогда
    ЗаполнитьПоСпецификации();
  КонецЕсли;

  Если this.Расход.Количество() = 0 Тогда
    Error("Добавьте продукцию в табличную часть Расход");
  КонецЕсли;
  Если this.Приход.Количество() = 0 Тогда
    Error("Добавьте комплектующие в табличную часть Приход");
  КонецЕсли;

  Для Каждого Строка Из this.Расход Цикл
    Если ЗначениеЗаполнено(Строка.Номенклатура) = Ложь
       ИЛИ ТипЗнч(Строка.Номенклатура) = "Строка"
       ИЛИ ПустаяСсылка(Строка.Номенклатура) Тогда
      Error("В табличной части Расход есть строка без номенклатуры (или передана строка вместо ссылки)");
    КонецЕсли;
    Если Строка.Количество <= 0 Тогда
      Error("Количество должно быть больше нуля: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;
  КонецЦикла;

  Для Каждого Строка Из this.Приход Цикл
    Если ЗначениеЗаполнено(Строка.Номенклатура) = Ложь
       ИЛИ ТипЗнч(Строка.Номенклатура) = "Строка"
       ИЛИ ПустаяСсылка(Строка.Номенклатура) Тогда
      Error("В табличной части Приход есть строка без номенклатуры (или передана строка вместо ссылки)");
    КонецЕсли;
    Если Строка.Количество <= 0 Тогда
      Error("Количество должно быть больше нуля: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;
  КонецЦикла;
КонецПроцедуры

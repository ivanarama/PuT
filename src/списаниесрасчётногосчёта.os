Процедура ПриЗаписи()
  Если ЗначениеЗаполнено(this.Организация) = Ложь Тогда
    this.Организация = ОрганизацияПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.БанковскийСчёт) = Ложь Тогда
    Error("Укажите банковский счёт");
  КонецЕсли;
  Если this.БанковскийСчёт.Вид <> "БанковскийСчёт" Тогда
    Error("Выбранная касса не является банковским счётом. Используйте РКО для наличных операций");
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Контрагент) = Ложь Тогда
    Error("Укажите контрагента");
  КонецЕсли;
  Если this.Сумма <= 0 Тогда
    Error("Сумма должна быть больше нуля");
  КонецЕсли;
  Если ЗначениеЗаполнено(this.ДокументРеализации) И ЗначениеЗаполнено(this.ДокументПоступления) Тогда
    Error("Укажите только один документ-основание — реализацию или поступление");
  КонецЕсли;
КонецПроцедуры

// Продажа списывает партию поступления, а не только остаток склада, и не
// продаёт больше, чем поступило. Товар другой организации того же склада
// продать нельзя: иначе его продают дважды — сначала чужая организация, потом
// своя. Запуск:
//   onebase test --project . --sqlite <база> --run ПартийФИФО

Функция НоваяОрганизация(Имя)
  Объект = Справочники.Организация.Создать();
  Объект.Наименование = Имя;
  Возврат Объект.Записать();
КонецФункции

Функция НовыйКонтрагент(Имя, Вид)
  Объект = Справочники.Контрагент.Создать();
  Объект.Наименование = Имя;
  Объект.Вид = Вид;
  Возврат Объект.Записать();
КонецФункции

Функция НовыйСклад(Имя)
  Объект = Справочники.Склад.Создать();
  Объект.Наименование = Имя;
  Возврат Объект.Записать();
КонецФункции

Функция НоваяНоменклатура(Имя)
  Объект = Справочники.Номенклатура.Создать();
  Объект.Наименование = Имя;
  Возврат Объект.Записать();
КонецФункции

Процедура Поступление(Организация, Склад, Поставщик, Номенклатура, Количество, Цена, ДатаДокумента)
  Документ = Документы.ПоступлениеТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Поставщик = Поставщик;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = Количество;
  СтрокаТЧ.Цена = Цена;
  Документ.Провести();
КонецПроцедуры

// Пустая строка — продажа проведена, иначе текст отказа.
Функция Продать(Организация, Склад, Покупатель, Номенклатура, Количество, ДатаДокумента)
  Документ = Документы.РеализацияТоваров.Создать();
  Документ.Дата = ДатаДокумента;
  Документ.Организация = Организация;
  Документ.Покупатель = Покупатель;
  Документ.Склад = Склад;
  СтрокаТЧ = Документ.Товары.Добавить();
  СтрокаТЧ.Номенклатура = Номенклатура;
  СтрокаТЧ.Количество = Количество;
  СтрокаТЧ.Цена = 150;
  Попытка
    Документ.Провести();
    Возврат "";
  Исключение
    Возврат ОписаниеОшибки();
  КонецПопытки;
КонецФункции

Функция ОстатокПартий(Номенклатура, Организация)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ КоличествоОстаток
                  ИЗ РегистрНакопления.ПартииТоваров.Остатки()
                  ГДЕ Номенклатура = &Ном И Организация = &Орг";
  Запрос.УстановитьПараметр("Ном", Номенклатура);
  Запрос.УстановитьПараметр("Орг", Организация);
  Итог = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Итог = Итог + Стр.КоличествоОстаток;
  КонецЦикла;
  Возврат Итог;
КонецФункции

Процедура Выполнить()
  ОрганизацияА = НоваяОрганизация("Тест партий: организация А");
  ОрганизацияБ = НоваяОрганизация("Тест партий: организация Б");
  Склад = НовыйСклад("Тест партий: склад");
  Поставщик = НовыйКонтрагент("Тест партий: поставщик", "Поставщик");
  Покупатель = НовыйКонтрагент("Тест партий: покупатель", "Покупатель");

  // 1. Партия списывается, повторная продажа отклоняется.
  Табурет = НоваяНоменклатура("Тест партий: табурет");
  Поступление(ОрганизацияА, Склад, Поставщик, Табурет, 10, 100, Дата(2026, 9, 1, 10, 0, 0));
  Утверждать.Равно(Продать(ОрганизацияА, Склад, Покупатель, Табурет, 10, Дата(2026, 9, 1, 11, 0, 0)), "",
    "продажа всего поступления проходит");
  Утверждать.Равно(ОстатокПартий(Табурет, ОрганизацияА), 0,
    "партия поступления списана продажей до нуля");
  Отказ = Продать(ОрганизацияА, Склад, Покупатель, Табурет, 10, Дата(2026, 9, 1, 12, 0, 0));
  Утверждать.Истина(СтрНайти(Отказ, "недостаточно") > 0,
    "повторная продажа уже проданного товара отклонена (получено: «" + Отказ + "»)");

  // 2. Товар организации Б на том же складе организация А не продаёт.
  Стул = НоваяНоменклатура("Тест партий: стул");
  Поступление(ОрганизацияБ, Склад, Поставщик, Стул, 5, 100, Дата(2026, 9, 2, 10, 0, 0));
  Отказ = Продать(ОрганизацияА, Склад, Покупатель, Стул, 5, Дата(2026, 9, 2, 11, 0, 0));
  Утверждать.Истина(СтрНайти(Отказ, "недостаточно") > 0,
    "организация А не продаёт товар организации Б (получено: «" + Отказ + "»)");
  Утверждать.Равно(Продать(ОрганизацияБ, Склад, Покупатель, Стул, 5, Дата(2026, 9, 2, 12, 0, 0)), "",
    "организация Б продаёт свой товар");
  Утверждать.Равно(ОстатокПартий(Стул, ОрганизацияБ), 0,
    "партия организации Б списана её продажей");
КонецПроцедуры

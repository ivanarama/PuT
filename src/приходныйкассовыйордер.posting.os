// ПКО: поступление в кассу/на банковский счёт.
//
// Касса.Вид определяет, кассовый это или банковский ордер — отдельные документы
// не плодим, отчёты разделяют по этому реквизиту.
//
// Движения:
//   ДенежныеСредства[Приход]  — пополнение кассы/счёта;
//   Взаиморасчеты[Расход]     — деньги пришли к нам → сальдо контрагента
//                              сдвигается «в его пользу».
//
// Тип контрагента берём из самого справочника (Контрагент.Вид) — отдельный
// реквизит документа не нужен.
//
// Если заполнено поле ДокументРеализации или ДокументПоступления — оно
// проставляется в атрибуты регистра, чтобы потом в АктеСверки и отчётах
// видеть «эта оплата гасит такую-то операцию».

Процедура ОбработкаПроведения()
  Движения.ДенежныеСредства.Очистить();
  Движения.Взаиморасчеты.Очистить();

  ДвДС = Движения.ДенежныеСредства.Добавить();
  ДвДС.ВидДвижения = "Приход";
  ДвДС.Касса       = this.Касса;
  ДвДС.Организация = this.Организация;
  ДвДС.Сумма       = this.Сумма;
  ДвДС.Контрагент  = this.Контрагент;
  ДвДС.Основание   = this.Основание;

  ДвВз = Движения.Взаиморасчеты.Добавить();
  ДвВз.ВидДвижения        = "Расход";
  ДвВз.Контрагент         = this.Контрагент;
  ДвВз.Организация        = this.Организация;
  ДвВз.ТипКонтрагента     = ЗначениеРеквизитаОбъекта(this.Контрагент, "Вид");
  ДвВз.ДокументРеализации = this.ДокументРеализации;
  ДвВз.ДокументПоступления = this.ДокументПоступления;
  ДвВз.Сумма              = this.Сумма;
КонецПроцедуры

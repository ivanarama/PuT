// Модуль документа «Закрытие заказов поставщикам».
// Позволяет снять зависшие ожидания товаров в пути по отменённым поставкам.

Процедура ОбработкаЗаполнения(ДанныеЗаполнения)
  Если ЗначениеЗаполнено(ДанныеЗаполнения) = Ложь Тогда
    Возврат;
  КонецЕсли;

  this.Организация = ДанныеЗаполнения.Организация;
  this.Склад       = ДанныеЗаполнения.Склад;
  this.Поставщик   = ДанныеЗаполнения.Поставщик;
  this.Комментарий = "Закрытие остатков по заказу поставщику № " + Строка(ДанныеЗаполнения.Номер);
  Момент = ?(ЗначениеЗаполнено(this.Дата), this.Дата, ТекущаяДатаВремя());

  // Получаем текущие открытые остатки товаров в пути по данному заказу
  ЗапросВПути = Новый Запрос;
  ЗапросВПути.Текст = "ВЫБРАТЬ
                          Номенклатура,
                          ЗаказПокупателя,
                          КоличествоОстаток
                        ИЗ РегистрНакопления.ТоварыВПути.Остатки(&Момент)
                        ГДЕ ЗаказПоставщику = &Заказ";
  ЗапросВПути.УстановитьПараметр("Момент", Момент);
  ЗапросВПути.УстановитьПараметр("Заказ", ДанныеЗаполнения.Ссылка);
  Рез = ЗапросВПути.Выполнить();

  Добавлено = 0;
  Для Каждого Стр Из Рез Цикл
    Если Стр.КоличествоОстаток > 0 Тогда
      СтрЗаказ = this.Заказы.Добавить();
      СтрЗаказ.ЗаказПоставщику = ДанныеЗаполнения.Ссылка;
      СтрЗаказ.ЗаказПокупателя = Стр.ЗаказПокупателя;
      СтрЗаказ.Номенклатура    = Стр.Номенклатура;
      СтрЗаказ.Количество      = Стр.КоличествоОстаток;
      СтрЗаказ.ПричинаЗакрытия = "Отказ поставщика / закрытие невыполненного остатка";
      Добавлено = Добавлено + 1;
    КонецЕсли;
  КонецЦикла;

  Если Добавлено = 0 Тогда
    Сообщить("По заказу поставщику № " + Строка(ДанныеЗаполнения.Номер) + " нет открытых товаров в пути.");
  КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи()
  Если ЗначениеЗаполнено(this.Организация) = Ложь Тогда
    this.Организация = ОрганизацияПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    this.Склад = СкладПоУмолчанию();
  КонецЕсли;
  Если ЗначениеЗаполнено(this.Склад) = Ложь Тогда
    Error("Укажите склад");
  КонецЕсли;
  Если this.Заказы.Количество() = 0 Тогда
    Error("Табличная часть не содержит строк для закрытия");
  КонецЕсли;

  Для Каждого Строка Из this.Заказы Цикл
    Если ЗначениеЗаполнено(Строка.Номенклатура) = Ложь
       ИЛИ ТипЗнч(Строка.Номенклатура) = "Строка"
       ИЛИ ПустаяСсылка(Строка.Номенклатура) Тогда
      Error("В табличной части есть строка без номенклатуры (или передана строка вместо ссылки)");
    КонецЕсли;
    Если ЗначениеЗаполнено(Строка.ЗаказПоставщику) = Ложь
       ИЛИ ТипЗнч(Строка.ЗаказПоставщику) = "Строка"
       ИЛИ ПустаяСсылка(Строка.ЗаказПоставщику) Тогда
      Error("В табличной части не указан закрываемый заказ поставщику");
    КонецЕсли;
    Если Строка.Количество <= 0 Тогда
      Error("Количество к закрытию должно быть больше нуля: «" + Строка(Строка.Номенклатура) + "»");
    КонецЕсли;
  КонецЦикла;
КонецПроцедуры

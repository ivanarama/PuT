  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Документ.ВозвратОтПокупателя УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    Объект = Документы.ВозвратОтПокупателя.НайтиПоИдентификатору(Идентификатор.ИД).ПолучитьОбъект();
    Если БП3ВПериоде(Объект.Дата, ДатаН, ДатаК) = Ложь Тогда Продолжить; КонецЕсли;
    Если ТолькоПроведенные И Объект.Проведён = Ложь Тогда Продолжить; КонецЕсли;
    Запись = Новый Соответствие;
    Запись.Вставить("uid", Идентификатор.ИД);
    Запись.Вставить("posted", Объект.Проведён);
    Запись.Вставить("Идентификатор1С", Объект.Идентификатор1С);
    Запись.Вставить("Номер", Объект.Номер);
    Запись.Вставить("Дата", БП3Дата(Объект.Дата));
    Запись.Вставить("Организация", БП3УИН(Объект.Организация));
    Запись.Вставить("Покупатель", БП3УИН(Объект.Покупатель));
    Запись.Вставить("Склад", БП3УИН(Объект.Склад));
    Запись.Вставить("Основание", БП3УИН(Объект.Основание));
    Запись.Вставить("СпособУчетаНДС", Объект.СпособУчетаНДС);
    Запись.Вставить("СуммаБезНДС", БП3Число(Объект.СуммаБезНДС));
    Запись.Вставить("СуммаНДС", БП3Число(Объект.СуммаНДС));
    Запись.Вставить("Сумма", БП3Число(Объект.Сумма));
    Строки = Новый Массив;
    Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
      СтрокаВыгрузки = Новый Соответствие;
      СтрокаВыгрузки.Вставить("Номенклатура", БП3УИН(СтрокаТаблицы.Номенклатура));
      СтрокаВыгрузки.Вставить("Количество", БП3Число(СтрокаТаблицы.Количество));
      СтрокаВыгрузки.Вставить("Цена", БП3Число(СтрокаТаблицы.Цена));
      СтрокаВыгрузки.Вставить("СтавкаНДС", БП3УИН(СтрокаТаблицы.СтавкаНДС));
      СтрокаВыгрузки.Вставить("СуммаНДС", БП3Число(СтрокаТаблицы.СуммаНДС));
      СтрокаВыгрузки.Вставить("Сумма", БП3Число(СтрокаТаблицы.Сумма));
      СтрокаВыгрузки.Вставить("Склад", БП3УИН(СтрокаТаблицы.Склад));
      Строки.Добавить(СтрокаВыгрузки);
    КонецЦикла;
    Запись.Вставить("Товары", Строки);
    Результат.Добавить(Запись);

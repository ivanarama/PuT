// PuT -> BP3 v1. Generated entity readers are appended by generate_bp3_exporter.py.
Процедура Выполнить()
  ДатаН = Параметры.ДатаНачала;
  ДатаК = Параметры.ДатаОкончания;
  БП3ПроверитьДатуПериода(ДатаН);
  БП3ПроверитьДатуПериода(ДатаК);
  Если ЗначениеЗаполнено(ДатаН) И ЗначениеЗаполнено(ДатаК) И ДатаН > ДатаК Тогда
    ВызватьИсключение "Дата начала периода больше даты окончания";
  КонецЕсли;
  Источник = Параметры.КодИсточника;
  Если ЗначениеЗаполнено(Источник) = Ложь Тогда Источник = "PuT"; КонецЕсли;
  Дамп = Новый Соответствие;
  Дамп.Вставить("format", "OneBase-PuT-BP3");
  Дамп.Вставить("version", "1.0");
  Дамп.Вставить("sourceId", Источник);
  Дамп.Вставить("exported", БП3Дата(ТекущаяДата()));
  Дамп.Вставить("catalogs", БП3Справочники());
  Дамп.Вставить("documents", БП3Документы(ДатаН, ДатаК, Параметры.ТолькоПроведенные = Истина));
  Период = Новый Соответствие;
  Период.Вставить("from", ДатаН);
  Период.Вставить("to", ДатаК);
  Дамп.Вставить("period", Период);
  Путь = Параметры.Путь;
  Если ЗначениеЗаполнено(Путь) = Ложь Тогда Путь = "PuT-BP3.json"; КонецЕсли;
  Запись = Новый ЗаписьТекста(Путь);
  Запись.Открыть();
  Запись.Записать(ЗаписатьJSON(Дамп));
  Запись.Закрыть();
  Сообщить("Выгрузка PuT для БП3 готова. Файл: " + Путь);
КонецПроцедуры

Процедура БП3ПроверитьДатуПериода(Граница)
  Если ЗначениеЗаполнено(Граница) = Ложь Тогда Возврат; КонецЕсли;
  Если СтрДлина(Граница) <> 10 ИЛИ Сред(Граница,5,1) <> "-" ИЛИ Сред(Граница,8,1) <> "-" Тогда
    ВызватьИсключение "Период задаётся датами ГГГГ-ММ-ДД";
  КонецЕсли;
  Проверка = Дата(Число(Лев(Граница,4)),Число(Сред(Граница,6,2)),Число(Прав(Граница,2)));
  Если Лев(БП3Дата(Проверка),10) <> Граница Тогда ВызватьИсключение "Некорректная дата периода: " + Граница; КонецЕсли;
КонецПроцедуры

Функция БП3ПереносимыйВид(Вид)
  Возврат Вид <> "ЗаказПокупателя" И Вид <> "ЗаказПоставщику"
    И Вид <> "ЗакрытиеЗаказовПокупателей" И Вид <> "ЗакрытиеЗаказовПоставщикам";
КонецФункции

Функция БП3ВыбратьДокументы(Вид, ДатаН, ДатаК, ТолькоПроведенные)
  Запрос = Новый Запрос;
  Условия = " ГДЕ 1 = 1";
  Если ЗначениеЗаполнено(ДатаН) Тогда
    Условия = Условия + " И Дата >= &С";
    Запрос.УстановитьПараметр("С", Дата(ДатаН));
  КонецЕсли;
  Если ЗначениеЗаполнено(ДатаК) Тогда
    Условия = Условия + " И Дата < &До";
    Запрос.УстановитьПараметр("До", ДобавитьДень(Дата(ДатаК), 1));
  КонецЕсли;
  Если ТолькоПроведенные Тогда Условия = Условия + " И posted = Истина"; КонецЕсли;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Документ." + Вид + Условия + " УПОРЯДОЧИТЬ ПО Ссылка";
  Возврат Запрос.Выполнить();
КонецФункции

Процедура БП3ДобавитьОснование(Вид, УИН, Включены, Очередь, Результат, Основание = Истина)
  Если НЕ ЗначениеЗаполнено(УИН) ИЛИ НЕ БП3ПереносимыйВид(Вид) Тогда Возврат; КонецЕсли;
  Ключ = Вид + ":" + УИН;
  Если Включены.Получить(Ключ) = Истина Тогда Возврат; КонецЕсли;
  Запись = БП3ПрочитатьДокумент(Вид, УИН);
  Запись.Вставить("dependency", Основание);
  Результат.Получить(Вид).Добавить(Запись);
  Включены.Вставить(Ключ, Истина);
  Очередь.Добавить(Новый Структура("Вид,Запись", Вид, Запись));
КонецПроцедуры

Функция БП3УИН(Ссылка)
  Если ЗначениеЗаполнено(Ссылка) = Ложь Тогда Возврат ""; КонецЕсли;
  Возврат Ссылка.УникальныйИдентификатор();
КонецФункции

Функция БП3СальдоДоДокумента(Объект)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ СуммаОстаток ИЗ РегистрНакопления.Взаиморасчеты.Остатки(&Момент) ГДЕ Контрагент = &Контрагент И Организация = &Организация";
  Запрос.УстановитьПараметр("Момент", Объект.МоментВремени());
  Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
  Запрос.УстановитьПараметр("Организация", Объект.Организация);
  Сальдо = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл Сальдо = Сальдо + Стр.СуммаОстаток; КонецЦикла;
  Возврат БП3Число(Сальдо);
КонецФункции

Функция БП3Число(Значение)
  Если Значение = Неопределено Тогда Возврат "0"; КонецЕсли;
  // Decimal is serialized as text to preserve precision through both runtimes.
  Возврат Строка(Значение);
КонецФункции

Функция БП3Дв(Значение)
  Возврат Прав("0" + Строка(Значение), 2);
КонецФункции

Функция БП3Дата(Значение)
  Если ЗначениеЗаполнено(Значение) = Ложь Тогда Возврат ""; КонецЕсли;
  Если ТипЗнч(Значение) <> Тип("Дата") Тогда
    Возврат Лев(СтрЗаменить(Строка(Значение), " ", "T"), 19);
  КонецЕсли;
  Возврат Строка(Год(Значение)) + "-" + БП3Дв(Месяц(Значение)) + "-" + БП3Дв(День(Значение))
    + "T" + БП3Дв(Час(Значение)) + ":" + БП3Дв(Минута(Значение)) + ":" + БП3Дв(Секунда(Значение));
КонецФункции

Функция БП3Справочники()
  Результат = Новый Соответствие;
  Результат.Вставить("Валюта", БП3Объект_Валюта());
  Результат.Вставить("ДоговорыКонтрагентов", БП3Объект_ДоговорыКонтрагентов());
  Результат.Вставить("ЕдиницаИзмерения", БП3Объект_ЕдиницаИзмерения());
  Результат.Вставить("Касса", БП3Объект_Касса());
  Результат.Вставить("Контрагент", БП3Объект_Контрагент());
  Результат.Вставить("НастройкиПользователя", БП3Объект_НастройкиПользователя());
  Результат.Вставить("Номенклатура", БП3Объект_Номенклатура());
  Результат.Вставить("Организация", БП3Объект_Организация());
  Результат.Вставить("ПодключаемоеОборудование", БП3Объект_ПодключаемоеОборудование());
  Результат.Вставить("Склад", БП3Объект_Склад());
  Результат.Вставить("СпецификацииНоменклатуры", БП3Объект_СпецификацииНоменклатуры());
  Результат.Вставить("СтавкаНДС", БП3Объект_СтавкаНДС());
  Результат.Вставить("ТипЦен", БП3Объект_ТипЦен());
  Результат.Вставить("Штрихкоды", БП3Объект_Штрихкоды());
  Возврат Результат;
КонецФункции

Функция БП3Документы(ДатаН, ДатаК, ТолькоПроведенные)
  Результат = Новый Соответствие;
  Включены = Новый Соответствие;
  Очередь = Новый Массив;
  Результат.Вставить("ВозвратОтПокупателя", Новый Массив);
  Результат.Вставить("ВозвратПоставщику", Новый Массив);
  Результат.Вставить("ЗаказПокупателя", Новый Массив);
  Результат.Вставить("ЗаказПоставщику", Новый Массив);
  Результат.Вставить("ЗакрытиеЗаказовПокупателей", Новый Массив);
  Результат.Вставить("ЗакрытиеЗаказовПоставщикам", Новый Массив);
  Результат.Вставить("КорректировкаДолга", Новый Массив);
  Результат.Вставить("ОприходованиеТоваров", Новый Массив);
  Результат.Вставить("ПеремещениеТоваров", Новый Массив);
  Результат.Вставить("ПересчетТоваров", Новый Массив);
  Результат.Вставить("ПоступлениеНаРасчётныйСчёт", Новый Массив);
  Результат.Вставить("ПоступлениеТоваров", Новый Массив);
  Результат.Вставить("ПриходныйКассовыйОрдер", Новый Массив);
  Результат.Вставить("РазборкаТоваров", Новый Массив);
  Результат.Вставить("РасходныйКассовыйОрдер", Новый Массив);
  Результат.Вставить("РеализацияТоваров", Новый Массив);
  Результат.Вставить("СборкаТоваров", Новый Массив);
  Результат.Вставить("СписаниеСРасчётногоСчёта", Новый Массив);
  Результат.Вставить("СписаниеТоваров", Новый Массив);
  Результат.Вставить("Счёт", Новый Массив);
  Результат.Вставить("УстановкаЦен", Новый Массив);
  Для Каждого Раздел Из Результат Цикл
    Если БП3ПереносимыйВид(Раздел.Ключ) Тогда
      Для Каждого Стр Из БП3ВыбратьДокументы(Раздел.Ключ, ДатаН, ДатаК, ТолькоПроведенные) Цикл
        БП3ДобавитьОснование(Раздел.Ключ, Стр.ИД, Включены, Очередь, Результат, Ложь);
      КонецЦикла;
    КонецЕсли;
  КонецЦикла;
  Индекс = 0;
  Пока Индекс < Очередь.Количество() Цикл
    Шаг = Очередь[Индекс];
    БП3ОснованияЗаписи(Шаг.Вид, Шаг.Запись, Включены, Очередь, Результат);
    Индекс = Индекс + 1;
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция БП3ПрочитатьДокумент(Вид, УИН)
  Если Вид = "ВозвратОтПокупателя" Тогда Возврат БП3Объект_ВозвратОтПокупателя(УИН); КонецЕсли;
  Если Вид = "ВозвратПоставщику" Тогда Возврат БП3Объект_ВозвратПоставщику(УИН); КонецЕсли;
  Если Вид = "КорректировкаДолга" Тогда Возврат БП3Объект_КорректировкаДолга(УИН); КонецЕсли;
  Если Вид = "ОприходованиеТоваров" Тогда Возврат БП3Объект_ОприходованиеТоваров(УИН); КонецЕсли;
  Если Вид = "ПеремещениеТоваров" Тогда Возврат БП3Объект_ПеремещениеТоваров(УИН); КонецЕсли;
  Если Вид = "ПересчетТоваров" Тогда Возврат БП3Объект_ПересчетТоваров(УИН); КонецЕсли;
  Если Вид = "ПоступлениеНаРасчётныйСчёт" Тогда Возврат БП3Объект_ПоступлениеНаРасчётныйСчёт(УИН); КонецЕсли;
  Если Вид = "ПоступлениеТоваров" Тогда Возврат БП3Объект_ПоступлениеТоваров(УИН); КонецЕсли;
  Если Вид = "ПриходныйКассовыйОрдер" Тогда Возврат БП3Объект_ПриходныйКассовыйОрдер(УИН); КонецЕсли;
  Если Вид = "РазборкаТоваров" Тогда Возврат БП3Объект_РазборкаТоваров(УИН); КонецЕсли;
  Если Вид = "РасходныйКассовыйОрдер" Тогда Возврат БП3Объект_РасходныйКассовыйОрдер(УИН); КонецЕсли;
  Если Вид = "РеализацияТоваров" Тогда Возврат БП3Объект_РеализацияТоваров(УИН); КонецЕсли;
  Если Вид = "СборкаТоваров" Тогда Возврат БП3Объект_СборкаТоваров(УИН); КонецЕсли;
  Если Вид = "СписаниеСРасчётногоСчёта" Тогда Возврат БП3Объект_СписаниеСРасчётногоСчёта(УИН); КонецЕсли;
  Если Вид = "СписаниеТоваров" Тогда Возврат БП3Объект_СписаниеТоваров(УИН); КонецЕсли;
  Если Вид = "Счёт" Тогда Возврат БП3Объект_Счёт(УИН); КонецЕсли;
  Если Вид = "УстановкаЦен" Тогда Возврат БП3Объект_УстановкаЦен(УИН); КонецЕсли;
  ВызватьИсключение "Неизвестный вид документа " + Вид;
КонецФункции

Функция БП3Объект_Валюта()
  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Справочник.Валюта УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    УИН = Идентификатор.ИД;
    Объект = Справочники.Валюта.НайтиПоИдентификатору(УИН).ПолучитьОбъект();
    Запись = Новый Соответствие;
    Запись.Вставить("uid", УИН);
    Запись.Вставить("Наименование", Объект.Наименование);
    Запись.Вставить("Код", Объект.Код);
    Результат.Добавить(Запись);
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция БП3Объект_ДоговорыКонтрагентов()
  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Справочник.ДоговорыКонтрагентов УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    УИН = Идентификатор.ИД;
    Объект = Справочники.ДоговорыКонтрагентов.НайтиПоИдентификатору(УИН).ПолучитьОбъект();
    Запись = Новый Соответствие;
    Запись.Вставить("uid", УИН);
    Запись.Вставить("Наименование", Объект.Наименование);
    Запись.Вставить("Владелец", БП3УИН(Объект.Владелец));
    Запись.Вставить("Номер", Объект.Номер);
    Запись.Вставить("Дата", БП3Дата(Объект.Дата));
    Запись.Вставить("ВидДоговора", Объект.ВидДоговора);
    Запись.Вставить("КредитныйЛимит", БП3Число(Объект.КредитныйЛимит));
    Запись.Вставить("Комментарий", Объект.Комментарий);
    Результат.Добавить(Запись);
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция БП3Объект_ЕдиницаИзмерения()
  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Справочник.ЕдиницаИзмерения УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    УИН = Идентификатор.ИД;
    Объект = Справочники.ЕдиницаИзмерения.НайтиПоИдентификатору(УИН).ПолучитьОбъект();
    Запись = Новый Соответствие;
    Запись.Вставить("uid", УИН);
    Запись.Вставить("Наименование", Объект.Наименование);
    Запись.Вставить("ПолноеНаименование", Объект.ПолноеНаименование);
    Запись.Вставить("КодОКЕИ", Объект.КодОКЕИ);
    Результат.Добавить(Запись);
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция БП3Объект_Касса()
  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Справочник.Касса УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    УИН = Идентификатор.ИД;
    Объект = Справочники.Касса.НайтиПоИдентификатору(УИН).ПолучитьОбъект();
    Запись = Новый Соответствие;
    Запись.Вставить("uid", УИН);
    Запись.Вставить("Наименование", Объект.Наименование);
    Запись.Вставить("Вид", Объект.Вид);
    Запись.Вставить("НомерСчёта", Объект.НомерСчёта);
    Запись.Вставить("Банк", Объект.Банк);
    Запись.Вставить("БИК", Объект.БИК);
    Результат.Добавить(Запись);
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция БП3Объект_Контрагент()
  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Справочник.Контрагент УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    УИН = Идентификатор.ИД;
    Объект = Справочники.Контрагент.НайтиПоИдентификатору(УИН).ПолучитьОбъект();
    Запись = Новый Соответствие;
    Запись.Вставить("uid", УИН);
    Запись.Вставить("Идентификатор1С", Объект.Идентификатор1С);
    Запись.Вставить("Наименование", Объект.Наименование);
    Запись.Вставить("ПолноеНаименование", Объект.ПолноеНаименование);
    Запись.Вставить("Вид", Объект.Вид);
    Запись.Вставить("ИНН", Объект.ИНН);
    Запись.Вставить("КПП", Объект.КПП);
    Запись.Вставить("ОГРН", Объект.ОГРН);
    Запись.Вставить("ОГРНИП", Объект.ОГРНИП);
    Запись.Вставить("ОКПО", Объект.ОКПО);
    Запись.Вставить("Сайт", Объект.Сайт);
    Запись.Вставить("ЮридическийАдрес", Объект.ЮридическийАдрес);
    Запись.Вставить("ФактическийАдрес", Объект.ФактическийАдрес);
    Запись.Вставить("Телефон", Объект.Телефон);
    Запись.Вставить("Email", Объект.Email);
    Запись.Вставить("КонтактноеЛицо", Объект.КонтактноеЛицо);
    Запись.Вставить("ТипЦенПродажи", БП3УИН(Объект.ТипЦенПродажи));

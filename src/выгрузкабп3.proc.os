Процедура БП3ОснованияЗаписи(Вид, Запись, Индекс, Выбранные, Очередь, Результат)
  Если Вид = "ВозвратОтПокупателя" Тогда
    БП3ДобавитьОснование("РеализацияТоваров", Запись.Получить("Основание"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ВозвратПоставщику" Тогда
    БП3ДобавитьОснование("ПоступлениеТоваров", Запись.Получить("Основание"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ЗаказПокупателя" Тогда
    БП3ДобавитьОснование("Счёт", Запись.Получить("Основание"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ОприходованиеТоваров" Тогда
    БП3ДобавитьОснование("ПересчетТоваров", Запись.Получить("Пересчет"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ПоступлениеНаРасчётныйСчёт" Тогда
    БП3ДобавитьОснование("РеализацияТоваров", Запись.Получить("ДокументРеализации"), Индекс, Выбранные, Очередь, Результат);
    БП3ДобавитьОснование("ПоступлениеТоваров", Запись.Получить("ДокументПоступления"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ПоступлениеТоваров" Тогда
    БП3ДобавитьОснование("ЗаказПоставщику", Запись.Получить("ЗаказПоставщику"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ПриходныйКассовыйОрдер" Тогда
    БП3ДобавитьОснование("РеализацияТоваров", Запись.Получить("ДокументРеализации"), Индекс, Выбранные, Очередь, Результат);
    БП3ДобавитьОснование("ПоступлениеТоваров", Запись.Получить("ДокументПоступления"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
  Если Вид = "РасходныйКассовыйОрдер" Тогда
    БП3ДобавитьОснование("РеализацияТоваров", Запись.Получить("ДокументРеализации"), Индекс, Выбранные, Очередь, Результат);
    БП3ДобавитьОснование("ПоступлениеТоваров", Запись.Получить("ДокументПоступления"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
  Если Вид = "РеализацияТоваров" Тогда
    БП3ДобавитьОснование("ЗаказПокупателя", Запись.Получить("ЗаказПокупателя"), Индекс, Выбранные, Очередь, Результат);
    БП3ДобавитьОснование("Счёт", Запись.Получить("Основание"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
  Если Вид = "СписаниеСРасчётногоСчёта" Тогда
    БП3ДобавитьОснование("РеализацияТоваров", Запись.Получить("ДокументРеализации"), Индекс, Выбранные, Очередь, Результат);
    БП3ДобавитьОснование("ПоступлениеТоваров", Запись.Получить("ДокументПоступления"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
  Если Вид = "СписаниеТоваров" Тогда
    БП3ДобавитьОснование("ПересчетТоваров", Запись.Получить("Пересчет"), Индекс, Выбранные, Очередь, Результат);
  КонецЕсли;
КонецПроцедуры

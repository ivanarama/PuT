Процедура БП3ОснованияЗаписи(Вид, Запись, Включены, Очередь, Результат)
  Если Вид = "ВозвратОтПокупателя" Тогда
    БП3ДобавитьОснование("РеализацияТоваров", Запись.Получить("Основание"), Включены, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ВозвратПоставщику" Тогда
    БП3ДобавитьОснование("ПоступлениеТоваров", Запись.Получить("Основание"), Включены, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ОприходованиеТоваров" Тогда
    БП3ДобавитьОснование("ПересчетТоваров", Запись.Получить("Пересчет"), Включены, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ПоступлениеНаРасчётныйСчёт" Тогда
    БП3ДобавитьОснование("РеализацияТоваров", Запись.Получить("ДокументРеализации"), Включены, Очередь, Результат);
    БП3ДобавитьОснование("ПоступлениеТоваров", Запись.Получить("ДокументПоступления"), Включены, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ПоступлениеТоваров" Тогда
    БП3ДобавитьОснование("ЗаказПоставщику", Запись.Получить("ЗаказПоставщику"), Включены, Очередь, Результат);
  КонецЕсли;
  Если Вид = "ПриходныйКассовыйОрдер" Тогда
    БП3ДобавитьОснование("РеализацияТоваров", Запись.Получить("ДокументРеализации"), Включены, Очередь, Результат);
    БП3ДобавитьОснование("ПоступлениеТоваров", Запись.Получить("ДокументПоступления"), Включены, Очередь, Результат);
  КонецЕсли;
  Если Вид = "РасходныйКассовыйОрдер" Тогда
    БП3ДобавитьОснование("РеализацияТоваров", Запись.Получить("ДокументРеализации"), Включены, Очередь, Результат);
    БП3ДобавитьОснование("ПоступлениеТоваров", Запись.Получить("ДокументПоступления"), Включены, Очередь, Результат);
  КонецЕсли;
  Если Вид = "РеализацияТоваров" Тогда
    БП3ДобавитьОснование("ЗаказПокупателя", Запись.Получить("ЗаказПокупателя"), Включены, Очередь, Результат);
    БП3ДобавитьОснование("Счёт", Запись.Получить("Основание"), Включены, Очередь, Результат);
  КонецЕсли;
  Если Вид = "СписаниеСРасчётногоСчёта" Тогда
    БП3ДобавитьОснование("РеализацияТоваров", Запись.Получить("ДокументРеализации"), Включены, Очередь, Результат);
    БП3ДобавитьОснование("ПоступлениеТоваров", Запись.Получить("ДокументПоступления"), Включены, Очередь, Результат);
  КонецЕсли;
  Если Вид = "СписаниеТоваров" Тогда
    БП3ДобавитьОснование("ПересчетТоваров", Запись.Получить("Пересчет"), Включены, Очередь, Результат);
  КонецЕсли;
КонецПроцедуры

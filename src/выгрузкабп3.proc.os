// PuT -> BP3 v1. Generated entity readers are appended by generate_bp3_exporter.py.
Процедура Выполнить()
  ДатаН = Параметры.ДатаНачала;
  ДатаК = Параметры.ДатаОкончания;
  БП3ПроверитьДатуПериода(ДатаН);
  БП3ПроверитьДатуПериода(ДатаК);
  Если ЗначениеЗаполнено(ДатаН) И ЗначениеЗаполнено(ДатаК) И ДатаН > ДатаК Тогда
    ВызватьИсключение "Дата начала периода больше даты окончания";
  КонецЕсли;
  Источник = Параметры.КодИсточника;
  Если ЗначениеЗаполнено(Источник) = Ложь Тогда Источник = "PuT"; КонецЕсли;
  Дамп = Новый Соответствие;
  Дамп.Вставить("format", "OneBase-PuT-BP3");
  Дамп.Вставить("version", "1.0");
  Дамп.Вставить("sourceId", Источник);
  Дамп.Вставить("exported", БП3Дата(ТекущаяДата()));
  Дамп.Вставить("catalogs", БП3Справочники(ДатаН, ДатаК, Ложь));
  Дамп.Вставить("documents", БП3ОтборСОснованиями(БП3Документы("", "", Ложь), ДатаН, ДатаК, Параметры.ТолькоПроведенные = Истина));
  Период = Новый Соответствие;
  Период.Вставить("from", ДатаН);
  Период.Вставить("to", ДатаК);
  Дамп.Вставить("period", Период);
  Путь = Параметры.Путь;
  Если ЗначениеЗаполнено(Путь) = Ложь Тогда Путь = "PuT-BP3.json"; КонецЕсли;
  Запись = Новый ЗаписьТекста(Путь);
  Запись.Открыть();
  Запись.Записать(ЗаписатьJSON(Дамп));
  Запись.Закрыть();
  Сообщить("Выгрузка PuT для БП3 готова. Файл: " + Путь);
КонецПроцедуры

Процедура БП3ПроверитьДатуПериода(Граница)
  Если ЗначениеЗаполнено(Граница) = Ложь Тогда Возврат; КонецЕсли;
  Если СтрДлина(Граница) <> 10 ИЛИ Сред(Граница,5,1) <> "-" ИЛИ Сред(Граница,8,1) <> "-" Тогда
    ВызватьИсключение "Период задаётся датами ГГГГ-ММ-ДД";
  КонецЕсли;
  Проверка = Дата(Число(Лев(Граница,4)),Число(Сред(Граница,6,2)),Число(Прав(Граница,2)));
  Если Лев(БП3Дата(Проверка),10) <> Граница Тогда ВызватьИсключение "Некорректная дата периода: " + Граница; КонецЕсли;
КонецПроцедуры

Функция БП3ПереносимыйВид(Вид)
  Возврат Вид <> "ЗаказПокупателя" И Вид <> "ЗаказПоставщику"
    И Вид <> "ЗакрытиеЗаказовПокупателей" И Вид <> "ЗакрытиеЗаказовПоставщикам";
КонецФункции

Функция БП3ОтборСОснованиями(Все, ДатаН, ДатаК, ТолькоПроведенные)
  Результат = Новый Соответствие;
  Индекс = Новый Соответствие;
  Выбранные = Новый Соответствие;
  Очередь = Новый Массив;
  Для Каждого Раздел Из Все Цикл
    Результат.Вставить(Раздел.Ключ, Новый Массив);
    Для Каждого Запись Из Раздел.Значение Цикл
      Индекс.Вставить(Раздел.Ключ + ":" + Запись.Получить("uid"), Запись);
      Если БП3ПереносимыйВид(Раздел.Ключ) И БП3ВПериоде(Запись.Получить("Дата"), ДатаН, ДатаК)
        И (ТолькоПроведенные = Ложь ИЛИ Запись.Получить("posted")) Тогда
        БП3ДобавитьОснование(Раздел.Ключ, Запись.Получить("uid"), Индекс, Выбранные, Очередь, Результат, Ложь);
      КонецЕсли;
    КонецЦикла;
  КонецЦикла;
  Номер = 0;
  Пока Номер < Очередь.Количество() Цикл
    Элемент = Очередь[Номер];
    БП3ОснованияЗаписи(Элемент.Получить("Вид"), Индекс.Получить(Элемент.Получить("Вид") + ":" + Элемент.Получить("УИН")), Индекс, Выбранные, Очередь, Результат);
    Номер = Номер + 1;
  КонецЦикла;
  Возврат Результат;
КонецФункции

Процедура БП3ДобавитьОснование(Вид, УИН, Индекс, Выбранные, Очередь, Результат, Основание = Истина)
  Если ЗначениеЗаполнено(УИН) = Ложь ИЛИ БП3ПереносимыйВид(Вид) = Ложь Тогда Возврат; КонецЕсли;
  Ключ = Вид + ":" + УИН;
  Если Выбранные.Получить(Ключ) = Истина Тогда Возврат; КонецЕсли;
  Запись = Индекс.Получить(Ключ);
  Если Запись = Неопределено Тогда ВызватьИсключение "Не найдено основание PuT: " + Ключ; КонецЕсли;
  Запись.Вставить("dependency", Основание);
  Результат.Получить(Вид).Добавить(Запись);
  Выбранные.Вставить(Ключ, Истина);
  Шаг = Новый Соответствие; Шаг.Вставить("Вид", Вид); Шаг.Вставить("УИН", УИН); Очередь.Добавить(Шаг);
КонецПроцедуры

Функция БП3УИН(Ссылка)
  Если ЗначениеЗаполнено(Ссылка) = Ложь Тогда Возврат ""; КонецЕсли;
  Возврат Ссылка.УникальныйИдентификатор();
КонецФункции

Функция БП3СальдоДоДокумента(Объект)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ СуммаОстаток ИЗ РегистрНакопления.Взаиморасчеты.Остатки(&Момент) ГДЕ Контрагент = &Контрагент И Организация = &Организация";
  Запрос.УстановитьПараметр("Момент", Объект.МоментВремени());
  Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
  Запрос.УстановитьПараметр("Организация", Объект.Организация);
  Сальдо = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл Сальдо = Сальдо + Стр.СуммаОстаток; КонецЦикла;
  Возврат БП3Число(Сальдо);
КонецФункции

Функция БП3Число(Значение)
  Если Значение = Неопределено Тогда Возврат "0"; КонецЕсли;
  // Decimal is serialized as text to preserve precision through both runtimes.
  Возврат Строка(Значение);
КонецФункции

Функция БП3Дв(Значение)
  Возврат Прав("0" + Строка(Значение), 2);
КонецФункции

Функция БП3Дата(Значение)
  Если ЗначениеЗаполнено(Значение) = Ложь Тогда Возврат ""; КонецЕсли;
  Если ТипЗнч(Значение) <> Тип("Дата") Тогда
    Возврат Лев(СтрЗаменить(Строка(Значение), " ", "T"), 19);
  КонецЕсли;
  Возврат Строка(Год(Значение)) + "-" + БП3Дв(Месяц(Значение)) + "-" + БП3Дв(День(Значение))
    + "T" + БП3Дв(Час(Значение)) + ":" + БП3Дв(Минута(Значение)) + ":" + БП3Дв(Секунда(Значение));
КонецФункции

Функция БП3ВПериоде(ДатаДокумента, ДатаН, ДатаК)
  ДеньДокумента = Лев(БП3Дата(ДатаДокумента), 10);
  Если ЗначениеЗаполнено(ДатаН) И ДеньДокумента < ДатаН Тогда Возврат Ложь; КонецЕсли;
  Если ЗначениеЗаполнено(ДатаК) И ДеньДокумента > ДатаК Тогда Возврат Ложь; КонецЕсли;
  Возврат Истина;
КонецФункции

Функция БП3Справочники(ДатаН, ДатаК, ТолькоПроведенные)
  Результат = Новый Соответствие;
  Результат.Вставить("Валюта", БП3Объект_Валюта(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ДоговорыКонтрагентов", БП3Объект_ДоговорыКонтрагентов(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ЕдиницаИзмерения", БП3Объект_ЕдиницаИзмерения(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("Касса", БП3Объект_Касса(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("Контрагент", БП3Объект_Контрагент(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("НастройкиПользователя", БП3Объект_НастройкиПользователя(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("Номенклатура", БП3Объект_Номенклатура(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("Организация", БП3Объект_Организация(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ПодключаемоеОборудование", БП3Объект_ПодключаемоеОборудование(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("Склад", БП3Объект_Склад(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("СпецификацииНоменклатуры", БП3Объект_СпецификацииНоменклатуры(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("СтавкаНДС", БП3Объект_СтавкаНДС(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ТипЦен", БП3Объект_ТипЦен(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("Штрихкоды", БП3Объект_Штрихкоды(ДатаН, ДатаК, ТолькоПроведенные));
  Возврат Результат;
КонецФункции

Функция БП3Документы(ДатаН, ДатаК, ТолькоПроведенные)
  Результат = Новый Соответствие;
  Результат.Вставить("ВозвратОтПокупателя", БП3Объект_ВозвратОтПокупателя(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ВозвратПоставщику", БП3Объект_ВозвратПоставщику(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ЗаказПокупателя", БП3Объект_ЗаказПокупателя(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ЗаказПоставщику", БП3Объект_ЗаказПоставщику(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ЗакрытиеЗаказовПокупателей", БП3Объект_ЗакрытиеЗаказовПокупателей(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ЗакрытиеЗаказовПоставщикам", БП3Объект_ЗакрытиеЗаказовПоставщикам(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("КорректировкаДолга", БП3Объект_КорректировкаДолга(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ОприходованиеТоваров", БП3Объект_ОприходованиеТоваров(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ПеремещениеТоваров", БП3Объект_ПеремещениеТоваров(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ПересчетТоваров", БП3Объект_ПересчетТоваров(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ПоступлениеНаРасчётныйСчёт", БП3Объект_ПоступлениеНаРасчётныйСчёт(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ПоступлениеТоваров", БП3Объект_ПоступлениеТоваров(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("ПриходныйКассовыйОрдер", БП3Объект_ПриходныйКассовыйОрдер(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("РазборкаТоваров", БП3Объект_РазборкаТоваров(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("РасходныйКассовыйОрдер", БП3Объект_РасходныйКассовыйОрдер(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("РеализацияТоваров", БП3Объект_РеализацияТоваров(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("СборкаТоваров", БП3Объект_СборкаТоваров(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("СписаниеСРасчётногоСчёта", БП3Объект_СписаниеСРасчётногоСчёта(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("СписаниеТоваров", БП3Объект_СписаниеТоваров(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("Счёт", БП3Объект_Счёт(ДатаН, ДатаК, ТолькоПроведенные));
  Результат.Вставить("УстановкаЦен", БП3Объект_УстановкаЦен(ДатаН, ДатаК, ТолькоПроведенные));
  Возврат Результат;
КонецФункции

Функция БП3Объект_Валюта(ДатаН, ДатаК, ТолькоПроведенные)
  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Справочник.Валюта УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    Объект = Справочники.Валюта.НайтиПоИдентификатору(Идентификатор.ИД).ПолучитьОбъект();
    Запись = Новый Соответствие;
    Запись.Вставить("uid", Идентификатор.ИД);
    Запись.Вставить("Наименование", Объект.Наименование);
    Запись.Вставить("Код", Объект.Код);
    Результат.Добавить(Запись);
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция БП3Объект_ДоговорыКонтрагентов(ДатаН, ДатаК, ТолькоПроведенные)
  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Справочник.ДоговорыКонтрагентов УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    Объект = Справочники.ДоговорыКонтрагентов.НайтиПоИдентификатору(Идентификатор.ИД).ПолучитьОбъект();
    Запись = Новый Соответствие;
    Запись.Вставить("uid", Идентификатор.ИД);
    Запись.Вставить("Наименование", Объект.Наименование);
    Запись.Вставить("Владелец", БП3УИН(Объект.Владелец));
    Запись.Вставить("Номер", Объект.Номер);
    Запись.Вставить("Дата", БП3Дата(Объект.Дата));
    Запись.Вставить("ВидДоговора", Объект.ВидДоговора);
    Запись.Вставить("КредитныйЛимит", БП3Число(Объект.КредитныйЛимит));
    Запись.Вставить("Комментарий", Объект.Комментарий);
    Результат.Добавить(Запись);
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция БП3Объект_ЕдиницаИзмерения(ДатаН, ДатаК, ТолькоПроведенные)
  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Справочник.ЕдиницаИзмерения УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    Объект = Справочники.ЕдиницаИзмерения.НайтиПоИдентификатору(Идентификатор.ИД).ПолучитьОбъект();
    Запись = Новый Соответствие;
    Запись.Вставить("uid", Идентификатор.ИД);
    Запись.Вставить("Наименование", Объект.Наименование);
    Запись.Вставить("ПолноеНаименование", Объект.ПолноеНаименование);
    Запись.Вставить("КодОКЕИ", Объект.КодОКЕИ);
    Результат.Добавить(Запись);
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция БП3Объект_Касса(ДатаН, ДатаК, ТолькоПроведенные)
  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Справочник.Касса УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    Объект = Справочники.Касса.НайтиПоИдентификатору(Идентификатор.ИД).ПолучитьОбъект();
    Запись = Новый Соответствие;
    Запись.Вставить("uid", Идентификатор.ИД);
    Запись.Вставить("Наименование", Объект.Наименование);
    Запись.Вставить("Вид", Объект.Вид);
    Запись.Вставить("НомерСчёта", Объект.НомерСчёта);
    Запись.Вставить("Банк", Объект.Банк);
    Запись.Вставить("БИК", Объект.БИК);
    Результат.Добавить(Запись);
  КонецЦикла;
  Возврат Результат;
КонецФункции

Функция БП3Объект_Контрагент(ДатаН, ДатаК, ТолькоПроведенные)
  Результат = Новый Массив;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ссылка КАК ИД ИЗ Справочник.Контрагент УПОРЯДОЧИТЬ ПО Ссылка";
  Для Каждого Идентификатор Из Запрос.Выполнить() Цикл
    Объект = Справочники.Контрагент.НайтиПоИдентификатору(Идентификатор.ИД).ПолучитьОбъект();
    Запись = Новый Соответствие;
    Запись.Вставить("uid", Идентификатор.ИД);
    Запись.Вставить("Идентификатор1С", Объект.Идентификатор1С);
    Запись.Вставить("Наименование", Объект.Наименование);
    Запись.Вставить("ПолноеНаименование", Объект.ПолноеНаименование);
    Запись.Вставить("Вид", Объект.Вид);
    Запись.Вставить("ИНН", Объект.ИНН);
    Запись.Вставить("КПП", Объект.КПП);
    Запись.Вставить("ОГРН", Объект.ОГРН);
    Запись.Вставить("ОГРНИП", Объект.ОГРНИП);
    Запись.Вставить("ОКПО", Объект.ОКПО);
    Запись.Вставить("Сайт", Объект.Сайт);

// РКО: выплата из кассы/списание с банковского счёта.
//
// Касса.Вид определяет тип ордера — кассовый или банковский — отчёты разделяют.
//
// Движения:
//   ДенежныеСредства[Расход]  — выбытие из кассы/со счёта;
//   Взаиморасчеты[Приход]     — деньги ушли от нас → сальдо контрагента
//                              сдвигается «в нашу пользу».
//
// Тип контрагента берём из Контрагент.Вид — отдельный реквизит документа
// убран как избыточный.
//
// Поля ДокументРеализации / ДокументПоступления заполняются по выбору
// пользователя и проставляются в атрибуты регистра — это и есть «привязка
// оплаты к документу-основанию».

Процедура ОбработкаПроведения()
  Движения.ДенежныеСредства.Очистить();
  Движения.Взаиморасчеты.Очистить();

  ДвДС = Движения.ДенежныеСредства.Добавить();
  ДвДС.ВидДвижения = "Расход";
  ДвДС.Касса       = this.Касса;
  ДвДС.Организация = this.Организация;
  ДвДС.Сумма       = this.Сумма;
  ДвДС.Контрагент  = this.Контрагент;
  ДвДС.Основание   = this.Основание;

  ДвВз = Движения.Взаиморасчеты.Добавить();
  ДвВз.ВидДвижения        = "Приход";
  ДвВз.Контрагент         = this.Контрагент;
  ДвВз.Организация        = this.Организация;
  ДвВз.ТипКонтрагента     = ЗначениеРеквизитаОбъекта(this.Контрагент, "Вид");
  ДвВз.ДокументРеализации = this.ДокументРеализации;
  ДвВз.ДокументПоступления = this.ДокументПоступления;
  ДвВз.Сумма              = this.Сумма;
КонецПроцедуры

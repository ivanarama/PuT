// Штрихкод однозначно указывает на товар: при повторе сканер нашёл бы
// произвольный из элементов с одинаковым кодом.
Процедура ПриЗаписи()
  ШК = СокрЛП(Строка(this.Штрихкод));
  Если ШК = "" Тогда
    ВызватьИсключение("Укажите штрихкод");
  КонецЕсли;
  this.Штрихкод = ШК;
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ Ш.Ссылка КАК ИД, Ш.Номенклатура.Наименование КАК НомИмя
                  ИЗ Справочник.Штрихкоды КАК Ш
                  ГДЕ Ш.Штрихкод = &ШК И Ш.deletion_mark = Ложь";
  Запрос.УстановитьПараметр("ШК", ШК);
  Для Каждого Стр Из Запрос.Выполнить() Цикл
    Если УИДСсылки(Стр.ИД) <> УИДСсылки(this.Ссылка) Тогда
      ВызватьИсключение("Штрихкод «" + ШК + "» уже назначен номенклатуре «" + Строка(Стр.НомИмя) + "»");
    КонецЕсли;
  КонецЦикла;
КонецПроцедуры

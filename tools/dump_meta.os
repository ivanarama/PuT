Соединитель = Новый COMОбъект("V83.COMConnector");
База = Соединитель.Connect("File=""C:\1c-bases\УТДемо_10_3_70_4"";Usr=""Федоров (администратор)"";");

СтруктураМеты = Новый Структура;

Список = "ПоступлениеТоваровУслуг,РеализацияТоваровУслуг,ВозвратТоваровПоставщику,ВозвратТоваровОтПокупателя,ПеремещениеТоваров,СписаниеТоваров,ОприходованиеТоваров,КомплектацияНоменклатуры,ПриходныйКассовыйОрдер,РасходныйКассовыйОрдер,ПлатежноеПоручениеВходящее,ПлатежноеПоручениеИсходящее";
МассивИмен = СтрРазделить(Список, ",");

Для Каждого ИмяДок Из МассивИмен Цикл
	Мета = База.Метаданные.Документы.Найти(ИмяДок);
	Если Мета = Неопределено Тогда
		Продолжить;
	КонецЕсли;
	
	РеквизитыШапки = Новый Массив;
	Для Индекс = 0 По Мета.Реквизиты.Количество() - 1 Цикл
		РеквизитыШапки.Добавить(Мета.Реквизиты.Получить(Индекс).Имя);
	КонецЦикла;
	
	ТЧСтр = Новый Структура;
	Для ИндексТЧ = 0 По Мета.ТабличныеЧасти.Количество() - 1 Цикл
		ТЧ = Мета.ТабличныеЧасти.Получить(ИндексТЧ);
		РеквизитыТЧ = Новый Массив;
		Для Индекс = 0 По ТЧ.Реквизиты.Количество() - 1 Цикл
			РеквизитыТЧ.Добавить(ТЧ.Реквизиты.Получить(Индекс).Имя);
		КонецЦикла;
		ТЧСтр.Вставить(ТЧ.Имя, РеквизитыТЧ);
	КонецЦикла;
	
	ДокИнфо = Новый Структура;
	ДокИнфо.Вставить("Шапка", РеквизитыШапки);
	ДокИнфо.Вставить("ТЧ", ТЧСтр);
	
	СтруктураМеты.Вставить(ИмяДок, ДокИнфо);
КонецЦикла;

ЗаписьJSON = Новый ЗаписьJSON;
ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
ЗаписьJSON.ОткрытьФайл("C:\Projects\OneBaseConfs\temp\data\meta_docs.json",,, ПараметрыЗаписи);
ЗаписатьJSON(ЗаписьJSON, СтруктураМеты);
ЗаписьJSON.Закрыть();
Сообщить("Мета сохранена в meta_docs.json");

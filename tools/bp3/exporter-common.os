// PuT -> BP3 v1. Generated entity readers are appended by generate_bp3_exporter.py.
Процедура Выполнить()
  ДатаН = Параметры.ДатаНачала;
  ДатаК = Параметры.ДатаОкончания;
  БП3ПроверитьДатуПериода(ДатаН);
  БП3ПроверитьДатуПериода(ДатаК);
  Если ЗначениеЗаполнено(ДатаН) И ЗначениеЗаполнено(ДатаК) И ДатаН > ДатаК Тогда
    ВызватьИсключение "Дата начала периода больше даты окончания";
  КонецЕсли;
  Источник = Параметры.КодИсточника;
  Если ЗначениеЗаполнено(Источник) = Ложь Тогда Источник = "PuT"; КонецЕсли;
  Дамп = Новый Соответствие;
  Дамп.Вставить("format", "OneBase-PuT-BP3");
  Дамп.Вставить("version", "1.0");
  Дамп.Вставить("sourceId", Источник);
  Дамп.Вставить("exported", БП3Дата(ТекущаяДата()));
  Дамп.Вставить("catalogs", БП3Справочники(ДатаН, ДатаК, Ложь));
  Дамп.Вставить("documents", БП3ОтборСОснованиями(БП3Документы("", "", Ложь), ДатаН, ДатаК, Параметры.ТолькоПроведенные = Истина));
  Период = Новый Соответствие;
  Период.Вставить("from", ДатаН);
  Период.Вставить("to", ДатаК);
  Дамп.Вставить("period", Период);
  Путь = Параметры.Путь;
  Если ЗначениеЗаполнено(Путь) = Ложь Тогда Путь = "PuT-BP3.json"; КонецЕсли;
  Запись = Новый ЗаписьТекста(Путь);
  Запись.Открыть();
  Запись.Записать(ЗаписатьJSON(Дамп));
  Запись.Закрыть();
  Сообщить("Выгрузка PuT для БП3 готова. Файл: " + Путь);
КонецПроцедуры

Процедура БП3ПроверитьДатуПериода(Граница)
  Если ЗначениеЗаполнено(Граница) = Ложь Тогда Возврат; КонецЕсли;
  Если СтрДлина(Граница) <> 10 ИЛИ Сред(Граница,5,1) <> "-" ИЛИ Сред(Граница,8,1) <> "-" Тогда
    ВызватьИсключение "Период задаётся датами ГГГГ-ММ-ДД";
  КонецЕсли;
  Проверка = Дата(Число(Лев(Граница,4)),Число(Сред(Граница,6,2)),Число(Прав(Граница,2)));
  Если Лев(БП3Дата(Проверка),10) <> Граница Тогда ВызватьИсключение "Некорректная дата периода: " + Граница; КонецЕсли;
КонецПроцедуры

Функция БП3ПереносимыйВид(Вид)
  Возврат Вид <> "ЗаказПокупателя" И Вид <> "ЗаказПоставщику"
    И Вид <> "ЗакрытиеЗаказовПокупателей" И Вид <> "ЗакрытиеЗаказовПоставщикам";
КонецФункции

Функция БП3ОтборСОснованиями(Все, ДатаН, ДатаК, ТолькоПроведенные)
  Результат = Новый Соответствие;
  Индекс = Новый Соответствие;
  Выбранные = Новый Соответствие;
  Очередь = Новый Массив;
  Для Каждого Раздел Из Все Цикл
    Результат.Вставить(Раздел.Ключ, Новый Массив);
    Для Каждого Запись Из Раздел.Значение Цикл
      Индекс.Вставить(Раздел.Ключ + ":" + Запись.Получить("uid"), Запись);
      Если БП3ПереносимыйВид(Раздел.Ключ) И БП3ВПериоде(Запись.Получить("Дата"), ДатаН, ДатаК)
        И (ТолькоПроведенные = Ложь ИЛИ Запись.Получить("posted")) Тогда
        БП3ДобавитьОснование(Раздел.Ключ, Запись.Получить("uid"), Индекс, Выбранные, Очередь, Результат, Ложь);
      КонецЕсли;
    КонецЦикла;
  КонецЦикла;
  Номер = 0;
  Пока Номер < Очередь.Количество() Цикл
    Элемент = Очередь[Номер];
    БП3ОснованияЗаписи(Элемент.Получить("Вид"), Индекс.Получить(Элемент.Получить("Вид") + ":" + Элемент.Получить("УИН")), Индекс, Выбранные, Очередь, Результат);
    Номер = Номер + 1;
  КонецЦикла;
  Возврат Результат;
КонецФункции

Процедура БП3ДобавитьОснование(Вид, УИН, Индекс, Выбранные, Очередь, Результат, Основание = Истина)
  Если ЗначениеЗаполнено(УИН) = Ложь ИЛИ БП3ПереносимыйВид(Вид) = Ложь Тогда Возврат; КонецЕсли;
  Ключ = Вид + ":" + УИН;
  Если Выбранные.Получить(Ключ) = Истина Тогда Возврат; КонецЕсли;
  Запись = Индекс.Получить(Ключ);
  Если Запись = Неопределено Тогда ВызватьИсключение "Не найдено основание PuT: " + Ключ; КонецЕсли;
  Запись.Вставить("dependency", Основание);
  Результат.Получить(Вид).Добавить(Запись);
  Выбранные.Вставить(Ключ, Истина);
  Шаг = Новый Соответствие; Шаг.Вставить("Вид", Вид); Шаг.Вставить("УИН", УИН); Очередь.Добавить(Шаг);
КонецПроцедуры

Функция БП3УИН(Ссылка)
  Если ЗначениеЗаполнено(Ссылка) = Ложь Тогда Возврат ""; КонецЕсли;
  Возврат Ссылка.УникальныйИдентификатор();
КонецФункции

Функция БП3СальдоДоДокумента(Объект)
  Запрос = Новый Запрос;
  Запрос.Текст = "ВЫБРАТЬ СуммаОстаток ИЗ РегистрНакопления.Взаиморасчеты.Остатки(&Момент) ГДЕ Контрагент = &Контрагент И Организация = &Организация";
  Запрос.УстановитьПараметр("Момент", Объект.МоментВремени());
  Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
  Запрос.УстановитьПараметр("Организация", Объект.Организация);
  Сальдо = 0;
  Для Каждого Стр Из Запрос.Выполнить() Цикл Сальдо = Сальдо + Стр.СуммаОстаток; КонецЦикла;
  Возврат БП3Число(Сальдо);
КонецФункции

Функция БП3Число(Значение)
  Если Значение = Неопределено Тогда Возврат "0"; КонецЕсли;
  // Decimal is serialized as text to preserve precision through both runtimes.
  Возврат Строка(Значение);
КонецФункции

Функция БП3Дв(Значение)
  Возврат Прав("0" + Строка(Значение), 2);
КонецФункции

Функция БП3Дата(Значение)
  Если ЗначениеЗаполнено(Значение) = Ложь Тогда Возврат ""; КонецЕсли;
  Если ТипЗнч(Значение) <> Тип("Дата") Тогда
    Возврат Лев(СтрЗаменить(Строка(Значение), " ", "T"), 19);
  КонецЕсли;
  Возврат Строка(Год(Значение)) + "-" + БП3Дв(Месяц(Значение)) + "-" + БП3Дв(День(Значение))
    + "T" + БП3Дв(Час(Значение)) + ":" + БП3Дв(Минута(Значение)) + ":" + БП3Дв(Секунда(Значение));
КонецФункции

Функция БП3ВПериоде(ДатаДокумента, ДатаН, ДатаК)
  ДеньДокумента = Лев(БП3Дата(ДатаДокумента), 10);
  Если ЗначениеЗаполнено(ДатаН) И ДеньДокумента < ДатаН Тогда Возврат Ложь; КонецЕсли;
  Если ЗначениеЗаполнено(ДатаК) И ДеньДокумента > ДатаК Тогда Возврат Ложь; КонецЕсли;
  Возврат Истина;
КонецФункции

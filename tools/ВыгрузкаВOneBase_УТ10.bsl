// ============================================================================
// ВНЕШНЯЯ ОБРАБОТКА 1С: ВЫГРУЗКА ДАННЫХ ИЗ 1С:УТ 10.3 В ONEBASE (PuT)
// ============================================================================
//
// ИНСТРУКЦИЯ ПО ИСПОЛЬЗОВАНИЮ В 1С:УТ 10.3:
// 1. В Конфигураторе 1С:УТ 10.3: Файл -> Новый -> Внешняя обработка.
// 2. Имя: ВыгрузкаВOneBase_УТ10.
// 3. Создайте форму обработки. На форме разместите:
//    - Поле ввода «КаталогВыгрузки» (тип Строка, длина 250);
//    - Флажок «ВыгружатьКонтрольныеСуммы» (тип Булево);
//    - Кнопку «Выгрузить в OneBase» (действие: КнопкаВыполнитьНажатие).
// 4. Вставьте данный код в модуль формы обработки.
// 5. Сохраните как ВыгрузкаВOneBase_УТ10.epf и открывайте в 1С:Предприятие (Файл -> Открыть).
// ============================================================================

Перем КаталогВыгрузки Экспорт;
Перем ВыгружатьКонтрольныеСуммы Экспорт;

Функция Чис(ЗначВход)
	Попытка
		Если ЗначВход = Неопределено Или ЗначВход = Null Тогда Возврат 0; КонецЕсли;
		Возврат Число(ЗначВход);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция Бул(ЗначВход)
	Попытка
		Если ЗначВход = Неопределено Или ЗначВход = Null Тогда Возврат Ложь; КонецЕсли;
		Возврат ?(ЗначВход = Истина Или ЗначВход = 1 Или Строка(ЗначВход) = "Да" Или Строка(ЗначВход) = "Истина" Или Строка(ЗначВход) = "True", Истина, Ложь);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция Стр(ЗначВход)
	Попытка
		Если ЗначВход = Неопределено Или ЗначВход = Null Тогда Возврат ""; КонецЕсли;
		Возврат СокрЛП(Строка(ЗначВход));
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ДатаВИСО(Дата1С)
	Попытка
		Если Не ЗначениеЗаполнено(Дата1С) Тогда Возврат ""; КонецЕсли;
		Возврат Формат(Дата1С, "ДФ=yyyy-MM-ddTHH:mm:ss");
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция УИН(Ссылка)
	Попытка
		Если Не ЗначениеЗаполнено(Ссылка) Тогда Возврат ""; КонецЕсли;
		Возврат XMLСтрока(Ссылка);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция СтавкаНДСВСтроку(СтавкаНДС1С)
	Если Не ЗначениеЗаполнено(СтавкаНДС1С) Тогда Возврат "20%"; КонецЕсли;
	СтрВход = Строка(СтавкаНДС1С);
	Если Найти(СтрВход, "18") > 0 Тогда Возврат "18%";
	ИначеЕсли Найти(СтрВход, "20") > 0 Тогда Возврат "20%";
	ИначеЕсли Найти(СтрВход, "10") > 0 Тогда Возврат "10%";
	ИначеЕсли Найти(СтрВход, "0") > 0 И Найти(СтрВход, "Без") = 0 Тогда Возврат "0%";
	ИначеЕсли Найти(СтрВход, "Без") > 0 Тогда Возврат "Без НДС";
	КонецЕсли;
	Возврат "20%";
КонецФункции

// --- СПРАВОЧНИКИ ---

Функция ВыгрузитьОрганизации()
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Код, Наименование, НаименованиеПолное, ИНН, КПП ИЗ Справочник.Организации");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элм = Новый Структура("id,code,name,nameFull,inn,kpp", 
			УИН(Выборка.Ссылка), Стр(Выборка.Код), Стр(Выборка.Наименование), Стр(Выборка.НаименованиеПолное), Стр(Выборка.ИНН), Стр(Выборка.КПП));
		Массив.Добавить(Элм);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ВыгрузитьКонтрагенты()
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Код, Наименование, НаименованиеПолное, ИНН, КПП, Покупатель, Поставщик, ЭтоГруппа, Родитель ИЗ Справочник.Контрагенты");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элм = Новый Структура("id,code,name,nameFull,inn,kpp,isCustomer,isVendor,isFolder,parentId",
			УИН(Выборка.Ссылка), Стр(Выборка.Код), Стр(Выборка.Наименование), Стр(Выборка.НаименованиеПолное), Стр(Выборка.ИНН), Стр(Выборка.КПП),
			Бул(Выборка.Покупатель), Бул(Выборка.Поставщик), Бул(Выборка.ЭтоГруппа), УИН(Выборка.Родитель));
		Массив.Добавить(Элм);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ВыгрузитьНоменклатуру()
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Код, Наименование, Артикул, ЕдиницаХраненияОстатков.Наименование КАК ЕдиницаИзмерения, СтавкаНДС, ЭтоГруппа, Родитель, Услуга ИЗ Справочник.Номенклатура");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элм = Новый Структура("id,code,name,article,unit,vatRate,isService,isFolder,parentId",
			УИН(Выборка.Ссылка), Стр(Выборка.Код), Стр(Выборка.Наименование), Стр(Выборка.Артикул),
			?(ЗначениеЗаполнено(Выборка.ЕдиницаИзмерения), Стр(Выборка.ЕдиницаИзмерения), "шт"),
			СтавкаНДСВСтроку(Выборка.СтавкаНДС), Бул(Выборка.Услуга), Бул(Выборка.ЭтоГруппа), УИН(Выборка.Родитель));
		Массив.Добавить(Элм);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ВыгрузитьСклады()
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Код, Наименование, ВидСклада ИЗ Справочник.Склады");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элм = Новый Структура("id,code,name,type", УИН(Выборка.Ссылка), Стр(Выборка.Код), Стр(Выборка.Наименование), Стр(Выборка.ВидСклада));
		Массив.Добавить(Элм);
	КонецЦикла;
	Возврат Массив;
КонецФункции

// --- ДОКУМЕНТЫ ---

Функция ВыгрузитьТабличныеТовары(ОбъектДок, СкладШапки)
	ТЧ = Новый Массив;
	Для Каждого СтрТЧ Из ОбъектДок.Товары Цикл
		СтрокаЭлм = Новый Структура("nomenclatureId,quantity,price,total,vatRate,vatAmount",
			УИН(СтрТЧ.Номенклатура), Чис(СтрТЧ.Количество), Чис(СтрТЧ.Цена), Чис(СтрТЧ.Сумма),
			СтавкаНДСВСтроку(СтрТЧ.СтавкаНДС), Чис(СтрТЧ.СуммаНДС));
		Попытка
			Если ЗначениеЗаполнено(СтрТЧ.Склад) Тогда
				СтрокаЭлм.Вставить("warehouseId", УИН(СтрТЧ.Склад));
			КонецЕсли;
		Исключение КонецПопытки;
		ТЧ.Добавить(СтрокаЭлм);
	КонецЦикла;
	Возврат ТЧ;
КонецФункции

Функция ВыгрузитьПоступленияТоваров()
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Номер, Дата, Организация, Контрагент, СкладОрдер КАК Склад, ДоговорКонтрагента.Наименование КАК Договор, СуммаДокумента, СуммаВключаетНДС, Комментарий ИЗ Документ.ПоступлениеТоваровУслуг ГДЕ Проведен = ИСТИНА УПОРЯДОЧИТЬ ПО Дата ВОЗР");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Новый Структура("id,number,date,organizationId,counterpartyId,contract,amountTotal,vatIncluded,comment,warehouseId,items",
			УИН(Выборка.Ссылка), Стр(Выборка.Номер), ДатаВИСО(Выборка.Дата), УИН(Выборка.Организация), УИН(Выборка.Контрагент),
			Стр(Выборка.Договор), Чис(Выборка.СуммаДокумента), Бул(Выборка.СуммаВключаетНДС), Стр(Выборка.Комментарий),
			УИН(Выборка.Склад), ВыгрузитьТабличныеТовары(Выборка.Ссылка.ПолучитьОбъект(), УИН(Выборка.Склад)));
		Массив.Добавить(Док);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ВыгрузитьРеализацииТоваров()
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Номер, Дата, Организация, Контрагент, Склад, ДоговорКонтрагента.Наименование КАК Договор, СуммаДокумента, СуммаВключаетНДС, Комментарий ИЗ Документ.РеализацияТоваровУслуг ГДЕ Проведен = ИСТИНА УПОРЯДОЧИТЬ ПО Дата ВОЗР");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Новый Структура("id,number,date,organizationId,counterpartyId,contract,amountTotal,vatIncluded,comment,warehouseId,items",
			УИН(Выборка.Ссылка), Стр(Выборка.Номер), ДатаВИСО(Выборка.Дата), УИН(Выборка.Организация), УИН(Выборка.Контрагент),
			Стр(Выборка.Договор), Чис(Выборка.СуммаДокумента), Бул(Выборка.СуммаВключаетНДС), Стр(Выборка.Комментарий),
			УИН(Выборка.Склад), ВыгрузитьТабличныеТовары(Выборка.Ссылка.ПолучитьОбъект(), УИН(Выборка.Склад)));
		Массив.Добавить(Док);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ВыгрузитьПлатежи(ИмяДокумента, ВидДДС)
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Номер, Дата, Организация, Контрагент, СтатьяДвиженияДенежныхСредств КАК СтатьяДДС, СуммаДокумента, ВидОперации, Комментарий ИЗ Документ." + ИмяДокумента + " ГДЕ Проведен = ИСТИНА УПОРЯДОЧИТЬ ПО Дата ВОЗР");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Новый Структура("id,number,date,organizationId,counterpartyId,cashFlowItemId,amountTotal,operationType,comment",
			УИН(Выборка.Ссылка), Стр(Выборка.Номер), ДатаВИСО(Выборка.Дата), УИН(Выборка.Организация), УИН(Выборка.Контрагент),
			УИН(Выборка.СтатьяДДС), Чис(Выборка.СуммаДокумента), XMLСтрока(Выборка.ВидОперации), Стр(Выборка.Комментарий));
		Массив.Добавить(Док);
	КонецЦикла;
	Возврат Массив;
КонецФункции

// --- ОСНОВНОЙ ПРОЦЕСС ---

Процедура КнопкаВыполнитьНажатие(Кнопка)
	Если ПустаяСтрока(КаталогВыгрузки) Тогда
		Предупреждение("Укажите каталог для выгрузки файлов!");
		Возврат;
	КонецЕсли;

	Каталог = СокрЛП(КаталогВыгрузки);
	Если Прав(Каталог, 1) <> "\" И Прав(Каталог, 1) <> "/" Тогда Каталог = Каталог + "\"; КонецЕсли;

	Сообщить("Сбор данных из 1С:УТ 10.3...");
	
	Справочники = Новый Структура;
	Справочники.Вставить("Организации", ВыгрузитьОрганизации());
	Справочники.Вставить("Контрагенты", ВыгрузитьКонтрагенты());
	Справочники.Вставить("Номенклатура", ВыгрузитьНоменклатуру());
	Справочники.Вставить("Склады", ВыгрузитьСклады());

	Документы = Новый Структура;
	Документы.Вставить("ПоступлениеТоваровУслуг", ВыгрузитьПоступленияТоваров());
	Документы.Вставить("РеализацияТоваровУслуг", ВыгрузитьРеализацииТоваров());
	Документы.Вставить("ПриходныйКассовыйОрдер", ВыгрузитьПлатежи("ПриходныйКассовыйОрдер", "Касса"));
	Документы.Вставить("РасходныйКассовыйОрдер", ВыгрузитьПлатежи("РасходныйКассовыйОрдер", "Касса"));
	Документы.Вставить("ПлатежноеПоручениеВходящее", ВыгрузитьПлатежи("ПлатежноеПоручениеВходящее", "Банк"));
	Документы.Вставить("ПлатежноеПоручениеИсходящее", ВыгрузитьПлатежи("ПлатежноеПоручениеИсходящее", "Банк"));

	Дамп = Новый Структура;
	Дамп.Вставить("version", "1.0");
	Дамп.Вставить("source", "УТ10");
	Дамп.Вставить("sourceVersion", "10.3");
	Дамп.Вставить("exported", ДатаВИСО(ТекущаяДата()));
	Дамп.Вставить("catalogs", Справочники);
	Дамп.Вставить("documents", Документы);

	ФайлДампа = Каталог + "ut10_dump.json";
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьФайл(ФайлДампа,,, Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
	ЗаписатьJSON(ЗаписьJSON, Дамп);
	ЗаписьJSON.Закрыть();

	Сообщить("УСПЕХ! Данные выгружены в файл: " + ФайлДампа);
	Предупреждение("Выгрузка успешно завершена в: " + ФайлДампа);
КонецПроцедуры

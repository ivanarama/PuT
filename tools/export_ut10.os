Функция ВыгрузитьКонтрольныеПродажиСебестоимость()
	Массив = Новый Массив;
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Период,
	|	Регистратор КАК Документ,
	|	Регистратор.Номер КАК НомерДокумента,
	|	Регистратор.Организация КАК Организация,
	|	Номенклатура,
	|	СУММА(Количество) КАК КоличествоТовара,
	|	СУММА(Выручка) КАК Выручка,
	|	СУММА(НДС) КАК НДС,
	|	СУММА(Себестоимость) КАК Себестоимость
	|ИЗ
	|(
	|	ВЫБРАТЬ
	|		Период,
	|		Регистратор,
	|		Номенклатура,
	|		Количество,
	|		Стоимость КАК Выручка,
	|		НДС,
	|		0 КАК Себестоимость
	|	ИЗ
	|		РегистрНакопления.Продажи
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Период,
	|		Регистратор,
	|		Номенклатура,
	|		0 КАК Количество,
	|		0 КАК Выручка,
	|		0 КАК НДС,
	|		Стоимость КАК Себестоимость
	|	ИЗ
	|		РегистрНакопления.ПродажиСебестоимость
	|) КАК ВложенныйЗапрос
	|СГРУППИРОВАТЬ ПО
	|	Период,
	|	Регистратор,
	|	Регистратор.Номер,
	|	Регистратор.Организация,
	|	Номенклатура
	|УПОРЯДОЧИТЬ ПО
	|	Период ВОЗР";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("period", ДатаВИСО(Выборка.Период));
		Запись.Вставить("docNumber", Стр(Выборка.НомерДокумента));
		Запись.Вставить("docId", УИН(Выборка.Документ));
		Запись.Вставить("organizationId", УИН(Выборка.Организация));
		Попытка
			Запись.Вставить("organizationCode", Стр(Выборка.Организация.Код));
			Запись.Вставить("organizationName", Стр(Выборка.Организация.Наименование));
		Исключение
			Запись.Вставить("organizationCode", "");
			Запись.Вставить("organizationName", "");
		КонецПопытки;
		Запись.Вставить("nomenclatureId", УИН(Выборка.Номенклатура));
		Попытка
			Запись.Вставить("nomenclatureCode", Стр(Выборка.Номенклатура.Код));
			Запись.Вставить("nomenclatureName", Стр(Выборка.Номенклатура.Наименование));
		Исключение
			Запись.Вставить("nomenclatureCode", "");
			Запись.Вставить("nomenclatureName", "");
		КонецПопытки;
		Запись.Вставить("quantity", Чис(Выборка.КоличествоТовара));
		Запись.Вставить("cost", Чис(Выборка.Себестоимость));
		Запись.Вставить("revenue", Чис(Выборка.Выручка));
		Запись.Вставить("vat", Чис(Выборка.НДС));
		Массив.Добавить(Запись);
	КонецЦикла;
	Возврат Массив;
КонецФункции


					СкладДок = УИН(СтрТЧ.Склад);
				КонецЕсли;
			Исключение
			КонецПопытки;
			ТЧ.Добавить(СтрокаЭлм);
		КонецЦикла;
		Док.Вставить("warehouseId", СкладДок);
		Док.Вставить("items", ТЧ);
		Массив.Добавить(Док);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ВыгрузитьПлатежи(ИмяДокумента, ВидДДС)
	Массив = Новый Массив;
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	Организация,
	|	Контрагент,
	|	СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
	|	СуммаДокумента,
	|	ВидОперации,
	|	Комментарий
	|ИЗ
	|	Документ." + ИмяДокумента + "
	|ГДЕ
	|	Проведен = ИСТИНА
	|УПОРЯДОЧИТЬ ПО
	|	Дата ВОЗР";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Новый Структура;
		Док.Вставить("id", УИН(Выборка.Ссылка));
		Док.Вставить("number", Стр(Выборка.Номер));
		Док.Вставить("date", ДатаВИСО(Выборка.Дата));
		Док.Вставить("organizationId", УИН(Выборка.Организация));
		Док.Вставить("counterpartyId", УИН(Выборка.Контрагент));
		Док.Вставить("cashFlowItemId", УИН(Выборка.СтатьяДДС));
		Док.Вставить("amountTotal", Чис(Выборка.СуммаДокумента));
		Док.Вставить("operationType", ПеречислениеВСтроку(Выборка.ВидОперации));
		Док.Вставить("comment", Стр(Выборка.Комментарий));
		Массив.Добавить(Док);
	КонецЦикла;
	Возврат Массив;
КонецФункции


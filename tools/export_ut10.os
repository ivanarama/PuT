// Экспортёр данных из 1С:Управление торговлей 10.3 в формат обмена OneBase (PuT)
// Выгружает нормативно-справочную информацию, документы и контрольные регистры (ПродажиСебестоимость, Взаиморасчеты)

Перем База1С;

Функция ПолучитьПараметр(МассивАрг, ИмяПарам, ЗначениеПоУмолчанию)
	Для Индекс = 0 По МассивАрг.Количество() - 1 Цикл
		Стр = МассивАрг[Индекс];
		Если НРег(Стр) = НРег(ИмяПарам) И Индекс + 1 < МассивАрг.Количество() Тогда
			Возврат МассивАрг[Индекс + 1];
		КонецЕсли;
	КонецЦикла;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция Чис(ЗначВход)
	Попытка
		Если ЗначВход = Неопределено Или ЗначВход = Null Тогда
			Возврат 0;
		КонецЕсли;
		Возврат Число(ЗначВход);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция Бул(ЗначВход)
	Попытка
		Если ЗначВход = Неопределено Или ЗначВход = Null Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат ?(ЗначВход = Истина Или ЗначВход = 1 Или Строка(ЗначВход) = "Да" Или Строка(ЗначВход) = "Истина" Или Строка(ЗначВход) = "True", Истина, Ложь);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция Стр(ЗначВход)
	Попытка
		Если ЗначВход = Неопределено Или ЗначВход = Null Тогда
			Возврат "";
		КонецЕсли;
		Возврат СокрЛП(Строка(ЗначВход));
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ДатаВИСО(Дата1С)
	Попытка
		Если Дата1С = Неопределено Или Дата1С = Null Тогда
			Возврат "";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Дата1С) Тогда
			Возврат "";
		КонецЕсли;
		Возврат Формат(Дата1С, "ДФ=yyyy-MM-ddTHH:mm:ss");
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция УИН(Ссылка)
	Попытка
		Если Ссылка = Неопределено Или Ссылка = Null Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(База1С.XMLСтрока(Ссылка));
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция СтавкаНДСВСтроку(СтавкаНДС1С)
	Если СтавкаНДС1С = Неопределено Или СтавкаНДС1С = Null Тогда
		Возврат "20%";
	КонецЕсли;
	СтрВход = Строка(СтавкаНДС1С);
	Если Найти(СтрВход, "18") > 0 Тогда
		Возврат "18%";
	ИначеЕсли Найти(СтрВход, "20") > 0 Тогда
		Возврат "20%";
	ИначеЕсли Найти(СтрВход, "10") > 0 Тогда
		Возврат "10%";
	ИначеЕсли Найти(СтрВход, "0") > 0 И Найти(СтрВход, "Без") = 0 Тогда
		Возврат "0%";
	ИначеЕсли Найти(СтрВход, "Без") > 0 Тогда
		Возврат "Без НДС";
	КонецЕсли;
	Возврат "20%";
КонецФункции

Функция ПеречислениеВСтроку(Знач1С)
	Попытка
		Если Знач1С = Неопределено Или Знач1С = Null Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(База1С.XMLСтрока(Знач1С));
	Исключение
		Возврат Стр(Знач1С);
	КонецПопытки;
КонецФункции

// -------------------------------------------------------------
// ВЫГРУЗКА СПРАВОЧНИКОВ
// -------------------------------------------------------------

Функция ВыгрузитьОрганизации()
	Массив = Новый Массив;
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	Код,
	|	Наименование,
	|	НаименованиеПолное,
	|	ИНН,
	|	КПП
	|ИЗ
	|	Справочник.Организации";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элм = Новый Структура;
		Элм.Вставить("id", УИН(Выборка.Ссылка));
		Элм.Вставить("code", Стр(Выборка.Код));
		Элм.Вставить("name", Стр(Выборка.Наименование));
		Элм.Вставить("nameFull", Стр(Выборка.НаименованиеПолное));
		Элм.Вставить("inn", Стр(Выборка.ИНН));
		Элм.Вставить("kpp", Стр(Выборка.КПП));
		Массив.Добавить(Элм);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ВыгрузитьКонтрагенты()
	Массив = Новый Массив;
	Запрос = База1С.NewObject("Запрос");

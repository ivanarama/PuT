	|	ИНН,
	|	КПП,
	|	Покупатель,
	|	Поставщик,
	|	ЭтоГруппа,
	|	Родитель
	|ИЗ
	|	Справочник.Контрагенты";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элм = Новый Структура;
		Элм.Вставить("id", УИН(Выборка.Ссылка));
		Элм.Вставить("code", Стр(Выборка.Код));
		Элм.Вставить("name", Стр(Выборка.Наименование));
		Элм.Вставить("nameFull", Стр(Выборка.НаименованиеПолное));
		Элм.Вставить("inn", Стр(Выборка.ИНН));
		Элм.Вставить("kpp", Стр(Выборка.КПП));
		Элм.Вставить("isCustomer", Бул(Выборка.Покупатель));
		Элм.Вставить("isVendor", Бул(Выборка.Поставщик));
		Элм.Вставить("isFolder", Бул(Выборка.ЭтоГруппа));
		Элм.Вставить("parentId", УИН(Выборка.Родитель));
		Массив.Добавить(Элм);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ВыгрузитьНоменклатуру()
	Массив = Новый Массив;
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	Код,
	|	Наименование,
	|	Артикул,
	|	ЕдиницаХраненияОстатков.Наименование КАК ЕдиницаИзмерения,
	|	СтавкаНДС,
	|	ЭтоГруппа,
	|	Родитель,
	|	Услуга
	|ИЗ
	|	Справочник.Номенклатура";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элм = Новый Структура;
		Элм.Вставить("id", УИН(Выборка.Ссылка));
		Элм.Вставить("code", Стр(Выборка.Код));
		Элм.Вставить("name", Стр(Выборка.Наименование));
		Элм.Вставить("article", Стр(Выборка.Артикул));
		Элм.Вставить("unit", ?(ЗначениеЗаполнено(Выборка.ЕдиницаИзмерения), Стр(Выборка.ЕдиницаИзмерения), "шт"));
		Элм.Вставить("vatRate", СтавкаНДСВСтроку(Выборка.СтавкаНДС));
		Элм.Вставить("isService", Бул(Выборка.Услуга));
		Элм.Вставить("isFolder", Бул(Выборка.ЭтоГруппа));
		Элм.Вставить("parentId", УИН(Выборка.Родитель));
		Массив.Добавить(Элм);
	КонецЦикла;
	Возврат Массив;
КонецФункции


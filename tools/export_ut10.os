Функция ВыгрузитьКомплектации()
	Массив = Новый Массив;
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	Организация,
	|	Склад,
	|	Номенклатура КАК Комплект,
	|	Количество,
	|	ВидОперации,
	|	Комментарий
	|ИЗ
	|	Документ.КомплектацияНоменклатуры
	|ГДЕ
	|	Проведен = ИСТИНА

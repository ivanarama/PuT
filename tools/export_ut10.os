		Запись.Вставить("counterpartyId", УИН(Выборка.Контрагент));
		Попытка
			Запись.Вставить("counterpartyName", Стр(Выборка.Контрагент.Наименование));
		Исключение
			Запись.Вставить("counterpartyName", "");
		КонецПопытки;
		Запись.Вставить("recordType", ?(Выборка.ВидДвижения = База1С.ВидДвиженияНакопления.Приход, "Приход", "Расход"));
		Запись.Вставить("amount", Чис(Выборка.СуммаВзаиморасчетов));
		Массив.Добавить(Запись);
	КонецЦикла;
	Возврат Массив;
КонецФункции

// -------------------------------------------------------------
// ГЛАВНЫЙ БЛОК ИСПОЛНЕНИЯ
// -------------------------------------------------------------

Попытка
	ПутьБазы = ПолучитьПараметр(АргументыКоманднойСтроки, "--base", "C:\1c-bases\УТДемо_10_3_70_4");
	ИмяПользователя = ПолучитьПараметр(АргументыКоманднойСтроки, "--user", "Федоров (администратор)");
	Пароль = ПолучитьПараметр(АргументыКоманднойСтроки, "--pass", "");
	ФайлДампа = ПолучитьПараметр(АргументыКоманднойСтроки, "--out", "C:\Projects\OneBaseConfs\temp\data\ut10_dump.json");
	ФайлКонтроля = ПолучитьПараметр(АргументыКоманднойСтроки, "--golden", "C:\Projects\OneBaseConfs\temp\data\ut10_golden.json");

	Сообщить("Подключение к 1С: " + ПутьБазы + " (пользователь: " + ИмяПользователя + ")...");
	Соединитель = Новый COMОбъект("V83.COMConnector");
	База1С = Соединитель.Connect("File=""" + ПутьБазы + """;Usr=""" + ИмяПользователя + """;Pwd=""" + Пароль + """;");
	Сообщить("Подключение к 1С установлено успешно.");

	Сообщить("1. Сбор справочников...");
	Справочники = Новый Структура;
	Справочники.Вставить("Организации", ВыгрузитьОрганизации());
	Справочники.Вставить("Контрагенты", ВыгрузитьКонтрагенты());
	Справочники.Вставить("Номенклатура", ВыгрузитьНоменклатуру());
	Справочники.Вставить("Склады", ВыгрузитьСклады());
	Справочники.Вставить("СтатьиДДС", ВыгрузитьСтатьиДДС());
	Справочники.Вставить("ТипыЦен", ВыгрузитьТипыЦен());

	Сообщить("2. Сбор документов...");
	Документы = Новый Структура;
	Документы.Вставить("ПоступлениеТоваровУслуг", ВыгрузитьПоступленияТоваров());
	Документы.Вставить("РеализацияТоваровУслуг", ВыгрузитьРеализацииТоваров());
	Документы.Вставить("ВозвратТоваровПоставщику", ВыгрузитьВозвратыПоставщику());
	Документы.Вставить("ВозвратТоваровОтПокупателя", ВыгрузитьВозвратыОтПокупателя());
	Документы.Вставить("ПеремещениеТоваров", ВыгрузитьПеремещенияТоваров());
	Документы.Вставить("СписаниеТоваров", ВыгрузитьСписанияТоваров());
	Документы.Вставить("ОприходованиеТоваров", ВыгрузитьОприходованияТоваров());
	Документы.Вставить("КомплектацияНоменклатуры", ВыгрузитьКомплектации());
	Документы.Вставить("ПриходныйКассовыйОрдер", ВыгрузитьПлатежи("ПриходныйКассовыйОрдер", "Касса"));
	Документы.Вставить("РасходныйКассовыйОрдер", ВыгрузитьПлатежи("РасходныйКассовыйОрдер", "Касса"));
	Документы.Вставить("ПлатежноеПоручениеВходящее", ВыгрузитьПлатежи("ПлатежноеПоручениеВходящее", "Банк"));
	Документы.Вставить("ПлатежноеПоручениеИсходящее", ВыгрузитьПлатежи("ПлатежноеПоручениеИсходящее", "Банк"));

	Дамп = Новый Структура;
	Дамп.Вставить("version", "1.0");
	Дамп.Вставить("source", "УТ10");
	Дамп.Вставить("sourceVersion", "10.3.70.4");
	Дамп.Вставить("exported", ДатаВИСО(ТекущаяДата()));
	Дамп.Вставить("catalogs", Справочники);
	Дамп.Вставить("documents", Документы);

	Сообщить("Запись дампа: " + ФайлДампа + "...");
	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
	ЗаписьJSON.ОткрытьФайл(ФайлДампа,,, ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON, Дамп);
	ЗаписьJSON.Закрыть();
	Сообщить("Дамп успешно записан!");

	Сообщить("3. Сбор контрольных данных (Golden dataset)...");
	Контроль = Новый Структура;
	Контроль.Вставить("source", "УТ10");
	Контроль.Вставить("exported", ДатаВИСО(ТекущаяДата()));
	Контроль.Вставить("ПродажиСебестоимость", ВыгрузитьКонтрольныеПродажиСебестоимость());
	Контроль.Вставить("Взаиморасчеты", ВыгрузитьКонтрольныеВзаиморасчеты());

	Сообщить("Запись контрольных данных: " + ФайлКонтроля + "...");
	ЗаписьКонтроля = Новый ЗаписьJSON;
	ЗаписьКонтроля.ОткрытьФайл(ФайлКонтроля,,, ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьКонтроля, Контроль);
	ЗаписьКонтроля.Закрыть();
	Сообщить("Контрольные данные успешно записаны!");
Исключение
	Сообщить("КРИТИЧЕСКАЯ ОШИБКА В ЭКСПОРТЕРЕ: " + ОписаниеОшибки());
КонецПопытки;

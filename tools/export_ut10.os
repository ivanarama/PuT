Функция ВыгрузитьВозвратыПоставщику()
	Массив = Новый Массив;
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	Организация,
	|	Контрагент,
	|	Склад,
	|	СуммаДокумента,
	|	СуммаВключаетНДС,
	|	Комментарий
	|ИЗ
	|	Документ.ВозвратТоваровПоставщику
	|ГДЕ
	|	Проведен = ИСТИНА
	|УПОРЯДОЧИТЬ ПО
	|	Дата ВОЗР";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Док = Новый Структура;
		Док.Вставить("id", УИН(Выборка.Ссылка));
		Док.Вставить("number", Стр(Выборка.Номер));
		Док.Вставить("date", ДатаВИСО(Выборка.Дата));
		Док.Вставить("organizationId", УИН(Выборка.Организация));
		Док.Вставить("counterpartyId", УИН(Выборка.Контрагент));
		Док.Вставить("amountTotal", Чис(Выборка.СуммаДокумента));
		Док.Вставить("vatIncluded", Бул(Выборка.СуммаВключаетНДС));
		Док.Вставить("comment", Стр(Выборка.Комментарий));
		
		СкладДок = УИН(Выборка.Склад);
		ТЧ = Новый Массив;
		ОбъектДок = Выборка.Ссылка.ПолучитьОбъект();
		Для Каждого СтрТЧ Из ОбъектДок.Товары Цикл
			СтрокаЭлм = Новый Структура;
			СтрокаЭлм.Вставить("nomenclatureId", УИН(СтрТЧ.Номенклатура));
			СтрокаЭлм.Вставить("quantity", Чис(СтрТЧ.Количество));
			СтрокаЭлм.Вставить("price", Чис(СтрТЧ.Цена));
			СтрокаЭлм.Вставить("total", Чис(СтрТЧ.Сумма));
			СтрокаЭлм.Вставить("vatRate", СтавкаНДСВСтроку(СтрТЧ.СтавкаНДС));
			СтрокаЭлм.Вставить("vatAmount", Чис(СтрТЧ.СуммаНДС));
			Попытка
				Если СкладДок = "" И ЗначениеЗаполнено(СтрТЧ.Склад) Тогда
					СкладДок = УИН(СтрТЧ.Склад);
				КонецЕсли;
			Исключение
			КонецПопытки;
			ТЧ.Добавить(СтрокаЭлм);
		КонецЦикла;
		Док.Вставить("warehouseId", СкладДок);
		Док.Вставить("items", ТЧ);
		Массив.Добавить(Док);
	КонецЦикла;
	Возврат Массив;
КонецФункции


		Док.Вставить("number", Стр(Выборка.Номер));
		Док.Вставить("date", ДатаВИСО(Выборка.Дата));
		Док.Вставить("organizationId", УИН(Выборка.Организация));
		Док.Вставить("setNomenclatureId", УИН(Выборка.Комплект));
		Док.Вставить("quantity", Чис(Выборка.Количество));
		Док.Вставить("operationType", ПеречислениеВСтроку(Выборка.ВидОперации)); // Комплектация / Разборка
		Док.Вставить("comment", Стр(Выборка.Комментарий));
		
		СкладДок = УИН(Выборка.Склад);
		ТЧ = Новый Массив;
		ОбъектДок = Выборка.Ссылка.ПолучитьОбъект();
		Для Каждого СтрТЧ Из ОбъектДок.Комплектующие Цикл
			СтрокаЭлм = Новый Структура;
			СтрокаЭлм.Вставить("nomenclatureId", УИН(СтрТЧ.Номенклатура));
			СтрокаЭлм.Вставить("quantity", Чис(СтрТЧ.Количество));
			СтрокаЭлм.Вставить("costShare", Чис(СтрТЧ.ДоляСтоимости));

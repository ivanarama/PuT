	КонецЦикла;
	
	Возврат Массив;
КонецФункции

Функция ВыгрузитьПлатежныеДокументы(ИмяДокумента1С, ИмяТипаOneBase)
	Массив = Новый Массив;
	
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	Проведен,
	|	ПометкаУдаления,
	|	Организация,
	|	Контрагент,
	|	СуммаДокумента,
	|	ХозяйственнаяОперация
	|ИЗ
	|	Документ." + ИмяДокумента1С + "
	|УПОРЯДОЧИТЬ ПО
	|	Дата ВОЗР";
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	
	ЗапросТЧ = База1С.NewObject("Запрос");
	Попытка
		ЗапросТЧ.Текст = 
		"ВЫБРАТЬ
		|	Ссылка,
		|	НомерСтроки,
		|	СуммаВзаиморасчетов КАК Сумма,
		|	СтатьяДвиженияДенежныхСредств
		|ИЗ
		|	Документ." + ИмяДокумента1С + ".РасшифровкаПлатежа
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка, НомерСтроки";
		ТЗТЧ = ЗапросТЧ.Выполнить().Выгрузить();
	Исключение
		ТЗТЧ = База1С.NewObject("ТаблицаЗначений");
	КонецПопытки;
	
	ТаблицаСтрок = Новый Соответствие;
	Если ТЗТЧ.Колонки.Количество() > 0 Тогда
		Для Каждого СтрТЧ Из ТЗТЧ Цикл
			УинДок = УИН(СтрТЧ.Ссылка);
			МассивСтрок = ТаблицаСтрок.Получить(УинДок);
			Если МассивСтрок = Неопределено Тогда
				МассивСтрок = Новый Массив;
				ТаблицаСтрок.Вставить(УинДок, МассивСтрок);
			КонецЕсли;
			
			СтрокаJSON = Новый Структура;
			СтрокаJSON.Вставить("lineNumber", Чис(СтрТЧ.НомерСтроки));
			СтрокаJSON.Вставить("amount", Чис(СтрТЧ.Сумма));
			СтрокаJSON.Вставить("cashFlowItem", УИН(СтрТЧ.СтатьяДвиженияДенежныхСредств));
			МассивСтрок.Добавить(СтрокаJSON);
		КонецЦикла;
	КонецЕсли;
	
	Пока ВыборкаШапка.Следующий() Цикл
		УинДок = УИН(ВыборкаШапка.Ссылка);
		ДокJSON = Новый Структура;
		ДокJSON.Вставить("type", ИмяТипаOneBase);
		ДокJSON.Вставить("id", УинДок);
		ДокJSON.Вставить("number", Стр(ВыборкаШапка.Номер));
		ДокJSON.Вставить("date", ДатаВИСО(ВыборкаШапка.Дата));
		ДокJSON.Вставить("posted", Бул(ВыборкаШапка.Проведен));
		ДокJSON.Вставить("deletionMark", Бул(ВыборкаШапка.ПометкаУдаления));
		Если Бул(ВыборкаШапка.ПометкаУдаления) Тогда Продолжить; КонецЕсли;
		ДокJSON.Вставить("organization", УИН(ВыборкаШапка.Организация));
		ДокJSON.Вставить("counterparty", УИН(ВыборкаШапка.Контрагент));
		ДокJSON.Вставить("totalAmount", Чис(ВыборкаШапка.СуммаДокумента));
		ДокJSON.Вставить("operationType", ПеречислениеВСтроку(ВыборкаШапка.ХозяйственнаяОперация));
		
		СтрокиДок = ТаблицаСтрок.Получить(УинДок);
		Если СтрокиДок = Неопределено Тогда
			СтрокиДок = Новый Массив;
		КонецЕсли;
		ДокJSON.Вставить("lines", СтрокиДок);
		
		Массив.Добавить(ДокJSON);
	КонецЦикла;
	
	Возврат Массив;
КонецФункции

// -------------------------------------------------------------
// ВЫГРУЗКА КОНТРОЛЬНЫХ ДАННЫХ (GOLDEN DATASET)
// -------------------------------------------------------------

Функция ВыгрузитьКонтрольныеДанныеПродаж()
	Массив = Новый Массив;
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Период,
	|	ПРЕДСТАВЛЕНИЕ(Регистратор) КАК Регистратор,
	|	АналитикаУчетаПоПартнерам.Организация.Наименование КАК Организация,
	|	АналитикаУчетаНоменклатуры.Номенклатура.Наименование КАК Номенклатура,
	|	АналитикаУчетаПоПартнерам.Контрагент.Наименование КАК Контрагент,
	|	Склад.Наименование КАК Склад,
	|	Количество КАК КоличествоТовара,
	|	СуммаВыручки КАК СуммаСНДС,
	|	СуммаВыручкиБезНДС КАК ВыручкаБезНДС,
	|	Стоимость КАК Себестоимость,
	|	СтоимостьБезНДС КАК СебестоимостьБезНДС,
	|	СуммаВыручки - Стоимость КАК ВаловаяПрибыльСНДС,
	|	СуммаВыручкиБезНДС - СтоимостьБезНДС КАК ВаловаяПрибыльБезНДС
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элм = Новый Структура;
		Элм.Вставить("period", ДатаВИСО(Выборка.Период));
		Элм.Вставить("registrator", Стр(Выборка.Регистратор));
		Элм.Вставить("organization", Стр(Выборка.Организация));
		Элм.Вставить("item", Стр(Выборка.Номенклатура));
		Элм.Вставить("counterparty", Стр(Выборка.Контрагент));
		Элм.Вставить("warehouse", Стр(Выборка.Склад));
		Элм.Вставить("quantity", Чис(Выборка.КоличествоТовара));
		Элм.Вставить("amountWithVAT", Чис(Выборка.СуммаСНДС));
		Элм.Вставить("amountNoVAT", Чис(Выборка.ВыручкаБезНДС));
		Элм.Вставить("costWithVAT", Чис(Выборка.Себестоимость));
		Элм.Вставить("costNoVAT", Чис(Выборка.СебестоимостьБезНДС));
		Элм.Вставить("grossProfitWithVAT", Чис(Выборка.ВаловаяПрибыльСНДС));
		Элм.Вставить("grossProfitNoVAT", Чис(Выборка.ВаловаяПрибыльБезНДС));
		Массив.Добавить(Элм);
	КонецЦикла;
	Возврат Массив;
КонецФункции

Функция ВыгрузитьКонтрольныеДанныеВзаиморасчетов()
	Массив = Новый Массив;
	
	// Клиенты
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Период,
	|	ПРЕДСТАВЛЕНИЕ(Регистратор) КАК Регистратор,
	|	АналитикаУчетаПоПартнерам.Организация.Наименование КАК Организация,
	|	АналитикаУчетаПоПартнерам.Контрагент.Наименование КАК Контрагент,
	|	Сумма,
	|	ВидДвижения
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элм = Новый Структура;
		Элм.Вставить("register", "РасчетыСКлиентами");
		Элм.Вставить("period", ДатаВИСО(Выборка.Период));
		Элм.Вставить("registrator", Стр(Выборка.Регистратор));
		Элм.Вставить("organization", Стр(Выборка.Организация));
		Элм.Вставить("counterparty", Стр(Выборка.Контрагент));
		Элм.Вставить("movementType", ?(Найти(Строка(Выборка.ВидДвижения), "Приход") > 0, "Приход", "Расход"));
		Элм.Вставить("amount", Чис(Выборка.Сумма));
		Массив.Добавить(Элм);
	КонецЦикла;
	
	// Поставщики
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Период,
	|	ПРЕДСТАВЛЕНИЕ(Регистратор) КАК Регистратор,
	|	АналитикаУчетаПоПартнерам.Организация.Наименование КАК Организация,
	|	АналитикаУчетаПоПартнерам.Контрагент.Наименование КАК Контрагент,
	|	Сумма,
	|	ВидДвижения
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщиками";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элм = Новый Структура;
		Элм.Вставить("register", "РасчетыСПоставщиками");
		Элм.Вставить("period", ДатаВИСО(Выборка.Период));
		Элм.Вставить("registrator", Стр(Выборка.Регистратор));
		Элм.Вставить("organization", Стр(Выборка.Организация));
		Элм.Вставить("counterparty", Стр(Выборка.Контрагент));
		Элм.Вставить("movementType", ?(Найти(Строка(Выборка.ВидДвижения), "Приход") > 0, "Приход", "Расход"));
		Элм.Вставить("amount", Чис(Выборка.Сумма));
		Массив.Добавить(Элм);
	КонецЦикла;
	
	Возврат Массив;
КонецФункции

// -------------------------------------------------------------
// ТОЧКА ВХОДА
// -------------------------------------------------------------

ПутьКБазе = ПолучитьПараметр(АргументыКоманднойСтроки, "--base", "C:\1c-bases\УТДемо_11_5_25_80");
ИмяПользователя = ПолучитьПараметр(АргументыКоманднойСтроки, "--user", "Администратор (ФедоровБМ)");
Пароль = ПолучитьПараметр(АргументыКоманднойСтроки, "--pass", "");
СтрокаСоединения = ПолучитьПараметр(АргументыКоманднойСтроки, "--conn", "");
ФайлДампа = ПолучитьПараметр(АргументыКоманднойСтроки, "--out", "data/ut11_dump.json");
ФайлКонтроля = ПолучитьПараметр(АргументыКоманднойСтроки, "--golden", "data/ut11_golden.json");

Сообщить("=== ВЫГРУЗКА ДАННЫХ ИЗ 1С:УТ 11 ===");
Если ЗначениеЗаполнено(СтрокаСоединения) Тогда
	// --conn задают целиком, например: --conn 'File="C:\bases\demo";Usr="...";Pwd="..."'
	Сообщить("Подключение по строке из --conn");
Иначе
	Сообщить("База: " + ПутьКБазе);
	Сообщить("Пользователь: " + ИмяПользователя);
КонецЕсли;

Попытка
	Соединитель = Новый COMОбъект("V83.COMConnector");
	Если ЗначениеЗаполнено(СтрокаСоединения) Тогда
		База1С = Соединитель.Connect(СтрокаСоединения);
	Иначе
		СтрокаПодключения = "File=""" + ПутьКБазе + """;Usr=""" + ИмяПользователя + """;Pwd=""" + Пароль + """;";
		База1С = Соединитель.Connect(СтрокаПодключения);
	КонецЕсли;
	Сообщить("Соединение с 1С успешно установлено.");
Исключение
	Сообщить("ОШИБКА подключения к 1С: " + ОписаниеОшибки());
	ЗавершитьРаботу(1);
КонецПопытки;


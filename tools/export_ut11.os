// -------------------------------------------------------------
// ВЫГРУЗКА ДОКУМЕНТОВ
// -------------------------------------------------------------

Функция ВыгрузитьДокументыТорговли(ИмяДокумента1С, ИмяТипаOneBase)
	Массив = Новый Массив;
	
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	Проведен,
	|	ПометкаУдаления,
	|	Организация,
	|	Контрагент,
	|	Склад,
	|	СуммаДокумента,
	|	ЦенаВключаетНДС
	|ИЗ
	|	Документ." + ИмяДокумента1С + "
	|УПОРЯДОЧИТЬ ПО
	|	Дата ВОЗР";
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	
	ЗапросТЧ = База1С.NewObject("Запрос");
	ЗапросТЧ.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	НомерСтроки,
	|	Номенклатура,
	|	Количество КАК КоличествоТовара,
	|	Цена,
	|	Сумма,
	|	СуммаСНДС,
	|	СтавкаНДС,
	|	СуммаНДС,
	|	Склад
	|ИЗ
	|	Документ." + ИмяДокумента1С + ".Товары
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка, НомерСтроки";
	
	ТЗТЧ = ЗапросТЧ.Выполнить().Выгрузить();
	
	ТаблицаСтрок = Новый Соответствие;
	Для Каждого СтрТЧ Из ТЗТЧ Цикл
		УинДок = УИН(СтрТЧ.Ссылка);
		МассивСтрок = ТаблицаСтрок.Получить(УинДок);
		Если МассивСтрок = Неопределено Тогда
			МассивСтрок = Новый Массив;
			ТаблицаСтрок.Вставить(УинДок, МассивСтрок);
		КонецЕсли;
		
		СтрокаJSON = Новый Структура;
		СтрокаJSON.Вставить("lineNumber", Чис(СтрТЧ.НомерСтроки));
		СтрокаJSON.Вставить("item", УИН(СтрТЧ.Номенклатура));
		СтрокаJSON.Вставить("quantity", Чис(СтрТЧ.КоличествоТовара));
		СтрокаJSON.Вставить("price", Чис(СтрТЧ.Цена));
		СтрокаJSON.Вставить("amount", Чис(СтрТЧ.Сумма));
		СтрокаJSON.Вставить("amountWithVAT", ?(Чис(СтрТЧ.СуммаСНДС) <> 0, Чис(СтрТЧ.СуммаСНДС), Чис(СтрТЧ.Сумма)));
		СтрокаJSON.Вставить("vatRate", СтавкаНДСВСтроку(СтрТЧ.СтавкаНДС));
		СтрокаJSON.Вставить("vatAmount", Чис(СтрТЧ.СуммаНДС));
		СтрокаJSON.Вставить("warehouse", УИН(СтрТЧ.Склад));
		
		МассивСтрок.Добавить(СтрокаJSON);
	КонецЦикла;
	
	Пока ВыборкаШапка.Следующий() Цикл
		УинДок = УИН(ВыборкаШапка.Ссылка);
		СтрокиДок = ТаблицаСтрок.Получить(УинДок);
		Если СтрокиДок = Неопределено Тогда
			СтрокиДок = Новый Массив;
		КонецЕсли;
		
		ДокJSON = Новый Структура;
		ДокJSON.Вставить("type", ИмяТипаOneBase);
		ДокJSON.Вставить("id", УинДок);
		ДокJSON.Вставить("number", Стр(ВыборкаШапка.Номер));
		ДокJSON.Вставить("date", ДатаВИСО(ВыборкаШапка.Дата));
		ДокJSON.Вставить("posted", Бул(ВыборкаШапка.Проведен));
		ДокJSON.Вставить("deletionMark", Бул(ВыборкаШапка.ПометкаУдаления));
		Если Бул(ВыборкаШапка.ПометкаУдаления) Тогда Продолжить; КонецЕсли;
		ДокJSON.Вставить("organization", УИН(ВыборкаШапка.Организация));
		ДокJSON.Вставить("counterparty", УИН(ВыборкаШапка.Контрагент));
		СкладДок = УИН(ВыборкаШапка.Склад);
		Если (СкладДок = "00000000-0000-0000-0000-000000000000" Или СкладДок = "") И СтрокиДок.Количество() > 0 Тогда
			Для Каждого СтрТЧ Из СтрокиДок Цикл
				СклСтр = СтрТЧ.warehouse;
				Если СклСтр <> "00000000-0000-0000-0000-000000000000" И СклСтр <> "" Тогда
					СкладДок = СклСтр;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ДокJSON.Вставить("warehouse", СкладДок);
		ДокJSON.Вставить("priceIncludesVAT", Бул(ВыборкаШапка.ЦенаВключаетНДС));
		ДокJSON.Вставить("totalAmount", Чис(ВыборкаШапка.СуммаДокумента));
		ДокJSON.Вставить("lines", СтрокиДок);
		
		Массив.Добавить(ДокJSON);
	КонецЦикла;
	
	Возврат Массив;
КонецФункции

Функция ВыгрузитьПеремещениеТоваров()
	Массив = Новый Массив;
	
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	Проведен,
	|	ПометкаУдаления,
	|	Организация,
	|	СкладОтправитель,
	|	СкладПолучатель
	|ИЗ
	|	Документ.ПеремещениеТоваров
	|УПОРЯДОЧИТЬ ПО
	|	Дата ВОЗР";
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	
	ЗапросТЧ = База1С.NewObject("Запрос");
	ЗапросТЧ.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	НомерСтроки,
	|	Номенклатура,
	|	Количество КАК КоличествоТовара
	|ИЗ
	|	Документ.ПеремещениеТоваров.Товары
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка, НомерСтроки";
	
	ТЗТЧ = ЗапросТЧ.Выполнить().Выгрузить();
	ТаблицаСтрок = Новый Соответствие;
	Для Каждого СтрТЧ Из ТЗТЧ Цикл
		УинДок = УИН(СтрТЧ.Ссылка);
		МассивСтрок = ТаблицаСтрок.Получить(УинДок);
		Если МассивСтрок = Неопределено Тогда
			МассивСтрок = Новый Массив;
			ТаблицаСтрок.Вставить(УинДок, МассивСтрок);
		КонецЕсли;
		
		СтрокаJSON = Новый Структура;
		СтрокаJSON.Вставить("lineNumber", Чис(СтрТЧ.НомерСтроки));
		СтрокаJSON.Вставить("item", УИН(СтрТЧ.Номенклатура));
		СтрокаJSON.Вставить("quantity", Чис(СтрТЧ.КоличествоТовара));
		МассивСтрок.Добавить(СтрокаJSON);
	КонецЦикла;
	
	Пока ВыборкаШапка.Следующий() Цикл
		УинДок = УИН(ВыборкаШапка.Ссылка);
		ДокJSON = Новый Структура;
		ДокJSON.Вставить("type", "ПеремещениеТоваров");
		ДокJSON.Вставить("id", УинДок);
		ДокJSON.Вставить("number", Стр(ВыборкаШапка.Номер));
		ДокJSON.Вставить("date", ДатаВИСО(ВыборкаШапка.Дата));
		ДокJSON.Вставить("posted", Бул(ВыборкаШапка.Проведен));
		ДокJSON.Вставить("deletionMark", Бул(ВыборкаШапка.ПометкаУдаления));
		Если Бул(ВыборкаШапка.ПометкаУдаления) Тогда Продолжить; КонецЕсли;
		ДокJSON.Вставить("organization", УИН(ВыборкаШапка.Организация));
		ДокJSON.Вставить("sourceWarehouse", УИН(ВыборкаШапка.СкладОтправитель));
		ДокJSON.Вставить("targetWarehouse", УИН(ВыборкаШапка.СкладПолучатель));
		
		СтрокиДок = ТаблицаСтрок.Получить(УинДок);
		Если СтрокиДок = Неопределено Тогда
			СтрокиДок = Новый Массив;
		КонецЕсли;
		ДокJSON.Вставить("lines", СтрокиДок);
		
		Массив.Добавить(ДокJSON);
	КонецЦикла;
	
	Возврат Массив;
КонецФункции

Функция ВыгрузитьСборкаТоваров()
	Массив = Новый Массив;
	
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	Проведен,
	|	ПометкаУдаления,
	|	Организация,
	|	Склад,
	|	Номенклатура КАК НоменклатураСборки,
	|	Количество КАК КоличествоСборки,
	|	ХозяйственнаяОперация
	|ИЗ
	|	Документ.СборкаТоваров
	|УПОРЯДОЧИТЬ ПО
	|	Дата ВОЗР";
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	
	ЗапросТЧ = База1С.NewObject("Запрос");
	ЗапросТЧ.Текст = 
	"ВЫБРАТЬ
	|	Ссылка,
	|	НомерСтроки,
	|	Номенклатура,
	|	Количество КАК КоличествоТовара
	|ИЗ
	|	Документ.СборкаТоваров.Товары
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка, НомерСтроки";
	
	ТЗТЧ = ЗапросТЧ.Выполнить().Выгрузить();
	ТаблицаСтрок = Новый Соответствие;
	Для Каждого СтрТЧ Из ТЗТЧ Цикл
		УинДок = УИН(СтрТЧ.Ссылка);
		МассивСтрок = ТаблицаСтрок.Получить(УинДок);
		Если МассивСтрок = Неопределено Тогда
			МассивСтрок = Новый Массив;
			ТаблицаСтрок.Вставить(УинДок, МассивСтрок);
		КонецЕсли;
		
		СтрокаJSON = Новый Структура;
		СтрокаJSON.Вставить("lineNumber", Чис(СтрТЧ.НомерСтроки));
		СтрокаJSON.Вставить("item", УИН(СтрТЧ.Номенклатура));
		СтрокаJSON.Вставить("quantity", Чис(СтрТЧ.КоличествоТовара));
		МассивСтрок.Добавить(СтрокаJSON);
	КонецЦикла;
	
	Пока ВыборкаШапка.Следующий() Цикл
		УинДок = УИН(ВыборкаШапка.Ссылка);
		ХозОп = ПеречислениеВСтроку(ВыборкаШапка.ХозяйственнаяОперация);
		ВидОп = ?(Найти(НРег(ХозОп), "разборка") > 0, "Разборка", "Комплектация");
		
		ДокJSON = Новый Структура;
		ДокJSON.Вставить("type", "КомплектацияНоменклатуры");
		ДокJSON.Вставить("id", УинДок);
		ДокJSON.Вставить("number", Стр(ВыборкаШапка.Номер));
		ДокJSON.Вставить("date", ДатаВИСО(ВыборкаШапка.Дата));
		ДокJSON.Вставить("posted", Бул(ВыборкаШапка.Проведен));
		ДокJSON.Вставить("deletionMark", Бул(ВыборкаШапка.ПометкаУдаления));
		Если Бул(ВыборкаШапка.ПометкаУдаления) Тогда Продолжить; КонецЕсли;
		ДокJSON.Вставить("organization", УИН(ВыборкаШапка.Организация));
		ДокJSON.Вставить("warehouse", УИН(ВыборкаШапка.Склад));
		ДокJSON.Вставить("operationType", ВидОп);
		ДокJSON.Вставить("item", УИН(ВыборкаШапка.НоменклатураСборки));
		ДокJSON.Вставить("quantity", Чис(ВыборкаШапка.КоличествоСборки));
		
		СтрокиДок = ТаблицаСтрок.Получить(УинДок);
		Если СтрокиДок = Неопределено Тогда
			СтрокиДок = Новый Массив;
		КонецЕсли;
		ДокJSON.Вставить("lines", СтрокиДок);
		
		Массив.Добавить(ДокJSON);
	КонецЦикла;
	
	Возврат Массив;
КонецФункции


Функция ВыгрузитьВводОстатков()
	Массив = Новый Массив;
	
	// 1. ВводОстатковТоваров
	Попытка
		Запрос = База1С.NewObject("Запрос");
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Ссылка, Номер, Дата, Проведен, ПометкаУдаления, Организация, Склад, ЦенаВключаетНДС
		|ИЗ
		|	Документ.ВводОстатковТоваров
		|УПОРЯДОЧИТЬ ПО Дата ВОЗР";
		ВыборкаШапка = Запрос.Выполнить().Выбрать();
		
		ЗапросТЧ = База1С.NewObject("Запрос");
		ЗапросТЧ.Текст = 
		"ВЫБРАТЬ
		|	Ссылка, НомерСтроки, Номенклатура, АналитикаУчетаНоменклатуры.Склад КАК Склад, Количество КАК КоличествоТовара,
		|	Цена, Сумма, СуммаСНДС, СтавкаНДС, СуммаНДС
		|ИЗ
		|	Документ.ВводОстатковТоваров.Товары
		|УПОРЯДОЧИТЬ ПО Ссылка, НомерСтроки";
		ТЗТЧ = ЗапросТЧ.Выполнить().Выгрузить();
		
		ТаблицаСтрок = Новый Соответствие;
		Для Каждого СтрТЧ Из ТЗТЧ Цикл
			УинДок = УИН(СтрТЧ.Ссылка);
			МассивСтрок = ТаблицаСтрок.Получить(УинДок);
			Если МассивСтрок = Неопределено Тогда
				МассивСтрок = Новый Массив;
				ТаблицаСтрок.Вставить(УинДок, МассивСтрок);
			КонецЕсли;
			
			СтрокаJSON = Новый Структура;
			СтрокаJSON.Вставить("lineNumber", Чис(СтрТЧ.НомерСтроки));
			СтрокаJSON.Вставить("item", УИН(СтрТЧ.Номенклатура));
			СтрокаJSON.Вставить("quantity", Чис(СтрТЧ.КоличествоТовара));
			СтрокаJSON.Вставить("price", Чис(СтрТЧ.Цена));
			СтрокаJSON.Вставить("amount", Чис(СтрТЧ.Сумма));
			СтрокаJSON.Вставить("amountWithVAT", ?(Чис(СтрТЧ.СуммаСНДС) <> 0, Чис(СтрТЧ.СуммаСНДС), Чис(СтрТЧ.Сумма)));
			СтрокаJSON.Вставить("vatRate", СтавкаНДСВСтроку(СтрТЧ.СтавкаНДС));
			СтрокаJSON.Вставить("vatAmount", Чис(СтрТЧ.СуммаНДС));
			СтрокаJSON.Вставить("warehouse", УИН(СтрТЧ.Склад));
			МассивСтрок.Добавить(СтрокаJSON);
		КонецЦикла;
		
		Пока ВыборкаШапка.Следующий() Цикл
			УинДок = УИН(ВыборкаШапка.Ссылка);
			СтрокиДок = ТаблицаСтрок.Получить(УинДок);
			Если СтрокиДок = Неопределено Тогда СтрокиДок = Новый Массив; КонецЕсли;
			Если СтрокиДок.Количество() = 0 Тогда Продолжить; КонецЕсли;
			
			СкладДок = УИН(ВыборкаШапка.Склад);
			Если (СкладДок = "00000000-0000-0000-0000-000000000000" Или СкладДок = "") И СтрокиДок.Количество() > 0 Тогда
				Для Каждого СтрТЧ Из СтрокиДок Цикл
					СклСтр = СтрТЧ.warehouse;
					Если СклСтр <> "00000000-0000-0000-0000-000000000000" И СклСтр <> "" Тогда
						СкладДок = СклСтр;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			ДокJSON = Новый Структура;
			ДокJSON.Вставить("type", "ОприходованиеТоваров");
			ДокJSON.Вставить("id", УинДок);
			ДокJSON.Вставить("number", Стр(ВыборкаШапка.Номер));
			ДокJSON.Вставить("date", ДатаВИСО(ВыборкаШапка.Дата));
			ДокJSON.Вставить("posted", Бул(ВыборкаШапка.Проведен));
			ДокJSON.Вставить("deletionMark", Бул(ВыборкаШапка.ПометкаУдаления));
			Если Бул(ВыборкаШапка.ПометкаУдаления) Тогда Продолжить; КонецЕсли;
			ДокJSON.Вставить("organization", УИН(ВыборкаШапка.Организация));
			ДокJSON.Вставить("warehouse", СкладДок);
			ДокJSON.Вставить("lines", СтрокиДок);
			Массив.Добавить(ДокJSON);
		КонецЦикла;
	Исключение
		Сообщить("Ошибка при выгрузке ВводОстатковТоваров: " + ОписаниеОшибки());
	КонецПопытки;

	// 2. ВводОстатков (универсальный)
	Попытка
		Запрос2 = База1С.NewObject("Запрос");
		Запрос2.Текст = 
		"ВЫБРАТЬ
		|	Ссылка, Номер, Дата, Проведен, ПометкаУдаления, Организация
		|ИЗ
		|	Документ.ВводОстатков
		|УПОРЯДОЧИТЬ ПО Дата ВОЗР";
		ВыборкаШапка2 = Запрос2.Выполнить().Выбрать();
		
		ЗапросТЧ2 = База1С.NewObject("Запрос");
		ЗапросТЧ2.Текст = 
		"ВЫБРАТЬ
		|	тч.Ссылка, тч.НомерСтроки, тч.Номенклатура,
		|	ВЫРАЗИТЬ(тч.АналитикаУчетаНоменклатуры КАК Справочник.КлючиАналитикиУчетаНоменклатуры).Склад КАК Склад,
		|	тч.Количество КАК КоличествоТовара,
		|	тч.Цена, тч.Сумма, тч.СуммаСНДС, тч.СтавкаНДС, тч.СуммаНДС
		|ИЗ
		|	Документ.ВводОстатков.Товары КАК тч
		|УПОРЯДОЧИТЬ ПО тч.Ссылка, тч.НомерСтроки";
		ТЗТЧ2 = ЗапросТЧ2.Выполнить().Выгрузить();
		
		ТаблицаСтрок2 = Новый Соответствие;
		Для Каждого СтрТЧ Из ТЗТЧ2 Цикл
			УинДок = УИН(СтрТЧ.Ссылка);
			МассивСтрок = ТаблицаСтрок2.Получить(УинДок);
			Если МассивСтрок = Неопределено Тогда
				МассивСтрок = Новый Массив;
				ТаблицаСтрок2.Вставить(УинДок, МассивСтрок);
			КонецЕсли;
			
			СтрокаJSON = Новый Структура;
			СтрокаJSON.Вставить("lineNumber", Чис(СтрТЧ.НомерСтроки));
			СтрокаJSON.Вставить("item", УИН(СтрТЧ.Номенклатура));
			СтрокаJSON.Вставить("quantity", Чис(СтрТЧ.КоличествоТовара));
			СтрокаJSON.Вставить("price", Чис(СтрТЧ.Цена));
			СтрокаJSON.Вставить("amount", Чис(СтрТЧ.Сумма));
			СтрокаJSON.Вставить("amountWithVAT", ?(Чис(СтрТЧ.СуммаСНДС) <> 0, Чис(СтрТЧ.СуммаСНДС), Чис(СтрТЧ.Сумма)));
			СтрокаJSON.Вставить("vatRate", СтавкаНДСВСтроку(СтрТЧ.СтавкаНДС));
			СтрокаJSON.Вставить("vatAmount", Чис(СтрТЧ.СуммаНДС));
			СтрокаJSON.Вставить("warehouse", УИН(СтрТЧ.Склад));
			МассивСтрок.Добавить(СтрокаJSON);
		КонецЦикла;
		
		Пока ВыборкаШапка2.Следующий() Цикл
			УинДок = УИН(ВыборкаШапка2.Ссылка);
			СтрокиДок = ТаблицаСтрок2.Получить(УинДок);
			Если СтрокиДок = Неопределено Тогда СтрокиДок = Новый Массив; КонецЕсли;
			Если СтрокиДок.Количество() = 0 Тогда Продолжить; КонецЕсли;
			
			СкладДок = "";
			Если СтрокиДок.Количество() > 0 Тогда
				Для Каждого СтрТЧ Из СтрокиДок Цикл
					СклСтр = СтрТЧ.warehouse;
					Если СклСтр <> "00000000-0000-0000-0000-000000000000" И СклСтр <> "" Тогда
						СкладДок = СклСтр;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			ДокJSON = Новый Структура;
			ДокJSON.Вставить("type", "ОприходованиеТоваров");
			ДокJSON.Вставить("id", УинДок);
			ДокJSON.Вставить("number", Стр(ВыборкаШапка2.Номер));
			ДокJSON.Вставить("date", ДатаВИСО(ВыборкаШапка2.Дата));
			ДокJSON.Вставить("posted", Бул(ВыборкаШапка2.Проведен));
			ДокJSON.Вставить("deletionMark", Бул(ВыборкаШапка2.ПометкаУдаления));
			Если Бул(ВыборкаШапка2.ПометкаУдаления) Тогда Продолжить; КонецЕсли;
			ДокJSON.Вставить("organization", УИН(ВыборкаШапка2.Организация));
			ДокJSON.Вставить("warehouse", СкладДок);
			ДокJSON.Вставить("lines", СтрокиДок);
			Массив.Добавить(ДокJSON);
		КонецЦикла;
	Исключение
		Сообщить("Ошибка при выгрузке ВводОстатков: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Массив;
КонецФункции

Функция ВыгрузитьОтчетОРозничныхПродажах()
	Массив = Новый Массив;
	
	Запрос = База1С.NewObject("Запрос");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка, Номер, Дата, Проведен, ПометкаУдаления, Организация, Склад, СуммаДокумента, ЦенаВключаетНДС
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах
	|УПОРЯДОЧИТЬ ПО Дата ВОЗР";
	ВыборкаШапка = Запрос.Выполнить().Выбрать();
	
	ЗапросТЧ = База1С.NewObject("Запрос");
	ЗапросТЧ.Текст = 
	"ВЫБРАТЬ
	|	Ссылка, Ссылка.ЦенаВключаетНДС КАК ЦенаВключаетНДС, НомерСтроки, Номенклатура, Количество КАК КоличествоТовара,
	|	Цена, Сумма, СтавкаНДС, СуммаНДС
	|ИЗ
	|	Документ.ОтчетОРозничныхПродажах.Товары
	|УПОРЯДОЧИТЬ ПО Ссылка, НомерСтроки";
	ТЗТЧ = ЗапросТЧ.Выполнить().Выгрузить();
	
	ТаблицаСтрок = Новый Соответствие;
	Для Каждого СтрТЧ Из ТЗТЧ Цикл
		УинДок = УИН(СтрТЧ.Ссылка);
		МассивСтрок = ТаблицаСтрок.Получить(УинДок);
		Если МассивСтрок = Неопределено Тогда
			МассивСтрок = Новый Массив;
			ТаблицаСтрок.Вставить(УинДок, МассивСтрок);
		КонецЕсли;
		
		СтрокаJSON = Новый Структура;
		СтрокаJSON.Вставить("lineNumber", Чис(СтрТЧ.НомерСтроки));
		СтрокаJSON.Вставить("item", УИН(СтрТЧ.Номенклатура));
		СтрокаJSON.Вставить("quantity", Чис(СтрТЧ.КоличествоТовара));
		СтрокаJSON.Вставить("price", Чис(СтрТЧ.Цена));
		СтрокаJSON.Вставить("amount", Чис(СтрТЧ.Сумма));
		СтрокаJSON.Вставить("amountWithVAT", ?(Бул(СтрТЧ.ЦенаВключаетНДС), Чис(СтрТЧ.Сумма), Чис(СтрТЧ.Сумма) + Чис(СтрТЧ.СуммаНДС)));
		СтрокаJSON.Вставить("vatRate", СтавкаНДСВСтроку(СтрТЧ.СтавкаНДС));
		СтрокаJSON.Вставить("vatAmount", Чис(СтрТЧ.СуммаНДС));
		МассивСтрок.Добавить(СтрокаJSON);
	КонецЦикла;
	
	Пока ВыборкаШапка.Следующий() Цикл
		УинДок = УИН(ВыборкаШапка.Ссылка);
		СтрокиДок = ТаблицаСтрок.Получить(УинДок);
		Если СтрокиДок = Неопределено Тогда СтрокиДок = Новый Массив; КонецЕсли;
		
		ДокJSON = Новый Структура;
		ДокJSON.Вставить("type", "РеализацияТоваровУслуг");
		ДокJSON.Вставить("id", УинДок);
		ДокJSON.Вставить("number", Стр(ВыборкаШапка.Номер));
		ДокJSON.Вставить("date", ДатаВИСО(ВыборкаШапка.Дата));
		ДокJSON.Вставить("posted", Бул(ВыборкаШапка.Проведен));
		ДокJSON.Вставить("deletionMark", Бул(ВыборкаШапка.ПометкаУдаления));
		Если Бул(ВыборкаШапка.ПометкаУдаления) Тогда Продолжить; КонецЕсли;
		ДокJSON.Вставить("organization", УИН(ВыборкаШапка.Организация));
		ДокJSON.Вставить("counterparty", "00000000-0000-0000-0000-000000000000");
		ДокJSON.Вставить("warehouse", УИН(ВыборкаШапка.Склад));
		ДокJSON.Вставить("priceIncludesVAT", Бул(ВыборкаШапка.ЦенаВключаетНДС));
		ДокJSON.Вставить("totalAmount", Чис(ВыборкаШапка.СуммаДокумента));
		ДокJSON.Вставить("lines", СтрокиДок);
		Массив.Добавить(ДокJSON);
	КонецЦикла;
	
	Возврат Массив;
КонецФункции


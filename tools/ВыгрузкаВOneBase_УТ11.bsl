// ============================================================================
// ВНЕШНЯЯ ОБРАБОТКА 1С: ВЫГРУЗКА ДАННЫХ ИЗ 1С:УТ 11.5 В ONEBASE (PuT)
// ============================================================================
//
// ИНСТРУКЦИЯ ПО ИСПОЛЬЗОВАНИЮ В 1С:УТ 11.5:
// 1. В Конфигураторе 1С:УТ 11.5: Файл -> Новый -> Внешняя обработка.
// 2. Имя: ВыгрузкаВOneBase_УТ11.
// 3. Создайте управляемую форму. На форме добавьте:
//    - Реквизит «КаталогВыгрузки» (Строка, 250);
//    - Команду «ВыполнитьВыгрузку» (кнопка на форме).
// 4. Вставьте данный код в модуль управляемой формы.
// 5. Сохраните как ВыгрузкаВOneBase_УТ11.epf и открывайте в 1С (Файл -> Открыть).
// ============================================================================

&НаКлиенте
Процедура ВыполнитьВыгрузку(Команда)
	Если ПустаяСтрока(КаталогВыгрузки) Тогда
		ПоказатьПредупреждение(, "Укажите каталог для выгрузки файлов!");
		Возврат;
	КонецЕсли;

	ИмяФайла = ВыгрузитьДанныеНаСервере(КаталогВыгрузки);
	ПоказатьПредупреждение(, "Выгрузка в OneBase успешно завершена!" + Символы.ПС + ИмяФайла);
КонецПроцедуры

&НаСервере
Функция ВыгрузитьДанныеНаСервере(Каталог)
	Каталог = СокрЛП(Каталог);
	Если Прав(Каталог, 1) <> "\" И Прав(Каталог, 1) <> "/" Тогда Каталог = Каталог + "\"; КонецЕсли;

	Справочники = Новый Структура;
	Справочники.Вставить("Организации", ВыгрузитьОрганизацииУТ11());
	Справочники.Вставить("Контрагенты", ВыгрузитьКонтрагентыУТ11());
	Справочники.Вставить("Номенклатура", ВыгрузитьНоменклатуруУТ11());
	Справочники.Вставить("Склады", ВыгрузитьСкладыУТ11());

	Документы = Новый Массив;
	ВыгрузитьДокументыУТ11(Документы);

	Дамп = Новый Структура;
	Дамп.Вставить("version", "1.0");
	Дамп.Вставить("source", "УТ11");
	Дамп.Вставить("sourceVersion", "11.5");
	Дамп.Вставить("exported", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Дамп.Вставить("catalogs", Справочники);
	Дамп.Вставить("documents", Документы);

	ФайлДампа = Каталог + "ut11_dump.json";
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьФайл(ФайлДампа,,, Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
	ЗаписатьJSON(ЗаписьJSON, Дамп);
	ЗаписьJSON.Закрыть();

	Возврат ФайлДампа;
КонецФункции

// --- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ---

&НаСервере
Функция УИН11(Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда Возврат ""; КонецЕсли;
	Возврат XMLСтрока(Ссылка);
КонецФункции

&НаСервере
Функция Стр11(ЗначВход)
	Если ЗначВход = Неопределено Или ЗначВход = Null Тогда Возврат ""; КонецЕсли;
	Возврат СокрЛП(Строка(ЗначВход));
КонецФункции

&НаСервере
Функция Чис11(ЗначВход)
	Если ЗначВход = Неопределено Или ЗначВход = Null Тогда Возврат 0; КонецЕсли;
	Попытка Возврат Число(ЗначВход); Исключение Возврат 0; КонецПопытки;
КонецФункции

&НаСервере
Функция Бул11(ЗначВход)
	Если ЗначВход = Неопределено Или ЗначВход = Null Тогда Возврат Ложь; КонецЕсли;
	Возврат ?(ЗначВход = Истина Или ЗначВход = 1 Или Строка(ЗначВход) = "Да", Истина, Ложь);
КонецФункции

&НаСервере
Функция ДатаВИСО11(Дата1С)
	Если Не ЗначениеЗаполнено(Дата1С) Тогда Возврат ""; КонецЕсли;
	Возврат Формат(Дата1С, "ДФ=yyyy-MM-ddTHH:mm:ss");
КонецФункции

// --- СПРАВОЧНИКИ УТ 11 ---

&НаСервере
Функция ВыгрузитьОрганизацииУТ11()
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Код, Наименование, НаименованиеПолное, ИНН, КПП ИЗ Справочник.Организации");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Новый Структура("id,code,name,nameFull,inn,kpp",
			УИН11(Выборка.Ссылка), Стр11(Выборка.Код), Стр11(Выборка.Наименование), Стр11(Выборка.НаименованиеПолное), Стр11(Выборка.ИНН), Стр11(Выборка.КПП)));
	КонецЦикла;
	Возврат Массив;
КонецФункции

&НаСервере
Функция ВыгрузитьКонтрагентыУТ11()
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Код, Наименование, НаименованиеПолное, ИНН, КПП, Клиент, Поставщик, ЭтоГруппа, Родитель ИЗ Справочник.Контрагенты");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Новый Структура("id,code,name,nameFull,inn,kpp,isCustomer,isVendor,isFolder,parentId",
			УИН11(Выборка.Ссылка), Стр11(Выборка.Код), Стр11(Выборка.Наименование), Стр11(Выборка.НаименованиеПолное), Стр11(Выборка.ИНН), Стр11(Выборка.КПП),
			Бул11(Выборка.Клиент), Бул11(Выборка.Поставщик), Бул11(Выборка.ЭтоГруппа), УИН11(Выборка.Родитель)));
	КонецЦикла;
	Возврат Массив;
КонецФункции

&НаСервере
Функция ВыгрузитьНоменклатуруУТ11()
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Код, Наименование, Артикул, ЕдиницаИзмерения.Наименование КАК Единица, СтавкаНДС, ТипНоменклатуры, ЭтоГруппа, Родитель ИЗ Справочник.Номенклатура");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Новый Структура("id,code,name,article,unit,vatRate,type,isFolder,parentId",
			УИН11(Выборка.Ссылка), Стр11(Выборка.Код), Стр11(Выборка.Наименование), Стр11(Выборка.Артикул),
			?(ЗначениеЗаполнено(Выборка.Единица), Стр11(Выборка.Единица), "шт"),
			Строка(Выборка.СтавкаНДС), XMLСтрока(Выборка.ТипНоменклатуры), Бул11(Выборка.ЭтоГруппа), УИН11(Выборка.Родитель)));
	КонецЦикла;
	Возврат Массив;
КонецФункции

&НаСервере
Функция ВыгрузитьСкладыУТ11()
	Массив = Новый Массив;
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Код, Наименование, ТипСклада ИЗ Справочник.Склады");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Новый Структура("id,code,name,type",
			УИН11(Выборка.Ссылка), Стр11(Выборка.Код), Стр11(Выборка.Наименование), XMLСтрока(Выборка.ТипСклада)));
	КонецЦикла;
	Возврат Массив;
КонецФункции

// --- ДОКУМЕНТЫ УТ 11 ---

&НаСервере
Процедура ВыгрузитьДокументыУТ11(Документы)
	// 1. Приобретения
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Номер, Дата, Организация, Контрагент, Склад, СуммаДокумента, ЦенаВключаетНДС, Проведен ИЗ Документ.ПриобретениеТоваровУслуг ГДЕ Проведен = ИСТИНА УПОРЯДОЧИТЬ ПО Дата ВОЗР");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТЧ = Новый Массив;
		ОбъектДок = Выборка.Ссылка.ПолучитьОбъект();
		Для Каждого СтрТЧ Из ОбъектДок.Товары Цикл
			ТЧ.Добавить(Новый Структура("item,quantity,price,amount,amountWithVAT,vatRate,vatAmount",
				УИН11(СтрТЧ.Номенклатура), Чис11(СтрТЧ.Количество), Чис11(СтрТЧ.Цена), Чис11(СтрТЧ.Сумма), Чис11(СтрТЧ.СуммаСНДС), Строка(СтрТЧ.СтавкаНДС), Чис11(СтрТЧ.СуммаНДС)));
		КонецЦикла;
		Документы.Добавить(Новый Структура("type,id,number,date,organization,counterparty,warehouse,amount,priceIncludesVAT,posted,lines",
			"ПоступлениеТоваровУслуг", УИН11(Выборка.Ссылка), Стр11(Выборка.Номер), ДатаВИСО11(Выборка.Дата), УИН11(Выборка.Организация),
			УИН11(Выборка.Контрагент), УИН11(Выборка.Склад), Чис11(Выборка.СуммаДокумента), Бул11(Выборка.ЦенаВключаетНДС), Истина, ТЧ));
	КонецЦикла;

	// 2. Реализации
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Номер, Дата, Организация, Контрагент, Склад, СуммаДокумента, ЦенаВключаетНДС, Проведен ИЗ Документ.РеализацияТоваровУслуг ГДЕ Проведен = ИСТИНА УПОРЯДОЧИТЬ ПО Дата ВОЗР");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТЧ = Новый Массив;
		ОбъектДок = Выборка.Ссылка.ПолучитьОбъект();
		Для Каждого СтрТЧ Из ОбъектДок.Товары Цикл
			ТЧ.Добавить(Новый Структура("item,quantity,price,amount,amountWithVAT,vatRate,vatAmount",
				УИН11(СтрТЧ.Номенклатура), Чис11(СтрТЧ.Количество), Чис11(СтрТЧ.Цена), Чис11(СтрТЧ.Сумма), Чис11(СтрТЧ.СуммаСНДС), Строка(СтрТЧ.СтавкаНДС), Чис11(СтрТЧ.СуммаНДС)));
		КонецЦикла;
		Документы.Добавить(Новый Структура("type,id,number,date,organization,counterparty,warehouse,amount,priceIncludesVAT,posted,lines",
			"РеализацияТоваровУслуг", УИН11(Выборка.Ссылка), Стр11(Выборка.Номер), ДатаВИСО11(Выборка.Дата), УИН11(Выборка.Организация),
			УИН11(Выборка.Контрагент), УИН11(Выборка.Склад), Чис11(Выборка.СуммаДокумента), Бул11(Выборка.ЦенаВключаетНДС), Истина, ТЧ));
	КонецЦикла;

	// 3. Платежи
	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Номер, Дата, Организация, Контрагент, СуммаДокумента, СтатьяДвиженияДенежныхСредств, ХозяйственнаяОперация ИЗ Документ.ПоступлениеБезналичныхДенежныхСредств ГДЕ Проведен = ИСТИНА");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Документы.Добавить(Новый Структура("type,id,number,date,organization,counterparty,amount,cashFlowItem,operation,posted",
			"ПоступлениеНаРасчетныйСчет", УИН11(Выборка.Ссылка), Стр11(Выборка.Номер), ДатаВИСО11(Выборка.Дата), УИН11(Выборка.Организация),
			УИН11(Выборка.Контрагент), Чис11(Выборка.СуммаДокумента), УИН11(Выборка.СтатьяДвиженияДенежныхСредств), XMLСтрока(Выборка.ХозяйственнаяОперация), Истина));
	КонецЦикла;
КонецПроцедуры

+	"strings"
+	"testing"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/google/uuid"
+)
+
+func TestStagesReportEncodedEntityAndReturnLink(t *testing.T) {
+	s, e, ctx := stagesUIServer(t)
+	id := uuid.New()
+	if err := s.store.Upsert(ctx, e.Name, id, map[string]any{"Наименование": "Проверка возврата", "Состояние": "Черновик"}, e); err != nil {
+		t.Fatal(err)
+	}
+	router := chi.NewRouter()
+	router.Get("/ui/stages/{entity}", s.stagesReport)
+	path := "/ui/stages/" + url.PathEscape(strings.ToLower(e.Name))
+	for _, object := range []string{id.String(), "https://outside.invalid/", "bad-id", ""} {
+		recorder := httptest.NewRecorder()
+		request := httptest.NewRequest(http.MethodGet, path+"?object="+url.QueryEscape(object), nil)
+		router.ServeHTTP(recorder, request)
+		body := recorder.Body.String()
+		if recorder.Code != http.StatusOK || !strings.Contains(body, "Черновик") || strings.Contains(body, `class="empty"`) {
+			t.Fatalf("encoded entity lost its stages: status=%d", recorder.Code)
+		}
+		if object == id.String() {
+			want := `href="/ui/catalog/` + url.PathEscape(e.Name) + "/" + id.String() + `"`
+			if !strings.Contains(body, want) || !strings.Contains(body, "data-ob-stage-return") {
+				t.Fatalf("report does not return to its source object: want %s", want)
+			}
+		} else if strings.Contains(body, "data-ob-stage-return") {
+			t.Fatalf("invalid source became a return URL: %q", object)
+		}
+	}
+	var route strings.Builder
+	if err := tmpl.ExecuteTemplate(&route, "stage-route", map[string]any{
+		"Entity": e, "ID": id.String(), "IsNew": false, "Cfg": s.cfg, "Lang": "ru",
+		"StageRoute": s.buildStageRoute(httptest.NewRequest(http.MethodGet, "/", nil), e, "Черновик"),
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(route.String(), "?object="+id.String()) {
+		t.Fatal("object form did not pass its identity to the stages report")
+	}
+}

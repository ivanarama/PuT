diff --git a/internal/ui/value_table_readonly_test.go b/internal/ui/value_table_readonly_test.go
new file mode 100644
index 00000000..7fcaabd0
--- /dev/null
+++ b/internal/ui/value_table_readonly_test.go
@@ -0,0 +1,66 @@
+package ui
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/go-chi/chi/v5"
+
+	"github.com/ivantit66/onebase/internal/metadata"
+)
+
+func TestValueTableReadonlyPresentationHTTP(t *testing.T) {
+	for _, readonly := range []bool{false, true} {
+		name := "editable"
+		if readonly {
+			name = "readonly"
+		}
+		t.Run(name, func(t *testing.T) {
+			form := managedObjectForm(&metadata.FormElement{
+				Kind: metadata.FormElementTablePart, Name: "History",
+				DataPath: "Форма.History", ReadOnly: readonly,
+				TitleMap: map[string]string{"ru": "Subscription history"},
+			})
+			form.EntityName = "Client"
+			form.Attributes = []*metadata.FormAttribute{{
+				Name: "History", TypeRef: "ValueTable",
+				Columns: []*metadata.FormAttributeColumn{{Name: "Product", TypeRef: "string"}},
+			}}
+			form.Attributes = append(form.Attributes, &metadata.FormAttribute{Name: "Result", TypeRef: "string"})
+			form.Elements = append(form.Elements, &metadata.FormElement{
+				Kind: metadata.FormElementField, Name: "Result", DataPath: "Форма.Result", Multiline: true, ReadOnly: readonly,
+			})
+			entity := &metadata.Entity{Name: "Client", Kind: metadata.KindCatalog,
+				Fields: []metadata.Field{{Name: "Наименование", Type: metadata.FieldTypeString}},
+				Forms:  []*metadata.FormModule{form},
+			}
+			server, _ := newSubmitTestServer(t, []*metadata.Entity{entity})
+			request := reqWithChi(http.MethodGet, "/ui/catalog/Client/new", nil,
+				map[string]string{"kind": "catalog", "entity": "Client"})
+			response := httptest.NewRecorder()
+			router := chi.NewRouter()
+			server.Mount(router)
+			router.ServeHTTP(response, request)
+			if response.Code != http.StatusOK {
+				t.Fatalf("status=%d: %s", response.Code, response.Body.String())
+			}
+			body := response.Body.String()
+			if !strings.Contains(body, `<textarea name="Result"`) {
+				t.Fatal("multiline form-local result must use a textarea")
+			}
+			if got := strings.Count(body, ">Subscription history</h3>"); got != 1 {
+				t.Fatalf("expected one table title, got %d", got)
+			}
+			hasAdd := strings.Contains(body, `data-ob-add-vt="History"`)
+			if hasAdd == readonly {
+				t.Fatalf("add row visible=%v, readonly=%v", hasAdd, readonly)
+			}
+			hasActionColumn := strings.Contains(body, `<th style="width:40px"></th>`)
+			if hasActionColumn == readonly {
+				t.Fatalf("action column visible=%v, readonly=%v", hasActionColumn, readonly)
+			}
+		})
+	}
+}

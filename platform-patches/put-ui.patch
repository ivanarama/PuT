+
+func TestProcessorFormScalarState(t *testing.T) {
+	proc := &processorpkg.Processor{Name: "Импорт"}
+	form := &metadata.FormModule{
+		Attributes: []*metadata.FormAttribute{
+			{Name: "Задача", TypeRef: "string"},
+			{Name: "Скрытое", TypeRef: "string"},
+			{Name: "Результат", TypeRef: "string"},
+		},
+		Elements: []*metadata.FormElement{
+			{Kind: metadata.FormElementField, Name: "Номер", DataPath: "Объект.Задача"},
+			{Kind: metadata.FormElementField, Name: "Вывод", DataPath: "Объект.Результат", ReadOnly: true},
+		},
+	}
+	controls := processorRequestControlsForForm(proc, form)
+	body := url.Values{"Задача": {"from-body"}, "Скрытое": {"forged"}, "Результат": {"forged"}, "posted": {"true"}}
+	req := httptest.NewRequest("POST", "/event?Задача=from-query", strings.NewReader(body.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	if err := req.ParseForm(); err != nil {
+		t.Fatal(err)
+	}
+	obj, err := processorFormObjectFromRequest(req, processorVirtualEntity(proc), form, nil, controls)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if obj.Fields["Задача"] != "from-body" {
+		t.Fatalf("state was lost: %#v", obj.Fields)
+	}
+	for _, name := range []string{"Скрытое", "Результат", "posted"} {
+		if _, ok := obj.Fields[name]; ok {
+			t.Fatalf("accepted forged %s", name)
+		}
+	}
+	req = httptest.NewRequest("POST", "/event?Задача=query-only", nil)
+	req.PostForm = url.Values{}
+	obj, err = processorFormObjectFromRequest(req, processorVirtualEntity(proc), form, nil, controls)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := obj.Fields["Задача"]; ok {
+		t.Fatal("accepted query-only state")
+	}
+}

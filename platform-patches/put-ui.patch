--- /dev/null
+++ b/internal/ui/static_performance_test.go
@@ -0,0 +1,110 @@
+package ui
+
+import (
+	"bytes"
+	"compress/gzip"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/go-chi/chi/v5"
+)
+
+func TestStaticAssetsCompressedOnPublicRoutes(t *testing.T) {
+	r := chi.NewRouter()
+	mountStatic(r)
+	r.Get("/ui/events", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = io.WriteString(w, "data: ready\n\n")
+	})
+	for _, path := range []string{
+		"/static/ui.js", "/static/managed.js", "/static/settings-navigation.js", "/static/query-builder.js",
+		"/vendor/echarts/echarts.min.js", "/vendor/lucide/sprite.svg",
+		"/vendor/slickgrid/slick.grid.js", "/vendor/slickgrid/slick.grid.css",
+	} {
+		t.Run(path, func(t *testing.T) {
+			plain := httptest.NewRecorder()
+			r.ServeHTTP(plain, httptest.NewRequest(http.MethodGet, path, nil))
+			req := httptest.NewRequest(http.MethodGet, path, nil)
+			req.Header.Set("Accept-Encoding", "gzip")
+			compressed := httptest.NewRecorder()
+			r.ServeHTTP(compressed, req)
+			if plain.Code != http.StatusOK || compressed.Code != http.StatusOK {
+				t.Fatalf("plain/gzip status = %d/%d", plain.Code, compressed.Code)
+			}
+			if compressed.Header().Get("Content-Encoding") != "gzip" || !strings.Contains(compressed.Header().Get("Vary"), "Accept-Encoding") {
+				t.Fatalf("missing compression negotiation: %v", compressed.Header())
+			}
+			reader, err := gzip.NewReader(compressed.Body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer reader.Close()
+			body, err := io.ReadAll(reader)
+			if err != nil || !bytes.Equal(body, plain.Body.Bytes()) {
+				t.Fatalf("decoded resource differs: %v", err)
+			}
+			if compressed.Body.Len()*2 >= plain.Body.Len() {
+				t.Fatalf("gzip did not halve the transfer: %d vs %d", compressed.Body.Len(), plain.Body.Len())
+			}
+			if plain.Header().Get("Content-Encoding") != "" {
+				t.Fatal("client without Accept-Encoding received compressed bytes")
+			}
+		})
+	}
+	req := httptest.NewRequest(http.MethodGet, "/ui/events", nil)
+	req.Header.Set("Accept-Encoding", "gzip")
+	response := httptest.NewRecorder()
+	r.ServeHTTP(response, req)
+	if response.Header().Get("Content-Encoding") != "" || response.Body.String() != "data: ready\n\n" {
+		t.Fatal("static compression leaked into SSE")
+	}
+	for _, encoding := range []string{"identity", "gzip;q=0", "gzip;q=0, *;q=1", "br"} {
+		req := httptest.NewRequest(http.MethodGet, "/static/ui.js", nil)
+		req.Header.Set("Accept-Encoding", encoding)
+		response := httptest.NewRecorder()
+		r.ServeHTTP(response, req)
+		if response.Header().Get("Content-Encoding") != "" || !bytes.Equal(response.Body.Bytes(), uiJS) {
+			t.Fatalf("client declining gzip received encoded bytes: %q", encoding)
+		}
+	}
+	req = httptest.NewRequest(http.MethodGet, "/vendor/slickgrid/slick.grid.js", nil)
+	req.Header.Set("Accept-Encoding", "gzip")
+	req.Header.Set("Range", "bytes=0-15")
+	response = httptest.NewRecorder()
+	r.ServeHTTP(response, req)
+	if response.Code != http.StatusPartialContent || response.Body.Len() != 16 || response.Header().Get("Content-Encoding") != "" {
+		t.Fatal("static compression changed a byte range")
+	}
+}
+
+func TestVersionedAppScriptsCacheAndRevalidate(t *testing.T) {
+	r := chi.NewRouter()
+	mountStatic(r)
+	for _, path := range []string{"/static/ui.js", "/static/managed.js", "/static/query-builder.js", "/static/settings-navigation.js"} {
+		plain := httptest.NewRecorder()
+		r.ServeHTTP(plain, httptest.NewRequest(http.MethodGet, path, nil))
+		version := strings.Trim(plain.Header().Get("ETag"), `"`)
+		if version == "" {
+			t.Fatalf("%s: missing content-derived version", path)
+		}
+		for _, suffix := range []string{"?v=" + version, "?v=previous-build", ""} {
+			req := httptest.NewRequest(http.MethodGet, path+suffix, nil)
+			rr := httptest.NewRecorder()
+			r.ServeHTTP(rr, req)
+			immutable := strings.Contains(rr.Header().Get("Cache-Control"), "immutable")
+			if immutable != (suffix == "?v="+version) || !bytes.Equal(rr.Body.Bytes(), plain.Body.Bytes()) {
+				t.Fatalf("%s%s: invalid cache/content contract", path, suffix)
+			}
+			req.Header.Set("If-None-Match", plain.Header().Get("ETag"))
+			req.Header.Set("Accept-Encoding", "gzip")
+			notModified := httptest.NewRecorder()
+			r.ServeHTTP(notModified, req)
+			if notModified.Code != http.StatusNotModified || notModified.Body.Len() != 0 {
+				t.Fatalf("%s%s: revalidation = %d, %d bytes", path, suffix, notModified.Code, notModified.Body.Len())
+			}
+		}
+	}
+}

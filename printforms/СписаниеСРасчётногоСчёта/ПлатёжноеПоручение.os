// Платёжное поручение для СписаниеСРасчётногоСчёта

Функция Сформировать(Документ) Экспорт
    Таб = Новый ТабличныйДокумент;

    Если Макет <> Неопределено Тогда
        Обл = Макет.Область("Заголовок");
        Если ЗначениеЗаполнено(Документ.ДатаПлатёжки) Тогда
            ДатаСтр = Формат(Документ.ДатаПлатёжки, "ДФ=dd.MM.yyyy");
        Иначе
            ДатаСтр = Формат(Документ.Дата, "ДФ=dd.MM.yyyy");
        КонецЕсли;
        НомПл = утилиты.СтрокаИлиПусто(Документ.НомерПлатёжки);
        Если НомПл = "" Тогда
            НомПл = утилиты.СтрокаИлиПусто(Документ.Номер);
        КонецЕсли;
        Обл.Параметры.Заголовок = "Платёжное поручение № " + НомПл + " от " + ДатаСтр;
        Таб.Вывести(Обл);

        Обл = Макет.Область("Шапка");
        Орг = утилиты.СтрокаИлиПусто(Документ.Организация.ПолноеНаименование);
        Если Орг = "" Тогда
            Орг = утилиты.СтрокаИлиПусто(Документ.Организация);
        КонецЕсли;
        Обл.Параметры.Плательщик = "Плательщик: " + Орг;
        Обл.Параметры.СчётПлательщика = "Счёт плательщика: " + утилиты.СтрокаИлиПусто(Документ.БанковскийСчёт.НомерСчёта);
        Обл.Параметры.БанкПлательщика = "Банк плательщика: " + утилиты.СтрокаИлиПусто(Документ.БанковскийСчёт.Банк) + ", БИК " + утилиты.СтрокаИлиПусто(Документ.БанковскийСчёт.БИК);
        
        Получ = утилиты.СтрокаИлиПусто(Документ.Контрагент.ПолноеНаименование);
        Если Получ = "" Тогда
            Получ = утилиты.СтрокаИлиПусто(Документ.Контрагент);
        КонецЕсли;
        Обл.Параметры.Получатель = "Получатель: " + Получ;
        Обл.Параметры.ИННКПППолучателя = "ИНН/КПП: " + утилиты.ФорматИННКПП(Документ.Контрагент.ИНН, Документ.Контрагент.КПП);
        Обл.Параметры.СчётПолучателя = "Счёт получателя: " + утилиты.СтрокаИлиПусто(Документ.Контрагент.РасчётныйСчёт);
        Обл.Параметры.БанкПолучателя = "Банк получателя: " + утилиты.СтрокаИлиПусто(Документ.Контрагент.НаименованиеБанка) + ", БИК " + утилиты.СтрокаИлиПусто(Документ.Контрагент.БИК);
        Обл.Параметры.КоррСчётПолучателя = "Корр. счёт: " + утилиты.СтрокаИлиПусто(Документ.Контрагент.КорреспондентскийСчёт);
        Обл.Параметры.СуммаЧислом = "Сумма: " + Формат(Документ.Сумма, "ЧЦ=15; ЧДЦ=2; ЧГ=0") + " руб.";
        Обл.Параметры.СуммаПрописью = "Сумма прописью: " + утилиты.СуммаПрописью(Документ.Сумма);
        Обл.Параметры.НазначениеПлатежа = "Назначение платежа: " + утилиты.СтрокаИлиПусто(Документ.НазначениеПлатежа);
        Таб.Вывести(Обл);

        Обл = Макет.Область("Подвал");
        Таб.Вывести(Обл);
    КонецЕсли;

    Возврат Таб;
КонецФункции

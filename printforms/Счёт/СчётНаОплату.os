// Счёт на оплату для документа Счёт

Функция СтрП(Значение)
    Если Значение = Неопределено Или ЗначениеЗаполнено(Значение) = Ложь Тогда
        Возврат "";
    КонецЕсли;
    Стр = Строка(Значение);
    Если Стр = "<nil>" Тогда
        Возврат "";
    КонецЕсли;
    Возврат Стр;
КонецФункции

Функция Сформировать(Документ) Экспорт
    Таб = Новый ТабличныйДокумент;

    Если Макет <> Неопределено Тогда

        // Банковские реквизиты
        Обл = Макет.Область("БанковскиеРеквизиты");
        Обл.Параметры.Банк = СтрП(Документ.Организация.НаименованиеБанка);
        Обл.Параметры.БИК = СтрП(Документ.Организация.БИК);
        Обл.Параметры.КоррСчёт = СтрП(Документ.Организация.КорреспондентскийСчёт);
        Обл.Параметры.ИНН = СтрП(Документ.Организация.ИНН);
        Обл.Параметры.КПП = СтрП(Документ.Организация.КПП);
        Обл.Параметры.РасчСчёт = СтрП(Документ.Организация.РасчётныйСчёт);
        
        Получатель = СтрП(Документ.Организация.ПолноеНаименование);
        Если Получатель = "" Тогда
            Получатель = СтрП(Документ.Организация);
        КонецЕсли;
        Обл.Параметры.Получатель = Получатель;
        Таб.Вывести(Обл);

        // Заголовок
        Обл = Макет.Область("Заголовок");
        Обл.Параметры.Номер = СтрП(Документ.Номер);
        Обл.Параметры.Дата = СтрП(Документ.Дата);
        Таб.Вывести(Обл);

        // Поставщик
        Обл = Макет.Область("Поставщик");
        ПоставщикИнфо = СтрП(Документ.Организация.ПолноеНаименование);
        Если ПоставщикИнфо = "" Тогда
            ПоставщикИнфо = СтрП(Документ.Организация);
        КонецЕсли;
        ИНН = СтрП(Документ.Организация.ИНН);
        Если ИНН <> "" Тогда
            ПоставщикИнфо = ПоставщикИнфо + ", ИНН " + ИНН;
        КонецЕсли;
        КПП = СтрП(Документ.Организация.КПП);
        Если КПП <> "" Тогда
            ПоставщикИнфо = ПоставщикИнфо + ", КПП " + КПП;
        КонецЕсли;
        Адрес = СтрП(Документ.Организация.ЮридическийАдрес);
        Если Адрес <> "" Тогда
            ПоставщикИнфо = ПоставщикИнфо + ", " + Адрес;
        КонецЕсли;
        Тел = СтрП(Документ.Организация.Телефон);
        Если Тел <> "" Тогда
            ПоставщикИнфо = ПоставщикИнфо + ", тел.: " + Тел;
        КонецЕсли;
        Обл.Параметры.Поставщик = ПоставщикИнфо;
        Таб.Вывести(Обл);

        // Покупатель
        Обл = Макет.Область("Покупатель");
        ПокупательИнфо = СтрП(Документ.Покупатель.ПолноеНаименование);
        Если ПокупательИнфо = "" Тогда
            ПокупательИнфо = СтрП(Документ.Покупатель);
        КонецЕсли;
        ИННПок = СтрП(Документ.Покупатель.ИНН);
        Если ИННПок <> "" Тогда
            ПокупательИнфо = ПокупательИнфо + ", ИНН " + ИННПок;
        КонецЕсли;
        КПППок = СтрП(Документ.Покупатель.КПП);
        Если КПППок <> "" Тогда
            ПокупательИнфо = ПокупательИнфо + ", КПП " + КПППок;
        КонецЕсли;
        АдресПок = СтрП(Документ.Покупатель.ЮридическийАдрес);
        Если АдресПок <> "" Тогда
            ПокупательИнфо = ПокупательИнфо + ", " + АдресПок;
        КонецЕсли;
        Обл.Параметры.ПокупательИнфо = ПокупательИнфо;
        Таб.Вывести(Обл);

        // Шапка таблицы
        Обл = Макет.Область("ШапкаТаблицы");
        Таб.Вывести(Обл);

        // Строки таблицы
        Ном = 0;
        Итого = 0;
        Для Каждого Стр Из Документ.Товары Цикл
            Ном = Ном + 1;
            Обл = Макет.Область("СтрокаТаблицы");
            Обл.Параметры.НомерПП = Строка(Ном);
            Обл.Параметры.Номенклатура = СтрП(Стр.Номенклатура);
            Обл.Параметры.Количество = Строка(Стр.Количество);
            
            Ед = СтрП(Стр.Номенклатура.ЕдиницаИзмерения);
            Если Ед = "" Тогда
                Ед = "шт";
            КонецЕсли;
            Обл.Параметры.ЕдИзм = Ед;
            Обл.Параметры.Цена = Строка(Стр.Цена);
            Обл.Параметры.Сумма = Строка(Стр.Сумма);
            Итого = Итого + Стр.Сумма;
            Таб.Вывести(Обл);
        КонецЦикла;

        // Итого
        Обл = Макет.Область("Итого");
        Обл.Параметры.ИтогоСумма = Строка(Итого);
        Таб.Вывести(Обл);

        // Подвал (НДС / всего)
        Обл = Макет.Область("Подвал");
        Обл.Параметры.ВсегоКОплате = Строка(Документ.Сумма);
        Таб.Вывести(Обл);

        // Сумма прописью
        Обл = Макет.Область("СуммаПрописью");
        Обл.Параметры.СуммаПрописью = Строка(Ном) + " наименований, на сумму " + Строка(Документ.Сумма) + " руб.";
        Обл.Параметры.ВсегоНаименований = "Всего наименований " + Строка(Ном) + ", на сумму " + Строка(Документ.Сумма) + " руб.";
        Таб.Вывести(Обл);

        // Предупреждение
        Обл = Макет.Область("Предупреждение");
        Таб.Вывести(Обл);

        // Подпись
        Обл = Макет.Область("Подпись");
        Должность = СтрП(Документ.Организация.ДолжностьРуководителя);
        Если Должность = "" Тогда
            Должность = "Руководитель";
        КонецЕсли;
        Обл.Параметры.ДолжностьРуководителя = Должность;
        Обл.Параметры.ФИОРуководителя = СтрП(Документ.Организация.Руководитель);
        Таб.Вывести(Обл);

    КонецЕсли;

    Возврат Таб;
КонецФункции

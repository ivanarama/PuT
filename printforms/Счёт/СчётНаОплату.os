// Счёт на оплату для документа Счёт

Функция Сформировать(Документ) Экспорт
    Таб = Новый ТабличныйДокумент

    Если Макет <> Неопределено Тогда

        // Банковские реквизиты
        Обл = Макет.Область("БанковскиеРеквизиты")
        Попытка
            Обл.Параметры.Банк = Строка(Документ.Организация.НаименованиеБанка)
        Исключение
            Обл.Параметры.Банк = ""
        КонецПопытки
        Попытка
            Обл.Параметры.БИК = Строка(Документ.Организация.БИК)
        Исключение
            Обл.Параметры.БИК = ""
        КонецПопытки
        Попытка
            Обл.Параметры.КоррСчёт = Строка(Документ.Организация.КорреспондентскийСчёт)
        Исключение
            Обл.Параметры.КоррСчёт = ""
        КонецПопытки
        Попытка
            Обл.Параметры.ИНН = Строка(Документ.Организация.ИНН)
        Исключение
            Обл.Параметры.ИНН = ""
        КонецПопытки
        Попытка
            Обл.Параметры.КПП = Строка(Документ.Организация.КПП)
        Исключение
            Обл.Параметры.КПП = ""
        КонецПопытки
        Попытка
            Обл.Параметры.РасчСчёт = Строка(Документ.Организация.РасчётныйСчёт)
        Исключение
            Обл.Параметры.РасчСчёт = ""
        КонецПопытки
        Попытка
            Обл.Параметры.Получатель = Строка(Документ.Организация.ПолноеНаименование)
        Исключение
            Обл.Параметры.Получатель = Строка(Документ.Организация)
        КонецПопытки
        Таб.Вывести(Обл)

        // Заголовок
        Обл = Макет.Область("Заголовок")
        Обл.Параметры.Номер = Строка(Документ.Номер)
        Обл.Параметры.Дата = Строка(Документ.Дата)
        Таб.Вывести(Обл)

        // Поставщик
        Обл = Макет.Область("Поставщик")
        ПоставщикИнфо = Строка(Документ.Организация)
        Попытка
            ПоставщикИнфо = ПоставщикИнфо + ", ИНН " + Строка(Документ.Организация.ИНН)
        Исключение
        КонецПопытки
        Попытка
            ПоставщикИнфо = ПоставщикИнфо + ", " + Строка(Документ.Организация.ЮридическийАдрес)
        Исключение
        КонецПопытки
        Попытка
            ПоставщикИнфо = ПоставщикИнфо + ", тел.: " + Строка(Документ.Организация.Телефон)
        Исключение
        КонецПопытки
        Обл.Параметры.Поставщик = ПоставщикИнфо
        Таб.Вывести(Обл)

        // Покупатель
        Обл = Макет.Область("Покупатель")
        ПокупательИнфо = Строка(Документ.Покупатель)
        Попытка
            ПокупательИнфо = ПокупательИнфо + ", ИНН " + Строка(Документ.Покупатель.ИНН)
        Исключение
        КонецПопытки
        Попытка
            ПокупательИнфо = ПокупательИнфо + ", КПП " + Строка(Документ.Покупатель.КПП)
        Исключение
        КонецПопытки
        Обл.Параметры.ПокупательИнфо = ПокупательИнфо
        Таб.Вывести(Обл)

        // Шапка таблицы
        Обл = Макет.Область("ШапкаТаблицы")
        Таб.Вывести(Обл)

        // Строки таблицы
        Ном = 0
        Итого = 0
        Для Каждого Стр Из Документ.Товары Цикл
            Ном = Ном + 1
            Обл = Макет.Область("СтрокаТаблицы")
            Обл.Параметры.НомерПП = Строка(Ном)
            Обл.Параметры.Номенклатура = Строка(Стр.Номенклатура)
            Обл.Параметры.Количество = Строка(Стр.Количество)
            Попытка
                Обл.Параметры.ЕдИзм = Строка(Стр.Номенклатура.ЕдиницаИзмерения)
            Исключение
                Обл.Параметры.ЕдИзм = "шт"
            КонецПопытки
            Обл.Параметры.Цена = Строка(Стр.Цена)
            Обл.Параметры.Сумма = Строка(Стр.Сумма)
            Попытка
                Итого = Итого + Стр.Сумма
            Исключение
            КонецПопытки
            Таб.Вывести(Обл)
        КонецЦикла

        // Итого
        Обл = Макет.Область("Итого")
        Обл.Параметры.ИтогоСумма = Строка(Итого)
        Таб.Вывести(Обл)

        // Подвал (НДС / всего)
        Обл = Макет.Область("Подвал")
        Обл.Параметры.ВсегоКОплате = Строка(Документ.Сумма)
        Таб.Вывести(Обл)

        // Сумма прописью
        Обл = Макет.Область("СуммаПрописью")
        Обл.Параметры.СуммаПрописью = Строка(Ном) + " наименований, на сумму " + Строка(Документ.Сумма) + " руб."
        Обл.Параметры.ВсегоНаименований = "Всего наименований " + Строка(Ном) + ", на сумму " + Строка(Документ.Сумма) + " руб."
        Таб.Вывести(Обл)

        // Предупреждение
        Обл = Макет.Область("Предупреждение")
        Таб.Вывести(Обл)

        // Подпись
        Обл = Макет.Область("Подпись")
        Попытка
            Обл.Параметры.ДолжностьРуководителя = Документ.Организация.ДолжностьРуководителя
        Исключение
            Обл.Параметры.ДолжностьРуководителя = "Руководитель"
        КонецПопытки
        Попытка
            Обл.Параметры.ФИОРуководителя = Строка(Документ.Организация.Руководитель)
        Исключение
            Обл.Параметры.ФИОРуководителя = ""
        КонецПопытки
        Таб.Вывести(Обл)

    КонецЕсли

    Возврат Таб
КонецФункции

// Счёт на оплату для документа Счёт

Функция Сформировать(Документ) Экспорт
    Таб = Новый ТабличныйДокумент;

    Если Макет <> Неопределено Тогда

        // Банковские реквизиты
        Обл = Макет.Область("БанковскиеРеквизиты");
        Обл.Параметры.Банк = утилиты.СтрокаИлиПусто(Документ.Организация.НаименованиеБанка);
        Обл.Параметры.БИК = утилиты.СтрокаИлиПусто(Документ.Организация.БИК);
        Обл.Параметры.КоррСчёт = утилиты.СтрокаИлиПусто(Документ.Организация.КорреспондентскийСчёт);
        Обл.Параметры.ИНН = утилиты.СтрокаИлиПусто(Документ.Организация.ИНН);
        Обл.Параметры.КПП = утилиты.СтрокаИлиПусто(Документ.Организация.КПП);
        Обл.Параметры.РасчСчёт = утилиты.СтрокаИлиПусто(Документ.Организация.РасчётныйСчёт);
        
        Получатель = утилиты.СтрокаИлиПусто(Документ.Организация.ПолноеНаименование);
        Если Получатель = "" Тогда
            Получатель = утилиты.СтрокаИлиПусто(Документ.Организация);
        КонецЕсли;
        Обл.Параметры.Получатель = Получатель;
        Таб.Вывести(Обл);

        // Заголовок
        Обл = Макет.Область("Заголовок");
        ДатаСтр = Формат(Документ.Дата, "ДФ=dd.MM.yyyy");
        Обл.Параметры.Заголовок = "Счёт на оплату № " + утилиты.СтрокаИлиПусто(Документ.Номер) + " от " + ДатаСтр;
        Таб.Вывести(Обл);

        // Поставщик
        Обл = Макет.Область("Поставщик");
        ПоставщикИнфо = утилиты.СтрокаИлиПусто(Документ.Организация.ПолноеНаименование);
        Если ПоставщикИнфо = "" Тогда
            ПоставщикИнфо = утилиты.СтрокаИлиПусто(Документ.Организация);
        КонецЕсли;
        ИНН = утилиты.СтрокаИлиПусто(Документ.Организация.ИНН);
        Если ИНН <> "" Тогда
            ПоставщикИнфо = ПоставщикИнфо + ", ИНН " + ИНН;
        КонецЕсли;
        КПП = утилиты.СтрокаИлиПусто(Документ.Организация.КПП);
        Если КПП <> "" Тогда
            ПоставщикИнфо = ПоставщикИнфо + ", КПП " + КПП;
        КонецЕсли;
        Адрес = утилиты.СтрокаИлиПусто(Документ.Организация.ЮридическийАдрес);
        Если Адрес <> "" Тогда
            ПоставщикИнфо = ПоставщикИнфо + ", " + Адрес;
        КонецЕсли;
        Тел = утилиты.СтрокаИлиПусто(Документ.Организация.Телефон);
        Если Тел <> "" Тогда
            ПоставщикИнфо = ПоставщикИнфо + ", тел.: " + Тел;
        КонецЕсли;
        Обл.Параметры.Поставщик = ПоставщикИнфо;
        Таб.Вывести(Обл);

        // Покупатель
        Обл = Макет.Область("Покупатель");
        ПокупательИнфо = утилиты.СтрокаИлиПусто(Документ.Покупатель.ПолноеНаименование);
        Если ПокупательИнфо = "" Тогда
            ПокупательИнфо = утилиты.СтрокаИлиПусто(Документ.Покупатель);
        КонецЕсли;
        ИННПок = утилиты.СтрокаИлиПусто(Документ.Покупатель.ИНН);
        Если ИННПок <> "" Тогда
            ПокупательИнфо = ПокупательИнфо + ", ИНН " + ИННПок;
        КонецЕсли;
        КПППок = утилиты.СтрокаИлиПусто(Документ.Покупатель.КПП);
        Если КПППок <> "" Тогда
            ПокупательИнфо = ПокупательИнфо + ", КПП " + КПППок;
        КонецЕсли;
        АдресПок = утилиты.СтрокаИлиПусто(Документ.Покупатель.ЮридическийАдрес);
        Если АдресПок <> "" Тогда
            ПокупательИнфо = ПокупательИнфо + ", " + АдресПок;
        КонецЕсли;
        Обл.Параметры.ПокупательИнфо = ПокупательИнфо;
        Таб.Вывести(Обл);

        // Шапка таблицы
        Обл = Макет.Область("ШапкаТаблицы");
        Таб.Вывести(Обл);

        // Строки таблицы
        Ном = 0;
        Итого = 0;
        Для Каждого Стр Из Документ.Товары Цикл
            Ном = Ном + 1;
            Обл = Макет.Область("СтрокаТаблицы");
            Обл.Параметры.НомерПП = Строка(Ном);
            Обл.Параметры.Номенклатура = утилиты.СтрокаИлиПусто(Стр.Номенклатура);
            Обл.Параметры.Количество = Строка(Стр.Количество);
            
            Ед = "";
            Попытка
                Ед = утилиты.СтрокаИлиПусто(Стр.Номенклатура.ЕдиницаИзмерения.Наименование);
            Исключение
            КонецПопытки;
            Если Ед = "" Или Ед = "<nil>" Или СтрДлина(Ед) > 30 Тогда
                Ед = "шт";
            КонецЕсли;
            Обл.Параметры.ЕдИзм = Ед;
            Обл.Параметры.Цена = Строка(Стр.Цена);
            Обл.Параметры.Сумма = Строка(Стр.Сумма);
            Итого = Итого + Стр.Сумма;
            Таб.Вывести(Обл);
        КонецЦикла;

        // Итого
        Обл = Макет.Область("Итого");
        Обл.Параметры.ИтогоСумма = Строка(Итого);
        Таб.Вывести(Обл);

        // Подвал (НДС / всего)
        Обл = Макет.Область("Подвал");
        Обл.Параметры.ВсегоКОплате = Строка(Документ.Сумма);
        Таб.Вывести(Обл);

        // Сумма прописью
        Обл = Макет.Область("СуммаПрописью");
        Обл.Параметры.ВсегоНаименований = "Всего наименований " + Строка(Ном) + ", на сумму " + Строка(Документ.Сумма) + " руб.";
        Обл.Параметры.СуммаПрописью = "Сумма прописью: " + утилиты.СуммаПрописью(Документ.Сумма);
        Таб.Вывести(Обл);

        // Предупреждение
        Обл = Макет.Область("Предупреждение");
        Таб.Вывести(Обл);

        // Подпись
        Обл = Макет.Область("Подпись");
        Должность = утилиты.СтрокаИлиПусто(Документ.Организация.ДолжностьРуководителя);
        Если Должность = "" Тогда
            Должность = "Руководитель";
        КонецЕсли;
        Обл.Параметры.ДолжностьРуководителя = Должность;
        Обл.Параметры.ФИОРуководителя = утилиты.СтрокаИлиПусто(Документ.Организация.Руководитель);
        Таб.Вывести(Обл);

    КонецЕсли;

    Возврат Таб;
КонецФункции

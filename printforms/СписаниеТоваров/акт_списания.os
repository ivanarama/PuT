// Акт списания — себестоимость из движений регистра ОстаткиТоваров.

Функция Сформировать(Документ) Экспорт
    Таб = Новый ТабличныйДокумент;

    Стоимость = Новый Структура;
    Если ЗначениеЗаполнено(Документ.Ссылка) Тогда
        Попытка
            Запрос = Новый Запрос;
            Запрос.Текст = "ВЫБРАТЬ Номенклатура, Сумма
                            ИЗ РегистрНакопления.ОстаткиТоваров
                            ГДЕ Регистратор = &Док И ВидДвижения = ""Расход"" И Склад = &Склад";
            Запрос.УстановитьПараметр("Док", Документ.Ссылка);
            Запрос.УстановитьПараметр("Склад", Документ.Склад);
            Для Каждого Стр Из Запрос.Выполнить() Цикл
                Стоимость.Вставить(Строка(Стр.Номенклатура), Стр.Сумма);
            КонецЦикла;
        Исключение
        КонецПопытки;
    КонецЕсли;

    Если Макет <> Неопределено Тогда
        Обл = Макет.Область("Заголовок");
        Обл.Параметры.Номер = Документ.Номер;
        Обл.Параметры.Дата = Документ.Дата;
        Таб.Вывести(Обл);

        Обл = Макет.Область("Реквизиты");
        Обл.Параметры.Организация = Документ.Организация;
        Обл.Параметры.Склад = Документ.Склад;
        Обл.Параметры.Причина = Документ.Причина;
        Таб.Вывести(Обл);

        Обл = Макет.Область("ШапкаТаблицы");
        Таб.Вывести(Обл);

        Ном = 0;
        Итого = 0;
        Для Каждого Стр Из Документ.Товары Цикл
            Ном = Ном + 1;
            Обл = Макет.Область("СтрокаТаблицы");
            Обл.Параметры.НомерПП = Строка(Ном);
            Обл.Параметры.Номенклатура = Стр.Номенклатура;
            Обл.Параметры.Количество = Строка(Стр.Количество);
            Сум = 0;
            Ключ = Строка(Стр.Номенклатура);
            Если Стоимость.Свойство(Ключ) Тогда
                Сум = Стоимость[Ключ];
            КонецЕсли;
            Обл.Параметры.Себестоимость = Строка(Сум);
            Итого = Итого + Сум;
            Таб.Вывести(Обл);
        КонецЦикла;

        Обл = Макет.Область("Подвал");
        Обл.Параметры.Итого = Строка(Итого);
        Таб.Вывести(Обл);

        Обл = Макет.Область("Подписи");
        Таб.Вывести(Обл);
    КонецЕсли;

    Возврат Таб;
КонецФункции

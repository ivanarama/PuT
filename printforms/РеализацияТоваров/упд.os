// УПД (статус 2) — Универсальный передаточный документ для РеализацииТоваров

Функция Сформировать(Документ) Экспорт
    Таб = Новый ТабличныйДокумент

    Если Макет <> Неопределено Тогда

        // Заголовок
        Обл = Макет.Область("Заголовок")
        Обл.Параметры.Номер = Документ.Номер
        Обл.Параметры.Дата = Документ.Дата
        Таб.Вывести(Обл)

        // Продавец (Организация)
        Обл = Макет.Область("Продавец")
        Обл.Параметры.Продавец = Документ.Организация.ПолноеНаименование
        Обл.Параметры.АдресПродавца = Документ.Организация.ЮридическийАдрес
        Обл.Параметры.ИННПродавца = Строка(Документ.Организация.ИНН) + " / " + Строка(Документ.Организация.КПП)
        Таб.Вывести(Обл)

        // Покупатель
        Обл = Макет.Область("Покупатель")
        Обл.Параметры.Покупатель = Документ.Покупатель.ПолноеНаименование
        Обл.Параметры.АдресПокупателя = Документ.Покупатель.ЮридическийАдрес
        Обл.Параметры.ИННПокупателя = Строка(Документ.Покупатель.ИНН) + " / " + Строка(Документ.Покупатель.КПП)
        Таб.Вывести(Обл)

        // Реквизиты
        Обл = Макет.Область("Реквизиты")
        Обл.Параметры.Грузополучатель = Строка(Документ.Покупатель.ПолноеНаименование) + ", " + Строка(Документ.Покупатель.ФактическийАдрес)
        Таб.Вывести(Обл)

        // Шапка таблицы
        Обл = Макет.Область("ШапкаТаблицы")
        Таб.Вывести(Обл)

        // Строки таблицы
        Ном = 0
        Итого = 0
        Для Каждого Стр Из Документ.Товары Цикл
            Ном = Ном + 1
            Обл = Макет.Область("СтрокаТаблицы")
            Обл.Параметры.НомерПП = Строка(Ном)
            Попытка
                Обл.Параметры.Артикул = Стр.Номенклатура.Артикул
            Исключение
                Обл.Параметры.Артикул = "--"
            КонецПопытки
            Обл.Параметры.Номенклатура = Строка(Стр.Номенклатура)
            Попытка
                Обл.Параметры.ЕдИзм = Строка(Стр.Номенклатура.ЕдиницаИзмерения)
            Исключение
                Обл.Параметры.ЕдИзм = "шт"
            КонецПопытки
            Обл.Параметры.Количество = Строка(Стр.Количество)
            Обл.Параметры.Цена = Строка(Стр.Цена)
            Попытка
                Обл.Параметры.СтавкаНДС = Строка(Стр.СтавкаНДС)
            Исключение
                Обл.Параметры.СтавкаНДС = "без НДС"
            КонецПопытки
            Обл.Параметры.Сумма = Строка(Стр.Сумма)
            Итого = Итого + Стр.Сумма
            Таб.Вывести(Обл)
        КонецЦикла

        // Итого
        Обл = Макет.Область("Итого")
        Обл.Параметры.ИтогоСумма = Строка(Итого)
        Таб.Вывести(Обл)

        // Подвал НДС
        Обл = Макет.Область("ПодвалНДС")
        Обл.Параметры.СуммаБезНДС = Строка(Документ.СуммаБезНДС)
        Обл.Параметры.СуммаНДС = Строка(Документ.СуммаНДС)
        Обл.Параметры.ВсегоСумма = Строка(Документ.Сумма)
        Таб.Вывести(Обл)

        // Подписи руководство
        Обл = Макет.Область("ПодписиРуководство")
        Обл.Параметры.ФИОРуководителя = Документ.Организация.Руководитель
        Обл.Параметры.ФИОБухгалтера = Документ.Организация.ГлавныйБухгалтер
        Таб.Вывести(Обл)

        // Подписи передача
        Обл = Макет.Область("ПодписиПередача")
        Обл.Параметры.ФИОРуководителя = Документ.Организация.Руководитель
        Обл.Параметры.ДатаОтгрузки = Документ.Дата
        Таб.Вывести(Обл)

        // Составитель
        Обл = Макет.Область("Составитель")
        Обл.Параметры.СоставительПродавец = Строка(Документ.Организация.ПолноеНаименование) + ", ИНН " + Строка(Документ.Организация.ИНН)
        Обл.Параметры.СоставительПокупатель = Строка(Документ.Покупатель.ПолноеНаименование) + ", ИНН/КПП " + Строка(Документ.Покупатель.ИНН) + "/" + Строка(Документ.Покупатель.КПП)
        Таб.Вывести(Обл)

        // МП
        Обл = Макет.Область("МП")
        Таб.Вывести(Обл)

    КонецЕсли

    Возврат Таб
КонецФункции

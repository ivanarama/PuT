// УПД (статус 2) — Универсальный передаточный документ для РеализацииТоваров

Функция Сформировать(Документ) Экспорт
    Таб = Новый ТабличныйДокумент;

    Если Макет <> Неопределено Тогда

        // Заголовок
        Обл = Макет.Область("Заголовок");
        Обл.Параметры.Номер = утилиты.СтрокаИлиПусто(Документ.Номер);
        Обл.Параметры.Дата = утилиты.СтрокаИлиПусто(Документ.Дата);
        Таб.Вывести(Обл);

        // Продавец (Организация)
        Обл = Макет.Область("Продавец");
        Продавец = утилиты.СтрокаИлиПусто(Документ.Организация.ПолноеНаименование);
        Если Продавец = "" Тогда
            Продавец = утилиты.СтрокаИлиПусто(Документ.Организация);
        КонецЕсли;
        Обл.Параметры.Продавец = Продавец;
        Обл.Параметры.АдресПродавца = утилиты.СтрокаИлиПусто(Документ.Организация.ЮридическийАдрес);
        Обл.Параметры.ИННПродавца = утилиты.ФорматИННКПП(Документ.Организация.ИНН, Документ.Организация.КПП);
        Таб.Вывести(Обл);

        // Покупатель
        Обл = Макет.Область("Покупатель");
        Покупатель = утилиты.СтрокаИлиПусто(Документ.Покупатель.ПолноеНаименование);
        Если Покупатель = "" Тогда
            Покупатель = утилиты.СтрокаИлиПусто(Документ.Покупатель);
        КонецЕсли;
        Обл.Параметры.Покупатель = Покупатель;
        Обл.Параметры.АдресПокупателя = утилиты.СтрокаИлиПусто(Документ.Покупатель.ЮридическийАдрес);
        Обл.Параметры.ИННПокупателя = утилиты.ФорматИННКПП(Документ.Покупатель.ИНН, Документ.Покупатель.КПП);
        Таб.Вывести(Обл);

        // Реквизиты
        Обл = Макет.Область("Реквизиты");
        Грузополучатель = Покупатель;
        ФактичАдрес = утилиты.СтрокаИлиПусто(Документ.Покупатель.ФактическийАдрес);
        Если ФактичАдрес <> "" Тогда
            Грузополучатель = Грузополучатель + ", " + ФактичАдрес;
        ИначеЕсли утилиты.СтрокаИлиПусто(Документ.Покупатель.ЮридическийАдрес) <> "" Тогда
            Грузополучатель = Грузополучатель + ", " + утилиты.СтрокаИлиПусто(Документ.Покупатель.ЮридическийАдрес);
        КонецЕсли;
        Обл.Параметры.Грузополучатель = Грузополучатель;
        Таб.Вывести(Обл);

        // Шапка таблицы
        Обл = Макет.Область("ШапкаТаблицы");
        Таб.Вывести(Обл);

        // Строки таблицы
        Ном = 0;
        Итого = 0;
        Для Каждого Стр Из Документ.Товары Цикл
            Ном = Ном + 1;
            Обл = Макет.Область("СтрокаТаблицы");
            Обл.Параметры.НомерПП = Строка(Ном);
            Артикул = утилиты.СтрокаИлиПусто(Стр.Номенклатура.Артикул);
            Если Артикул = "" Тогда
                Артикул = "--";
            КонецЕсли;
            Обл.Параметры.Артикул = Артикул;
            Обл.Параметры.Номенклатура = утилиты.СтрокаИлиПусто(Стр.Номенклатура);
            Ед = утилиты.СтрокаИлиПусто(Стр.Номенклатура.ЕдиницаИзмерения);
            Если Ед = "" Тогда
                Ед = "шт";
            КонецЕсли;
            Обл.Параметры.ЕдИзм = Ед;
            Обл.Параметры.Количество = Строка(Стр.Количество);
            Обл.Параметры.Цена = Строка(Стр.Цена);
            Ставка = утилиты.СтрокаИлиПусто(Стр.СтавкаНДС);
            Если Ставка = "" Тогда
                Ставка = "без НДС";
            КонецЕсли;
            Обл.Параметры.СтавкаНДС = Ставка;
            Обл.Параметры.Сумма = Строка(Стр.Сумма);
            Итого = Итого + Стр.Сумма;
            Таб.Вывести(Обл);
        КонецЦикла;

        // Итого
        Обл = Макет.Область("Итого");
        Обл.Параметры.ИтогоСумма = Строка(Итого);
        Таб.Вывести(Обл);

        // Подвал НДС
        Обл = Макет.Область("ПодвалНДС");
        Обл.Параметры.СуммаБезНДС = Строка(Документ.СуммаБезНДС);
        Обл.Параметры.СуммаНДС = Строка(Документ.СуммаНДС);
        Обл.Параметры.ВсегоСумма = Строка(Документ.Сумма);
        Таб.Вывести(Обл);

        // Подписи руководство
        Обл = Макет.Область("ПодписиРуководство");
        Обл.Параметры.ФИОРуководителя = утилиты.СтрокаИлиПусто(Документ.Организация.Руководитель);
        Обл.Параметры.ФИОБухгалтера = утилиты.СтрокаИлиПусто(Документ.Организация.ГлавныйБухгалтер);
        Таб.Вывести(Обл);

        // Подписи передача
        Обл = Макет.Область("ПодписиПередача");
        Обл.Параметры.ФИОРуководителя = утилиты.СтрокаИлиПусто(Документ.Организация.Руководитель);
        Обл.Параметры.ДатаОтгрузки = утилиты.СтрокаИлиПусто(Документ.Дата);
        Таб.Вывести(Обл);

        // Составитель
        Обл = Макет.Область("Составитель");
        СоставительПрод = Продавец;
        ИННПрод = утилиты.СтрокаИлиПусто(Документ.Организация.ИНН);
        Если ИННПрод <> "" Тогда
            СоставительПрод = СоставительПрод + ", ИНН " + ИННПрод;
        КонецЕсли;
        Обл.Параметры.СоставительПродавец = СоставительПрод;
        
        СоставительПок = Покупатель;
        ИННКПППок = утилиты.ФорматИННКПП(Документ.Покупатель.ИНН, Документ.Покупатель.КПП);
        Если ИННКПППок <> "" Тогда
            СоставительПок = СоставительПок + ", ИНН/КПП " + ИННКПППок;
        КонецЕсли;
        Обл.Параметры.СоставительПокупатель = СоставительПок;
        Таб.Вывести(Обл);

        // МП
        Обл = Макет.Область("МП");
        Таб.Вывести(Обл);

    КонецЕсли;

    Возврат Таб;
КонецФункции

// Расходный кассовый ордер

Функция Сформировать(Документ) Экспорт
    Таб = Новый ТабличныйДокумент;

    Если Макет <> Неопределено Тогда
        Обл = Макет.Область("Заголовок");
        ДатаСтр = Формат(Документ.Дата, "ДФ=dd.MM.yyyy");
        Обл.Параметры.Заголовок = "Расходный кассовый ордер № " + утилиты.СтрокаИлиПусто(Документ.Номер) + " от " + ДатаСтр;
        Таб.Вывести(Обл);

        Обл = Макет.Область("Шапка");
        Орг = утилиты.СтрокаИлиПусто(Документ.Организация.ПолноеНаименование);
        Если Орг = "" Тогда
            Орг = утилиты.СтрокаИлиПусто(Документ.Организация);
        КонецЕсли;
        Обл.Параметры.Организация = Орг;
        Обл.Параметры.Касса = "Касса/счёт: " + утилиты.СтрокаИлиПусто(Документ.Касса);
        Обл.Параметры.Выдать = "Выдать: " + утилиты.СтрокаИлиПусто(Документ.Контрагент);
        Обл.Параметры.Основание = "Основание: " + утилиты.СтрокаИлиПусто(Документ.Основание);
        Обл.Параметры.СуммаЧислом = "Сумма: " + Формат(Документ.Сумма, "ЧЦ=15; ЧДЦ=2; ЧГ=0") + " рублей";
        Обл.Параметры.СуммаПрописью = "Сумма прописью: " + утилиты.СуммаПрописью(Документ.Сумма);
        Таб.Вывести(Обл);

        Обл = Макет.Область("Подвал");
        Таб.Вывести(Обл);
    КонецЕсли;

    Возврат Таб;
КонецФункции

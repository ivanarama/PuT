// АРМ Приёмки — приём товара по заказу поставщику со сверкой.
// Заполняет ожидаемое (остаток в пути по заказу) и цены, считает расхождение.
// Создаёт и проводит ПоступлениеТоваров: закрытие товаров в пути, партии FIFO,
// долг поставщику — всё в проведении поступления.

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДатаВремя();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаКлиенте
// Подтянуть поставщика и склад из выбранного заказа.
Процедура ЗаказПриИзменении(Элемент)
    Если ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
        Объект.Поставщик = ЗначениеРеквизитаОбъекта(Объект.ЗаказПоставщику, "Поставщик");
        Объект.Склад     = ЗначениеРеквизитаОбъекта(Объект.ЗаказПоставщику, "Склад");
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
// Пересчёт расхождения при правке принятого количества.
Процедура ТабТоварыПриИзменении()
    Для Каждого Стр Из Объект.Товары Цикл
        Стр.Расхождение = Стр.Принято - Стр.Заказано;
    КонецЦикла;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаЗаполнитьНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
        ВызватьИсключение("Укажите заказ поставщику");
    КонецЕсли;
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), КонецДня(Объект.Дата), ТекущаяДатаВремя());

    Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
        Объект.Поставщик = ЗначениеРеквизитаОбъекта(Объект.ЗаказПоставщику, "Поставщик");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = ЗначениеРеквизитаОбъекта(Объект.ЗаказПоставщику, "Склад");
    КонецЕсли;

    // Цены из строк заказа (Номенклатура → Цена).
    ЦеныЗаказа = Новый Соответствие;
    ЗаказОбъект = Объект.ЗаказПоставщику.ПолучитьОбъект();
    Для Каждого СтрЗ Из ЗаказОбъект.Товары Цикл
        ЦеныЗаказа.Вставить(СтрЗ.Номенклатура, СтрЗ.Цена);
    КонецЦикла;

    ТипЗакуп = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");

    // Ожидается к приёмке = остаток в пути по заказу.
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Номенклатура, КоличествоОстаток
                    ИЗ РегистрНакопления.ТоварыВПути.Остатки(&Момент)
                    ГДЕ ЗаказПоставщику = &Заказ И КоличествоОстаток > 0";
    Запрос.УстановитьПараметр("Заказ", Объект.ЗаказПоставщику);
    Запрос.УстановитьПараметр("Момент", Момент);

    Объект.Товары.Очистить();
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        НомСсылка = Стр.Номенклатура;
        Если ТипЗнч(НомСсылка) = "Строка" Тогда
            НомСсылка = Справочники.Номенклатура.НайтиПоНаименованию(Стр.Номенклатура);
        КонецЕсли;
        Если НЕ ЗначениеЗаполнено(НомСсылка) Тогда Продолжить; КонецЕсли;

        Нов = Объект.Товары.Добавить();
        Нов.Номенклатура = Строка(Стр.Номенклатура);
        Нов.Заказано     = Стр.КоличествоОстаток;
        Нов.Принято      = Стр.КоличествоОстаток;
        Нов.Расхождение  = 0;
        Цена = ЦеныЗаказа.Получить(Стр.Номенклатура);
        Если Цена = Неопределено ИЛИ Цена = 0 Тогда
            Цена = ПолучитьЦену(НомСсылка, ТипЗакуп, Момент);
        КонецЕсли;
        Нов.Цена = Цена;
    КонецЦикла;

    Если Объект.Товары.Количество() = 0 Тогда
        Сообщить("По заказу нет товаров в пути — принимать нечего (возможно, уже принято)");
    Иначе
        Сообщить("Заполнено позиций по заказу: " + Строка(Объект.Товары.Количество())
            + ". Проверьте цены и принятое количество.");
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Товары.Очистить();
    Сообщить("Таблица очищена");
КонецПроцедуры

// @directive=&НаСервере
// Создаёт и проводит ПоступлениеТоваров по принятым позициям.
Процедура КнопкаСоздатьПоступлениеНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
        ВызватьИсключение("Укажите заказ поставщику");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
        ВызватьИсключение("Не заполнен поставщик (выберите заказ заново)");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Не заполнен склад (выберите заказ заново)");
    КонецЕсли;
    Если Объект.Товары.Количество() = 0 Тогда
        ВызватьИсключение("Сначала заполните таблицу по заказу");
    КонецЕсли;

    Попытка
        Пост = Документы.ПоступлениеТоваров.Создать();
        Пост.Дата           = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
        Пост.Организация    = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());
        Пост.Поставщик      = Объект.Поставщик;
        Пост.Склад          = Объект.Склад;
        Пост.ЗаказПоставщику = Объект.ЗаказПоставщику;
        Пост.СпособУчетаНДС  = "ВТомЧисле";

        ЗаказыПокупателейЗаказа = Новый Соответствие;
        ЗаказОбъект = Объект.ЗаказПоставщику.ПолучитьОбъект();
        Для Каждого СтрЗ Из ЗаказОбъект.Товары Цикл
            ЗаказыПокупателейЗаказа.Вставить(СтрЗ.Номенклатура, СтрЗ.ЗаказПокупателя);
        КонецЦикла;

        Позиций = 0;
        Недопоставка = 0;
        Для Каждого Стр Из Объект.Товары Цикл
            Если Стр.Принято <= 0 ИЛИ НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда Продолжить; КонецЕсли;
            Если Стр.Цена <= 0 Тогда
                ВызватьИсключение("Не указана цена по «" + Строка(Стр.Номенклатура)
                    + "» — поступление нельзя провести без цены");
            КонецЕсли;

            НомСсылка = Стр.Номенклатура;
            Если ТипЗнч(НомСсылка) = "Строка" Тогда
                НомСсылка = Справочники.Номенклатура.НайтиПоНаименованию(Стр.Номенклатура);
            КонецЕсли;
            Если НЕ ЗначениеЗаполнено(НомСсылка) Тогда Продолжить; КонецЕсли;

            СтрП = Пост.Товары.Добавить();
            СтрП.Номенклатура = НомСсылка;
            СтрП.Количество   = Стр.Принято;
            СтрП.Цена         = Стр.Цена;
            СтрП.ЗаказПокупателя = ЗаказыПокупателейЗаказа.Получить(НомСсылка);
            Позиций = Позиций + 1;
            Если Стр.Принято < Стр.Заказано Тогда
                Недопоставка = Недопоставка + 1;
            КонецЕсли;
        КонецЦикла;

        Если Позиций = 0 Тогда
            ВызватьИсключение("Нет строк с принятым количеством");
        КонецЕсли;

        Пост.Записать();
        Пост.Провести();

        Результат = "Поступление № " + Пост.Номер + " на " + Строка(Пост.Сумма) + " проведено";
        Если Недопоставка > 0 Тогда
            Результат = Результат + " (недопоставка по " + Строка(Недопоставка) + " позиц. — остаток ждём в пути)";
        КонецЕсли;
        Объект.Товары.Очистить();
        Сообщить(Результат);
    Исключение
        ВызватьИсключение("Не удалось оформить поступление: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

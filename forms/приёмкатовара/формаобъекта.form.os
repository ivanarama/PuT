// АРМ Приёмки — приём товара по заказу поставщику со сверкой.
// Заполняет ожидаемое (остаток в пути по заказу) и цены, считает расхождение.
// Создаёт и проводит ПоступлениеТоваров: закрытие товаров в пути, партии FIFO,
// долг поставщику — всё в проведении поступления.

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДатаВремя();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаКлиенте
// Подтянуть поставщика и склад из выбранного заказа.
Процедура ЗаказПриИзменении(Элемент)
    Объект.Товары.Очистить();
    Если ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
        Объект.Организация = ЗначениеРеквизитаОбъекта(Объект.ЗаказПоставщику, "Организация");
        Объект.Поставщик = ЗначениеРеквизитаОбъекта(Объект.ЗаказПоставщику, "Поставщик");
        Объект.Склад     = ЗначениеРеквизитаОбъекта(Объект.ЗаказПоставщику, "Склад");
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
// Пересчёт расхождения при правке принятого количества.
Процедура ТабТоварыПриИзменении()
    Для Каждого Стр Из Объект.Товары Цикл
        Стр.Расхождение = Стр.Принято - Стр.Заказано;
    КонецЦикла;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаЗаполнитьНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
        ВызватьИсключение("Укажите заказ поставщику");
    КонецЕсли;
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), КонецДня(Объект.Дата), ТекущаяДатаВремя());

    Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
        Объект.Поставщик = ЗначениеРеквизитаОбъекта(Объект.ЗаказПоставщику, "Поставщик");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = ЗначениеРеквизитаОбъекта(Объект.ЗаказПоставщику, "Склад");
    КонецЕсли;

    Заказ = Объект.ЗаказПоставщику.ПолучитьОбъект();
    Остатки = ОстаткиОдногоЗаказа(Объект.ЗаказПоставщику, Момент, Истина);
    СкладыРегистра = СкладыСтарогоЗаказа(Объект.ЗаказПоставщику);

    // У старых поступлений нет номера строки. Общий остаток регистра ограничивает
    // доступное количество; новые частичные приёмки привязаны к выбранной строке.
    ПринятоПоСтрокам = ПринятыеСтрокиЗаказа(Объект.ЗаказПоставщику, Момент);

    Объект.Товары.Очистить();
    Номер = 0;
    Для Каждого Позиция Из Заказ.Товары Цикл
        Номер = Номер + 1;
        Склад = ?(ЗначениеЗаполнено(Позиция.Склад), Позиция.Склад, Заказ.Склад);
        Ключ = КлючСтрокиЗаказа(Склад, Позиция.Номенклатура, Позиция.ЗаказПокупателя);
        СтарыйСклад = СкладыРегистра.Получить(Ключ);
        Если ЗначениеЗаполнено(СтарыйСклад) Тогда
            Ключ = КлючСтрокиЗаказа(СтарыйСклад, Позиция.Номенклатура, Позиция.ЗаказПокупателя);
        КонецЕсли;
        Остаток = Остатки.Получить(Ключ);
        Если Остаток = Неопределено ИЛИ Остаток.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Количество = Мин(Остаток.Количество, Позиция.Количество - ПринятоПоСтрокам.Получить(Номер));
        Если Количество <= 0 Тогда Продолжить; КонецЕсли;
        Нов = Объект.Товары.Добавить();
        Нов.СтрокаЗаказа = Номер;
        Нов.Номенклатура = Позиция.Номенклатура;
        Нов.ЗаказПокупателя = Позиция.ЗаказПокупателя;
        Нов.Склад = Склад;
        Нов.СтавкаНДС = Позиция.СтавкаНДС;
        Нов.Цена = Позиция.Цена;
        Нов.Заказано = Количество;
        Нов.Принято = Количество;
        Нов.Расхождение = 0;
        Остаток.Количество = Остаток.Количество - Количество;
    КонецЦикла;

    Если Объект.Товары.Количество() = 0 Тогда
        Сообщить("По заказу нет товаров в пути — принимать нечего (возможно, уже принято)");
    Иначе
        Сообщить("Заполнено позиций по заказу: " + Строка(Объект.Товары.Количество())
            + ". Проверьте цены и принятое количество.");
    КонецЕсли;
КонецПроцедуры

Функция ПринятыеСтрокиЗаказа(ЗаказСсылка, Момент = Неопределено)
    ПринятоПоСтрокам = Новый Соответствие;
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
    Запрос.УстановитьПараметр("Момент", Момент);
    Запрос.Текст = "ВЫБРАТЬ П.Ссылка КАК Ид ИЗ Документ.ПоступлениеТоваров КАК П
                    ГДЕ П.ЗаказПоставщику = &Заказ И П.posted = Истина И (&Момент ЕСТЬ ПУСТО ИЛИ П.Дата <= &Момент)";
    Для Каждого Д Из Запрос.Выполнить() Цикл
        Пост = Документы.ПоступлениеТоваров.НайтиПоИдентификатору(УИДСсылки(Д.Ид)).ПолучитьОбъект();
        Для Каждого Стр Из Пост.Товары Цикл
            Если Стр.СтрокаЗаказа > 0 Тогда
                ПринятоПоСтрокам.Вставить(Стр.СтрокаЗаказа, ПринятоПоСтрокам.Получить(Стр.СтрокаЗаказа) + Стр.Количество);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Возврат ПринятоПоСтрокам;
КонецФункции

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Товары.Очистить();
    Сообщить("Таблица очищена");
КонецПроцедуры

// @directive=&НаСервере
// Создаёт и проводит ПоступлениеТоваров по принятым позициям.
Процедура КнопкаСоздатьПоступлениеНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.ЗаказПоставщику) Тогда
        ВызватьИсключение("Укажите заказ поставщику");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
        ВызватьИсключение("Не заполнен поставщик (выберите заказ заново)");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Не заполнен склад (выберите заказ заново)");
    КонецЕсли;
    Если Объект.Товары.Количество() = 0 Тогда
        ВызватьИсключение("Сначала заполните таблицу по заказу");
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        Блокировка = БлокировкаДанных();
        Элемент = Блокировка.Добавить("ТоварыВПути");
        Элемент.УстановитьЗначение("ЗаказПоставщику", УИДСсылки(Объект.ЗаказПоставщику));
        Блокировка.Заблокировать();
        Пост = Документы.ПоступлениеТоваров.Создать();
        Пост.Дата           = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
        Пост.Организация    = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());
        Пост.Поставщик      = Объект.Поставщик;
        Пост.Склад          = Объект.Склад;
        Пост.ЗаказПоставщику = Объект.ЗаказПоставщику;
        Заказ = Объект.ЗаказПоставщику.ПолучитьОбъект();
        Пост.СпособУчетаНДС = Заказ.СпособУчетаНДС;
        Если УИДСсылки(Пост.Поставщик) <> УИДСсылки(Заказ.Поставщик)
            ИЛИ УИДСсылки(Пост.Организация) <> УИДСсылки(Заказ.Организация) Тогда
            ВызватьИсключение("Поставщик и организация должны совпадать с заказом");
        КонецЕсли;
        ПринятоПоСтрокам = ПринятыеСтрокиЗаказа(Объект.ЗаказПоставщику);
        Позиции = Новый Массив;
        Для Каждого Позиция Из Заказ.Товары Цикл
            Позиции.Добавить(Позиция);
        КонецЦикла;
        Позиций = 0;
        Недопоставка = 0;
        Для Каждого Стр Из Объект.Товары Цикл
            Если Стр.Принято <= 0 ИЛИ НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда Продолжить; КонецЕсли;
            // Пустая цена строки из грида приходит как NULL и «<= 0» не ловит.
            Если НЕ ЗначениеЗаполнено(Стр.Цена) ИЛИ Стр.Цена <= 0 Тогда
                ВызватьИсключение("Не указана цена по «" + Строка(Стр.Номенклатура)
                    + "» — поступление нельзя провести без цены");
            КонецЕсли;

            Если Стр.СтрокаЗаказа < 1 ИЛИ Стр.СтрокаЗаказа > Заказ.Товары.Количество() Тогда
                ВызватьИсключение("Строка заказа отсутствует. Заполните таблицу по заказу.");
            КонецЕсли;
            Позиция = Позиции[Стр.СтрокаЗаказа - 1];
            НовоеКоличество = ПринятоПоСтрокам.Получить(Стр.СтрокаЗаказа) + Стр.Принято;
            Если НовоеКоличество > Позиция.Количество Тогда
                ВызватьИсключение("Количество превышает непринятый остаток строки заказа. Обновите таблицу.");
            КонецЕсли;
            ПринятоПоСтрокам.Вставить(Стр.СтрокаЗаказа, НовоеКоличество);
            Склад = ?(ЗначениеЗаполнено(Позиция.Склад), Позиция.Склад, Заказ.Склад);
            Если КлючСтрокиЗаказа(Стр.Склад, Стр.Номенклатура, Стр.ЗаказПокупателя)
                <> КлючСтрокиЗаказа(Склад, Позиция.Номенклатура, Позиция.ЗаказПокупателя) Тогда
                ВызватьИсключение("Изменились товар, склад или заказ покупателя. Заполните таблицу заново.");
            КонецЕсли;
            СтрП = Пост.Товары.Добавить();
            СтрП.СтрокаЗаказа = Стр.СтрокаЗаказа;
            СтрП.Номенклатура = Позиция.Номенклатура;
            СтрП.Количество = Стр.Принято;
            СтрП.Цена = Стр.Цена;
            СтрП.Склад = Склад;
            СтрП.СтавкаНДС = Позиция.СтавкаНДС;
            СтрП.ЗаказПокупателя = Позиция.ЗаказПокупателя;
            Позиций = Позиций + 1;
            Если Стр.Принято < Стр.Заказано Тогда
                Недопоставка = Недопоставка + 1;
            КонецЕсли;
        КонецЦикла;

        Если Позиций = 0 Тогда
            ВызватьИсключение("Нет строк с принятым количеством");
        КонецЕсли;

        Пост.Записать();
        Пост.Провести();
        Результат = "Поступление № " + Пост.Номер + " на " + Строка(Пост.Сумма) + " проведено";
        Если Недопоставка > 0 Тогда
            Результат = Результат + " (недопоставка по " + Строка(Недопоставка) + " позиц. — остаток ждём в пути)";
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение("Не удалось оформить поступление: " + ОписаниеОшибки());
    КонецПопытки;
    Объект.Товары.Очистить();
    Сообщить(Результат);
КонецПроцедуры

// Обработчики управляемой формы «Сопоставление и загрузка ЭДО (УПД)».
// Логика парсинга и сопоставления синхронизирована с src/загрузкаэдо.proc.os:
// парсер на ПрочитатьXML (файл может прийти в одну строку), суммы УПД —
// «сверху» (СпособУчетаНДС = Сверху), дата документа — из УПД,
// повторная загрузка того же УПД не создаёт дубль и не оставляет побочных данных.

// ── Вспомогательные функции парсинга XML ─────────────────────────────────────

Функция ХвостИмени(КвалифицированноеИмя)
	Стр = Строка(КвалифицированноеИмя);
	Поз = СтрНайти(Стр, ":");
	Если Поз > 0 Тогда
		Возврат Сред(Стр, Поз + 1);
	КонецЕсли;
	Возврат Стр;
КонецФункции

Функция АтрибУзла(Узел, ИмяАтрибута)
	Для Каждого Пара Из Узел.Атрибуты Цикл
		Если ВРег(ХвостИмени(Пара.Ключ)) = ВРег(ИмяАтрибута) Тогда
			Возврат СокрЛП(Строка(Пара.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ТекстДочернегоУзла(Узел, ИмяЭлемента)
	Для Каждого Ребёнок Из Узел.Элементы Цикл
		Если ВРег(ХвостИмени(Ребёнок.Имя)) = ВРег(ИмяЭлемента) Тогда
			Возврат СокрЛП(Строка(Ребёнок.Текст));
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция НормализоватьСтавкуНДС(СтавкаТекст, Сумма, СуммаНДС)
	Стр = СокрЛП(Строка(СтавкаТекст));
	Если СтрНайти(ВРег(Стр), "БЕЗ") > 0 Тогда
		Возврат "Без НДС";
	КонецЕсли;
	Цифры = "";
	ЕстьРазделитель = Ложь;
	Для Поз = 1 По СтрДлина(Стр) Цикл
		Симв = Сред(Стр, Поз, 1);
		Если Симв = "/" Тогда
			Прервать; // расчётная ставка вида «20/120» — берём числитель
		КонецЕсли;
		Если Симв >= "0" И Симв <= "9" Тогда
			Цифры = Цифры + Симв;
		ИначеЕсли (Симв = "." ИЛИ Симв = ",") И НЕ ЕстьРазделитель И Цифры <> "" Тогда
			Цифры = Цифры + ".";
			ЕстьРазделитель = Истина;
		КонецЕсли;
	КонецЦикла;
	Если СтрЗаканчиваетсяНа(Цифры, ".") Тогда
		Цифры = Лев(Цифры, СтрДлина(Цифры) - 1);
	КонецЕсли;
	Если Цифры <> "" Тогда
		Возврат Цифры + "%";
	КонецЕсли;
	Если СуммаНДС > 0 И Сумма > 0 Тогда
		Возврат Строка(Окр(СуммаНДС / Сумма * 100, 2)) + "%";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ОбеспечитьСтавкуНДС(ИмяСтавки)
	Если НЕ ЗначениеЗаполнено(ИмяСтавки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ставка = Справочники.СтавкаНДС.НайтиПоНаименованию(ИмяСтавки);
	Если ЗначениеЗаполнено(Ставка) Тогда
		Возврат Ставка;
	КонецЕсли;
	НовСтавка = Справочники.СтавкаНДС.Создать();
	НовСтавка.Наименование = ИмяСтавки;
	НовСтавка.Процент = Число(СтрЗаменить(ИмяСтавки, "%", ""));
	НовСтавка.Записать();
	Возврат НовСтавка.Ссылка;
КонецФункции

Функция ОбеспечитьЕдиницуИзмерения(ИмяЕд)
	Если НЕ ЗначениеЗаполнено(ИмяЕд) Тогда
		ИмяЕд = "шт";
	КонецЕсли;
	Ед = Справочники.ЕдиницаИзмерения.НайтиПоНаименованию(ИмяЕд);
	Если ЗначениеЗаполнено(Ед) Тогда
		Возврат Ед;
	КонецЕсли;
	НовЕд = Справочники.ЕдиницаИзмерения.Создать();
	НовЕд.Наименование = ИмяЕд;
	НовЕд.Записать();
	Возврат НовЕд.Ссылка;
КонецФункции

Процедура ОбойтиУзелУПД(Узел, Блок, Результат)
	Имя = ВРег(ХвостИмени(Узел.Имя));

	Если Имя = "ФАЙЛ" Тогда
		ИдЭДО = АтрибУзла(Узел, "ИдФайл");
		Если ИдЭДО <> "" И Результат.ИдентификаторЭДО = "" Тогда
			Результат.ИдентификаторЭДО = ИдЭДО;
		КонецЕсли;

	ИначеЕсли Имя = "СВСЧФАКТ" ИЛИ Имя = "СВДОКПТП" ИЛИ Имя = "ДОКУМЕНТ" Тогда
		Ном = АтрибУзла(Узел, "НомерСчФ");
		Если Ном = "" Тогда Ном = АтрибУзла(Узел, "НомерДок"); КонецЕсли;
		Если Ном <> "" И Результат.НомерДок = "" Тогда Результат.НомерДок = Ном; КонецЕсли;
		Дат = АтрибУзла(Узел, "ДатаСчФ");
		Если Дат = "" Тогда Дат = АтрибУзла(Узел, "ДатаДок"); КонецЕсли;
		Если Дат <> "" И Результат.ДатаДок = "" Тогда Результат.ДатаДок = Дат; КонецЕсли;

	ИначеЕсли Имя = "СВПРОД" Тогда
		Блок = "Прод";
	ИначеЕсли Имя = "СВПОКУП" Тогда
		Блок = "Покуп";

	ИначеЕсли Имя = "СВЮЛУЧ" ИЛИ Имя = "СВИП" ИЛИ Имя = "ИДСВ" Тогда
		Если Блок = "Прод" ИЛИ Блок = "Покуп" Тогда
			Инн = АтрибУзла(Узел, "ИННЮЛ");
			Если Инн = "" Тогда Инн = АтрибУзла(Узел, "ИННФЛ"); КонецЕсли;
			Кпп = АтрибУзла(Узел, "КПП");
			Наим = АтрибУзла(Узел, "НаимОрг");
			Если Блок = "Прод" Тогда
				Если Инн <> "" Тогда Результат.ПродавецИНН = Инн; КонецЕсли;
				Если Кпп <> "" Тогда Результат.ПродавецКПП = Кпп; КонецЕсли;
				Если Наим <> "" Тогда Результат.ПродавецНаим = Наим; КонецЕсли;
			Иначе
				Если Инн <> "" Тогда Результат.ПокупательИНН = Инн; КонецЕсли;
				Если Кпп <> "" Тогда Результат.ПокупательКПП = Кпп; КонецЕсли;
				Если Наим <> "" Тогда Результат.ПокупательНаим = Наим; КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли Имя = "СВЕДТОВ" Тогда
		Товар = Новый Структура;
		Товар.Вставить("НомСтр", АтрибУзла(Узел, "НомСтр"));
		Товар.Вставить("НаимТов", АтрибУзла(Узел, "НаимТов"));
		Товар.Вставить("Артикул", АтрибУзла(Узел, "АртикулТов"));
		Товар.Вставить("КодТов", "");
		Товар.Вставить("ОКЕИ", АтрибУзла(Узел, "ОКЕИ_Тов"));
		Товар.Вставить("ЕдИзм", АтрибУзла(Узел, "НаимЕдИзм"));
		Если Товар.ЕдИзм = "" Тогда Товар.ЕдИзм = "шт"; КонецЕсли;

		Кол = Число(АтрибУзла(Узел, "КолТов"));
		Товар.Вставить("Количество", Кол);

		Цена = Число(АтрибУзла(Узел, "ЦенаТов"));
		Товар.Вставить("Цена", Цена);

		СуммаНДСТекст = АтрибУзла(Узел, "СумНал");
		Если СуммаНДСТекст = "" Тогда
			СуммаНДСТекст = ТекстДочернегоУзла(Узел, "СумНал");
		КонецЕсли;
		СуммаНДС = Число(СуммаНДСТекст);
		Всего = Число(АтрибУзла(Узел, "СтТовУчНал"));
		Сумма = Число(АтрибУзла(Узел, "СтТовБезНДС"));
		Если Сумма = 0 И (Всего > 0 ИЛИ СуммаНДС > 0) Тогда
			// Кривая выгрузка без нетто: выводим из «всего»
			Сумма = Всего - СуммаНДС;
		КонецЕсли;
		Товар.Вставить("Сумма", Сумма);

		Товар.Вставить("СтавкаНДС", НормализоватьСтавкуНДС(АтрибУзла(Узел, "НалСт"), Сумма, СуммаНДС));
		Товар.Вставить("СуммаНДС", СуммаНДС);

		Если Всего = 0 Тогда Всего = Сумма + СуммаНДС; КонецЕсли;
		Товар.Вставить("Всего", Всего);

		Если Цена = 0 И Кол > 0 И Сумма > 0 Тогда
			Товар.Цена = Сумма / Кол;
		КонецЕсли;

		// Если артикул пуст — пробуем извлечь из начала наименования
		Если Товар.Артикул = "" Тогда
			Товар.Артикул = ИзвлечьАртикулИзНаименования(Товар.НаимТов);
		КонецЕсли;

		Результат.Товары.Добавить(Товар);

	ИначеЕсли Имя = "ДОПСВЕДТОВ" Тогда
		Если Результат.Товары.Количество() > 0 Тогда
			ТекТовар = Результат.Товары[Результат.Товары.Количество() - 1];
			Код = АтрибУзла(Узел, "КодТов");
			Если Код <> "" Тогда
				ТекТовар.КодТов = Код;
				Если ТекТовар.Артикул = "" Тогда
					ТекТовар.Артикул = Код;
				КонецЕсли;
			КонецЕсли;
			Арт = АтрибУзла(Узел, "Артикул");
			Если Арт <> "" Тогда
				ТекТовар.Артикул = Арт;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Для Каждого Ребёнок Из Узел.Элементы Цикл
		ОбойтиУзелУПД(Ребёнок, Блок, Результат);
	КонецЦикла;
КонецПроцедуры

Функция РазобратьXML_УПД(ТекстФайла)
	Результат = Новый Структура;
	Результат.Вставить("НомерДок", "");
	Результат.Вставить("ДатаДок", "");
	Результат.Вставить("ПродавецИНН", "");
	Результат.Вставить("ПродавецКПП", "");
	Результат.Вставить("ПродавецНаим", "");
	Результат.Вставить("ПокупательИНН", "");
	Результат.Вставить("ПокупательКПП", "");
	Результат.Вставить("ПокупательНаим", "");
	Результат.Вставить("ИдентификаторЭДО", "");
	Результат.Вставить("СуммаВсего", 0);
	Результат.Вставить("Товары", Новый Массив);

	Корень = ПрочитатьXML(ТекстФайла);
	ОбойтиУзелУПД(Корень, "", Результат);
	Возврат Результат;
КонецФункции

// ── Чтение файла ЭДО (путь или уже готовый текст) ────────────────────────────

Функция ПрочитатьТекстЭДО(Знач ФайлТекст)
	Если СтрНайти(ФайлТекст, Символ(10)) > 0 ИЛИ СтрНайти(ФайлТекст, "<?xml") > 0 Тогда
		Возврат ФайлТекст;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеТекста(ФайлТекст);
		Чтение.Открыть();
		ТекстФайла = Чтение.Прочитать();
		Чтение.Закрыть();
		Возврат ТекстФайла;
	Исключение
		Сообщить("Ошибка чтения файла: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

// ── Сопоставление номенклатуры ───────────────────────────────────────────────

Функция НормализоватьАртикул(Знач АртикулВход, Знач Префикс, Знач ОчищатьСпец)
	Стр = СокрЛП(Строка(АртикулВход));
	Если Стр = "" Тогда
		Возврат "";
	КонецЕсли;

	Если ЗначениеЗаполнено(Префикс) Тогда
		Пр = СокрЛП(Строка(Префикс));
		Если СтрНачинаетсяС(ВРег(Стр), ВРег(Пр)) Тогда
			Стр = Сред(Стр, СтрДлина(Пр) + 1);
		КонецЕсли;
	КонецЕсли;

	Если ОчищатьСпец Тогда
		СпецСимволы = " -_./\,();:+=*#~`'""";
		Рез = "";
		Для Поз = 1 По СтрДлина(Стр) Цикл
			Симв = Сред(Стр, Поз, 1);
			Если СтрНайти(СпецСимволы, Симв) = 0 Тогда
				Рез = Рез + Симв;
			КонецЕсли;
		КонецЦикла;
		Возврат ВРег(Рез);
	Иначе
		Возврат ВРег(СокрЛП(Стр));
	КонецЕсли;
КонецФункции

Функция ИзвлечьАртикулИзНаименования(Наим)
	Стр = СокрЛП(Строка(Наим));
	ПозПробела = СтрНайти(Стр, " ");
	Если ПозПробела > 2 Тогда
		ПервоеСлово = Лев(Стр, ПозПробела - 1);
		ЕстьЦифры = Ложь;
		Для Индекс = 1 По СтрДлина(ПервоеСлово) Цикл
			Симв = Сред(ПервоеСлово, Индекс, 1);
			Если Симв >= "0" И Симв <= "9" Тогда
				ЕстьЦифры = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьЦифры Тогда
			Возврат ПервоеСлово;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция НоменклатураИзВыборкиРегистра(Запрос)
	Рез = Запрос.Выполнить();
	Для Каждого Стр Из Рез Цикл
		Если ЗначениеЗаполнено(Стр.ИдНоменклатуры) Тогда
			Возврат Справочники.Номенклатура.НайтиПоИдентификатору(Стр.ИдНоменклатуры);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПоискПоРегиструСопоставлений(КонтрагентСсылка, АртикулПоставщика, НаимПоставщика)
	Если НЕ ЗначениеЗаполнено(КонтрагентСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Арт = СокрЛП(Строка(АртикулПоставщика));
	НаимС = СокрЛП(Строка(НаимПоставщика));

	Если Арт <> "" И НаимС <> "" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Номенклатура КАК ИдНоменклатуры ИЗ РегистрСведений.НоменклатураКонтрагентов
			ГДЕ Контрагент = &Контрагент И АртикулПоставщика = &Артикул И НаименованиеПоставщика = &Наим";
		Запрос.УстановитьПараметр("Контрагент", КонтрагентСсылка);
		Запрос.УстановитьПараметр("Артикул", Арт);
		Запрос.УстановитьПараметр("Наим", НаимС);
		Найденная = НоменклатураИзВыборкиРегистра(Запрос);
		Если ЗначениеЗаполнено(Найденная) Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;

	Если Арт <> "" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Номенклатура КАК ИдНоменклатуры ИЗ РегистрСведений.НоменклатураКонтрагентов
			ГДЕ Контрагент = &Контрагент И АртикулПоставщика = &Артикул";
		Запрос.УстановитьПараметр("Контрагент", КонтрагентСсылка);
		Запрос.УстановитьПараметр("Артикул", Арт);
		Найденная = НоменклатураИзВыборкиРегистра(Запрос);
		Если ЗначениеЗаполнено(Найденная) Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;

	Если НаимС <> "" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Номенклатура КАК ИдНоменклатуры ИЗ РегистрСведений.НоменклатураКонтрагентов
			ГДЕ Контрагент = &Контрагент И НаименованиеПоставщика = &Наим";
		Запрос.УстановитьПараметр("Контрагент", КонтрагентСсылка);
		Запрос.УстановитьПараметр("Наим", НаимС);
		Найденная = НоменклатураИзВыборкиРегистра(Запрос);
		Если ЗначениеЗаполнено(Найденная) Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;
КонецФункции

Функция ПодобратьНоменклатуруБазы(ПоставщикСсылка, АртикулПоставщика, НаимПоставщика, КодПоставщика, Вариант, Префикс, ОчищатьСпец)
	Сохраненная = ПоискПоРегиструСопоставлений(ПоставщикСсылка, АртикулПоставщика, НаимПоставщика);
	Если ЗначениеЗаполнено(Сохраненная) Тогда
		Рез = Новый Структура;
		Рез.Вставить("Номенклатура", Сохраненная);
		Рез.Вставить("Статус", "✅ Сопоставлено (по регистру)");
		Возврат Рез;
	КонецЕсли;

	НормАртикул = НормализоватьАртикул(АртикулПоставщика, Префикс, ОчищатьСпец);
	НаимПоиск = СокрЛП(Строка(НаимПоставщика));
	Найденные = Новый Массив;

	// 1. По артикулу
	Если (Вариант = "Умный поиск (все варианты)" ИЛИ Вариант = "По артикулу" ИЛИ Вариант = "Артикул + Наименование") И ЗначениеЗаполнено(АртикулПоставщика) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ Артикул = &Арт";
		Запрос.УстановитьПараметр("Арт", СокрЛП(Строка(АртикулПоставщика)));
		Для Каждого Стр Из Запрос.Выполнить() Цикл
			Найденные.Добавить(Стр.Ссылка);
		КонецЦикла;

		Если Найденные.Количество() = 0 И НормАртикул <> "" Тогда
			ЗапросВсе = Новый Запрос;
			ЗапросВсе.Текст = "ВЫБРАТЬ Ссылка, Артикул ИЗ Справочник.Номенклатура";
			Для Каждого Стр Из ЗапросВсе.Выполнить() Цикл
				Если ЗначениеЗаполнено(Стр.Артикул) Тогда
					АртБазыНорм = НормализоватьАртикул(Стр.Артикул, "", ОчищатьСпец);
					Если АртБазыНорм = НормАртикул Тогда
						Найденные.Добавить(Стр.Ссылка);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// 2. По коду
	Если Найденные.Количество() = 0 И (Вариант = "Умный поиск (все варианты)" ИЛИ Вариант = "По коду") И ЗначениеЗаполнено(КодПоставщика) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ Идентификатор1С = &Код ИЛИ Артикул = &Код";
		Запрос.УстановитьПараметр("Код", СокрЛП(Строка(КодПоставщика)));
		Для Каждого Стр Из Запрос.Выполнить() Цикл
			Найденные.Добавить(Стр.Ссылка);
		КонецЦикла;
	КонецЕсли;

	// 3. По наименованию
	Если Найденные.Количество() = 0 И (Вариант = "Умный поиск (все варианты)" ИЛИ Вариант = "По наименованию" ИЛИ Вариант = "Артикул + Наименование") И НаимПоиск <> "" Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ Наименование = &Наим";
		Запрос.УстановитьПараметр("Наим", НаимПоиск);
		Для Каждого Стр Из Запрос.Выполнить() Цикл
			Найденные.Добавить(Стр.Ссылка);
		КонецЦикла;

		Если Найденные.Количество() = 0 И СтрДлина(НаимПоиск) > 5 Тогда
			ЗапросВсе = Новый Запрос;
			ЗапросВсе.Текст = "ВЫБРАТЬ Ссылка, Наименование ИЗ Справочник.Номенклатура";
			Подстрока = ВРег(Лев(НаимПоиск, 15));
			Для Каждого Стр Из ЗапросВсе.Выполнить() Цикл
				Если СтрНайти(ВРег(Стр.Наименование), Подстрока) > 0 Тогда
					Найденные.Добавить(Стр.Ссылка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Рез = Новый Структура;
	Если Найденные.Количество() = 1 Тогда
		Рез.Вставить("Номенклатура", Найденные[0]);
		Рез.Вставить("Статус", "✅ Сопоставлено (точно)");
	ИначеЕсли Найденные.Количество() > 1 Тогда
		Рез.Вставить("Номенклатура", Найденные[0]);
		Рез.Вставить("Статус", "⚠️ Несколько вариантов (" + Строка(Найденные.Количество()) + ")");
	Иначе
		Рез.Вставить("Номенклатура", Неопределено);
		Рез.Вставить("Статус", "❓ Не найдено");
	КонецЕсли;

	Возврат Рез;
КонецФункции

Процедура ЗаписатьВРегистрСопоставлений(КонтрагентСсылка, АртикулПоставщика, НаимПоставщика, НоменклатураСсылка)
	Если НЕ ЗначениеЗаполнено(КонтрагентСсылка) ИЛИ НЕ ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат;
	КонецЕсли;

	МЗ = РегистрыСведений.НоменклатураКонтрагентов.СоздатьМенеджерЗаписи();
	МЗ.Контрагент = КонтрагентСсылка;
	МЗ.АртикулПоставщика = СокрЛП(Строка(АртикулПоставщика));
	МЗ.НаименованиеПоставщика = СокрЛП(Строка(НаимПоставщика));
	МЗ.Номенклатура = НоменклатураСсылка;
	Попытка
		МЗ.Записать();
	Исключение
		Сообщить("ВНИМАНИЕ: сопоставление не сохранено (" + АртикулПоставщика + "): " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция СоздатьНовуюНоменклатуру(Наим, Артикул, ЕдИзм, СтавкаНДС)
	Нов = Справочники.Номенклатура.Создать();
	Нов.Наименование = СокрЛП(Строка(Наим));
	Нов.Артикул = СокрЛП(Строка(Артикул));
	// Ссылочные поля принимают только ссылки: строка «шт»/«20%» молча не сохраняется.
	Нов.ЕдиницаИзмерения = ОбеспечитьЕдиницуИзмерения(ЕдИзм);
	СтавкаСсылка = ОбеспечитьСтавкуНДС(СтавкаНДС);
	Если ЗначениеЗаполнено(СтавкаСсылка) Тогда
		Нов.СтавкаНДС = СтавкаСсылка;
	КонецЕсли;
	Нов.Услуга = Ложь;
	Нов.Записать();
	Возврат Нов.Ссылка;
КонецФункции

// ── Поиск участников по ИНН (safe-match с уточнением по КПП) ─────────────────

Функция НайтиПоставщикаПоИННКПП(ИНН, КПП)
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Совпадение = Справочники.Контрагент.ПроверитьСовпадениеПоРеквизиту("ИНН", ИНН);
	Если Совпадение.Статус = "НайденаОдна" Тогда
		Возврат Совпадение.Ссылка;
	КонецЕсли;
	Если Совпадение.Статус = "НайденоНесколько" И ЗначениеЗаполнено(КПП) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Контрагент ГДЕ ИНН = &ИНН И КПП = &КПП";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		Рез = Запрос.Выполнить();
		Если Рез.Количество() = 1 Тогда
			Возврат Рез[0].Ссылка;
		КонецЕсли;
		Сообщить("ВНИМАНИЕ: несколько контрагентов с ИНН " + ИНН + ", по КПП " + КПП + " не уточнилось — укажите поставщика вручную.");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НайтиОрганизациюПоИНН(ИНН)
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Совпадение = Справочники.Организация.ПроверитьСовпадениеПоРеквизиту("ИНН", ИНН);
	Если Совпадение.Статус = "НайденаОдна" Тогда
		Возврат Совпадение.Ссылка;
	КонецЕсли;
	Если Совпадение.Статус = "НайденоНесколько" Тогда
		Сообщить("ВНИМАНИЕ: несколько организаций с ИНН " + ИНН + " — укажите организацию вручную.");
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ИдентификаторУчастникаУПД(СсылкаУчастника, ИНН, КПП)
	Если ЗначениеЗаполнено(ИНН) Тогда
		Возврат "ИНН=" + СокрЛП(Строка(ИНН)) + ";КПП=" + СокрЛП(Строка(КПП));
	КонецЕсли;
	Если ЗначениеЗаполнено(СсылкаУчастника) Тогда
		Возврат "REF=" + СсылкаУчастника.УникальныйИдентификатор();
	КонецЕсли;
	Возврат "";
КонецФункции

Функция КлючИмпортаУПД(ДанныеУПД, ОрганизацияСсылка, ПоставщикСсылка)
	ОрганизацияИд = ИдентификаторУчастникаУПД(ОрганизацияСсылка, ДанныеУПД.ПокупательИНН, ДанныеУПД.ПокупательКПП);
	ПоставщикИд = ИдентификаторУчастникаУПД(ПоставщикСсылка, ДанныеУПД.ПродавецИНН, ДанныеУПД.ПродавецКПП);
	Возврат "ЭДО:" + Base64Строка(ОрганизацияИд) + "." + Base64Строка(ПоставщикИд)
		+ "." + Base64Строка(СокрЛП(ДанныеУПД.НомерДок))
		+ "." + Base64Строка(СокрЛП(ДанныеУПД.ДатаДок))
		+ "." + Base64Строка(СокрЛП(ДанныеУПД.ИдентификаторЭДО));
КонецФункции

Процедура НачатьЗащищенныйИмпортУПД(ДанныеУПД, ОрганизацияСсылка, ПоставщикСсылка)
	НачатьТранзакцию();
	Попытка
		Блокировка = БлокировкаДанных();
		ЭлементБлокировки = Блокировка.Добавить("НоменклатураКонтрагентов");
		ЭлементБлокировки.УстановитьЗначение("АртикулПоставщика", КлючИмпортаУПД(ДанныеУПД, ОрганизацияСсылка, ПоставщикСсылка));
		Блокировка.Заблокировать();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Функция НайтиЗагруженныйУПД(ДанныеУПД, ОрганизацияСсылка, ПоставщикСсылка)
	Если НЕ ЗначениеЗаполнено(ОрганизацияСсылка)
		ИЛИ НЕ ЗначениеЗаполнено(ПоставщикСсылка)
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеУПД.НомерДок) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ключ = КлючИмпортаУПД(ДанныеУПД, ОрганизацияСсылка, ПоставщикСсылка);
	ДатаУПД = Дата(ДанныеУПД.ДатаДок);
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(ДатаУПД) Тогда
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ПоступлениеТоваров
			ГДЕ Идентификатор1С = &Ключ
			ИЛИ (Организация = &Организация И Поставщик = &Поставщик И Номер = &Номер И Дата = &Дата)";
		Запрос.УстановитьПараметр("Дата", ДатаУПД);
	Иначе
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.ПоступлениеТоваров
			ГДЕ Идентификатор1С = &Ключ
			ИЛИ (Организация = &Организация И Поставщик = &Поставщик И Номер = &Номер)";
	КонецЕсли;
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Запрос.УстановитьПараметр("Организация", ОрганизацияСсылка);
	Запрос.УстановитьПараметр("Поставщик", ПоставщикСсылка);
	Запрос.УстановитьПараметр("Номер", ДанныеУПД.НомерДок);
	Рез = Запрос.Выполнить();
	Если Рез.Количество() > 0 Тогда
		Возврат Рез[0].Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ПроверитьИтогиУПД(Док, СуммаБезНДС, СуммаНДС, СуммаВсего)
	Если Окр(Док.СуммаБезНДС, 2) <> Окр(СуммаБезНДС, 2)
		ИЛИ Окр(Док.СуммаНДС, 2) <> Окр(СуммаНДС, 2)
		ИЛИ Окр(Док.Сумма, 2) <> Окр(СуммаВсего, 2) Тогда
		ВызватьИсключение("Итоги созданного поступления не совпали с УПД: ожидалось "
			+ Строка(СуммаБезНДС) + "/" + Строка(СуммаНДС) + "/" + Строка(СуммаВсего)
			+ ", получено " + Строка(Док.СуммаБезНДС) + "/" + Строка(Док.СуммаНДС) + "/" + Строка(Док.Сумма));
	КонецЕсли;
КонецПроцедуры

// ── Обработчики событий формы ────────────────────────────────────────────────

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
	Если НЕ ЗначениеЗаполнено(Объект.ВариантПоиска) Тогда
		Объект.ВариантПоиска = "Умный поиск (все варианты)";
	КонецЕсли;
	Если Объект.ОчищатьСпецсимволы = Неопределено Тогда
		Объект.ОчищатьСпецсимволы = Истина;
	КонецЕсли;
	Если Объект.СохранятьСопоставления = Неопределено Тогда
		Объект.СохранятьСопоставления = Истина;
	КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаРазобратьНажатие()
	ФайлТекст = Объект.ФайлЭДО;
	Если НЕ ЗначениеЗаполнено(ФайлТекст) Тогда
		Сообщить("Укажите файл УПД (XML) для загрузки!");
		Возврат;
	КонецЕсли;

	ТекстФайла = ПрочитатьТекстЭДО(ФайлТекст);
	Если ТекстФайла = "" Тогда
		Сообщить("Файл пуст!");
		Возврат;
	КонецЕсли;

	ДанныеУПД = РазобратьXML_УПД(ТекстФайла);
	Сообщить("Документ №: " + ДанныеУПД.НомерДок + " от " + ДанныеУПД.ДатаДок + ", позиций: " + Строка(ДанныеУПД.Товары.Количество()));

	// Определение Организации
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = НайтиОрганизациюПоИНН(ДанныеУПД.ПокупательИНН);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ЗапросПервОрг = Новый Запрос;
		ЗапросПервОрг.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Организация";
		РезПервОрг = ЗапросПервОрг.Выполнить();
		Если РезПервОрг.Количество() > 0 Тогда
			Объект.Организация = РезПервОрг[0].Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Определение Поставщика
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Объект.Поставщик = НайтиПоставщикаПоИННКПП(ДанныеУПД.ПродавецИНН, ДанныеУПД.ПродавецКПП);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Существующий = НайтиЗагруженныйУПД(ДанныеУПД, Объект.Организация, Объект.Поставщик);
		Если ЗначениеЗаполнено(Существующий) Тогда
			Объект.Товары.Очистить();
			Сообщить("УПД «" + ДанныеУПД.НомерДок + "» этой организации и поставщика уже загружен — повторный разбор остановлен до создания данных.");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) И Объект.СоздаватьНедостающую = Истина И ЗначениеЗаполнено(ДанныеУПД.ПродавецИНН) Тогда
		НовПост = Справочники.Контрагент.Создать();
		НовПост.Наименование = ?(ДанныеУПД.ПродавецНаим <> "", ДанныеУПД.ПродавецНаим, "Поставщик ИНН " + ДанныеУПД.ПродавецИНН);
		НовПост.ИНН = ДанныеУПД.ПродавецИНН;
		НовПост.КПП = ДанныеУПД.ПродавецКПП;
		НовПост.Вид = "Поставщик";
		НовПост.Записать();
		Объект.Поставщик = НовПост.Ссылка;
		Сообщить("Создан новый контрагент: " + НовПост.Наименование);
	КонецЕсли;

	// Определение Склада
	Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		ЗапросСкл = Новый Запрос;
		ЗапросСкл.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Склад";
		РезСкл = ЗапросСкл.Выполнить();
		Если РезСкл.Количество() > 0 Тогда
			Объект.Склад = РезСкл[0].Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Заполнение таблицы товаров
	Объект.Товары.Очистить();

	Сопоставлено = 0;
	НеНайдено = 0;
	Создано = 0;

	Вариант = ?(ЗначениеЗаполнено(Объект.ВариантПоиска), Объект.ВариантПоиска, "Умный поиск (все варианты)");
	Префикс = Объект.ПрефиксАртикула;
	ОчищатьСпец = ?(Объект.ОчищатьСпецсимволы = Ложь, Ложь, Истина);
	СоздаватьНедост = ?(Объект.СоздаватьНедостающую = Истина, Истина, Ложь);
	СохранятьСопост = ?(Объект.СохранятьСопоставления = Ложь, Ложь, Истина);

	Для Каждого Товар Из ДанныеУПД.Товары Цикл
		СтрТЧ = Объект.Товары.Добавить();
		СтрТЧ.НомерСтроки = Число(Товар.НомСтр);
		СтрТЧ.НаимТов = Товар.НаимТов;
		СтрТЧ.Артикул = Товар.Артикул;
		СтрТЧ.Количество = Товар.Количество;
		СтрТЧ.Цена = Товар.Цена;
		СтрТЧ.Сумма = Товар.Сумма;
		СтрТЧ.СтавкаНДС = Товар.СтавкаНДС;
		СтрТЧ.СуммаНДС = Товар.СуммаНДС;
		СтрТЧ.Всего = Товар.Всего;

		Подбор = ПодобратьНоменклатуруБазы(Объект.Поставщик, Товар.Артикул, Товар.НаимТов, Товар.КодТов, Вариант, Префикс, ОчищатьСпец);

		ТомСсылка = Подбор.Номенклатура;
		Статус = Подбор.Статус;

		Если НЕ ЗначениеЗаполнено(ТомСсылка) И СоздаватьНедост Тогда
			ТомСсылка = СоздатьНовуюНоменклатуру(Товар.НаимТов, Товар.Артикул, Товар.ЕдИзм, Товар.СтавкаНДС);
			Статус = "✨ Создано автоматически";
			Создано = Создано + 1;
		КонецЕсли;

		Если ЗначениеЗаполнено(ТомСсылка) Тогда
			Сопоставлено = Сопоставлено + 1;
			СтрТЧ.Номенклатура = ТомСсылка;
			Если СохранятьСопост И ЗначениеЗаполнено(Объект.Поставщик) Тогда
				ЗаписатьВРегистрСопоставлений(Объект.Поставщик, Товар.Артикул, Товар.НаимТов, ТомСсылка);
			КонецЕсли;
		Иначе
			НеНайдено = НеНайдено + 1;
		КонецЕсли;

		СтрТЧ.Статус = Статус;
	КонецЦикла;

	Сообщить("УПД разобран: строк " + Строка(Объект.Товары.Количество()) + ", сопоставлено: " + Строка(Сопоставлено) + ", создано: " + Строка(Создано) + ", не найдено: " + Строка(НеНайдено));
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаСоздатьНедостающиеНажатие()
	Создано = 0;
	Для Каждого СтрТЧ Из Объект.Товары Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Номенклатура) Тогда
			ТомСсылка = СоздатьНовуюНоменклатуру(СтрТЧ.НаимТов, СтрТЧ.Артикул, "шт", СтрТЧ.СтавкаНДС);
			СтрТЧ.Номенклатура = ТомСсылка;
			СтрТЧ.Статус = "✨ Создано вручную";
			Создано = Создано + 1;

			Если Объект.СохранятьСопоставления <> Ложь И ЗначениеЗаполнено(Объект.Поставщик) Тогда
				ЗаписатьВРегистрСопоставлений(Объект.Поставщик, СтрТЧ.Артикул, СтрТЧ.НаимТов, ТомСсылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Сообщить("Создано новых позиций номенклатуры: " + Строка(Создано));
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаСоздатьДокументНажатие()
	СоздатьДокументПоступления(Ложь);
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаСоздатьИПровестиНажатие()
	СоздатьДокументПоступления(Истина);
КонецПроцедуры

// @directive=&НаСервере
Процедура СоздатьДокументПоступления(Проводить)
	Если Объект.Товары.Количество() = 0 Тогда
		Сообщить("Таблица товаров пуста. Сначала выполните разбор XML!");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Сообщить("Укажите организацию!");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Сообщить("Укажите поставщика!");
		Возврат;
	КонецЕсли;

	// Номер и дата — из УПД (перечитываем файл; в ТЧ формы они не хранятся)
	ДанныеУПД = Неопределено;
	Если ЗначениеЗаполнено(Объект.ФайлЭДО) Тогда
		ТекстФайла = ПрочитатьТекстЭДО(Объект.ФайлЭДО);
		Если ТекстФайла <> "" Тогда
			ДанныеУПД = РазобратьXML_УПД(ТекстФайла);
		КонецЕсли;
	КонецЕсли;
	НомерУПД = "";
	Если ДанныеУПД <> Неопределено Тогда
		НомерУПД = ДанныеУПД.НомерДок;
	КонецЕсли;
	Если ДанныеУПД = Неопределено Тогда
		Сообщить("Не удалось перечитать исходный УПД; создание документа отменено.");
		Возврат;
	КонецЕсли;

	НачатьЗащищенныйИмпортУПД(ДанныеУПД, Объект.Организация, Объект.Поставщик);
	Существующий = НайтиЗагруженныйУПД(ДанныеУПД, Объект.Организация, Объект.Поставщик);
	Если ЗначениеЗаполнено(Существующий) Тогда
		ОтменитьТранзакцию();
		Сообщить("УПД «" + НомерУПД + "» этой организации и поставщика уже загружен — создание отменено без побочных эффектов.");
		Возврат;
	КонецЕсли;

	Док = Документы.ПоступлениеТоваров.Создать();
	Если НомерУПД <> "" Тогда
		Док.Номер = НомерУПД;
	КонецЕсли;
	Док.Идентификатор1С = КлючИмпортаУПД(ДанныеУПД, Объект.Организация, Объект.Поставщик);
	Если ДанныеУПД <> Неопределено И ЗначениеЗаполнено(ДанныеУПД.ДатаДок) Тогда
		// Дата — из УПД, а не дата загрузки: иначе съезжают партии и периоды.
		Док.Дата = Дата(ДанныеУПД.ДатаДок);
		Если НЕ ЗначениеЗаполнено(Док.Дата) Тогда
			Док.Дата = ТекущаяДатаВремя();
		КонецЕсли;
	Иначе
		Док.Дата = ТекущаяДатаВремя();
	КонецЕсли;
	Док.Организация = Объект.Организация;
	Док.Поставщик = Объект.Поставщик;
	Док.Склад = Объект.Склад;
	// Суммы УПД — нетто + НДС сверху. Без этого хук ПриЗаписи пересчитает
	// НДС «в том числе» и исказит суммы документа.
	Док.СпособУчетаНДС = "Сверху";

	СуммаБезНДСИтог = 0;
	СуммаНДСИтог = 0;
	СуммаИтог = 0;
	ДобавленоСтрок = 0;

	Для Каждого Стр Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда
			СтрТЧ = Док.Товары.Добавить();
			СтрТЧ.Номенклатура = Стр.Номенклатура;
			СтрТЧ.Количество = Стр.Количество;
			СтрТЧ.Цена = Стр.Цена;
			СтрТЧ.Сумма = Стр.Сумма;
			СтрТЧ.СуммаНДС = Стр.СуммаНДС;

			СтавкаСсылка = ОбеспечитьСтавкуНДС(Стр.СтавкаНДС);
			Если ЗначениеЗаполнено(СтавкаСсылка) Тогда
				СтрТЧ.СтавкаНДС = СтавкаСсылка;
			КонецЕсли;

			СуммаБезНДСИтог = СуммаБезНДСИтог + Стр.Сумма;
			СуммаНДСИтог = СуммаНДСИтог + Стр.СуммаНДС;
			СуммаИтог = СуммаИтог + Стр.Всего;
			ДобавленоСтрок = ДобавленоСтрок + 1;

			// Если пользователь выбрал номенклатуру вручную, сохраним её сопоставление
			Если Объект.СохранятьСопоставления <> Ложь И ЗначениеЗаполнено(Объект.Поставщик) Тогда
				ЗаписатьВРегистрСопоставлений(Объект.Поставщик, Стр.Артикул, Стр.НаимТов, Стр.Номенклатура);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ДобавленоСтрок = 0 Тогда
		ОтменитьТранзакцию();
		Сообщить("Нет сопоставленных позиций для создания документа!");
		Возврат;
	КонецЕсли;

	Док.СуммаБезНДС = СуммаБезНДСИтог;
	Док.СуммаНДС = СуммаНДСИтог;
	Док.Сумма = СуммаИтог;

	Док.Записать();
	ПроверитьИтогиУПД(Док, СуммаБезНДСИтог, СуммаНДСИтог, СуммаИтог);
	Сообщить("✅ Документ «Поступление товаров» № " + Док.Номер + " от " + Формат(Док.Дата, "ДФ=dd.MM.yyyy") + " успешно создан!");

	Если Проводить Тогда
		Попытка
			Док.Провести();
			Сообщить("🚀 Документ «Поступление товаров» успешно ПРОВЕДЕН!");
		Исключение
			Сообщить("ВНИМАНИЕ: Ошибка при проведении документа: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	ЗафиксироватьТранзакцию();
КонецПроцедуры

// АРМ Инвентаризации — пересчёт склада, оформление излишков и недостач.
// Заполняет учётный остаток (СУММА по номенклатуре), факт правит кладовщик.
// По отклонению создаёт одно Оприходование (излишки, средняя цена остатка) и
// одно Списание (недостачи, себестоимость спишет FIFO).

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДата();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = СкладПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
// Пересчёт отклонения при правке факта.
Процедура ТабВедомостьПриИзменении()
    Для Каждого Стр Из Объект.Ведомость Цикл
        Стр.Отклонение = Стр.Факт - Стр.Учёт;
    КонецЦикла;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаЗаполнитьНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());

    // Свёртка по номенклатуре (один склад — несколько организаций/строк среза).
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
                      Номенклатура КАК Номенклатура,
                      СУММА(КоличествоОстаток) КАК Кол
                    ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент)
                    ГДЕ Склад = &Склад
                    СГРУППИРОВАТЬ ПО Номенклатура
                    ИМЕЯ СУММА(КоличествоОстаток) <> 0";
    Запрос.УстановитьПараметр("Склад", Объект.Склад);
    Запрос.УстановитьПараметр("Момент", Момент);

    Объект.Ведомость.Очистить();
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        Нов = Объект.Ведомость.Добавить();
        Нов.Номенклатура = Стр.Номенклатура;
        Нов.Учёт         = Стр.Кол;
        Нов.Факт         = Стр.Кол;
        Нов.Отклонение   = 0;
    КонецЦикла;

    Если Объект.Ведомость.Количество() = 0 Тогда
        Сообщить("На складе нет остатков для пересчёта");
    Иначе
        Сообщить("Заполнено позиций: " + Строка(Объект.Ведомость.Количество())
            + ". Внесите фактическое количество.");
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Ведомость.Очистить();
    Сообщить("Ведомость очищена");
КонецПроцедуры

// @directive=&НаСервере
// Излишки → Оприходование (цена = средняя из остатка), недостачи → Списание.
Процедура КнопкаОформитьНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Если Объект.Ведомость.Количество() = 0 Тогда
        ВызватьИсключение("Сначала заполните ведомость");
    КонецЕсли;
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
    Орг    = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());

    // Средняя себестоимость остатка для оприходования излишков.
    СредЦена = Новый Соответствие;
    ЗСред = Новый Запрос;
    ЗСред.Текст = "ВЫБРАТЬ
                     Номенклатура КАК Номенклатура,
                     СУММА(КоличествоОстаток) КАК Кол,
                     СУММА(СуммаОстаток) КАК Сум
                   ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент)
                   ГДЕ Склад = &Склад
                   СГРУППИРОВАТЬ ПО Номенклатура";
    ЗСред.УстановитьПараметр("Склад", Объект.Склад);
    ЗСред.УстановитьПараметр("Момент", Момент);
    Для Каждого Стр Из ЗСред.Выполнить() Цикл
        Если Стр.Кол > 0 Тогда
            СредЦена.Вставить(Стр.Номенклатура, Окр(Стр.Сум / Стр.Кол, 2));
        КонецЕсли;
    КонецЦикла;

    Попытка
        Опр = Неопределено;
        Спис = Неопределено;
        ИзлишковПозиций = 0;
        НедостачПозиций = 0;

        Для Каждого Стр Из Объект.Ведомость Цикл
            Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда Продолжить; КонецЕсли;
            Откл = Стр.Факт - Стр.Учёт;
            Если Откл > 0 Тогда
                Если Опр = Неопределено Тогда
                    Опр = Документы.ОприходованиеТоваров.Создать();
                    Опр.Дата = Момент; Опр.Организация = Орг; Опр.Склад = Объект.Склад;
                    Опр.Причина = "Излишки по инвентаризации (АРМ)";
                КонецЕсли;
                СтрО = Опр.Товары.Добавить();
                СтрО.Номенклатура = Стр.Номенклатура;
                СтрО.Количество   = Откл;
                Цена = СредЦена.Получить(Стр.Номенклатура);
                СтрО.Цена = ?(Цена = Неопределено, 0, Цена);
                ИзлишковПозиций = ИзлишковПозиций + 1;
            ИначеЕсли Откл < 0 Тогда
                Если Спис = Неопределено Тогда
                    Спис = Документы.СписаниеТоваров.Создать();
                    Спис.Дата = Момент; Спис.Организация = Орг; Спис.Склад = Объект.Склад;
                    Спис.Причина = "Недостачи по инвентаризации (АРМ)";
                КонецЕсли;
                СтрС = Спис.Товары.Добавить();
                СтрС.Номенклатура = Стр.Номенклатура;
                СтрС.Количество   = -Откл;
                НедостачПозиций = НедостачПозиций + 1;
            КонецЕсли;
        КонецЦикла;

        Если ИзлишковПозиций = 0 И НедостачПозиций = 0 Тогда
            ВызватьИсключение("Отклонений нет — оформлять нечего");
        КонецЕсли;

        Результат = "";
        Если Опр <> Неопределено Тогда
            Опр.Записать(); Опр.Провести();
            Результат = "Оприходование № " + Опр.Номер + " (" + Строка(ИзлишковПозиций) + " позиц.)";
        КонецЕсли;
        Если Спис <> Неопределено Тогда
            Спис.Записать(); Спис.Провести();
            Результат = Результат + ?(Результат = "", "", "; ")
                + "Списание № " + Спис.Номер + " (" + Строка(НедостачПозиций) + " позиц.)";
        КонецЕсли;

        Сообщить("Оформлено: " + Результат);
    Исключение
        ВызватьИсключение("Не удалось оформить инвентаризацию: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Обработчики управляемой формы «Разборка товаров».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДатаВремя();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = СкладПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПередЗаписьюФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Если Объект.Расход.Количество() = 0 Тогда
        ВызватьИсключение("Добавьте продукцию для разборки");
    КонецЕсли;
    Если Объект.Приход.Количество() = 0 Тогда
        ВызватьИсключение("Добавьте комплектующие");
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПриЗаписиФормы()
    Сообщить("Разборка № " + Объект.Номер + " сохранена");
КонецПроцедуры

// @directive=&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаКлиенте
Процедура СкладПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьРасходНажатие()
    Объект.Расход.Очистить();
    Сообщить("Продукция очищена");
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьПриходНажатие()
    Объект.Приход.Очистить();
    Сообщить("Комплектующие очищены");
КонецПроцедуры

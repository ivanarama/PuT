// АРМ Продавца — рабочее место менеджера продаж.
// Подбор по свободному остатку склада (остаток − чужие резервы), цены из прайса,
// оформление реализации и (опционально) ПКО в один клик. Цены/НДС/себестоимость/
// резервы/FIFO считает запись и проведение РеализацииТоваров — АРМ движений не делает.

// ── События уровня формы ──────────────────────────────────────────────────

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДата();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = СкладПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// ── События полей ─────────────────────────────────────────────────────────

// @directive=&НаКлиенте
Процедура ПокупательПриИзменении(Элемент)
    Если ЗначениеЗаполнено(Объект.Покупатель) Тогда
        ТипЦен = ЗначениеРеквизитаОбъекта(Объект.Покупатель, "ТипЦенПродажи");
        Если ЗначениеЗаполнено(ТипЦен) И НЕ ЗначениеЗаполнено(Объект.ТипЦенПродажи) Тогда
            Объект.ТипЦенПродажи = ТипЦен;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

// @directive=&НаКлиенте
Процедура ТипЦенПродажиПриИзменении(Элемент)
    Если ЗначениеЗаполнено(Объект.ТипЦенПродажи) Тогда
        Для Каждого Стр Из Объект.Товары Цикл
            Если Стр.Цена = 0 И ЗначениеЗаполнено(Стр.Номенклатура) Тогда
                Стр.Цена = ПолучитьЦену(Стр.Номенклатура, Объект.ТипЦенПродажи, Объект.Дата);
                Стр.Сумма = Стр.Количество * Стр.Цена;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
// Авто-пересчёт суммы строки при правке количества/цены в гриде.
Процедура ТабТоварыПриИзменении()
    Для Каждого Стр Из Объект.Товары Цикл
        Если Стр.Цена = 0 И ЗначениеЗаполнено(Стр.Номенклатура) И ЗначениеЗаполнено(Объект.ТипЦенПродажи) Тогда
            Стр.Цена = ПолучитьЦену(Стр.Номенклатура, Объект.ТипЦенПродажи, Объект.Дата);
        КонецЕсли;
        Стр.Сумма = Стр.Количество * Стр.Цена;
    КонецЦикла;
КонецПроцедуры

// ── Подбор товара ───────────────────────────────────────────────────────────

// @directive=&НаСервере
// ФАЗА 1 — собрать свободные остатки склада и открыть диалог подбора.
Процедура КнопкаПодборНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Сначала укажите склад");
    КонецЕсли;
    Орг = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());

    // Уже добавленные позиции исключаем из предложения (по наименованию).
    Есть = Новый Соответствие;
    Для Каждого Стр Из Объект.Товары Цикл
        Есть.Вставить(Строка(Стр.Номенклатура), Истина);
    КонецЦикла;

    Кандидаты = СвободныеОстаткиСклада(Объект.Склад, Орг, Неопределено, Момент);

    Колонки = Новый Массив;
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип,Редактируемое", "Номенклатура", "Номенклатура", "string", Ложь));
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип,Редактируемое", "Свободно",     "Свободно",     "number", Ложь));
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип,Редактируемое", "Цена",         "Цена",         "number", Ложь));
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип,Редактируемое", "Количество",   "Кол-во",       "number", Истина));

    Данные = Новый Массив;
    Для Каждого К Из Кандидаты Цикл
        Имя = Строка(К.Номенклатура);
        Если Есть.Получить(Имя) <> Неопределено Тогда Продолжить; КонецЕсли;
        Цена = 0;
        Если ЗначениеЗаполнено(Объект.ТипЦенПродажи) Тогда
            Цена = ПолучитьЦену(К.Номенклатура, Объект.ТипЦенПродажи, Момент);
        КонецЕсли;
        Данные.Добавить(Новый Структура(
            "Идентификатор,Номенклатура,Свободно,Цена,Количество",
            Имя, Имя, К.Свободно, Цена, 0));
    КонецЦикла;

    Если Данные.Количество() = 0 Тогда
        Сообщить("Свободных остатков на складе нет");
        Возврат;
    КонецЕсли;

    Конфиг = Новый Структура("Заголовок,ПолеПоиска,ПолеКоличества,ВыбратьВсе",
        "Подбор по свободному остатку", "Номенклатура", "Количество", Ложь);

    ПоказатьПодбор(Данные, Колонки, Конфиг);
КонецПроцедуры

// @directive=&НаСервере
// ФАЗА 2 — перенести отмеченные строки в табличную часть.
Процедура КнопкаПодборВыбор()
    Добавлено = 0;
    Для Каждого Стр Из ПодборРезультат Цикл
        Кол = Число(Стр.Количество);
        Если Кол <= 0 Тогда Продолжить; КонецЕсли;
        НомСсылка = Справочники.Номенклатура.НайтиПоНаименованию(Стр.Номенклатура);
        Если ЗначениеЗаполнено(НомСсылка) = Ложь Тогда Продолжить; КонецЕсли;
        Нов = Объект.Товары.Добавить();
        Нов.Номенклатура = НомСсылка;
        Нов.Свободно     = Число(Стр.Свободно);
        Нов.Количество   = Кол;
        Если ЗначениеЗаполнено(Объект.ТипЦенПродажи) Тогда
            Нов.Цена = ПолучитьЦену(НомСсылка, Объект.ТипЦенПродажи, Объект.Дата);
        КонецЕсли;
        Нов.Сумма = Нов.Количество * Нов.Цена;
        Добавлено = Добавлено + 1;
    КонецЦикла;
    Сообщить(?(Добавлено = 0, "Ничего не выбрано", "Подобрано позиций: " + Строка(Добавлено)));
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Товары.Очистить();
    Сообщить("Таблица товаров очищена");
КонецПроцедуры

// ── Оформление продажи ───────────────────────────────────────────────────────

// @directive=&НаСервере
// Создаёт и проводит РеализациюТоваров; при «Оплатить сразу» — ещё и ПКО.
// Контроль свободного остатка и FIFO выполняет проведение реализации.
Процедура КнопкаОформитьНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Покупатель) Тогда
        ВызватьИсключение("Укажите покупателя");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Если Объект.Товары.Количество() = 0 Тогда
        ВызватьИсключение("Подберите хотя бы одну позицию");
    КонецЕсли;
    Если Объект.ОплатитьСразу И НЕ ЗначениеЗаполнено(Объект.Касса) Тогда
        ВызватьИсключение("Для оплаты сразу укажите наличную кассу");
    КонецЕсли;

    Дата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());

    Попытка
        Реал = Документы.РеализацияТоваров.Создать();
        Реал.Дата          = Дата;
        Реал.Организация   = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());
        Реал.Покупатель    = Объект.Покупатель;
        Реал.Склад         = Объект.Склад;
        Реал.ТипЦенПродажи = Объект.ТипЦенПродажи;
        Реал.СпособУчетаНДС = "ВТомЧисле";
        Для Каждого Стр Из Объект.Товары Цикл
            Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) ИЛИ Стр.Количество <= 0 Тогда Продолжить; КонецЕсли;
            СтрР = Реал.Товары.Добавить();
            СтрР.Номенклатура = Стр.Номенклатура;
            СтрР.Количество   = Стр.Количество;
            СтрР.Цена         = Стр.Цена;
        КонецЦикла;
        Реал.Записать();
        Реал.Провести();

        Результат = "Реализация № " + Реал.Номер + " на сумму " + Строка(Реал.Сумма) + " проведена";

        Если Объект.ОплатитьСразу Тогда
            ПКО = Документы.ПриходныйКассовыйОрдер.Создать();
            ПКО.Дата              = Дата;
            ПКО.Организация       = Реал.Организация;
            ПКО.Касса             = Объект.Касса;
            ПКО.Контрагент        = Объект.Покупатель;
            ПКО.ДокументРеализации = Реал.Ссылка;
            ПКО.Основание         = "Оплата по реализации " + Реал.Номер;
            ПКО.Сумма             = Реал.Сумма;
            ПКО.Записать();
            ПКО.Провести();
            Результат = Результат + "; ПКО № " + ПКО.Номер + " на " + Строка(ПКО.Сумма);
        КонецЕсли;

        Объект.Товары.Очистить();
        Сообщить(Результат);
    Исключение
        ВызватьИсключение("Не удалось оформить продажу: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

// Обработчики управляемой формы «Сборка товаров».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если ЗначениеЗаполнено(Объект.Спецификация) Тогда
      Объект.ИзделиеПодбора = ЗначениеРеквизитаОбъекта(Объект.Спецификация, "Номенклатура");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДатаВремя();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = СкладПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПередЗаписьюФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Если Объект.Расход.Количество() = 0 Тогда
        ВызватьИсключение("Добавьте комплектующие");
    КонецЕсли;
    Если Объект.Приход.Количество() = 0 Тогда
        ВызватьИсключение("Добавьте готовую продукцию");
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПриЗаписиФормы()
    Сообщить("Сборка № " + Объект.Номер + " сохранена");
КонецПроцедуры// @directive=&НаСервере
Процедура КнопкаОчиститьРасходНажатие()
    Объект.Расход.Очистить();
    Сообщить("Комплектующие очищены");
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьПриходНажатие()
    Объект.Приход.Очистить();
    Сообщить("Продукция очищена");
КонецПроцедуры

Процедура ИзделиеИзменено()
  Объект.Спецификация = Неопределено;
КонецПроцедуры

Процедура ЗаполнитьПоСпецификацииФормы()
  Если НЕ ЗначениеЗаполнено(Объект.Спецификация) Тогда ВызватьИсключение("Выберите изделие и его спецификацию"); КонецЕсли;
  Спец = Объект.Спецификация.ПолучитьОбъект();
  Если Спец.Номенклатура <> Объект.ИзделиеПодбора Тогда ВызватьИсключение("Спецификация принадлежит другому изделию"); КонецЕсли;
  Если Спец.Состав.Количество() = 0 Тогда ВызватьИсключение("В спецификации нет комплектующих"); КонецЕсли;
  Объект.Расход.Очистить();
  Объект.Приход.Очистить();
  Для Каждого Стр Из Спец.Состав Цикл
    Новая = Объект.Расход.Добавить();
    Новая.Номенклатура = Стр.Номенклатура;
    Новая.Количество = Стр.Количество;
  КонецЦикла;
  Новая = Объект.Приход.Добавить();
  Новая.Номенклатура = Спец.Номенклатура;
  Новая.Количество = ?(Спец.Количество > 0, Спец.Количество, 1);
КонецПроцедуры

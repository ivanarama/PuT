// Обработчики управляемой формы «Перемещение товаров».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДата();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПередЗаписьюФормы()
    Если НЕ ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда
        ВызватьИсключение("Укажите склад-отправитель");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.СкладПолучатель) Тогда
        ВызватьИсключение("Укажите склад-получатель");
    КонецЕсли;
    Если Объект.СкладОтправитель = Объект.СкладПолучатель Тогда
        ВызватьИсключение("Склад-отправитель и склад-получатель не могут совпадать");
    КонецЕсли;
    Если Объект.Товары.Количество() = 0 Тогда
        ВызватьИсключение("Добавьте хотя бы одну строку в табличную часть");
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПриЗаписиФормы()
    Сообщить("Перемещение № " + Объект.Номер + " сохранено");
КонецПроцедуры

// @directive=&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаКлиенте
Процедура СкладОтправительПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаКлиенте
Процедура СкладПолучательПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Товары.Очистить();
    Сообщить("Таблица товаров очищена");
КонецПроцедуры

// @directive=&НаКлиенте
Процедура КнопкаПечатьНажатие()
    Печать();
КонецПроцедуры

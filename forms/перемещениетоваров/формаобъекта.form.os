// Обработчики управляемой формы «Перемещение товаров».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДата();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПередЗаписьюФормы()
    Если НЕ ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда
        ВызватьИсключение("Укажите склад-отправитель");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.СкладПолучатель) Тогда
        ВызватьИсключение("Укажите склад-получатель");
    КонецЕсли;
    Если Объект.СкладОтправитель = Объект.СкладПолучатель Тогда
        ВызватьИсключение("Склад-отправитель и склад-получатель не могут совпадать");
    КонецЕсли;
    Если Объект.Товары.Количество() = 0 Тогда
        ВызватьИсключение("Добавьте хотя бы одну строку в табличную часть");
    КонецЕсли;
    ПересчитатьИтоги();
КонецПроцедуры

// @directive=&НаСервере
Процедура ПриЗаписиФормы()
    Сообщить("Перемещение № " + Объект.Номер + " на сумму " + Строка(Объект.Сумма) + " сохранено");
КонецПроцедуры

// @directive=&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаКлиенте
Процедура СкладОтправительПриИзменении(Элемент)
    Если ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда
        Сообщить("Отправитель: " + Строка(Объект.СкладОтправитель));
    КонецЕсли;
КонецПроцедуры

// @directive=&НаКлиенте
Процедура СкладПолучательПриИзменении(Элемент)
    Если ЗначениеЗаполнено(Объект.СкладПолучатель) Тогда
        Сообщить("Получатель: " + Строка(Объект.СкладПолучатель));
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаПересчитатьНажатие()
    ПересчитатьИтоги();
    Сообщить("Итоги пересчитаны: сумма " + Строка(Объект.Сумма));
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Товары.Очистить();
    Объект.Сумма = 0;
    Сообщить("Таблица товаров очищена");
КонецПроцедуры

// @directive=&НаСервере
Процедура ПересчитатьИтоги()
    Итог = 0;
    Для Каждого Стр Из Объект.Товары Цикл
        Стр.Сумма = Стр.Количество * Стр.Себестоимость;
        Итог = Итог + Стр.Сумма;
    КонецЦикла;
    Объект.Сумма = Итог;
КонецПроцедуры

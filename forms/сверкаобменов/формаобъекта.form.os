Процедура ОбновитьИсторию()
  Запрос = Новый Запрос;
  Ограничение = ?(ЗначениеЗаполнено(Объект.Загрузка), "", "ПЕРВЫЕ 100 ");
  Условие = " ГДЕ Ж.deletion_mark = Ложь";
  Если ЗначениеЗаполнено(Объект.Загрузка) Тогда
    Условие = Условие + " И Ж.Загрузка = &Загрузка";
    Запрос.УстановитьПараметр("Загрузка", Объект.Загрузка);
  КонецЕсли;
  Если ЗначениеЗаполнено(Объект.СтатусОтбора) И Объект.СтатусОтбора <> "Все" Тогда
    Условие = Условие + " И Ж.Статус = &Статус";
    Запрос.УстановитьПараметр("Статус", Объект.СтатусОтбора);
  КонецЕсли;
  Запрос.Текст = "ВЫБРАТЬ " + Ограничение + "Ж.Ссылка КАК Ид, Ж.ДоступенПовтор КАК Повтор, Ж.Момент КАК Момент, Ж.Обмен КАК Обмен, Ж.Наименование КАК Наименование, Ж.Статус КАК Статус, Ж.Описание КАК Описание, Ж.Загрузка.Наименование КАК Источник ИЗ Справочник.ЖурналОбменов КАК Ж" + Условие + " УПОРЯДОЧИТЬ ПО Ж.Момент УБЫВ, Ж.Ссылка";
  Объект.История.Очистить();
  Результат = Запрос.Выполнить();
  Если Объект.СтатусОтбора = "Ошибка" И ЗначениеЗаполнено(Объект.Загрузка) Тогда
    Объект.ЗаписьЖурнала = Неопределено;
    Если Результат.Количество() = 1 И Результат[0].Повтор Тогда
      Объект.ЗаписьЖурнала = Справочники.ЖурналОбменов.НайтиПоИдентификатору(УИДСсылки(Результат[0].Ид));
    КонецЕсли;
  КонецЕсли;
  Для Каждого Запись Из Результат Цикл
    Стр = Объект.История.Добавить();
    Стр.Источник = Запись.Источник;
    Стр.Момент = Запись.Момент; Стр.Обмен = Запись.Обмен; Стр.Документ = Запись.Наименование;
    Стр.Статус = Запись.Статус; Стр.Описание = Запись.Описание;
  КонецЦикла;
КонецПроцедуры

Процедура ПовторитьСтроку()
  Если ЗначениеЗаполнено(Объект.Загрузка) И ЗначениеЗаполнено(Объект.ЗаписьЖурнала) Тогда
    ЗагрузкаСтроки = ЗначениеРеквизитаОбъекта(Объект.ЗаписьЖурнала, "Загрузка");
    Если УИДСсылки(ЗагрузкаСтроки) <> УИДСсылки(Объект.Загрузка) Тогда ВызватьИсключение("Выберите ошибку из выбранной загрузки"); КонецЕсли;
  КонецЕсли;
  Результат = ПовторитьОшибкуОбмена(Объект.ЗаписьЖурнала);
  Сообщить(ЗаписатьJSON(Результат));
  ОбновитьИсторию();
КонецПроцедуры

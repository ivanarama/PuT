// Обработчики управляемой формы «Загрузка банковской выписки».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Формат) Тогда
        Объект.Формат = "Авто";
    КонецЕсли;
КонецПроцедуры

Процедура ЗагрузитьНажатие()
    Результат = ОбработатьБанковскуюВыписку(Объект.ТекстВыгрузки, Объект.БанковскийСчёт, Объект.Формат, "Предпросмотр");
    Объект.Платежи.Очистить();
    Для Каждого Платёж Из Результат.Платежи Цикл
        Стр = Объект.Платежи.Добавить();
        Стр.Дата = Платёж.Дата;
        Стр.Тип = Платёж.Тип;
        Стр.Контрагент = Платёж.Контрагент;
        Стр.Сумма = Платёж.Сумма;
        Стр.НазначениеПлатежа = Платёж.НазначениеПлатежа;
        Если Платёж.Свойство("Номер") Тогда
            Стр.НомерПлатёжки = Платёж.Номер;
        КонецЕсли;
    КонецЦикла;

    Сообщить("Платежей в выписке: " + Строка(Результат.Всего));
КонецПроцедуры

Процедура ЗаписатьНажатие()
    ВыполнитьДействие("Записать");
КонецПроцедуры

Процедура ЗаписатьИПровестиНажатие()
    ВыполнитьДействие("ЗаписатьИПровести");
КонецПроцедуры

Процедура ВыполнитьДействие(Действие)
    Результат = ОбработатьБанковскуюВыписку(Объект.ТекстВыгрузки, Объект.БанковскийСчёт, Объект.Формат, Действие, Объект.Организация, Объект.ИсточникОбмена);
    Сообщить(ЗаписатьJSON(Результат));
КонецПроцедуры

// Обработчики управляемой формы «Загрузка банковской выписки».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Формат) Тогда
        Объект.Формат = "Авто";
    КонецЕсли;
КонецПроцедуры

// @directive=&НаКлиенте
Процедура ЗагрузитьНажатие()
    ТекстВыгрузки = Объект.ТекстВыгрузки;
    Если ТекстВыгрузки = "" Тогда
        Сообщить("Выберите файл выгрузки клиент-банка");
        Возврат;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.БанковскийСчёт) Тогда
        Сообщить("Укажите банковский счёт");
        Возврат;
    КонецЕсли;

    // Если значение — путь (одна строка без переносов), читаем файл
    Если СтрНайти(ТекстВыгрузки, Символ(10)) = 0 Тогда
        Чтение = ЧтениеТекста(ТекстВыгрузки);
        Чтение.Открыть();
        ТекстВыгрузки = Чтение.Прочитать();
        Чтение.Закрыть();
    КонецЕсли;

    СтрокиВыгрузки = СтрРазделить(СтрЗаменить(ТекстВыгрузки, Символ(13), ""), Символ(10));

    Формат = Объект.Формат;
    Если Формат = "" ИЛИ Формат = "Авто" Тогда
        Если СтрокиВыгрузки.Количество() > 0 Тогда
            ПерваяСтрока = СокрЛП(СтрокиВыгрузки[0]);
            Если СтрНачинаетсяС(ПерваяСтрока, "1CClientBankExchange") Тогда
                Формат = "1CClientBankExchange";
            Иначе
                Формат = "JSON";
            КонецЕсли;
        Иначе
            Формат = "JSON";
        КонецЕсли;
    КонецЕсли;

    Если Формат = "1CClientBankExchange" Тогда
        Разбор = Разобрать1CClientBankExchange(СтрокиВыгрузки);
        Платежи = Разбор.Платежи;
        СчётИзФайла = Разбор.РасчСчет;
    ИначеЕсли Формат = "JSON" Тогда
        Платежи = ReadJSON(ТекстВыгрузки);
        СчётИзФайла = "";
    Иначе
        Сообщить("Неизвестный формат: " + Формат);
        Возврат;
    КонецЕсли;

    // Проверка счёта
    Если СчётИзФайла <> "" Тогда
        Попытка
            НомерИзСправочника = ЗначениеРеквизитаОбъекта(Объект.БанковскийСчёт, "НомерСчёта");
            Если НомерИзСправочника <> "" И НомерИзСправочника <> СчётИзФайла Тогда
                Сообщить("Внимание: счёт в параметрах (" + НомерИзСправочника + ") не совпадает со счётом в файле (" + СчётИзФайла + ")");
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЕсли;

    // Разрешить контрагентов
    РазрешитьКонтрагентов(Платежи);

    // Заполнить табличную часть предпросмотра
    Объект.Платежи.Очистить();
    Для Каждого Платёж Из Платежи Цикл
        Стр = Объект.Платежи.Добавить();
        Стр.Дата = Платёж.Дата;
        Стр.Тип = Платёж.Тип;
        Стр.Контрагент = Платёж.Контрагент;
        Стр.Сумма = Платёж.Сумма;
        Стр.НазначениеПлатежа = Платёж.НазначениеПлатежа;
        Если Платёж.Свойство("НомерПлатёжки") Тогда
            Стр.НомерПлатёжки = Платёж.НомерПлатёжки;
        КонецЕсли;
    КонецЦикла;

    // Итоги
    КолПоступлений = 0;
    КолСписаний = 0;
    СуммаПоступлений = 0;
    СуммаСписаний = 0;
    Для Каждого Платёж Из Платежи Цикл
        Если Платёж.Тип = "Поступление" Тогда
            КолПоступлений = КолПоступлений + 1;
            СуммаПоступлений = СуммаПоступлений + Платёж.Сумма;
        ИначеЕсли Платёж.Тип = "Списание" Тогда
            КолСписаний = КолСписаний + 1;
            СуммаСписаний = СуммаСписаний + Платёж.Сумма;
        КонецЕсли;
        Маркер = "";
        Если Платёж.Свойство("СсылкаКонтрагент") И ЗначениеЗаполнено(Платёж.СсылкаКонтрагент) = Ложь Тогда
            Маркер = " [нет контрагента]";
        КонецЕсли;
        Сообщить(Платёж.Дата + " | " + Платёж.Тип + " | " + Платёж.Контрагент + Маркер + " | " + Строка(Платёж.Сумма));
    КонецЦикла;

    Сообщить("Поступлений: " + Строка(КолПоступлений) + " на сумму " + Строка(СуммаПоступлений));
    Сообщить("Списаний: " + Строка(КолСписаний) + " на сумму " + Строка(СуммаСписаний));
    Сообщить("Всего: " + Строка(Платежи.Количество()) + " платежей");
КонецПроцедуры

// @directive=&НаСервере
Процедура ЗаписатьНажатие()
    ВыполнитьДействие("Записать");
КонецПроцедуры

// @directive=&НаСервере
Процедура ЗаписатьИПровестиНажатие()
    ВыполнитьДействие("ЗаписатьИПровести");
КонецПроцедуры

// @directive=&НаСервере
Процедура ВыполнитьДействие(Действие)
    ТекстВыгрузки = Объект.ТекстВыгрузки;
    Если ТекстВыгрузки = "" Тогда
        Сообщить("Выберите файл выгрузки клиент-банка");
        Возврат;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.БанковскийСчёт) Тогда
        Сообщить("Укажите банковский счёт");
        Возврат;
    КонецЕсли;

    // Если значение — путь (одна строка без переносов), читаем файл
    Если СтрНайти(ТекстВыгрузки, Символ(10)) = 0 Тогда
        Чтение = ЧтениеТекста(ТекстВыгрузки);
        Чтение.Открыть();
        ТекстВыгрузки = Чтение.Прочитать();
        Чтение.Закрыть();
    КонецЕсли;

    СтрокиВыгрузки = СтрРазделить(СтрЗаменить(ТекстВыгрузки, Символ(13), ""), Символ(10));

    Формат = Объект.Формат;
    Если Формат = "" ИЛИ Формат = "Авто" Тогда
        Если СтрокиВыгрузки.Количество() > 0 Тогда
            ПерваяСтрока = СокрЛП(СтрокиВыгрузки[0]);
            Если СтрНачинаетсяС(ПерваяСтрока, "1CClientBankExchange") Тогда
                Формат = "1CClientBankExchange";
            Иначе
                Формат = "JSON";
            КонецЕсли;
        Иначе
            Формат = "JSON";
        КонецЕсли;
    КонецЕсли;

    Если Формат = "1CClientBankExchange" Тогда
        Разбор = Разобрать1CClientBankExchange(СтрокиВыгрузки);
        Платежи = Разбор.Платежи;
    ИначеЕсли Формат = "JSON" Тогда
        Платежи = ReadJSON(ТекстВыгрузки);
    Иначе
        Сообщить("Неизвестный формат: " + Формат);
        Возврат;
    КонецЕсли;

    РазрешитьКонтрагентов(Платежи);

    Проводить = (Действие = "ЗаписатьИПровести");
    СоздатьДокументы(Платежи, Объект.БанковскийСчёт, Проводить);
КонецПроцедуры

// ---- функции парсера (дублируют загрузкавыписки.proc.os для доступа из формы) ----

Функция Разобрать1CClientBankExchange(Строки)
    НашСчёт = "";
    ЧислоСтрок = Строки.Количество();

    Для Ном = 0 По ЧислоСтрок - 1 Цикл
        Стр = СокрЛП(Строки[Ном]);
        Если СтрНачинаетсяС(Стр, "РасчСчет=") Тогда
            НашСчёт = СокрЛП(Сред(Стр, 10));
            Прервать;
        КонецЕсли;
        Если СтрНачинаетсяС(Стр, "СекцияДокумент") Тогда
            Прервать;
        КонецЕсли;
    КонецЦикла;

    Платежи = Новый Массив;
    ВДокументе = Ложь;
    Платёж = Неопределено;
    СчетаЧастота = Новый Структура;

    Для Ном = 0 По ЧислоСтрок - 1 Цикл
        Стр = СокрЛП(Строки[Ном]);

        Если СтрНачинаетсяС(Стр, "СекцияДокумент") Тогда
            ВДокументе = Истина;
            Платёж = Новый Структура;
            Платёж.НазначениеПлатежа = "";
            Платёж.НомерПлатёжки = "";
            Платёж.Плательщик = "";
            Платёж.Получатель = "";
            Платёж.ПлательщикСчет = "";
            Платёж.ПолучательСчет = "";
            Продолжить;
        КонецЕсли;

        Если СтрНачинаетсяС(Стр, "КонецДокумента") Тогда
            Если Платёж <> Неопределено Тогда
                Если Платёж.ПлательщикСчет <> "" Тогда
                    УчестьСчёт(СчетаЧастота, Платёж.ПлательщикСчет);
                КонецЕсли;
                Если Платёж.ПолучательСчет <> "" Тогда
                    УчестьСчёт(СчетаЧастота, Платёж.ПолучательСчет);
                КонецЕсли;
                Платежи.Добавить(Платёж);
            КонецЕсли;
            ВДокументе = Ложь;
            Платёж = Неопределено;
            Продолжить;
        КонецЕсли;

        Если ВДокументе = Ложь Тогда
            Продолжить;
        КонецЕсли;

        ПозРавно = СтрНайти(Стр, "=");
        Если ПозРавно = 0 Тогда
            Продолжить;
        КонецЕсли;

        Ключ = Лев(Стр, ПозРавно - 1);
        Значение = Сред(Стр, ПозРавно + 1);

        Если Ключ = "Номер" Тогда
            Платёж.НомерПлатёжки = Значение;
        ИначеЕсли Ключ = "Дата" Тогда
            Платёж.Дата = Сред(Значение, 7, 4) + "-" + Сред(Значение, 4, 2) + "-" + Лев(Значение, 2);
        ИначеЕсли Ключ = "Сумма" Тогда
            Платёж.Сумма = Число(Значение);
        ИначеЕсли Ключ = "ПлательщикСчет" Тогда
            Платёж.ПлательщикСчет = Значение;
        ИначеЕсли Ключ = "ПолучательСчет" Тогда
            Платёж.ПолучательСчет = Значение;
        ИначеЕсли Ключ = "Получатель" Тогда
            Платёж.Получатель = Значение;
        ИначеЕсли Ключ = "Плательщик" Тогда
            Платёж.Плательщик = Значение;
        ИначеЕсли СтрНачинаетсяС(Ключ, "НазначениеПлатежа") Тогда
            Если Платёж.НазначениеПлатежа = "" Тогда
                Платёж.НазначениеПлатежа = Значение;
            Иначе
                Платёж.НазначениеПлатежа = Платёж.НазначениеПлатежа + " " + Значение;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Если НашСчёт = "" И СчетаЧастота.Количество() > 0 Тогда
        МаксЧастота = 0;
        Для Каждого Элемент Из СчетаЧастота Цикл
            Если Элемент.Значение > МаксЧастота Тогда
                МаксЧастота = Элемент.Значение;
                НашСчёт = Элемент.Ключ;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Для Каждого Платёж Из Платежи Цикл
        Если Платёж.ПлательщикСчет = НашСчёт Тогда
            Платёж.Тип = "Списание";
            Платёж.Контрагент = Платёж.Получатель;
        Иначе
            Платёж.Тип = "Поступление";
            Платёж.Контрагент = Платёж.Плательщик;
        КонецЕсли;
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Платежи = Платежи;
    Результат.РасчСчет = НашСчёт;
    Возврат Результат;
КонецФункции

Процедура УчестьСчёт(Счета, Счёт)
    Если Счета.Свойство(Счёт) Тогда
        Счета[Счёт] = Счета[Счёт] + 1;
    Иначе
        Счета.Вставить(Счёт, 1);
    КонецЕсли;
КонецПроцедуры

Процедура РазрешитьКонтрагентов(Платежи)
    Кэш = Новый Структура;
    Для Каждого Платёж Из Платежи Цикл
        Имя = Платёж.Контрагент;
        Если Имя = "" Тогда
            Продолжить;
        КонецЕсли;

        Если Кэш.Свойство(Имя) Тогда
            Платёж.СсылкаКонтрагент = Кэш[Имя];
            Продолжить;
        КонецЕсли;

        Ссылка = Справочники.Контрагент.НайтиПоНаименованию(Имя);
        Если ЗначениеЗаполнено(Ссылка) = Ложь Тогда
            Ссылка = Справочники.Контрагент.Создать();
            Ссылка.Наименование = Имя;
            Ссылка.Записать();
        КонецЕсли;
        Кэш.Вставить(Имя, Ссылка);
        Платёж.СсылкаКонтрагент = Ссылка;
    КонецЦикла;
КонецПроцедуры

Процедура СоздатьДокументы(Платежи, БанковскийСчёт, Проводить)
    Результат = Новый Структура;
    Результат.Поступлений = 0;
    Результат.Списаний = 0;
    Результат.Проведено = 0;
    Результат.Ошибки = Новый Массив;

    НачатьТранзакцию();
    Попытка
        Для Каждого Платёж Из Платежи Цикл
            Попытка
                Если Платёж.Свойство("СсылкаКонтрагент") = Ложь ИЛИ ЗначениеЗаполнено(Платёж.СсылкаКонтрагент) = Ложь Тогда
                    Результат.Ошибки.Добавить(Строка(Платёж.Тип) + " " + Строка(Платёж.Сумма) + ": контрагент не найден (" + Платёж.Контрагент + ")");
                    Продолжить;
                КонецЕсли;

                Тип = Платёж.Тип;
                Если Тип = "Поступление" Тогда
                    Документ = Документы.ПоступлениеНаРасчётныйСчёт.Создать();
                    Результат.Поступлений = Результат.Поступлений + 1;
                ИначеЕсли Тип = "Списание" Тогда
                    Документ = Документы.СписаниеСРасчётныйСчёт.Создать();
                    Результат.Списаний = Результат.Списаний + 1;
                Иначе
                    Результат.Ошибки.Добавить("Неизвестный тип: " + Строка(Тип));
                    Продолжить;
                КонецЕсли;

                Документ.Дата = Платёж.Дата;
                Документ.Организация = ОрганизацияПоУмолчанию();
                Документ.БанковскийСчёт = БанковскийСчёт;
                Документ.Контрагент = Платёж.СсылкаКонтрагент;
                Документ.Сумма = Платёж.Сумма;
                Документ.НазначениеПлатежа = Платёж.НазначениеПлатежа;

                Если Платёж.Свойство("НомерПлатёжки") И Платёж.НомерПлатёжки <> "" Тогда
                    Документ.НомерПлатёжки = Платёж.НомерПлатёжки;
                КонецЕсли;
                Если Платёж.Свойство("ДатаПлатёжки") Тогда
                    Документ.ДатаПлатёжки = Платёж.ДатаПлатёжки;
                КонецЕсли;

                Документ.Записать();

                Если Проводить = Истина Тогда
                    Документ.Провести();
                    Результат.Проведено = Результат.Проведено + 1;
                КонецЕсли;
            Исключение
                Результат.Ошибки.Добавить(Строка(Платёж.Тип) + " " + Строка(Платёж.Сумма) + ": " + ОписаниеОшибки());
            КонецПопытки;
        КонецЦикла;

        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        Результат.Поступлений = 0;
        Результат.Списаний = 0;
        Результат.Проведено = 0;
        Результат.Ошибки.Добавить("Транзакция откатана: " + ОписаниеОшибки());
    КонецПопытки;

    Для Каждого Ошибка Из Результат.Ошибки Цикл
        Сообщить("Ошибка: " + Ошибка);
    КонецЦикла;
    Сообщить("Создано: поступлений " + Строка(Результат.Поступлений) + ", списаний " + Строка(Результат.Списаний) + ", проведено " + Строка(Результат.Проведено));
КонецПроцедуры

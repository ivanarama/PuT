// Обработчики управляемой формы «Заказ покупателя».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДата();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.СпособУчетаНДС) Тогда
        Объект.СпособУчетаНДС = "ВТомЧисле";
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПередЗаписьюФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Покупатель) Тогда
        ВызватьИсключение("Укажите покупателя");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Если Объект.Товары.Количество() = 0 Тогда
        ВызватьИсключение("Добавьте хотя бы одну строку в табличную часть");
    КонецЕсли;
    ПересчитатьИтоги();
КонецПроцедуры

// @directive=&НаСервере
Процедура ПриЗаписиФормы()
    Сообщить("Заказ покупателя № " + Объект.Номер
        + " на сумму " + Строка(Объект.Сумма) + " сохранён");
КонецПроцедуры

// @directive=&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаКлиенте
Процедура ПокупательПриИзменении(Элемент)
    Если ЗначениеЗаполнено(Объект.Покупатель) Тогда
        ТипЦен = ЗначениеРеквизитаОбъекта(Объект.Покупатель, "ТипЦенПродажи");
        Если ЗначениеЗаполнено(ТипЦен) И НЕ ЗначениеЗаполнено(Объект.ТипЦенПродажи) Тогда
            Объект.ТипЦенПродажи = ТипЦен;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

// @directive=&НаКлиенте
Процедура СкладПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаКлиенте
Процедура ТипЦенПродажиПриИзменении(Элемент)
    Если ЗначениеЗаполнено(Объект.ТипЦенПродажи) Тогда
        Для Каждого Стр Из Объект.Товары Цикл
            Если Стр.Цена = 0 И ЗначениеЗаполнено(Стр.Номенклатура) Тогда
                Стр.Цена = ПолучитьЦену(Стр.Номенклатура, Объект.ТипЦенПродажи, Объект.Дата);
            КонецЕсли;
        КонецЦикла;
        ПересчитатьИтоги();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаКлиенте
Процедура СпособУчетаНДСПриИзменении(Элемент)
    ПересчитатьИтоги();
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаПересчитатьНажатие()
    ПересчитатьИтоги();
    Сообщить("Итоги пересчитаны: сумма " + Строка(Объект.Сумма));
КонецПроцедуры

// @directive=&НаСервере
// Авто-заполнение цены/ставки и пересчёт итогов при изменении ячейки грида
// (событие ПриИзменении табличной части). Тихий — без Сообщить.
Процедура ТабТоварыПриИзменении()
    ЗаполнитьЦеныИСтавкиСтрок();
    ПересчитатьИтоги();
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Товары.Очистить();
    Объект.СуммаБезНДС = 0;
    Объект.СуммаНДС = 0;
    Объект.Сумма = 0;
    Сообщить("Таблица товаров очищена");
КонецПроцедуры

// @directive=&НаСервере
// ФАЗА 1 — собрать кандидатов и открыть диалог подбора.
Процедура КнопкаПодборНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Сначала укажите склад");
    КонецЕсли;
    Орг = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());

    // Уже добавленные позиции исключаем из предложения (по наименованию).
    Есть = Новый Соответствие;
    Для Каждого Стр Из Объект.Товары Цикл
        Есть.Вставить(Строка(Стр.Номенклатура), Истина);
    КонецЦикла;

    // Ссылка самого заказа: при повторном подборе его собственные резервы
    // не должны съедать ему же свободный остаток (у новой записи Ссылки нет —
    // ЗначениеЗаполнено даст Ложь, фильтр просто не поставится).
    Кандидаты = СвободныеОстаткиСклада(Объект.Склад, Орг, Объект.Ссылка, Момент);

    // Описание колонок диалога (массив структур).
    Колонки = Новый Массив;
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип,Редактируемое", "Номенклатура", "Номенклатура", "string", Ложь));
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип,Редактируемое", "Свободно",     "Свободно",     "number", Ложь));
    Колонки.Добавить(Новый Структура("Имя,Заголовок,Тип,Редактируемое", "Количество",   "Кол-во",       "number", Истина));

    // Строки диалога. Идентификатор = наименование (фаза 2 ищет НайтиПоНаименованию).
    Данные = Новый Массив;
    Для Каждого К Из Кандидаты Цикл
        Имя = Строка(К.Номенклатура);
        Если Есть.Получить(Имя) <> Неопределено Тогда Продолжить; КонецЕсли;
        Данные.Добавить(Новый Структура(
            "Идентификатор,Номенклатура,Свободно,Количество",
            Имя, Имя, К.Свободно, 0));
    КонецЦикла;

    Если Данные.Количество() = 0 Тогда
        Сообщить("Свободных остатков на складе нет");
        Возврат;
    КонецЕсли;

    Конфиг = Новый Структура("Заголовок,ПолеПоиска,ПолеКоличества,ВыбратьВсе",
        "Подбор по остаткам", "Номенклатура", "Количество", Ложь);

    ПоказатьПодбор(Данные, Колонки, Конфиг);
КонецПроцедуры

// @directive=&НаСервере
// ФАЗА 2 — перенести отмеченные строки диалога в табличную часть.
Процедура КнопкаПодборВыбор()
    Добавлено = 0;
    Для Каждого Стр Из ПодборРезультат Цикл
        Кол = Число(Стр.Количество);
        Если Кол <= 0 Тогда Продолжить; КонецЕсли;
        НомСсылка = Справочники.Номенклатура.НайтиПоНаименованию(Стр.Номенклатура);
        Если ЗначениеЗаполнено(НомСсылка) = Ложь Тогда Продолжить; КонецЕсли;
        Нов = Объект.Товары.Добавить();
        Нов.Номенклатура = НомСсылка;
        Нов.Количество   = Кол;
        Нов.СтавкаНДС    = ЗначениеРеквизитаОбъекта(НомСсылка, "СтавкаНДС");
        Если ЗначениеЗаполнено(Объект.ТипЦенПродажи) Тогда
            Нов.Цена = ПолучитьЦену(НомСсылка, Объект.ТипЦенПродажи, Объект.Дата);
        КонецЕсли;
        Добавлено = Добавлено + 1;
    КонецЦикла;
    ПересчитатьИтоги();
    Сообщить(?(Добавлено = 0, "Ничего не выбрано",
        "Подобрано позиций: " + Строка(Добавлено)));
КонецПроцедуры

// @directive=&НаСервере
// Заполняет пустые цену и ставку НДС у строк (по номенклатуре и типу цен).
// Используется авто-заполнением при изменении ячейки грида.
Процедура ЗаполнитьЦеныИСтавкиСтрок()
    Для Каждого Стр Из Объект.Товары Цикл
        Если ЗначениеЗаполнено(Стр.Номенклатура) = Ложь Тогда Продолжить; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.СтавкаНДС) = Ложь Тогда
            Стр.СтавкаНДС = ЗначениеРеквизитаОбъекта(Стр.Номенклатура, "СтавкаНДС");
        КонецЕсли;
        Если Стр.Цена = 0 И ЗначениеЗаполнено(Объект.ТипЦенПродажи) Тогда
            Стр.Цена = ПолучитьЦену(Стр.Номенклатура, Объект.ТипЦенПродажи, Объект.Дата);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПересчитатьИтоги()
    Способ = Объект.СпособУчетаНДС;
    Если ЗначениеЗаполнено(Способ) = Ложь Тогда
        Способ = "ВТомЧисле";
    КонецЕсли;

    ИтогБезНДС = 0;
    ИтогНДС = 0;
    Для Каждого Стр Из Объект.Товары Цикл
        Стр.Сумма = Стр.Количество * Стр.Цена;
        Если ЗначениеЗаполнено(Стр.СтавкаНДС) Тогда
            Стр.СуммаНДС = СуммаНДСстроки(Стр.Сумма, Стр.СтавкаНДС, Способ);
        Иначе
            Стр.СуммаНДС = 0;
        КонецЕсли;
        Если Способ = "Сверху" Тогда
            ИтогБезНДС = ИтогБезНДС + Стр.Сумма;
        Иначе
            ИтогБезНДС = ИтогБезНДС + (Стр.Сумма - Стр.СуммаНДС);
        КонецЕсли;
        ИтогНДС = ИтогНДС + Стр.СуммаНДС;
    КонецЦикла;

    Объект.СуммаБезНДС = ИтогБезНДС;
    Объект.СуммаНДС = ИтогНДС;
    Объект.Сумма = ИтогБезНДС + ИтогНДС;
КонецПроцедуры

// Обработчики управляемой формы «Установка цен».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДата();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПередЗаписьюФормы()
    Если НЕ ЗначениеЗаполнено(Объект.ТипЦен) Тогда
        ВызватьИсключение("Укажите тип цен");
    КонецЕсли;
    Если Объект.Цены.Количество() = 0 Тогда
        ВызватьИсключение("Добавьте хотя бы одну строку в табличную часть");
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПриЗаписиФормы()
    Сообщить("Установка цен № " + Объект.Номер + " (" + Строка(Объект.Цены.Количество()) + " позиций) сохранена");
КонецПроцедуры

// @directive=&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Цены.Очистить();
    Сообщить("Таблица цен очищена");
КонецПроцедуры

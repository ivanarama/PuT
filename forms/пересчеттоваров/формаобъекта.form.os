// Обработчики управляемой формы «Пересчёт товаров».
// Документ не проводится: фиксирует результат пересчёта и оформляет
// оприходование излишков / списание недостач отдельными документами.

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДатаВремя();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = СкладПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПередЗаписьюФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        ВызватьИсключение("Укажите организацию");
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
// Заполнить ТЧ учётными остатками склада (факт = учёт, отклонения вносит оператор).
Процедура КнопкаЗаполнитьНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Сообщить("Укажите склад!");
        Возврат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
        Номенклатура КАК Номенклатура,
        СУММА(ВЫБОР КОГДА вид_движения = ""Приход"" ТОГДА Количество ИНАЧЕ -Количество КОНЕЦ) КАК Остаток
      ИЗ РегистрНакопления.ОстаткиТоваров
      ГДЕ Склад = &Склад
      СГРУППИРОВАТЬ ПО Номенклатура
      ИМЕЯ СУММА(ВЫБОР КОГДА вид_движения = ""Приход"" ТОГДА Количество ИНАЧЕ -Количество КОНЕЦ) <> 0
      УПОРЯДОЧИТЬ ПО Номенклатура";
    Запрос.УстановитьПараметр("Склад", Объект.Склад);

    Объект.Товары.Очистить();
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        НовСтр = Объект.Товары.Добавить();
        НовСтр.Номенклатура = Стр.Номенклатура;
        НовСтр.КоличествоУчёт = Стр.Остаток;
        НовСтр.КоличествоФакт = Стр.Остаток;
    КонецЦикла;
    Сообщить("Заполнено позиций по учётным остаткам: " + Строка(Объект.Товары.Количество()));
КонецПроцедуры

// @directive=&НаСервере
// Оформить излишки (оприходование) и недостачи (списание) по отклонениям.
Процедура КнопкаОформитьНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Организация) ИЛИ НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Сообщить("Укажите организацию и склад!");
        Возврат;
    КонецЕсли;
    Если Объект.Товары.Количество() = 0 Тогда
        Сообщить("Таблица пуста — сначала заполните или внесите результаты пересчёта.");
        Возврат;
    КонецЕсли;

    Опр = Неопределено;
    Спис = Неопределено;
    Излишков = 0;
    Недостач = 0;

    Для Каждого Стр Из Объект.Товары Цикл
        Если НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда Продолжить; КонецЕсли;
        Откл = Стр.КоличествоФакт - Стр.КоличествоУчёт;
        Если Откл = 0 Тогда Продолжить; КонецЕсли;

        Если Откл > 0 Тогда
            Если Опр = Неопределено Тогда
                Опр = Документы.ОприходованиеТоваров.Создать();
                Опр.Дата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаВремя());
                Опр.Организация = Объект.Организация;
                Опр.Склад = Объект.Склад;
                Опр.Причина = "Излишки по пересчёту (от " + Строка(Объект.Номер) + ")";
            КонецЕсли;
            СтрО = Опр.Товары.Добавить();
            СтрО.Номенклатура = Стр.Номенклатура;
            СтрО.Количество = Откл;
            СтрО.Цена = СредняяЦенаПартии(Стр.Номенклатура);
            СтрО.Сумма = Окр(СтрО.Количество * СтрО.Цена, 2);
            Излишков = Излишков + 1;
        Иначе
            Если Спис = Неопределено Тогда
                Спис = Документы.СписаниеТоваров.Создать();
                Спис.Дата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаВремя());
                Спис.Организация = Объект.Организация;
                Спис.Склад = Объект.Склад;
                Спис.Причина = "Недостачи по пересчёту (от " + Строка(Объект.Номер) + ")";
            КонецЕсли;
            СтрС = Спис.Товары.Добавить();
            СтрС.Номенклатура = Стр.Номенклатура;
            СтрС.Количество = -Откл;
            Недостач = Недостач + 1;
        КонецЕсли;
    КонецЦикла;

    Если Опр <> Неопределено Тогда
        Опр.Записать();
        Опр.Провести();
        Сообщить("✅ Излишки: «Оприходование товаров» № " + Опр.Номер + " проведено (" + Строка(Излишков) + " поз.)");
    КонецЕсли;
    Если Спис <> Неопределено Тогда
        Спис.Записать();
        Спис.Провести();
        Сообщить("✅ Недостачи: «Списание товаров» № " + Спис.Номер + " проведено (" + Строка(Недостач) + " поз.)");
    КонецЕсли;
    Если Опр = Неопределено И Спис = Неопределено Тогда
        Сообщить("Отклонений нет — расхождений факт/учёт не обнаружено.");
    КонецЕсли;
КонецПроцедуры

// Средняя себестоимость единицы по партиям склада (для оценки излишков).
Функция СредняяЦенаПартии(Номенклатура)
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
        СУММА(ВЫБОР КОГДА вид_движения = ""Приход"" ТОГДА Сумма ИНАЧЕ -Сумма КОНЕЦ) КАК Сумма,
        СУММА(ВЫБОР КОГДА вид_движения = ""Приход"" ТОГДА Количество ИНАЧЕ -Количество КОНЕЦ) КАК Кол
      ИЗ РегистрНакопления.ПартииТоваров
      ГДЕ Номенклатура = &Ном AND Склад = &Скл";
    Запрос.УстановитьПараметр("Ном", Номенклатура);
    Запрос.УстановитьПараметр("Скл", Объект.Склад);
    Рез = Запрос.Выполнить();
    Если Рез.Количество() > 0 Тогда
        Стр = Рез[0];
        Если ЗначениеЗаполнено(Стр.Кол) И Стр.Кол > 0 И ЗначениеЗаполнено(Стр.Сумма) Тогда
            Возврат Окр(Стр.Сумма / Стр.Кол, 2);
        КонецЕсли;
    КонецЕсли;
    Возврат 0;
КонецФункции

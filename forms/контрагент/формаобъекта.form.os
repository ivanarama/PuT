
Процедура ОбновитьСведения()
  Объект.ДолгПокупателя = 0; Объект.ДолгПоставщику = 0; Объект.Просрочено = 0;
  Объект.НераспределённыеОплаты = 0;
  Объект.ДоступныйКредит = "Без ограничения";
  Объект.Неоплаченные.Очистить(); Объект.Заказы.Очистить(); Объект.История.Очистить();
  Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда Возврат; КонецЕсли;
  Данные = СводкаКонтрагентаПУТ(Объект.Ссылка);
  Объект.ДолгПокупателя = Данные.ДолгПокупателя;
  Объект.ДолгПоставщику = Данные.ДолгПоставщику;
  Объект.Просрочено = Данные.Просрочено;
  Объект.НераспределённыеОплаты = Данные.НераспределённыеОплаты;
  Если ЗначениеЗаполнено(Объект.КредитныйЛимит) Тогда
    Объект.ДоступныйКредит = Формат(МАКС(0, Объект.КредитныйЛимит - Объект.ДолгПокупателя), "ЧДЦ=2");
  КонецЕсли;
  ЗаполнитьТаблицуКарточкиПУТ(Объект.Неоплаченные, Данные.Неоплаченные, "Номер,Дата,СрокОплаты,Долг");
  ЗаполнитьТаблицуКарточкиПУТ(Объект.Заказы, ЗаказыКонтрагентаПУТ(Объект.Ссылка), "Номер,Дата,Этап,Сумма,Проведен");
  ЗаполнитьТаблицуКарточкиПУТ(Объект.История, ИсторияКонтрагентаПУТ(Объект.Ссылка), "Вид,Номер,Дата,Сумма");
КонецПроцедуры

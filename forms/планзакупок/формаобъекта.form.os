// АРМ Закупок — планирование потребности.
// Дефицит = резерв покупателей − остаток − товары в пути по организации и складу.
// Заказы поставщику создаёт и проводит этот АРМ; движения (ТоварыВПути) пишет
// проведение ЗаказаПоставщику.

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДатаВремя();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = СкладПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

Процедура ПараметрыРасчетаИзменены(Элемент)
    Объект.Потребность.Очистить();
КонецПроцедуры

// Владельца резерва хранит само движение, владельца поставки — заказ поставщику.
Функция ПолучитьПотребность(Момент)
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        ВызватьИсключение("Укажите организацию");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Запрос = Новый Запрос;
    // У старых движений реквизит пуст до переноса из заказов при обновлении.
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Р.Количество КАК Количество
                   ИЗ РегистрНакопления.РезервыТоваров КАК Р
                   ГДЕ Р.Склад = &Склад И Р.period <= &Момент
                       И (Р.КлючОрганизации ЕСТЬ ПУСТО ИЛИ Р.КлючОрганизации = """")";
    Запрос.УстановитьПараметр("Момент", Момент);
    Запрос.УстановитьПараметр("Склад", Объект.Склад);
    Для Каждого БезВладельца Из Запрос.Выполнить() Цикл
        ВызватьИсключение("В движениях резервов склада не заполнена организация. Попросите администратора выполнить перенос владельцев резервов.");
    КонецЦикла;
    Запрос.Текст = "ВЫБРАТЬ Д.ТоварИД, СУММА(Д.Заказано) КАК Заказано,
                         СУММА(Д.Остаток) КАК Остаток, СУММА(Д.ВПути) КАК ВПути
                   ИЗ (ВЫБРАТЬ Р.Номенклатура.Ссылка КАК ТоварИД,
                              СУММА(ВЫБОР КОГДА Р.вид_движения = ""Приход"" ТОГДА Р.Количество ИНАЧЕ -Р.Количество КОНЕЦ) КАК Заказано,
                              0 КАК Остаток, 0 КАК ВПути
                       ИЗ РегистрНакопления.РезервыТоваров КАК Р
                       ГДЕ Р.Склад = &Склад И Р.КлючОрганизации = &КлючОрганизации И Р.period <= &Момент
                       СГРУППИРОВАТЬ ПО Р.Номенклатура.Ссылка
                       ИМЕЯ СУММА(ВЫБОР КОГДА Р.вид_движения = ""Приход"" ТОГДА Р.Количество ИНАЧЕ -Р.Количество КОНЕЦ) > 0
                       ОБЪЕДИНИТЬ ВСЕ
                       ВЫБРАТЬ О.Номенклатура.Ссылка, 0, О.КоличествоОстаток, 0
                       ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент) КАК О
                       ГДЕ О.Склад = &Склад И О.Организация = &Организация
                       ОБЪЕДИНИТЬ ВСЕ
                       ВЫБРАТЬ Т.Номенклатура.Ссылка, 0, 0, Т.КоличествоОстаток
                       ИЗ РегистрНакопления.ТоварыВПути.Остатки(&Момент) КАК Т
                       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК П ПО П.Ссылка = Т.ЗаказПоставщику
                       ГДЕ Т.Склад = &Склад И П.Организация = &Организация) КАК Д
                   СГРУППИРОВАТЬ ПО Д.ТоварИД
                   ИМЕЯ СУММА(Д.Заказано) > 0";
    Запрос.УстановитьПараметр("Организация", Объект.Организация);
    Запрос.УстановитьПараметр("КлючОрганизации", УИДСсылки(Объект.Организация));
    Данные = Новый Соответствие;
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        Данные.Вставить(УИДСсылки(Стр.ТоварИД), Стр);
    КонецЦикла;
    Возврат Данные;
КонецФункции

// @directive=&НаСервере
// Авто-пересчёт суммы при правке количества или цены в гриде.
Процедура ТабПотребностьПриИзменении()
    Для Каждого Стр Из Объект.Потребность Цикл
        Стр.Дефицит = Стр.Заказано - Стр.Остаток - Стр.ВПути;
        Если Стр.Дефицит < 0 Тогда Стр.Дефицит = 0; КонецЕсли;
        Стр.Сумма   = Стр.КЗаказу * Стр.Цена;
    КонецЦикла;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаРассчитатьНажатие()
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), КонецДня(Объект.Дата), ТекущаяДатаВремя());
    Данные = ПолучитьПотребность(Момент);
    ТипЗакуп = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");

    Объект.Потребность.Очистить();
    ВсегоДефицит = 0;
    ВсегоСумма   = 0;
    Для Каждого Пара Из Данные Цикл
        Стрк = Пара.Значение;
        Дефицит = Макс(0, Стрк.Заказано - Стрк.Остаток - Стрк.ВПути);
        НомСсылка = Справочники.Номенклатура.НайтиПоИдентификатору(Пара.Ключ);
        Цена = 0;
        Если ЗначениеЗаполнено(ТипЗакуп) Тогда
            Цена = ПолучитьЦену(НомСсылка, ТипЗакуп, Момент);
        КонецЕсли;

        Нов = Объект.Потребность.Добавить();
        Нов.Номенклатура = НомСсылка;
        Нов.Заказано     = Стрк.Заказано;
        Нов.Остаток      = Стрк.Остаток;
        Нов.ВПути        = Стрк.ВПути;
        Нов.Дефицит      = Дефицит;
        Нов.КЗаказу      = Дефицит;
        Нов.Цена         = Цена;
        Нов.Сумма        = Дефицит * Цена;

        ВсегоДефицит = ВсегоДефицит + Дефицит;
        ВсегоСумма   = ВсегоСумма + Нов.Сумма;
    КонецЦикла;

    Если Объект.Потребность.Количество() = 0 Тогда
        Сообщить("Резервов под заказы покупателей на складе нет — потребности нет");
    Иначе
        Сообщить("Рассчитано позиций: " + Строка(Объект.Потребность.Количество())
            + ", дефицит: " + Строка(ВсегоДефицит) + " шт. на сумму " + Строка(ВсегоСумма));
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Потребность.Очистить();
    Сообщить("Таблица очищена");
КонецПроцедуры

// @directive=&НаСервере
// По строкам с «К заказу» > 0 создаёт и проводит ЗаказПоставщику.
Процедура КнопкаСоздатьЗаказНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
        ВызватьИсключение("Укажите поставщика");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Если Объект.Потребность.Количество() = 0 Тогда
        ВызватьИсключение("Сначала рассчитайте потребность");
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        // Второй заказ из ранее открытой вкладки должен увидеть первую поставку.
        Блокировка = БлокировкаДанных();
        Блок = Блокировка.Добавить("ПланЗакупок");
        Блок.УстановитьЗначение("Организация", УИДСсылки(Объект.Организация));
        Блок.УстановитьЗначение("Склад", УИДСсылки(Объект.Склад));
        Блокировка.Заблокировать();
        Момент = ?(ЗначениеЗаполнено(Объект.Дата), КонецДня(Объект.Дата), ТекущаяДатаВремя());
        Текущие = ПолучитьПотребность(Момент);
        Заказ = Документы.ЗаказПоставщику.Создать();
        Заказ.Дата          = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
        Заказ.Организация   = Объект.Организация;
        Заказ.Поставщик     = Объект.Поставщик;
        Заказ.Склад         = Объект.Склад;
        Заказ.СпособУчетаНДС = "ВТомЧисле";
        Заказ.Комментарий   = "Создан из АРМ Закупок по дефициту";

        Позиций = 0;
        Для Каждого Стр Из Объект.Потребность Цикл
            Если Стр.КЗаказу <= 0 ИЛИ НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда Продолжить; КонецЕсли;

            Если Стр.Заказано > 0 Тогда
                Текущая = Текущие.Получить(УИДСсылки(Стр.Номенклатура));
                Если Текущая = Неопределено ИЛИ Текущая.Заказано <> Стр.Заказано
                   ИЛИ Текущая.Остаток <> Стр.Остаток ИЛИ Текущая.ВПути <> Стр.ВПути Тогда
                    ВызватьИсключение("Потребность изменилась. Рассчитайте её заново.");
                КонецЕсли;
            КонецЕсли;
            СтрЗ = Заказ.Товары.Добавить();
            СтрЗ.Номенклатура = Стр.Номенклатура;
            СтрЗ.Количество   = Стр.КЗаказу;
            СтрЗ.Цена         = Стр.Цена;
            Позиций = Позиций + 1;
        КонецЦикла;

        Если Позиций = 0 Тогда
            ВызватьИсключение("Нет позиций с «К заказу» > 0 — заказывать нечего");
        КонецЕсли;

        Заказ.Записать();
        Заказ.Провести();
        Результат = "Заказ поставщику № " + Заказ.Номер + " на сумму " + Строка(Заказ.Сумма)
            + " (" + Строка(Позиций) + " позиц.) проведён — товары в пути обновлены";
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение("Не удалось создать заказ: " + ОписаниеОшибки());
    КонецПопытки;
    Объект.Потребность.Очистить();
    Сообщить(Результат);
КонецПроцедуры

// АРМ Закупок — планирование потребности.
// Дефицит = резерв покупателей − свободный остаток − товары в пути (по складу).
// Заказы поставщику создаёт и проводит этот АРМ; движения (ТоварыВПути) пишет
// проведение ЗаказаПоставщику.

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДата();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = СкладПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
// Получить (или завести) строку-аккумулятор {Заказано, Остаток, ВПути} по номенклатуре.
Функция ПолучитьСтроку(Данные, Ном)
    Стрк = Данные.Получить(Ном);
    Если Стрк = Неопределено Тогда
        Стрк = Новый Структура("Заказано,Остаток,ВПути", 0, 0, 0);
        Данные.Вставить(Ном, Стрк);
    КонецЕсли;
    Возврат Стрк;
КонецФункции

// @directive=&НаСервере
// Авто-пересчёт суммы при правке количества или цены в гриде.
Процедура ТабПотребностьПриИзменении()
    Для Каждого Стр Из Объект.Потребность Цикл
        Стр.Дефицит = Стр.Заказано - Стр.Остаток - Стр.ВПути;
        Если Стр.Дефицит < 0 Тогда Стр.Дефицит = 0; КонецЕсли;
        Стр.Сумма   = Стр.КЗаказу * Стр.Цена;
    КонецЦикла;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаРассчитатьНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), КонецДня(Объект.Дата), ТекущаяДатаВремя());

    Данные = Новый Соответствие;

    // Потребность = резервы под заказы покупателей. ЗаказПокупателя в SELECT НЕ берём
    // (автоджойн ищет наименование у документа) — фильтр и свёртка по номенклатуре.
    ЗРез = Новый Запрос;
    ЗРез.Текст = "ВЫБРАТЬ Номенклатура, КоличествоОстаток
                  ИЗ РегистрНакопления.РезервыТоваров.Остатки(&Момент)
                  ГДЕ Склад = &Склад И КоличествоОстаток > 0";
    ЗРез.УстановитьПараметр("Склад", Объект.Склад);
    ЗРез.УстановитьПараметр("Момент", Момент);
    Для Каждого Стр Из ЗРез.Выполнить() Цикл
        ИмяНом = Строка(Стр.Номенклатура);
        Стрк = ПолучитьСтроку(Данные, ИмяНом);
        Стрк.Заказано = Стрк.Заказано + Стр.КоличествоОстаток;
    КонецЦикла;

    // Остаток на складе.
    ЗОст = Новый Запрос;
    ЗОст.Текст = "ВЫБРАТЬ Номенклатура, КоличествоОстаток
                  ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент)
                  ГДЕ Склад = &Склад";
    ЗОст.УстановитьПараметр("Склад", Объект.Склад);
    ЗОст.УстановитьПараметр("Момент", Момент);
    Для Каждого Стр Из ЗОст.Выполнить() Цикл
        ИмяНом = Строка(Стр.Номенклатура);
        Стрк = ПолучитьСтроку(Данные, ИмяНом);
        Стрк.Остаток = Стрк.Остаток + Стр.КоличествоОстаток;
    КонецЦикла;

    // Товары в пути (ожидаемые поставки по складу).
    ЗПуть = Новый Запрос;
    ЗПуть.Текст = "ВЫБРАТЬ Номенклатура, КоличествоОстаток
                   ИЗ РегистрНакопления.ТоварыВПути.Остатки(&Момент)
                   ГДЕ Склад = &Склад";
    ЗПуть.УстановитьПараметр("Склад", Объект.Склад);
    ЗПуть.УстановитьПараметр("Момент", Момент);
    Для Каждого Стр Из ЗПуть.Выполнить() Цикл
        ИмяНом = Строка(Стр.Номенклатура);
        Стрк = ПолучитьСтроку(Данные, ИмяНом);
        Стрк.ВПути = Стрк.ВПути + Стр.КоличествоОстаток;
    КонецЦикла;

    ТипЗакуп = Справочники.ТипЦен.НайтиПоНаименованию("Закупочная");

    Объект.Потребность.Очистить();
    ВсегоДефицит = 0;
    ВсегоСумма   = 0;
    Для Каждого Пара Из Данные Цикл
        Стрк = Пара.Значение;
        // Показываем только позиции с реальной потребностью (есть резерв покупателей).
        Если Стрк.Заказано <= 0 Тогда Продолжить; КонецЕсли;
        Дефицит = Стрк.Заказано - Стрк.Остаток - Стрк.ВПути;
        Если Дефицит < 0 Тогда Дефицит = 0; КонецЕсли;

        НомСсылка = Справочники.Номенклатура.НайтиПоНаименованию(Пара.Ключ);
        Если НЕ ЗначениеЗаполнено(НомСсылка) Тогда
            Продолжить;
        КонецЕсли;

        Цена = 0;
        Если ЗначениеЗаполнено(ТипЗакуп) Тогда
            Цена = ПолучитьЦену(НомСсылка, ТипЗакуп, Момент);
        КонецЕсли;

        Нов = Объект.Потребность.Добавить();
        Нов.Номенклатура = Пара.Ключ;
        Нов.Заказано     = Стрк.Заказано;
        Нов.Остаток      = Стрк.Остаток;
        Нов.ВПути        = Стрк.ВПути;
        Нов.Дефицит      = Дефицит;
        Нов.КЗаказу      = Дефицит;
        Нов.Цена         = Цена;
        Нов.Сумма        = Дефицит * Цена;

        ВсегоДефицит = ВсегоДефицит + Дефицит;
        ВсегоСумма   = ВсегоСумма + Нов.Сумма;
    КонецЦикла;

    Если Объект.Потребность.Количество() = 0 Тогда
        Сообщить("Резервов под заказы покупателей на складе нет — потребности нет");
    Иначе
        Сообщить("Рассчитано позиций: " + Строка(Объект.Потребность.Количество())
            + ", дефицит: " + Строка(ВсегоДефицит) + " шт. на сумму " + Строка(ВсегоСумма));
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Потребность.Очистить();
    Сообщить("Таблица очищена");
КонецПроцедуры

// @directive=&НаСервере
// По строкам с «К заказу» > 0 создаёт и проводит ЗаказПоставщику.
Процедура КнопкаСоздатьЗаказНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
        ВызватьИсключение("Укажите поставщика");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Если Объект.Потребность.Количество() = 0 Тогда
        ВызватьИсключение("Сначала рассчитайте потребность");
    КонецЕсли;

    Попытка
        Заказ = Документы.ЗаказПоставщику.Создать();
        Заказ.Дата          = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
        Заказ.Организация   = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());
        Заказ.Поставщик     = Объект.Поставщик;
        Заказ.Склад         = Объект.Склад;
        Заказ.СпособУчетаНДС = "ВТомЧисле";
        Заказ.Комментарий   = "Создан из АРМ Закупок по дефициту";

        Позиций = 0;
        Для Каждого Стр Из Объект.Потребность Цикл
            Если Стр.КЗаказу <= 0 ИЛИ НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда Продолжить; КонецЕсли;

            НомСсылка = Стр.Номенклатура;
            Если ТипЗнч(НомСсылка) = "Строка" Тогда
                НомСсылка = Справочники.Номенклатура.НайтиПоНаименованию(Стр.Номенклатура);
            КонецЕсли;
            Если НЕ ЗначениеЗаполнено(НомСсылка) Тогда Продолжить; КонецЕсли;

            СтрЗ = Заказ.Товары.Добавить();
            СтрЗ.Номенклатура = НомСсылка;
            СтрЗ.Количество   = Стр.КЗаказу;
            СтрЗ.Цена         = Стр.Цена;
            Позиций = Позиций + 1;
        КонецЦикла;

        Если Позиций = 0 Тогда
            ВызватьИсключение("Нет позиций с «К заказу» > 0 — заказывать нечего");
        КонецЕсли;

        Заказ.Записать();
        Заказ.Провести();
        Сообщить("Заказ поставщику № " + Заказ.Номер + " на сумму " + Строка(Заказ.Сумма)
            + " (" + Строка(Позиций) + " позиц.) проведён — товары в пути обновлены");
    Исключение
        ВызватьИсключение("Не удалось создать заказ: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

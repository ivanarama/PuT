// АРМ Отгрузки — отгрузка зарезервированного по заказам покупателя.
// Заполняет резервы по заказам с учётом остатка склада; создаёт одну
// РеализациюТоваров на заказ. Проведение реализации снимает резерв (привязка
// ЗаказПокупателя) и списывает FIFO. Каждый заказ — в своей Попытке.

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДатаВремя();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = СкладПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаЗаполнитьНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Покупатель) Тогда
        ВызватьИсключение("Укажите покупателя");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), КонецДня(Объект.Дата), ТекущаяДатаВремя());

    Остатки = Новый Соответствие;
    ЗОст = Новый Запрос;
    ЗОст.Текст = "ВЫБРАТЬ Номенклатура.Ссылка КАК Ид, КоличествоОстаток
                  ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент)
                  ГДЕ Склад = &Склад И (&Организация ЕСТЬ ПУСТО ИЛИ Организация = &Организация)";
    ЗОст.УстановитьПараметр("Склад", Объект.Склад);
    ЗОст.УстановитьПараметр("Организация", Объект.Организация);
    ЗОст.УстановитьПараметр("Момент", Момент);
    Для Каждого Стр Из ЗОст.Выполнить() Цикл
        Ид = УИДСсылки(Стр.Ид);
        Остатки.Вставить(Ид, Остатки.Получить(Ид) + Стр.КоличествоОстаток);
    КонецЦикла;

    ЗРез = Новый Запрос;
    ЗРез.Текст = "ВЫБРАТЬ Р.ЗаказПокупателя.Ссылка КАК ЗаказИД, Р.Номенклатура.Ссылка КАК ТоварИД,
                          Р.КоличествоОстаток КАК Резерв
                  ИЗ РегистрНакопления.РезервыТоваров.Остатки(&Момент) КАК Р
                  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя КАК З ПО З.Ссылка = Р.ЗаказПокупателя
                  ГДЕ Р.Склад = &Склад И З.Покупатель = &Покупатель И Р.КоличествоОстаток > 0
                    И (&Организация ЕСТЬ ПУСТО ИЛИ З.Организация = &Организация)
                  УПОРЯДОЧИТЬ ПО З.Дата, З.Номер, Р.Номенклатура";
    ЗРез.УстановитьПараметр("Склад", Объект.Склад);
    ЗРез.УстановитьПараметр("Момент", Момент);
    ЗРез.УстановитьПараметр("Организация", Объект.Организация);
    ЗРез.УстановитьПараметр("Покупатель", Объект.Покупатель);

    Объект.Строки.Очистить();
    Для Каждого Р Из ЗРез.Выполнить() Цикл
        Ид = УИДСсылки(Р.ТоварИД);
        Остаток = Макс(0, Остатки.Получить(Ид));
        Нов = Объект.Строки.Добавить();
        Нов.ЗаказПокупателя = Документы.ЗаказПокупателя.НайтиПоИдентификатору(УИДСсылки(Р.ЗаказИД));
        Нов.Номенклатура = Справочники.Номенклатура.НайтиПоИдентификатору(Ид);
        Нов.Резерв = Р.Резерв;
        Нов.Остаток = Остаток;
        Нов.КОтгрузке = Мин(Р.Резерв, Остаток);
        Остатки.Вставить(Ид, Остаток - Нов.КОтгрузке);
    КонецЦикла;

    Если Объект.Строки.Количество() = 0 Тогда
        Сообщить("У покупателя нет открытых резервов по заказам на этом складе");
    Иначе
        Сообщить("Заполнено строк к отгрузке: " + Строка(Объект.Строки.Количество()));
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Строки.Очистить();
    Сообщить("Таблица очищена");
КонецПроцедуры

// @directive=&НаСервере
// Группирует строки по заказу и создаёт по реализации на заказ.
Процедура КнопкаСоздатьРеализацииНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Покупатель) Тогда
        ВызватьИсключение("Укажите покупателя");
    КонецЕсли;
    Если Объект.Строки.Количество() = 0 Тогда
        ВызватьИсключение("Сначала заполните строки к отгрузке");
    КонецЕсли;

    // Группировка по заказу (с сохранением порядка появления).
    Группы  = Новый Соответствие;
    Порядок = Новый Массив;
    Для Каждого Стр Из Объект.Строки Цикл
        Если Стр.КОтгрузке <= 0 ИЛИ НЕ ЗначениеЗаполнено(Стр.ЗаказПокупателя)
           ИЛИ НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда Продолжить; КонецЕсли;
        Список = Группы.Получить(Стр.ЗаказПокупателя);
        Если Список = Неопределено Тогда
            Список = Новый Массив;
            Группы.Вставить(Стр.ЗаказПокупателя, Список);
            Порядок.Добавить(Стр.ЗаказПокупателя);
        КонецЕсли;
        Список.Добавить(Новый Структура("Номенклатура,Количество", Стр.Номенклатура, Стр.КОтгрузке));
    КонецЦикла;

    Если Порядок.Количество() = 0 Тогда
        ВызватьИсключение("Нет строк с количеством к отгрузке");
    КонецЕсли;

    Дата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
    Орг  = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());

    Создано = 0;
    Ошибок  = 0;
    Для Каждого Заказ Из Порядок Цикл
        НачатьТранзакцию();
        Попытка
            ЗаказОбъект = Заказ.ПолучитьОбъект();
            Если УИДСсылки(ЗаказОбъект.Покупатель) <> УИДСсылки(Объект.Покупатель)
                ИЛИ УИДСсылки(ЗаказОбъект.Организация) <> УИДСсылки(Орг) Тогда
                ВызватьИсключение("Изменились покупатель или организация. Заполните строки заново.");
            КонецЕсли;
            ОстаткиРезерва = ОстаткиОдногоЗаказа(Заказ, Дата, Ложь);
            СкладыСтарого = СкладыСтарогоЗаказа(Заказ, Ложь);
            ПозицииПоТовару = Новый Соответствие;
            ЗаказаноПоТовару = Новый Соответствие;
            Для Каждого Позиция Из ЗаказОбъект.Товары Цикл
                Склад = ?(ЗначениеЗаполнено(Позиция.Склад), Позиция.Склад, ЗаказОбъект.Склад);
                СтарыйСклад = СкладыСтарого.Получить(КлючСтрокиЗаказа(Склад, Позиция.Номенклатура));
                СкладРезерва = ?(ЗначениеЗаполнено(СтарыйСклад), СтарыйСклад, Склад);
                Если УИДСсылки(СкладРезерва) <> УИДСсылки(Объект.Склад) Тогда Продолжить; КонецЕсли;
                Ид = УИДСсылки(Позиция.Номенклатура);
                Позиции = ПозицииПоТовару.Получить(Ид);
                Если Позиции = Неопределено Тогда
                    Позиции = Новый Массив;
                    ПозицииПоТовару.Вставить(Ид, Позиции);
                КонецЕсли;
                Позиции.Добавить(Позиция);
                ЗаказаноПоТовару.Вставить(Ид, ЗаказаноПоТовару.Получить(Ид) + Позиция.Количество);
            КонецЦикла;

            Реал = Документы.РеализацияТоваров.Создать();
            Реал.Дата           = Дата;
            Реал.Организация    = Орг;
            Реал.Покупатель     = Объект.Покупатель;
            Реал.Склад          = Объект.Склад;
            Реал.ЗаказПокупателя = Заказ;
            Реал.ТипЦенПродажи  = ЗначениеРеквизитаОбъекта(Заказ, "ТипЦенПродажи");
            Способ = ЗначениеРеквизитаОбъекта(Заказ, "СпособУчетаНДС");
            Реал.СпособУчетаНДС = ?(ЗначениеЗаполнено(Способ), Способ, "ВТомЧисле");
            Для Каждого П Из Группы.Получить(Заказ) Цикл
                Ид = УИДСсылки(П.Номенклатура);
                Остаток = ОстаткиРезерва.Получить(КлючСтрокиЗаказа(Объект.Склад, П.Номенклатура));
                Если Остаток = Неопределено ИЛИ П.Количество > Остаток.Количество ИЛИ ПозицииПоТовару.Получить(Ид) = Неопределено Тогда
                    ВызватьИсключение("Количество к отгрузке превышает текущий резерв. Обновите таблицу.");
                КонецЕсли;
                РанееОтгружено = Макс(0, ЗаказаноПоТовару.Получить(Ид) - Остаток.Количество);
                ОсталосьОтгрузить = П.Количество;
                Для Каждого Позиция Из ПозицииПоТовару.Получить(Ид) Цикл
                    Учтено = Мин(РанееОтгружено, Позиция.Количество);
                    РанееОтгружено = РанееОтгружено - Учтено;
                    Количество = Мин(ОсталосьОтгрузить, Позиция.Количество - Учтено);
                    Если Количество <= 0 Тогда Продолжить; КонецЕсли;
                    СтрР = Реал.Товары.Добавить();
                    СтрР.Номенклатура = Позиция.Номенклатура;
                    СтрР.Количество = Количество;
                    СтрР.Цена = Позиция.Цена;
                    СтрР.СтавкаНДС = Позиция.СтавкаНДС;
                    СтрР.ПроцентСкидки = Позиция.ПроцентСкидки;
                    СтрР.Склад = ?(ЗначениеЗаполнено(Позиция.Склад), Позиция.Склад, ЗаказОбъект.Склад);
                    ОсталосьОтгрузить = ОсталосьОтгрузить - Количество;
                КонецЦикла;
                Если ОсталосьОтгрузить > 0 Тогда
                    ВызватьИсключение("Состав заказа изменился. Обновите таблицу.");
                КонецЕсли;
                Остаток.Количество = Остаток.Количество - П.Количество;
            КонецЦикла;
            Реал.Записать();
            Реал.Провести();
            ЗафиксироватьТранзакцию();
            Создано = Создано + 1;
        Исключение
            ОтменитьТранзакцию();
            Ошибок = Ошибок + 1;
            Сообщить("Заказ «" + Строка(Заказ) + "» пропущен: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;

    Если Создано > 0 Тогда
        Объект.Строки.Очистить();
    КонецЕсли;
    Сообщить("Создано реализаций: " + Строка(Создано)
        + ?(Ошибок > 0, " (с ошибками: " + Строка(Ошибок) + ")", ""));
КонецПроцедуры

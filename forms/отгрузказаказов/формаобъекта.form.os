// АРМ Отгрузки — отгрузка зарезервированного по заказам покупателя.
// Заполняет резервы по заказам с учётом остатка склада; создаёт одну
// РеализациюТоваров на заказ. Проведение реализации снимает резерв (привязка
// ЗаказПокупателя) и списывает FIFO. Каждый заказ — в своей Попытке.

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДатаВремя();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        Объект.Склад = СкладПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаЗаполнитьНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Покупатель) Тогда
        ВызватьИсключение("Укажите покупателя");
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), КонецДня(Объект.Дата), ТекущаяДатаВремя());

    // Остаток склада по номенклатуре.
    Остатки = Новый Соответствие;
    ЗОст = Новый Запрос;
    ЗОст.Текст = "ВЫБРАТЬ Номенклатура, КоличествоОстаток
                  ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент)
                  ГДЕ Склад = &Склад";
    ЗОст.УстановитьПараметр("Склад", Объект.Склад);
    ЗОст.УстановитьПараметр("Момент", Момент);
    Для Каждого Стр Из ЗОст.Выполнить() Цикл
        Тек = Остатки.Получить(Стр.Номенклатура);
        Если Тек = Неопределено Тогда Тек = 0; КонецЕсли;
        Остатки.Вставить(Стр.Номенклатура, Тек + Стр.КоличествоОстаток);
    КонецЦикла;

    // Заказы покупателя на этом складе (по номеру → ссылка).
    ЗЗак = Новый Запрос;
    ЗЗак.Текст = "ВЫБРАТЬ р.Номер КАК Номер
                  ИЗ Документ.ЗаказПокупателя КАК р
                  ГДЕ р.Покупатель = &Пок И р.Склад = &Склад";
    ЗЗак.УстановитьПараметр("Пок", Объект.Покупатель);
    ЗЗак.УстановитьПараметр("Склад", Объект.Склад);

    Объект.Строки.Очистить();
    Для Каждого СтрЗ Из ЗЗак.Выполнить() Цикл
        ЗаказСсылка = Документы.ЗаказПокупателя.НайтиПоНомеру(СтрЗ.Номер);
        Если НЕ ЗначениеЗаполнено(ЗаказСсылка) Тогда Продолжить; КонецЕсли;

        // Резерв по заказу. ЗаказПокупателя в SELECT не берём (автоджойн ищет
        // наименование у документа) — фильтруем во ГДЕ.
        ЗРез = Новый Запрос;
        ЗРез.Текст = "ВЫБРАТЬ Номенклатура, КоличествоОстаток
                      ИЗ РегистрНакопления.РезервыТоваров.Остатки(&Момент)
                      ГДЕ ЗаказПокупателя = &Заказ И КоличествоОстаток > 0";
        ЗРез.УстановитьПараметр("Заказ", ЗаказСсылка);
        ЗРез.УстановитьПараметр("Момент", Момент);
        Для Каждого СтрР Из ЗРез.Выполнить() Цикл
            ИмяНом = Строка(СтрР.Номенклатура);
            НомСсылка = Справочники.Номенклатура.НайтиПоНаименованию(ИмяНом);
            Если НЕ ЗначениеЗаполнено(НомСсылка) Тогда Продолжить; КонецЕсли;

            Остаток = Остатки.Получить(ИмяНом);
            Если Остаток = Неопределено Тогда
                Остаток = Остатки.Получить(НомСсылка);
            КонецЕсли;
            Если Остаток = Неопределено Тогда Остаток = 0; КонецЕсли;

            Нов = Объект.Строки.Добавить();
            Нов.ЗаказПокупателя = ЗаказСсылка;
            Нов.Номенклатура    = ИмяНом;
            Нов.Резерв          = СтрР.КоличествоОстаток;
            Нов.Остаток         = Остаток;
            Нов.КОтгрузке       = Мин(СтрР.КоличествоОстаток, Остаток);
        КонецЦикла;
    КонецЦикла;

    Если Объект.Строки.Количество() = 0 Тогда
        Сообщить("У покупателя нет открытых резервов по заказам на этом складе");
    Иначе
        Сообщить("Заполнено строк к отгрузке: " + Строка(Объект.Строки.Количество()));
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Строки.Очистить();
    Сообщить("Таблица очищена");
КонецПроцедуры

// @directive=&НаСервере
// Группирует строки по заказу и создаёт по реализации на заказ.
Процедура КнопкаСоздатьРеализацииНажатие()
    Если НЕ ЗначениеЗаполнено(Объект.Покупатель) Тогда
        ВызватьИсключение("Укажите покупателя");
    КонецЕсли;
    Если Объект.Строки.Количество() = 0 Тогда
        ВызватьИсключение("Сначала заполните строки к отгрузке");
    КонецЕсли;

    // Группировка по заказу (с сохранением порядка появления).
    Группы  = Новый Соответствие;
    Порядок = Новый Массив;
    Для Каждого Стр Из Объект.Строки Цикл
        Если Стр.КОтгрузке <= 0 ИЛИ НЕ ЗначениеЗаполнено(Стр.ЗаказПокупателя)
           ИЛИ НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда Продолжить; КонецЕсли;
        Список = Группы.Получить(Стр.ЗаказПокупателя);
        Если Список = Неопределено Тогда
            Список = Новый Массив;
            Группы.Вставить(Стр.ЗаказПокупателя, Список);
            Порядок.Добавить(Стр.ЗаказПокупателя);
        КонецЕсли;
        Список.Добавить(Новый Структура("Номенклатура,Количество", Стр.Номенклатура, Стр.КОтгрузке));
    КонецЦикла;

    Если Порядок.Количество() = 0 Тогда
        ВызватьИсключение("Нет строк с количеством к отгрузке");
    КонецЕсли;

    Дата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
    Орг  = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());

    Создано = 0;
    Ошибок  = 0;
    Для Каждого Заказ Из Порядок Цикл
        Попытка
            // Цены из строк исходного заказа покупателя
            ЦеныЗаказа = Новый Соответствие;
            ЗаказОбъект = Заказ.ПолучитьОбъект();
            Для Каждого СтрЗ Из ЗаказОбъект.Товары Цикл
                ЦеныЗаказа.Вставить(СтрЗ.Номенклатура, СтрЗ.Цена);
                ЦеныЗаказа.Вставить(Строка(СтрЗ.Номенклатура), СтрЗ.Цена);
            КонецЦикла;

            Реал = Документы.РеализацияТоваров.Создать();
            Реал.Дата           = Дата;
            Реал.Организация    = Орг;
            Реал.Покупатель     = Объект.Покупатель;
            Реал.Склад          = Объект.Склад;
            Реал.ЗаказПокупателя = Заказ;
            Реал.ТипЦенПродажи  = ЗначениеРеквизитаОбъекта(Заказ, "ТипЦенПродажи");
            Способ = ЗначениеРеквизитаОбъекта(Заказ, "СпособУчетаНДС");
            Реал.СпособУчетаНДС = ?(ЗначениеЗаполнено(Способ), Способ, "ВТомЧисле");
            Для Каждого П Из Группы.Получить(Заказ) Цикл
                НомСсылка = П.Номенклатура;
                Если ТипЗнч(НомСсылка) = "Строка" Тогда
                    НомСсылка = Справочники.Номенклатура.НайтиПоНаименованию(П.Номенклатура);
                КонецЕсли;
                Если НЕ ЗначениеЗаполнено(НомСсылка) Тогда Продолжить; КонецЕсли;

                СтрР = Реал.Товары.Добавить();
                СтрР.Номенклатура = НомСсылка;
                СтрР.Количество   = П.Количество;
                Цена = ЦеныЗаказа.Получить(НомСсылка);
                Если Цена = Неопределено Тогда
                    Цена = ЦеныЗаказа.Получить(Строка(НомСсылка));
                КонецЕсли;
                Если Цена <> Неопределено И Цена > 0 Тогда
                    СтрР.Цена = Цена;
                КонецЕсли;
            КонецЦикла;
            Реал.Записать();
            Реал.Провести();
            Создано = Создано + 1;
        Исключение
            Ошибок = Ошибок + 1;
            Сообщить("Заказ «" + Строка(Заказ) + "» пропущен: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;

    Если Создано > 0 Тогда
        Объект.Строки.Очистить();
    КонецЕсли;
    Сообщить("Создано реализаций: " + Строка(Создано)
        + ?(Ошибок > 0, " (с ошибками: " + Строка(Ошибок) + ")", ""));
КонецПроцедуры


Процедура ОбновитьСведения()
  Объект.Остатки.Очистить(); Объект.Цены.Очистить(); Объект.Движения.Очистить();
  Объект.ВсегоНаСкладах = 0; Объект.Зарезервировано = 0; Объект.СвободноВсего = 0; Объект.ОжидаетсяВсего = 0;
  Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда Возврат; КонецЕсли;
  ЗаполнитьТаблицуКарточкиПУТ(Объект.Остатки, ОстаткиТовараПУТ(Объект.Ссылка), "Склад,Остаток,Резерв,Свободно,Ожидается");
  Для Каждого Стр Из Объект.Остатки Цикл
    Объект.ВсегоНаСкладах = Объект.ВсегоНаСкладах + Стр.Остаток;
    Объект.Зарезервировано = Объект.Зарезервировано + Стр.Резерв;
    Объект.СвободноВсего = Объект.СвободноВсего + Стр.Свободно;
    Объект.ОжидаетсяВсего = Объект.ОжидаетсяВсего + Стр.Ожидается;
  КонецЦикла;
  ЗаполнитьТаблицуКарточкиПУТ(Объект.Цены, ЦеныТовараПУТ(Объект.Ссылка), "ТипЦен,Цена");
  ЗаполнитьТаблицуКарточкиПУТ(Объект.Движения, ДвиженияТовараПУТ(Объект.Ссылка), "Дата,Склад,Вид,Количество");
КонецПроцедуры

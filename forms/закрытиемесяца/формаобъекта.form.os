
Процедура ЗапуститьВФоне()
  Если НЕ ЗначениеЗаполнено(Объект.ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
    ВызватьИсключение("Укажите начало и окончание периода");
  КонецЕсли;
  Если Объект.ДатаНачала > Объект.ДатаОкончания Тогда ВызватьИсключение("Начало периода позже окончания"); КонецЕсли;
  П = Новый Структура;
  П.Вставить("Организация", ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация.УникальныйИдентификатор(), ""));
  П.Вставить("ДатаНачала", Объект.ДатаНачала);
  П.Вставить("ДатаОкончания", Объект.ДатаОкончания);
  П.Вставить("УстановитьДатуЗапрета", Объект.УстановитьДатуЗапрета);
  Объект.ИдЗадачи = ФоновыеЗадания.Поставить("ФонЗакрытиеМесяца", П, "пут-ЗакрытиеМесяца");
  ОбновитьСтатус();
КонецПроцедуры

Процедура ОбновитьСтатус()
  Если НЕ ЗначениеЗаполнено(Объект.ИдЗадачи) Тогда Возврат; КонецЕсли;
  Задача = ФоновыеЗадания.Задача(Объект.ИдЗадачи);
  Если Задача = Неопределено Тогда Объект.СостояниеЗадачи = "История задачи удалена"; Возврат; КонецЕсли;
  Объект.СостояниеЗадачи = Задача.Статус;
  Если Задача.Статус = "pending" Тогда Объект.СостояниеЗадачи = "Ожидает выполнения"; КонецЕсли;
  Если Задача.Статус = "running" Тогда Объект.СостояниеЗадачи = "Выполняется"; КонецЕсли;
  Если Задача.Статус = "done" Тогда Объект.СостояниеЗадачи = "Выполнено"; КонецЕсли;
  Если Задача.Статус = "dead" Тогда Объект.СостояниеЗадачи = "Ошибка — требуется проверка"; КонецЕсли;
  Объект.РезультатЗадачи = Строка(Задача.Вывод) + " " + Строка(Задача.Ошибка);
КонецПроцедуры

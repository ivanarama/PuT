// Обработчики управляемой формы «Оприходование товаров».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДата();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ПередЗаписьюФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
        ВызватьИсключение("Укажите склад");
    КонецЕсли;
    Если Объект.Товары.Количество() = 0 Тогда
        ВызватьИсключение("Добавьте хотя бы одну строку в табличную часть");
    КонецЕсли;
    ПересчитатьИтоги();
КонецПроцедуры

// @directive=&НаСервере
Процедура ПриЗаписиФормы()
    Сообщить("Оприходование № " + Объект.Номер + " на сумму " + Строка(Объект.Сумма) + " сохранено");
КонецПроцедуры

// @directive=&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаКлиенте
Процедура СкладПриИзменении(Элемент)
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаПересчитатьНажатие()
    ПересчитатьИтоги();
    Сообщить("Итоги пересчитаны: сумма " + Строка(Объект.Сумма));
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Товары.Очистить();
    Объект.Сумма = 0;
    Сообщить("Таблица товаров очищена");
КонецПроцедуры

// @directive=&НаСервере
Процедура ПересчитатьИтоги()
    Итог = 0;
    Для Каждого Стр Из Объект.Товары Цикл
        Стр.Сумма = Стр.Количество * Стр.Цена;
        Итог = Итог + Стр.Сумма;
    КонецЦикла;
    Объект.Сумма = Итог;
КонецПроцедуры

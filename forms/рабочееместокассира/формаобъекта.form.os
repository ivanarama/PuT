// АРМ Кассира — взаиморасчёты в одном окне.
// Сальдо по контрагенту: > 0 — покупатель должен нам (→ ПКО), < 0 — мы должны
// поставщику (→ РКО). Оплаты создают и проводят ПКО/РКО; движения по
// ДенежнымСредствам и Взаиморасчётам пишет их проведение.

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
    Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
        Объект.Дата = ТекущаяДата();
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
        Объект.Организация = ОрганизацияПоУмолчанию();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаРассчитатьНажатие()
    Орг = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());
    Если НЕ ЗначениеЗаполнено(Орг) Тогда
        ВызватьИсключение("Укажите организацию");
    КонецЕсли;
    Момент = ?(ЗначениеЗаполнено(Объект.Дата), КонецДня(Объект.Дата), ТекущаяДатаВремя());

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Контрагент, СуммаОстаток
                    ИЗ РегистрНакопления.Взаиморасчеты.Остатки(&Момент)
                    ГДЕ Организация = &Орг";
    Запрос.УстановитьПараметр("Орг", Орг);
    Запрос.УстановитьПараметр("Момент", Момент);

    // Свёртка по контрагенту (на случай нескольких строк среза).
    Сальдо = Новый Соответствие;
    Для Каждого Стр Из Запрос.Выполнить() Цикл
        Тек = Сальдо.Получить(Стр.Контрагент);
        Если Тек = Неопределено Тогда Тек = 0; КонецЕсли;
        Сальдо.Вставить(Стр.Контрагент, Тек + Стр.СуммаОстаток);
    КонецЦикла;

    Объект.Долги.Очистить();
    Для Каждого Пара Из Сальдо Цикл
        С = Пара.Значение;
        Если С = 0 Тогда Продолжить; КонецЕсли;
        Нов = Объект.Долги.Добавить();
        Нов.Контрагент = Пара.Ключ;
        Нов.Долг = С;
        Если С > 0 Тогда
            Нов.ТипКонтрагента = "Покупатель";
            Нов.КОплате = С;
        Иначе
            Нов.ТипКонтрагента = "Поставщик";
            Нов.КОплате = -С;
        КонецЕсли;
    КонецЦикла;

    Если Объект.Долги.Количество() = 0 Тогда
        Сообщить("Открытых взаиморасчётов по организации нет");
    Иначе
        Сообщить("Контрагентов с сальдо: " + Строка(Объект.Долги.Количество()));
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОчиститьНажатие()
    Объект.Долги.Очистить();
    Сообщить("Таблица очищена");
КонецПроцедуры

// @directive=&НаСервере
// Проверка, что выбранная касса — наличная (ПКО/РКО работают только с видом «Касса»).
Процедура ПроверитьНаличнуюКассу()
    Если НЕ ЗначениеЗаполнено(Объект.Касса) Тогда
        ВызватьИсключение("Укажите кассу");
    КонецЕсли;
    Если ЗначениеРеквизитаОбъекта(Объект.Касса, "Вид") <> "Касса" Тогда
        ВызватьИсключение("Выбранная касса не наличная — для безнала используйте банковские документы");
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
// Общая логика оформления оплат: Приходный=Истина → ПКО по покупателям,
// Приходный=Ложь → РКО по поставщикам. Каждый ордер в своей Попытке —
// сбой одного контрагента не рушит весь пакет.
Процедура ОформитьОплаты(ТипКонтр, Приходный)
    ПроверитьНаличнуюКассу();
    Если Объект.Долги.Количество() = 0 Тогда
        ВызватьИсключение("Сначала рассчитайте долги");
    КонецЕсли;
    Дата = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
    Орг  = ?(ЗначениеЗаполнено(Объект.Организация), Объект.Организация, ОрганизацияПоУмолчанию());

    Создано = 0;
    ИтогоСумма = 0;
    Ошибок = 0;
    Для Каждого Стр Из Объект.Долги Цикл
        Если Стр.ТипКонтрагента <> ТипКонтр ИЛИ Стр.КОплате <= 0 Тогда Продолжить; КонецЕсли;
        Попытка
            Если Приходный Тогда
                Ордер = Документы.ПриходныйКассовыйОрдер.Создать();
                Ордер.Основание = "Оплата от покупателя (АРМ Кассира)";
            Иначе
                Ордер = Документы.РасходныйКассовыйОрдер.Создать();
                Ордер.Основание = "Оплата поставщику (АРМ Кассира)";
            КонецЕсли;
            Ордер.Дата        = Дата;
            Ордер.Организация = Орг;
            Ордер.Касса       = Объект.Касса;
            Ордер.Контрагент  = Стр.Контрагент;
            Ордер.Сумма       = Стр.КОплате;
            Ордер.Записать();
            Ордер.Провести();
            Создано = Создано + 1;
            ИтогоСумма = ИтогоСумма + Стр.КОплате;
        Исключение
            Ошибок = Ошибок + 1;
            Сообщить("Пропущен «" + Строка(Стр.Контрагент) + "»: " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;

    Если Создано = 0 Тогда
        Сообщить("Нет контрагентов для оплаты по типу «" + ТипКонтр + "»");
    Иначе
        Сообщить("Создано ордеров: " + Строка(Создано) + " на сумму " + Строка(ИтогоСумма)
            + ?(Ошибок > 0, " (пропущено: " + Строка(Ошибок) + ")", ""));
        КнопкаРассчитатьНажатие();
    КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаПринятьОплатуНажатие()
    ОформитьОплаты("Покупатель", Истина);
КонецПроцедуры

// @directive=&НаСервере
Процедура КнопкаОплатитьПоставщикуНажатие()
    ОформитьОплаты("Поставщик", Ложь);
КонецПроцедуры
